<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The gallery in the browser, published to GitHub Pages by .github/workflows/build.yml.

    Building it needs the wasm-tools workload (`dotnet workload install wasm-tools`): Avalonia.Browser
    ships Skia and HarfBuzz as native static libraries that are linked into dotnet.wasm, and that
    native link is what the workload provides.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fili.Theme.MudAvalonia.Gallery.Browser</RootNamespace>
    <AssemblyName>Fili.Theme.MudAvalonia.Gallery.Browser</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- No lock file here, alone in the solution: the WebAssembly SDK adds its own packages
         (ILLink, the WebAssembly pack) at the installed SDK's patch version, so a lock file would
         fail every CI restore the day the runner's SDK patch differed from the one that wrote it.
         Everything else this project restores is locked through the gallery it references. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <!-- Warnings fail the build (Directory.Build.props), but IL2104 is the trimmer's summary for
         a package's own assembly - Avalonia.Controls.DataGrid's - which this repository cannot
         fix. A trim warning in the theme or the gallery is still an error, one IL code each. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fili.Theme.MudAvalonia.Gallery\Fili.Theme.MudAvalonia.Gallery.csproj" />
  </ItemGroup>

</Project>
