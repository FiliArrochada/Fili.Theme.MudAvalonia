<!--
  MudDataGrid, loaded by FiliTheme.axaml's OptionalStyleInclude only when the app has
  Avalonia.Controls.DataGrid 12.1.0 or later.

  THE BOUNDARY: Avalonia.Controls.DataGrid's types are named in this folder and nowhere else. An
  app without the package never loads these two files, so it never asks for the assembly; a
  DataGrid selector or type anywhere else would take the whole theme down at startup in that app.
  OptionalBoundaryTests names the file and line that crosses it, and NoDataGridTests is the app.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:optional="using:Fili.Theme.MudAvalonia.Optional">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Optional/DataGrid/DataGrid.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!--
    MudDataGrid's row states, from _table.scss. Here rather than in DataGrid.axaml because a row's
    theme cannot see its grid's classes, and in this order because the later style wins: a stripe,
    then `hover`, which replaces the stripe under the pointer as `.mud-table-hover.mud-table-striped`
    does, then selection - this theme's one addition to MudDataGrid, which draws none.
  -->
  <Style Selector="DataGrid.striped DataGridRow /template/ Border#PART_Stripe">
    <Setter Property="Background" Value="{DynamicResource FiliTableStripedBrush}" />
  </Style>
  <Style Selector="DataGrid.hover DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource FiliTableHoverBrush}" />
  </Style>
  <Style Selector="DataGrid.hover DataGridRow:pointerover /template/ Border#PART_Stripe">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Border#PART_Stripe">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- `.mud-table-dense`: 6px 24px 6px 16px on every cell, the headers' too, but 16px on the right
       of the last, and a 39px header row ($header-height-dense); the group row's expander drops
       to 4px round its icon. -->
  <Style Selector="DataGrid.dense DataGridCell">
    <Setter Property="Padding" Value="16,6,24,6" />
  </Style>
  <Style Selector="DataGrid.dense DataGridColumnHeader">
    <Setter Property="Padding" Value="16,0,24,0" />
    <Setter Property="MinHeight" Value="39" />
  </Style>
  <!-- `.mud-table-cell:last-child`: 16px on the right, the header's too. -->
  <Style Selector="DataGrid.dense DataGridCell[(optional|DataGridLastColumn.IsLast)=True]">
    <Setter Property="Padding" Value="16,6,16,6" />
  </Style>
  <Style Selector="DataGrid.dense DataGridColumnHeader[(optional|DataGridLastColumn.IsLast)=True]">
    <Setter Property="Padding" Value="16,0,16,0" />
  </Style>
  <Style Selector="DataGrid.dense DataGridRowGroupHeader">
    <Setter Property="Padding" Value="16,6,0,6" />
  </Style>
  <Style Selector="DataGrid.dense DataGridRowGroupHeader /template/ ToggleButton#PART_ExpanderButton">
    <Setter Property="Padding" Value="4" />
  </Style>

  <!-- `.mud-table-cell .mud-checkbox`: margin -4px, and its icon button padded 4px rather than 12,
       so a checkbox in a cell is the dense one's 32 / 28 / 44px circle and takes 8px less of the
       row than that. Every size is named: the 48px is set inline in the template, which only a
       selector with an activator overrides. -->
  <Style Selector="DataGridCell CheckBox">
    <Setter Property="Margin" Value="-4" />
  </Style>
  <Style Selector="DataGridCell CheckBox:not(.small):not(.large) /template/ Panel#PART_Box">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
  </Style>
  <Style Selector="DataGridCell CheckBox.small /template/ Panel#PART_Box">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="DataGridCell CheckBox.large /template/ Panel#PART_Box">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
  </Style>

  <!-- A checkbox column's boxes keep their colour. DataGridCheckBoxColumn disables the box in
       every row but the current one, which it enables to toggle on a click, and a read-only grid
       disables them all; in text-disabled they looked disabled in all those rows. MudDataGrid's
       read-only checkbox is action-default, as an enabled one is. -->
  <Style Selector="DataGridCell CheckBox:disabled /template/ Path#PART_Unchecked, DataGridCell CheckBox:disabled /template/ Path#PART_Checked, DataGridCell CheckBox:disabled /template/ Path#PART_Indeterminate">
    <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultBrush}" />
  </Style>

  <!-- material-elevation-overlay on a grid; see FiliTheme.axaml. -->
  <!-- GENERATED by ThemeColourGenerator: material elevation overlay. -->
  <Style Selector=".material-elevation-overlay DataGrid:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay1}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation0:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay0}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation1:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay1}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation2:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay2}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation3:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay3}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation4:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay4}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation5:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay5}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation6:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay6}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation7:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay7}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation8:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay8}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation9:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay9}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation10:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay10}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation11:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay11}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation12:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay12}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation13:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay13}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation14:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay14}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation15:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay15}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation16:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay16}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation17:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay17}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation18:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay18}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation19:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay19}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation20:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay20}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation21:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay21}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation22:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay22}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation23:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay23}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation24:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay24}" />
  </Style>
  <Style Selector=".material-elevation-overlay DataGrid.elevation25:not(.outlined) /template/ Border#DataGridBorder">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay25}" />
  </Style>
  <!-- END GENERATED -->
</Styles>
