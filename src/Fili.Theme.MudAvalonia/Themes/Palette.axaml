      <SolidColorBrush x:Key="FiliFocusRingBrush"      Color="{DynamicResource FiliTextPrimaryColor}" />
      <SolidColorBrush x:Key="FiliFocusRingInnerBrush" Color="{DynamicResource FiliWhiteColor}" />
      <!-- END GENERATED -->
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>


  <!--
    The ripple's opacity: Palette.cs RippleOpacity 0.1 and RippleOpacitySecondary 0.2, the second
    on filled buttons, filled chips and coloured FABs. NON-VARYING: MudThemeProvider.razor.cs
    writes both from PaletteLight whatever the mode. Its colour is the control's text, so it has
    no token. Zero, in an app's or a control's resources, turns the ripple off there.
  -->
  <sys:Double x:Key="FiliRippleOpacity">0.1</sys:Double>
  <sys:Double x:Key="FiliRippleOpacitySecondary">0.2</sys:Double>

  <!--
    Reduced motion: True, in an app's resources, stops the ripple and the theme's fades, slides,
    pulses and transitions; an indeterminate progress indicator keeps moving (Motion.cs). Not
    MudBlazor's: it has no such switch. NON-VARYING.
  -->
  <sys:Boolean x:Key="FiliReducedMotion">False</sys:Boolean>

  <!--
    The focus ring's thickness; its two brushes, FiliFocusRingBrush and FiliFocusRingInnerBrush,
    are with the other brushes in the variant dictionaries. Drawn when FiliFocusRing is True
    (FocusRing.cs). Not MudBlazor's: it has no ring. The two brushes follow the variant through
    the colours they are built from, text-primary outside and white against the control, so at least one keeps 3:1 on
    a light page, a dark one and a coloured app bar. The thickness is the outer stroke's; the
    inner one stays 2px and the ring moves out to make room. An app replaces the thickness in its
    application's or a window's resources, as the ring is drawn in each window's adorner layer;
    the brushes are looked up from the control the ring frames (FocusRing.cs), so a container's
    resources and a ThemeVariantScope's variant reach them too.
  -->
  <sys:Double x:Key="FiliFocusRingThickness">2</sys:Double>

</ResourceDictionary>
