<!--
  Palette tokens.

  Values are the MudBlazor default light and dark palettes, read from its source
  (src/MudBlazor/Themes/Models/Palette.cs and PaletteDark.cs) with the Colors.* references
  resolved to hex. MudBlazor is MIT licensed; these are colour values, not code.

  CSS rgba() alpha is folded into the Avalonia #AARRGGBB form:
    0.02 -> 05   0.04 -> 0A   0.11 -> 1C   0.12 -> 1F   0.20 -> 33   0.26 -> 42
    0.30 -> 4D   0.38 -> 61   0.50 -> 80   0.54 -> 8A   0.70 -> B3
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <ResourceDictionary.ThemeDictionaries>

    <!-- ============================== LIGHT ============================== -->
    <ResourceDictionary x:Key="Light">

      <!--
        The ContrastText values are the text on a fill of the colour: a filled button, chip, FAB,
        alert, snackbar, badge, avatar, tooltip or tab bar, and its darken shade under the pointer.
        Palette.cs makes every one Colors.Shades.White, and PaletteDark.cs overrides none. NOT
        MUDBLAZOR'S, since 1.2.0, where white falls short of WCAG AA's 4.5:1 on the fill or its
        darken shade: secondary, tertiary, info, success, warning and error take black at 87%
        (DE), Material's text on a light fill, which reaches 4.60:1 or more on both. Each line
        names white's worst ratio, on the fill or the darken shade, and black's
        (FillContrastTests). Primary and dark keep white, 6.00:1 and 10.05:1.
      -->
      <Color x:Key="FiliPrimaryColor">#594AE2</Color>
      <Color x:Key="FiliPrimaryContrastTextColor">#FFFFFF</Color>
      <Color x:Key="FiliSecondaryColor">#FF4081</Color>
      <!-- White 3.33:1; 5.19:1. -->
      <Color x:Key="FiliSecondaryContrastTextColor">#DE000000</Color>
      <Color x:Key="FiliTertiaryColor">#1EC8A5</Color>
      <!-- White 2.13:1; 6.29:1. -->
      <Color x:Key="FiliTertiaryContrastTextColor">#DE000000</Color>

      <Color x:Key="FiliInfoColor">#2196F3</Color>
      <!-- White 3.12:1; 4.70:1. -->
      <Color x:Key="FiliInfoContrastTextColor">#DE000000</Color>
      <Color x:Key="FiliSuccessColor">#00C853</Color>
      <!-- White 2.24:1; 5.69:1. -->
      <Color x:Key="FiliSuccessContrastTextColor">#DE000000</Color>
      <Color x:Key="FiliWarningColor">#FF9800</Color>
      <!-- White 2.16:1; 6.20:1. -->
      <Color x:Key="FiliWarningContrastTextColor">#DE000000</Color>
      <Color x:Key="FiliErrorColor">#F44336</Color>
      <!-- White 3.68:1; 4.60:1. -->
      <Color x:Key="FiliErrorContrastTextColor">#DE000000</Color>
      <Color x:Key="FiliDarkColor">#424242</Color>
      <Color x:Key="FiliDarkContrastTextColor">#FFFFFF</Color>
      <Color x:Key="FiliBlackColor">#272C34</Color>
      <Color x:Key="FiliWhiteColor">#FFFFFF</Color>

      <Color x:Key="FiliTextPrimaryColor">#424242</Color>
      <Color x:Key="FiliTextSecondaryColor">#8A000000</Color>
      <Color x:Key="FiliTextDisabledColor">#61000000</Color>

      <Color x:Key="FiliActionDefaultColor">#8A000000</Color>
      <Color x:Key="FiliActionDisabledColor">#42000000</Color>
      <Color x:Key="FiliActionDisabledBackgroundColor">#1F000000</Color>

      <Color x:Key="FiliBackgroundColor">#FFFFFF</Color>
      <Color x:Key="FiliBackgroundGrayColor">#F5F5F5</Color>
      <Color x:Key="FiliSurfaceColor">#FFFFFF</Color>

      <Color x:Key="FiliAppbarBackgroundColor">#594AE2</Color>
      <Color x:Key="FiliAppbarTextColor">#FFFFFF</Color>
      <Color x:Key="FiliDrawerBackgroundColor">#FFFFFF</Color>
      <Color x:Key="FiliDrawerTextColor">#424242</Color>
      <Color x:Key="FiliDrawerIconColor">#616161</Color>
      <!-- The drawer's edge. Transparent here and in dark, where the pane is separated by its
           own background colour; High Contrast is where it has to exist, because there both
           grounds are black. Avalonia's Simple SplitView already carries the rectangle for it
           (HCPaneBorder), so lighting it up costs a Style and no template. -->
      <Color x:Key="FiliDrawerBorderColor">#00000000</Color>

      <Color x:Key="FiliLinesDefaultColor">#1F000000</Color>
      <!-- An unfocused field's underline or outline. NOT MUDBLAZOR'S, since 1.1.0: its #BDBDBD
           (Colors.Gray.Lighten1) is 1.88:1 on white, and WCAG 1.4.11 asks 3:1 of the edge that
           shows where a field is. The first grey at 3:1, with a level to spare, on the page and
           on a filled field's own 9% fill: 3.74:1 on white, 3.05:1 on the fill
           (InputLineContrastTests). A default avatar's ground keeps #BDBDBD, as
           FiliAvatarBackgroundColor. -->
      <Color x:Key="FiliLinesInputsColor">#848484</Color>
      <Color x:Key="FiliDividerColor">#E0E0E0</Color>
      <!-- Palette.cs DividerLight: black at 0.8 (CC), and PaletteDark.cs white at 0.06 (0F).
           `.mud-divider-light` paints it - in light, the STRONGER line, despite the name. -->
      <Color x:Key="FiliDividerLightColor">#CC000000</Color>
      <!-- Palette.GrayDefault ... GrayDarker: Colors.Gray.Default, Lighten1, Lighten2, Darken1 and
           Darken2. PaletteDark.cs does not override them, so dark repeats them. -->
      <Color x:Key="FiliGrayDefaultColor">#9E9E9E</Color>
      <Color x:Key="FiliGrayLightColor">#BDBDBD</Color>
      <Color x:Key="FiliGrayLighterColor">#E0E0E0</Color>
      <Color x:Key="FiliGrayDarkColor">#757575</Color>
      <Color x:Key="FiliGrayDarkerColor">#616161</Color>
      <Color x:Key="FiliTableLinesColor">#E0E0E0</Color>
      <Color x:Key="FiliTableStripedColor">#05000000</Color>
      <Color x:Key="FiliTableHoverColor">#0A000000</Color>
      <Color x:Key="FiliSkeletonColor">#1C000000</Color>
      <!-- Animation.Wave's band: rgba(0,0,0,0.04) composited over the skeleton colour, which is
           black at 0.11 + 0.04 x 0.89 = 0.145 (25). -->
      <Color x:Key="FiliSkeletonWaveColor">#25000000</Color>

      <!-- The text MudBlazor puts on its two light-grey grounds: text-primary on a default avatar
           (lines-inputs) and a default badge (gray-light). Tokens of their own only so High
           Contrast can differ: here they ARE text-primary. FiliAvatarBareTextColor was white on
           9.11's unstyled Variant.Text avatar; 9.12 styles that one, with no ground and
           text-primary, so the theme no longer paints with it. Published, so it stays until 2.0. -->
      <Color x:Key="FiliAvatarTextColor">#424242</Color>
      <Color x:Key="FiliAvatarBareTextColor">#FFFFFF</Color>
      <Color x:Key="FiliBadgeTextColor">#424242</Color>
      <!-- A default avatar's ground: MudBlazor's lines-inputs, #BDBDBD, which _avatar.scss paints.
           A token of its own since 1.1.0, when lines-inputs darkened to 3:1 for a field's edge:
           text-primary on the darker grey would fall to 2.7:1, and on this it is 5.35:1. -->
      <Color x:Key="FiliAvatarBackgroundColor">#BDBDBD</Color>

      <!--
        Primary at 6%. MudBlazor Palette.cs derives it as PrimaryColor with HoverOpacity, and it
        is what a selected list row paints under itself (`mud-primary-hover`, alongside
        `mud-primary-text` on the label) - so selection is a tint plus a colour change, never a
        filled bar.
      -->
      <Color x:Key="FiliPrimaryHoverColor">#0F594AE2</Color>

      <!-- The other colours' `mud-palette-{color}-hover`: the colour at HoverOpacity, 0.06 ->
           0F (MudThemeProvider.razor.cs, `SetAlpha(palette.HoverOpacity)`). What a text or
           outlined button of that colour paints under itself on hover, focus and press. -->
      <Color x:Key="FiliSecondaryHoverColor">#0FFF4081</Color>
      <Color x:Key="FiliTertiaryHoverColor">#0F1EC8A5</Color>
      <Color x:Key="FiliInfoHoverColor">#0F2196F3</Color>
      <Color x:Key="FiliSuccessHoverColor">#0F00C853</Color>
      <Color x:Key="FiliWarningHoverColor">#0FFF9800</Color>
      <Color x:Key="FiliErrorHoverColor">#0FF44336</Color>
      <Color x:Key="FiliDarkHoverColor">#0F424242</Color>
      <!-- `mud-palette-action-default-hover`: ActionDefault at HoverOpacity. Black here, so
           #0F000000 - the hover of a button with no colour. -->
      <Color x:Key="FiliActionDefaultHoverColor">#0F000000</Color>

      <!--
        `mud-palette-{color}-darken`: a filled button's fill on hover, focus and press.
        Palette.cs derives it as `Color.ColorRgbDarken()`, which is HSL lightness minus 0.075
        (MudColor.cs), with hue rounded to a degree and saturation and lightness to two places
        the way .NET's Math.Round does it: scaled by 100 in double arithmetic, then rounded
        half-to-even, so 0.465 goes to 0.46. PaletteDerivationTests recomputes every one of these
        with MudColorPort, a C# port of that code, and fails if a value here disagrees.

        `mud-palette-{color}-lighten` is the same with lightness PLUS 0.075 (ColorRgbLighten). A
        filled button group divides its segments with it. Darken and lighten of the seven
        non-Dark colours, 14 values, all match mudblazor.com exactly.
      -->
      <Color x:Key="FiliPrimaryDarkenColor">#3E2CDD</Color>
      <Color x:Key="FiliSecondaryDarkenColor">#FF1F69</Color>
      <Color x:Key="FiliTertiaryDarkenColor">#19A98C</Color>
      <Color x:Key="FiliInfoDarkenColor">#0C80DF</Color>
      <Color x:Key="FiliSuccessDarkenColor">#00A344</Color>
      <Color x:Key="FiliWarningDarkenColor">#D68100</Color>
      <Color x:Key="FiliErrorDarkenColor">#F21C0D</Color>
      <Color x:Key="FiliDarkDarkenColor">#2E2E2E</Color>
      <Color x:Key="FiliPrimaryLightenColor">#766AE7</Color>
      <Color x:Key="FiliSecondaryLightenColor">#FF6699</Color>
      <Color x:Key="FiliTertiaryLightenColor">#2ADFBB</Color>
      <Color x:Key="FiliInfoLightenColor">#47A7F5</Color>
      <Color x:Key="FiliSuccessLightenColor">#00EB62</Color>
      <Color x:Key="FiliWarningLightenColor">#FFA724</Color>
      <Color x:Key="FiliErrorLightenColor">#F66055</Color>
      <Color x:Key="FiliDarkLightenColor">#575757</Color>

      <!--
        A text or outlined alert's text, on the colour's hover tint (text) or on the ground itself
        (outlined). _alert.scss paints `mud-alert-text-{severity}` with
        `mud-palette-{severity}-darken`, and that is kept where it reaches WCAG AA, 4.5:1, on the
        worst of those grounds (the tint over the page or a surface): primary and dark here.
        NOT MUDBLAZOR'S, since 1.0.1: every other darken shade fell short, so each is that shade
        darkened - HSL lightness lowered, hue and saturation kept - to the first value at 4.5:1
        even with the painted ground one level off the arithmetic, as Skia's can be.
        Each line names MudBlazor's value and the worst ratio before and after
        (AlertTextContrastTests).
      -->
      <Color x:Key="FiliPrimaryAlertTextColor">#3E2CDD</Color>
      <!-- MudBlazor #FF1F69, 3.46:1; 4.55:1. -->
      <Color x:Key="FiliSecondaryAlertTextColor">#E1004A</Color>
      <!-- MudBlazor #19A98C, 2.83:1; 4.58:1. -->
      <Color x:Key="FiliTertiaryAlertTextColor">#13816B</Color>
      <!-- MudBlazor #0C80DF, 3.82:1; 4.58:1. -->
      <Color x:Key="FiliInfoAlertTextColor">#0B73C9</Color>
      <!-- MudBlazor #00A344, 3.16:1; 4.58:1. -->
      <Color x:Key="FiliSuccessAlertTextColor">#008437</Color>
      <!-- MudBlazor #D68100, 2.87:1; 4.58:1. -->
      <Color x:Key="FiliWarningAlertTextColor">#A56300</Color>
      <!-- MudBlazor #F21C0D, 3.93:1; 4.57:1. -->
      <Color x:Key="FiliErrorAlertTextColor">#DE1A0C</Color>
      <Color x:Key="FiliDarkAlertTextColor">#2E2E2E</Color>

      <!--
        The colour AS TEXT on the page or a surface: `mud-{color}-text`, which MudBlazor paints in
        the colour itself - a link, a text or outlined button's label, a text or outlined chip, a
        selected tab, list row or nav link, a focused field's label, an error message, MudText's
        Color. The colour stays the fill; this is only its text. The colour itself where it
        reaches WCAG AA, 4.5:1, on the worst of those grounds (the page, a surface, the colour's 6%
        hover tint over either, under a text button or a selected row, and the colour at 12% over
        either, under a text chip or a selected nav link on hover): primary and dark here. NOT
        MUDBLAZOR'S, since 1.1.0: every other colour fell short, as low as 2.04:1, so each is the
        same hue darkened to 4.5:1 on those grounds, a step darker than its alert text since 1.2.0,
        when the 12% hover joined them. Each line names the colour and the worst ratio before and
        after (TextContrastTests).
      -->
      <Color x:Key="FiliPrimaryTextColor">#594AE2</Color>
      <!-- #FF4081, 2.86:1; 4.57:1. -->
      <Color x:Key="FiliSecondaryTextColor">#D60046</Color>
      <!-- #1EC8A5, 1.93:1; 4.58:1. -->
      <Color x:Key="FiliTertiaryTextColor">#127D67</Color>
      <!-- #2196F3, 2.74:1; 4.59:1. -->
      <Color x:Key="FiliInfoTextColor">#0B6EC1</Color>
      <!-- #00C853, 2.00:1; 4.60:1. -->
      <Color x:Key="FiliSuccessTextColor">#007F35</Color>
      <!-- #FF9800, 1.95:1; 4.57:1. -->
      <Color x:Key="FiliWarningTextColor">#A06000</Color>
      <!-- #F44336, 3.14:1; 4.54:1. -->
      <Color x:Key="FiliErrorTextColor">#D4190B</Color>
      <Color x:Key="FiliDarkTextColor">#424242</Color>

      <!--
        The colour as a LINE OR GLYPH, the WCAG 1.4.11 non-text uses that show a control's state
        or value: a checked checkbox or radio, an on switch's thumb, a slider's thumb and track, a
        progress bar, a focused or invalid field's underline or outline, a tab's indicator, an
        active nav link's line and icon, an alert's icon, a coloured icon. The colour itself where
        it reaches 3:1 on the worst of their grounds (the page, a surface, a filled field's fill
        over either, and the colour's 6% hover tint over either): primary, error and dark here.
        NOT MUDBLAZOR'S, since 1.2.0: every other colour fell short, as low as 1.74:1, so each is
        the same hue darkened to 3:1 with a level to spare. The colour stays the fill of a filled
        control and the border of an outlined one, which its text identifies. Each line names the
        colour and the worst ratio before and after (NonTextContrastTests).
      -->
      <Color x:Key="FiliPrimaryNonTextColor">#594AE2</Color>
      <!-- #FF4081, 2.72:1; 3.02:1. -->
      <Color x:Key="FiliSecondaryNonTextColor">#FF206C</Color>
      <!-- #1EC8A5, 1.74:1; 3.05:1. -->
      <Color x:Key="FiliTertiaryNonTextColor">#16957B</Color>
      <!-- #2196F3, 2.55:1; 3.03:1. -->
      <Color x:Key="FiliInfoNonTextColor">#0D87E9</Color>
      <!-- #00C853, 1.83:1; 3.05:1. -->
      <Color x:Key="FiliSuccessNonTextColor">#00993F</Color>
      <!-- #FF9800, 1.76:1; 3.05:1. -->
      <Color x:Key="FiliWarningNonTextColor">#BF7200</Color>
      <Color x:Key="FiliErrorNonTextColor">#F44336</Color>
      <Color x:Key="FiliDarkNonTextColor">#424242</Color>

      <!-- A default chip's ground on hover, focus and press: action-disabled, as _chip.scss
           paints it. A token of its own so that high contrast can keep white text readable. -->
      <Color x:Key="FiliChipHoverColor">#42000000</Color>

      <!-- The slider's rail: the colour at 30%, _slider.scss's `opacity: .3`. -->
      <sys:Double x:Key="FiliSliderRailOpacity">0.30</sys:Double>

      <!-- The focus ring: on. MudBlazor draws none and leaves keyboard focus to the state layer's
           tint, about 1.1:1 on the background, which a keyboard user loses; the ring is 10:1. It
           draws only for keyboard focus (the AdornerLayer adorns a control focused by Tab or the
           arrows, never one clicked or touched). False in an app's resources keeps MudBlazor's
           tint alone. Not MudBlazor's. -->
      <sys:Boolean x:Key="FiliFocusRing">True</sys:Boolean>

      <!-- State-layer overlays. Material behaviour, not a MudBlazor palette token. -->
      <Color x:Key="FiliOverlayHoverColor">#0A000000</Color>
      <Color x:Key="FiliOverlayPressedColor">#1F000000</Color>

      <!--
        Filled-input fill. TRANSLUCENT ON PURPOSE, and this is the whole point of it: an opaque
        token cannot work, because the field has to stay visible on every ground it might sit on.
        Using FiliBackgroundGray here made filled fields vanish in dark mode, where that token IS
        the page ground. MudBlazor _input.scss paints rgba(0,0,0,.09) light and the white equivalent dark - 9% in
        both, not Material spec 6%.
      -->
      <Color x:Key="FiliInputFilledColor">#17000000</Color>

      <!--
        Non-varying between LIGHT and DARK, and that is still MudBlazor's behaviour - but they
        live in the variant dictionaries rather than below them, because HIGH CONTRAST has to
        override them and a token declared outside the theme dictionaries CANNOT be overridden
        by one: a dictionary's own entries are found before its ThemeDictionaries, so the outer
        value wins in every variant. Scrim: Palette.cs OverlayDark is #212121 at 50%, not black.
        Tooltip: _tooltip.scss paints `mud-palette-gray-darker` = Colors.Gray.Darken2, solid.
      -->
      <Color x:Key="FiliOverlayDarkColor">#80212121</Color>
      <Color x:Key="FiliOverlayLightColor">#80FFFFFF</Color>
      <Color x:Key="FiliTooltipBackgroundColor">#616161</Color>
      <!-- `.mud-switch-base { color: #fafafa }` - a literal in _switch.scss, not a palette
           property, so it is the same in light and dark. It is the thumb of every switch
           with no colour, on and off; a coloured switch replaces it only when on. -->
      <Color x:Key="FiliSwitchThumbColor">#FAFAFA</Color>
      <!-- The scroll bar MudThemeProvider injects unless DefaultScrollbar is set
           (MudThemeProvider.razor.cs BuildMudBlazorScrollbar): `::-webkit-scrollbar-thumb`
           #c4c4c4, #a6a6a6 under the pointer. Literals, not palette properties, so the same in
           light and dark. -->
      <Color x:Key="FiliScrollbarThumbColor">#C4C4C4</Color>
      <Color x:Key="FiliScrollbarThumbHoverColor">#A6A6A6</Color>


      <!--
        Brushes, one set per variant, each built with DynamicResource from the colours above.
        A brush in a variant's dictionary resolves its colour for THAT variant, so a window or a
        ThemeVariantScope asking for a variant other than the application's paints with that
        variant's brushes (VariantScopeTests), and a colour an app sets in its application's
        resources still reaches every brush. DynamicResource is mandatory: StaticResource would
        freeze the colour (ResourceResolutionTests). Written once, here: ThemeColourGenerator
        copies the block into Dark and High contrast. High contrast needs its own copy, as a key
        it lacks falls back to Dark's brush, which resolves Dark's colours.
      -->
      <!-- BRUSHES: copied into the other variants by ThemeColourGenerator -->
      <SolidColorBrush x:Key="FiliPrimaryBrush"               Color="{DynamicResource FiliPrimaryColor}" />
      <SolidColorBrush x:Key="FiliPrimaryContrastTextBrush"   Color="{DynamicResource FiliPrimaryContrastTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryBrush"             Color="{DynamicResource FiliSecondaryColor}" />
      <SolidColorBrush x:Key="FiliSecondaryContrastTextBrush" Color="{DynamicResource FiliSecondaryContrastTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryBrush"              Color="{DynamicResource FiliTertiaryColor}" />
      <SolidColorBrush x:Key="FiliTertiaryContrastTextBrush"  Color="{DynamicResource FiliTertiaryContrastTextColor}" />

      <SolidColorBrush x:Key="FiliInfoBrush"                Color="{DynamicResource FiliInfoColor}" />
      <SolidColorBrush x:Key="FiliInfoContrastTextBrush"    Color="{DynamicResource FiliInfoContrastTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessBrush"             Color="{DynamicResource FiliSuccessColor}" />
      <SolidColorBrush x:Key="FiliSuccessContrastTextBrush" Color="{DynamicResource FiliSuccessContrastTextColor}" />
      <SolidColorBrush x:Key="FiliWarningBrush"             Color="{DynamicResource FiliWarningColor}" />
      <SolidColorBrush x:Key="FiliWarningContrastTextBrush" Color="{DynamicResource FiliWarningContrastTextColor}" />
      <SolidColorBrush x:Key="FiliErrorBrush"               Color="{DynamicResource FiliErrorColor}" />
      <SolidColorBrush x:Key="FiliErrorContrastTextBrush"   Color="{DynamicResource FiliErrorContrastTextColor}" />
      <SolidColorBrush x:Key="FiliDarkBrush"    Color="{DynamicResource FiliDarkColor}" />
      <SolidColorBrush x:Key="FiliDarkContrastTextBrush" Color="{DynamicResource FiliDarkContrastTextColor}" />

      <SolidColorBrush x:Key="FiliSecondaryHoverBrush" Color="{DynamicResource FiliSecondaryHoverColor}" />
      <SolidColorBrush x:Key="FiliTertiaryHoverBrush" Color="{DynamicResource FiliTertiaryHoverColor}" />
      <SolidColorBrush x:Key="FiliInfoHoverBrush" Color="{DynamicResource FiliInfoHoverColor}" />
      <SolidColorBrush x:Key="FiliSuccessHoverBrush" Color="{DynamicResource FiliSuccessHoverColor}" />
      <SolidColorBrush x:Key="FiliWarningHoverBrush" Color="{DynamicResource FiliWarningHoverColor}" />
      <SolidColorBrush x:Key="FiliErrorHoverBrush" Color="{DynamicResource FiliErrorHoverColor}" />
      <SolidColorBrush x:Key="FiliDarkHoverBrush" Color="{DynamicResource FiliDarkHoverColor}" />
      <SolidColorBrush x:Key="FiliActionDefaultHoverBrush" Color="{DynamicResource FiliActionDefaultHoverColor}" />

      <SolidColorBrush x:Key="FiliPrimaryDarkenBrush" Color="{DynamicResource FiliPrimaryDarkenColor}" />
      <SolidColorBrush x:Key="FiliSecondaryDarkenBrush" Color="{DynamicResource FiliSecondaryDarkenColor}" />
      <SolidColorBrush x:Key="FiliTertiaryDarkenBrush" Color="{DynamicResource FiliTertiaryDarkenColor}" />
      <SolidColorBrush x:Key="FiliInfoDarkenBrush" Color="{DynamicResource FiliInfoDarkenColor}" />
      <SolidColorBrush x:Key="FiliSuccessDarkenBrush" Color="{DynamicResource FiliSuccessDarkenColor}" />
      <SolidColorBrush x:Key="FiliWarningDarkenBrush" Color="{DynamicResource FiliWarningDarkenColor}" />
      <SolidColorBrush x:Key="FiliErrorDarkenBrush" Color="{DynamicResource FiliErrorDarkenColor}" />
      <SolidColorBrush x:Key="FiliDarkDarkenBrush" Color="{DynamicResource FiliDarkDarkenColor}" />
      <SolidColorBrush x:Key="FiliPrimaryLightenBrush" Color="{DynamicResource FiliPrimaryLightenColor}" />
      <SolidColorBrush x:Key="FiliSecondaryLightenBrush" Color="{DynamicResource FiliSecondaryLightenColor}" />
      <SolidColorBrush x:Key="FiliTertiaryLightenBrush" Color="{DynamicResource FiliTertiaryLightenColor}" />
      <SolidColorBrush x:Key="FiliInfoLightenBrush" Color="{DynamicResource FiliInfoLightenColor}" />
      <SolidColorBrush x:Key="FiliSuccessLightenBrush" Color="{DynamicResource FiliSuccessLightenColor}" />
      <SolidColorBrush x:Key="FiliWarningLightenBrush" Color="{DynamicResource FiliWarningLightenColor}" />
      <SolidColorBrush x:Key="FiliErrorLightenBrush" Color="{DynamicResource FiliErrorLightenColor}" />
      <SolidColorBrush x:Key="FiliDarkLightenBrush" Color="{DynamicResource FiliDarkLightenColor}" />
      <SolidColorBrush x:Key="FiliPrimaryAlertTextBrush" Color="{DynamicResource FiliPrimaryAlertTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryAlertTextBrush" Color="{DynamicResource FiliSecondaryAlertTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryAlertTextBrush" Color="{DynamicResource FiliTertiaryAlertTextColor}" />
      <SolidColorBrush x:Key="FiliInfoAlertTextBrush" Color="{DynamicResource FiliInfoAlertTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessAlertTextBrush" Color="{DynamicResource FiliSuccessAlertTextColor}" />
      <SolidColorBrush x:Key="FiliWarningAlertTextBrush" Color="{DynamicResource FiliWarningAlertTextColor}" />
      <SolidColorBrush x:Key="FiliErrorAlertTextBrush" Color="{DynamicResource FiliErrorAlertTextColor}" />
      <SolidColorBrush x:Key="FiliDarkAlertTextBrush" Color="{DynamicResource FiliDarkAlertTextColor}" />
      <SolidColorBrush x:Key="FiliPrimaryTextBrush" Color="{DynamicResource FiliPrimaryTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryTextBrush" Color="{DynamicResource FiliSecondaryTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryTextBrush" Color="{DynamicResource FiliTertiaryTextColor}" />
      <SolidColorBrush x:Key="FiliInfoTextBrush" Color="{DynamicResource FiliInfoTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessTextBrush" Color="{DynamicResource FiliSuccessTextColor}" />
      <SolidColorBrush x:Key="FiliWarningTextBrush" Color="{DynamicResource FiliWarningTextColor}" />
      <SolidColorBrush x:Key="FiliErrorTextBrush" Color="{DynamicResource FiliErrorTextColor}" />
      <SolidColorBrush x:Key="FiliDarkTextBrush" Color="{DynamicResource FiliDarkTextColor}" />
      <SolidColorBrush x:Key="FiliPrimaryNonTextBrush" Color="{DynamicResource FiliPrimaryNonTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryNonTextBrush" Color="{DynamicResource FiliSecondaryNonTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryNonTextBrush" Color="{DynamicResource FiliTertiaryNonTextColor}" />
      <SolidColorBrush x:Key="FiliInfoNonTextBrush" Color="{DynamicResource FiliInfoNonTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessNonTextBrush" Color="{DynamicResource FiliSuccessNonTextColor}" />
      <SolidColorBrush x:Key="FiliWarningNonTextBrush" Color="{DynamicResource FiliWarningNonTextColor}" />
      <SolidColorBrush x:Key="FiliErrorNonTextBrush" Color="{DynamicResource FiliErrorNonTextColor}" />
      <SolidColorBrush x:Key="FiliDarkNonTextBrush" Color="{DynamicResource FiliDarkNonTextColor}" />
      <SolidColorBrush x:Key="FiliChipHoverBrush" Color="{DynamicResource FiliChipHoverColor}" />
      <SolidColorBrush x:Key="FiliBlackBrush"   Color="{DynamicResource FiliBlackColor}" />
      <SolidColorBrush x:Key="FiliWhiteBrush"   Color="{DynamicResource FiliWhiteColor}" />

      <SolidColorBrush x:Key="FiliTextPrimaryBrush"   Color="{DynamicResource FiliTextPrimaryColor}" />
      <SolidColorBrush x:Key="FiliTextSecondaryBrush" Color="{DynamicResource FiliTextSecondaryColor}" />
      <SolidColorBrush x:Key="FiliTextDisabledBrush"  Color="{DynamicResource FiliTextDisabledColor}" />

      <SolidColorBrush x:Key="FiliActionDefaultBrush"            Color="{DynamicResource FiliActionDefaultColor}" />
      <SolidColorBrush x:Key="FiliActionDisabledBrush"           Color="{DynamicResource FiliActionDisabledColor}" />
      <SolidColorBrush x:Key="FiliActionDisabledBackgroundBrush" Color="{DynamicResource FiliActionDisabledBackgroundColor}" />

      <SolidColorBrush x:Key="FiliBackgroundBrush"     Color="{DynamicResource FiliBackgroundColor}" />
      <SolidColorBrush x:Key="FiliBackgroundGrayBrush" Color="{DynamicResource FiliBackgroundGrayColor}" />
      <SolidColorBrush x:Key="FiliSurfaceBrush"        Color="{DynamicResource FiliSurfaceColor}" />

      <SolidColorBrush x:Key="FiliAppbarBackgroundBrush" Color="{DynamicResource FiliAppbarBackgroundColor}" />
      <SolidColorBrush x:Key="FiliAppbarTextBrush"       Color="{DynamicResource FiliAppbarTextColor}" />
      <SolidColorBrush x:Key="FiliDrawerBackgroundBrush" Color="{DynamicResource FiliDrawerBackgroundColor}" />
      <SolidColorBrush x:Key="FiliDrawerTextBrush"       Color="{DynamicResource FiliDrawerTextColor}" />
      <SolidColorBrush x:Key="FiliDrawerIconBrush"       Color="{DynamicResource FiliDrawerIconColor}" />
      <SolidColorBrush x:Key="FiliDrawerBorderBrush"     Color="{DynamicResource FiliDrawerBorderColor}" />

      <SolidColorBrush x:Key="FiliLinesDefaultBrush" Color="{DynamicResource FiliLinesDefaultColor}" />
      <SolidColorBrush x:Key="FiliLinesInputsBrush"  Color="{DynamicResource FiliLinesInputsColor}" />
      <SolidColorBrush x:Key="FiliDividerBrush"      Color="{DynamicResource FiliDividerColor}" />
      <SolidColorBrush x:Key="FiliDividerLightBrush" Color="{DynamicResource FiliDividerLightColor}" />
      <SolidColorBrush x:Key="FiliGrayDefaultBrush" Color="{DynamicResource FiliGrayDefaultColor}" />
      <SolidColorBrush x:Key="FiliGrayLightBrush" Color="{DynamicResource FiliGrayLightColor}" />
      <SolidColorBrush x:Key="FiliGrayLighterBrush" Color="{DynamicResource FiliGrayLighterColor}" />
      <SolidColorBrush x:Key="FiliGrayDarkBrush" Color="{DynamicResource FiliGrayDarkColor}" />
      <SolidColorBrush x:Key="FiliGrayDarkerBrush" Color="{DynamicResource FiliGrayDarkerColor}" />
      <SolidColorBrush x:Key="FiliTableLinesBrush"   Color="{DynamicResource FiliTableLinesColor}" />
      <SolidColorBrush x:Key="FiliTableStripedBrush" Color="{DynamicResource FiliTableStripedColor}" />
      <SolidColorBrush x:Key="FiliTableHoverBrush"   Color="{DynamicResource FiliTableHoverColor}" />
      <SolidColorBrush x:Key="FiliSkeletonBrush"     Color="{DynamicResource FiliSkeletonColor}" />
      <SolidColorBrush x:Key="FiliAvatarTextBrush"     Color="{DynamicResource FiliAvatarTextColor}" />
      <SolidColorBrush x:Key="FiliAvatarBareTextBrush" Color="{DynamicResource FiliAvatarBareTextColor}" />
      <SolidColorBrush x:Key="FiliAvatarBackgroundBrush" Color="{DynamicResource FiliAvatarBackgroundColor}" />
      <SolidColorBrush x:Key="FiliBadgeTextBrush"      Color="{DynamicResource FiliBadgeTextColor}" />
      <!-- Animation.Wave's two key frames: the band one skeleton wide, entirely off the left edge and
           entirely off the right. FiliTheme.axaml animates Background between them. -->
      <LinearGradientBrush x:Key="FiliSkeletonWaveStartBrush" StartPoint="-100%,0%" EndPoint="0%,0%">
        <GradientStop Offset="0" Color="{DynamicResource FiliSkeletonColor}" />
        <GradientStop Offset="0.5" Color="{DynamicResource FiliSkeletonWaveColor}" />
        <GradientStop Offset="1" Color="{DynamicResource FiliSkeletonColor}" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="FiliSkeletonWaveEndBrush" StartPoint="100%,0%" EndPoint="200%,0%">
        <GradientStop Offset="0" Color="{DynamicResource FiliSkeletonColor}" />
        <GradientStop Offset="0.5" Color="{DynamicResource FiliSkeletonWaveColor}" />
        <GradientStop Offset="1" Color="{DynamicResource FiliSkeletonColor}" />
      </LinearGradientBrush>

      <SolidColorBrush x:Key="FiliPrimaryHoverBrush"   Color="{DynamicResource FiliPrimaryHoverColor}" />
      <!--
        Scrim colours for a modal surface. NON-VARYING, like elevation: Palette.cs specifies them as
        literal colours - OverlayDark is #212121 at 50%, not black - and PaletteDark does not override
        either one, so the same scrim is correct in both variants.
      -->
      <SolidColorBrush x:Key="FiliOverlayDarkBrush"  Color="{DynamicResource FiliOverlayDarkColor}" />
      <SolidColorBrush x:Key="FiliOverlayLightBrush" Color="{DynamicResource FiliOverlayLightColor}" />

      <SolidColorBrush x:Key="FiliOverlayHoverBrush"   Color="{DynamicResource FiliOverlayHoverColor}" />
      <SolidColorBrush x:Key="FiliOverlayPressedBrush" Color="{DynamicResource FiliOverlayPressedColor}" />

      <!--
        Tooltip fill. NON-VARYING on purpose, and transcribed rather than chosen: MudBlazor _tooltip.scss
        paints background-color from the CSS variable `mud-palette-gray-darker`, which is
        Palette.GrayDarker =
        Colors.Gray.Darken2 = #616161, SOLID. An earlier version used 90% alpha, which was Material
        spec rather than what MudBlazor renders.
      -->
      <SolidColorBrush x:Key="FiliTooltipBackgroundBrush" Color="{DynamicResource FiliTooltipBackgroundColor}" />
      <SolidColorBrush x:Key="FiliSwitchThumbBrush" Color="{DynamicResource FiliSwitchThumbColor}" />
      <SolidColorBrush x:Key="FiliScrollbarThumbBrush" Color="{DynamicResource FiliScrollbarThumbColor}" />
      <SolidColorBrush x:Key="FiliScrollbarThumbHoverBrush" Color="{DynamicResource FiliScrollbarThumbHoverColor}" />

      <SolidColorBrush x:Key="FiliInputFilledBrush"    Color="{DynamicResource FiliInputFilledColor}" />

      <SolidColorBrush x:Key="FiliFocusRingBrush"      Color="{DynamicResource FiliTextPrimaryColor}" />
      <SolidColorBrush x:Key="FiliFocusRingInnerBrush" Color="{DynamicResource FiliWhiteColor}" />
      <!-- END BRUSHES -->
    </ResourceDictionary>

    <!-- ============================== DARK =============================== -->
    <ResourceDictionary x:Key="Dark">

      <!-- NOT MUDBLAZOR'S, since 1.2.0: PaletteDark.cs's #776BE7 carries its white text at
           4.17:1, and black would fall to 3.29:1 on its darken shade under the pointer. The same
           hue darkened to the first value where white reaches 4.5:1 with a level to spare:
           4.60:1, 6.58:1 on its darken shade (FillContrastTests). Its darken, lighten and hover
           shades follow it by MudBlazor's rule. Every LINE or GLYPH in primary paints
           FiliPrimaryNonTextColor below, which is lighter, not this. -->
      <Color x:Key="FiliPrimaryColor">#6F62E6</Color>
      <Color x:Key="FiliPrimaryContrastTextColor">#FFFFFF</Color>
      <!-- Black at 87% where white falls short of 4.5:1, as in Light: each line names white's
           worst ratio, on the fill or its darken shade, and black's (FillContrastTests). -->
      <Color x:Key="FiliSecondaryColor">#FF4081</Color>
      <!-- White 3.33:1; 5.19:1. -->
      <Color x:Key="FiliSecondaryContrastTextColor">#DE000000</Color>
      <Color x:Key="FiliTertiaryColor">#1EC8A5</Color>
      <!-- White 2.13:1; 6.29:1. -->
      <Color x:Key="FiliTertiaryContrastTextColor">#DE000000</Color>

      <Color x:Key="FiliInfoColor">#3299FF</Color>
      <!-- White 2.94:1; 5.27:1. -->
      <Color x:Key="FiliInfoContrastTextColor">#DE000000</Color>
      <Color x:Key="FiliSuccessColor">#0BBA83</Color>
      <!-- White 2.51:1; 5.28:1. -->
      <Color x:Key="FiliSuccessContrastTextColor">#DE000000</Color>
      <Color x:Key="FiliWarningColor">#FFA800</Color>
      <!-- White 1.93:1; 6.82:1. -->
      <Color x:Key="FiliWarningContrastTextColor">#DE000000</Color>
      <Color x:Key="FiliErrorColor">#F64E62</Color>
      <!-- White 3.40:1; 4.89:1. -->
      <Color x:Key="FiliErrorContrastTextColor">#DE000000</Color>
      <Color x:Key="FiliDarkColor">#27272F</Color>
      <Color x:Key="FiliDarkContrastTextColor">#FFFFFF</Color>
      <Color x:Key="FiliBlackColor">#27272F</Color>
      <Color x:Key="FiliWhiteColor">#FFFFFF</Color>

      <Color x:Key="FiliTextPrimaryColor">#B3FFFFFF</Color>
      <!-- NOT MUDBLAZOR'S, since 1.1.0: PaletteDark.cs's white at 0.50 (80) is 4.26:1 on the
           surface. White at 0.53 (87), the first alpha at 4.5:1 with a level to spare: 4.57:1 on
           the surface, 4.75:1 on the page (TextContrastTests). -->
      <Color x:Key="FiliTextSecondaryColor">#87FFFFFF</Color>
      <Color x:Key="FiliTextDisabledColor">#33FFFFFF</Color>

      <Color x:Key="FiliActionDefaultColor">#ADADB1</Color>
      <Color x:Key="FiliActionDisabledColor">#42FFFFFF</Color>
      <Color x:Key="FiliActionDisabledBackgroundColor">#1FFFFFFF</Color>

      <Color x:Key="FiliBackgroundColor">#32333D</Color>
      <Color x:Key="FiliBackgroundGrayColor">#27272F</Color>
      <Color x:Key="FiliSurfaceColor">#373740</Color>

      <Color x:Key="FiliAppbarBackgroundColor">#27272F</Color>
      <Color x:Key="FiliAppbarTextColor">#B3FFFFFF</Color>
      <Color x:Key="FiliDrawerBackgroundColor">#27272F</Color>
      <Color x:Key="FiliDrawerTextColor">#80FFFFFF</Color>
      <Color x:Key="FiliDrawerIconColor">#80FFFFFF</Color>
      <Color x:Key="FiliDrawerBorderColor">#00000000</Color>

      <Color x:Key="FiliLinesDefaultColor">#1FFFFFFF</Color>
      <!-- NOT MUDBLAZOR'S, since 1.1.0: its white at 0.30 (4D) is 2.50:1 on the surface, short of
           1.4.11's 3:1 for a field's edge. White at 0.43 (6D), the first alpha at 3:1 with a level
           to spare on the page, a surface and a filled field's fill over either: 3.52:1 on the
           surface, 3.06:1 on the fill (InputLineContrastTests). -->
      <Color x:Key="FiliLinesInputsColor">#6DFFFFFF</Color>
      <Color x:Key="FiliDividerColor">#1FFFFFFF</Color>
      <Color x:Key="FiliDividerLightColor">#0FFFFFFF</Color>
      <Color x:Key="FiliGrayDefaultColor">#9E9E9E</Color>
      <Color x:Key="FiliGrayLightColor">#BDBDBD</Color>
      <Color x:Key="FiliGrayLighterColor">#E0E0E0</Color>
      <Color x:Key="FiliGrayDarkColor">#757575</Color>
      <Color x:Key="FiliGrayDarkerColor">#616161</Color>
      <Color x:Key="FiliTableLinesColor">#1FFFFFFF</Color>
      <Color x:Key="FiliTableStripedColor">#33FFFFFF</Color>
      <Color x:Key="FiliTableHoverColor">#14FFFFFF</Color>
      <Color x:Key="FiliSkeletonColor">#1CFFFFFF</Color>
      <!-- 4% black over white at 0.11: alpha 0.145 (25), and white's share of it 0.105 / 0.145 =
           0.725 of full (B9). -->
      <Color x:Key="FiliSkeletonWaveColor">#25B9B9B9</Color>

      <!-- text-primary and white, as in Light. -->
      <Color x:Key="FiliAvatarTextColor">#B3FFFFFF</Color>
      <Color x:Key="FiliAvatarBareTextColor">#FFFFFF</Color>
      <Color x:Key="FiliBadgeTextColor">#B3FFFFFF</Color>
      <!-- MudBlazor's dark lines-inputs, white at 0.30, as in Light. -->
      <Color x:Key="FiliAvatarBackgroundColor">#4DFFFFFF</Color>

      <Color x:Key="FiliPrimaryHoverColor">#0F6F62E6</Color>

      <!-- `mud-palette-{color}-hover`, the colour at 0F. -->
      <Color x:Key="FiliSecondaryHoverColor">#0FFF4081</Color>
      <Color x:Key="FiliTertiaryHoverColor">#0F1EC8A5</Color>
      <Color x:Key="FiliInfoHoverColor">#0F3299FF</Color>
      <Color x:Key="FiliSuccessHoverColor">#0F0BBA83</Color>
      <Color x:Key="FiliWarningHoverColor">#0FFFA800</Color>
      <Color x:Key="FiliErrorHoverColor">#0FF64E62</Color>
      <Color x:Key="FiliDarkHoverColor">#0F27272F</Color>
      <Color x:Key="FiliActionDefaultHoverColor">#0FADADB1</Color>

      <!-- ColorRgbDarken of the dark palette's own colours; PaletteDark.cs sets none itself. -->
      <Color x:Key="FiliPrimaryDarkenColor">#5141E1</Color>
      <Color x:Key="FiliSecondaryDarkenColor">#FF1F69</Color>
      <Color x:Key="FiliTertiaryDarkenColor">#19A98C</Color>
      <Color x:Key="FiliInfoDarkenColor">#0A85FF</Color>
      <Color x:Key="FiliSuccessDarkenColor">#099A6C</Color>
      <Color x:Key="FiliWarningDarkenColor">#D68F00</Color>
      <Color x:Key="FiliErrorDarkenColor">#F42F46</Color>
      <Color x:Key="FiliDarkDarkenColor">#17171C</Color>
      <Color x:Key="FiliPrimaryLightenColor">#8E83EC</Color>
      <Color x:Key="FiliSecondaryLightenColor">#FF6699</Color>
      <Color x:Key="FiliTertiaryLightenColor">#2ADFBB</Color>
      <Color x:Key="FiliInfoLightenColor">#5CADFF</Color>
      <Color x:Key="FiliSuccessLightenColor">#0DDE9C</Color>
      <Color x:Key="FiliWarningLightenColor">#FFB624</Color>
      <Color x:Key="FiliErrorLightenColor">#F87786</Color>
      <Color x:Key="FiliDarkLightenColor">#383843</Color>

      <!-- NOT MUDBLAZOR'S, since 1.0.1. MudBlazor paints the darken shade here as in light, and
           on a dark ground every one fell short of 4.5:1 (the worst ground is the tint over the
           surface, or the surface itself for `dark`). Each is that shade LIGHTENED - HSL
           lightness raised, hue and saturation kept - to the first value at 4.5:1 even with the
           painted ground one level off the arithmetic, as Skia's can be. Each line
           names MudBlazor's value and the worst ratio before and after (AlertTextContrastTests). -->
      <!-- MudBlazor #5A4BE2, 1.87:1; 4.59:1. Since 1.2.0 the darken shade is #5141E1, of the
           darker primary, and this is unchanged: the same hue, still 4.5:1 on the tint. -->
      <Color x:Key="FiliPrimaryAlertTextColor">#A59DEF</Color>
      <!-- MudBlazor #FF1F69, 2.99:1; 4.57:1. -->
      <Color x:Key="FiliSecondaryAlertTextColor">#FF7BA6</Color>
      <!-- MudBlazor #19A98C, 3.59:1; 4.59:1. -->
      <Color x:Key="FiliTertiaryAlertTextColor">#1CC09F</Color>
      <!-- MudBlazor #0A85FF, 3.01:1; 4.59:1. -->
      <Color x:Key="FiliInfoAlertTextColor">#5AADFF</Color>
      <!-- MudBlazor #099A6C, 3.01:1; 4.59:1. -->
      <Color x:Key="FiliSuccessAlertTextColor">#0BC086</Color>
      <!-- MudBlazor #D68F00, 3.91:1; 4.58:1. -->
      <Color x:Key="FiliWarningAlertTextColor">#E89B00</Color>
      <!-- MudBlazor #F42F46, 2.85:1; 4.57:1. -->
      <Color x:Key="FiliErrorAlertTextColor">#F8828F</Color>
      <!-- MudBlazor #17171C, 1.41:1; 4.58:1. -->
      <Color x:Key="FiliDarkAlertTextColor">#A0A0B1</Color>

      <!-- The colour as text, as in Light: the colour where it reaches 4.5:1 on the page, the
           surface and its 6% and 12% tints over either (warning), and NOT
           MUDBLAZOR'S, since 1.1.0, everywhere else: the colour's hue lightened to 4.5:1, a step
           lighter than its alert text since 1.2.0. Primary is the one a dark app sees most, as
           links, text buttons, focused labels and the active nav link; the colour stays the fill
           of a filled button, whose white text the lighter shade could not carry. Each line
           names the colour and the worst ratio before and after (TextContrastTests). -->
      <!-- #6F62E6, 2.29:1; 4.58:1. -->
      <Color x:Key="FiliPrimaryTextColor">#AAA2F0</Color>
      <!-- #FF4081, 3.13:1; 4.58:1. -->
      <Color x:Key="FiliSecondaryTextColor">#FF85AD</Color>
      <!-- #1EC8A5, 4.48:1; 4.57:1. -->
      <Color x:Key="FiliTertiaryTextColor">#1ECAA7</Color>
      <!-- #3299FF, 3.40:1; 4.60:1. -->
      <Color x:Key="FiliInfoTextColor">#69B5FF</Color>
      <!-- #0BBA83, 3.93:1; 4.62:1. -->
      <Color x:Key="FiliSuccessTextColor">#0CCA8D</Color>
      <Color x:Key="FiliWarningTextColor">#FFA800</Color>
      <!-- #F64E62, 3.07:1; 4.59:1. -->
      <Color x:Key="FiliErrorTextColor">#F98C98</Color>
      <!-- #27272F, 1.15:1; 4.58:1. -->
      <Color x:Key="FiliDarkTextColor">#A0A0B1</Color>

      <!-- The colour as a line or glyph, as in Light: the colour where it reaches 3:1 on the
           page, the surface, a filled field's fill and its tint over either (tertiary, info,
           success and warning), and NOT MUDBLAZOR'S, since 1.2.0, everywhere else: the colour's
           hue lightened to 3:1 with a level to spare. Primary is the darker fill above lightened;
           MudBlazor's #776BE7 was 2.14:1 on a filled field. Each line names the colour and the
           worst ratio before and after (NonTextContrastTests). -->
      <!-- #6F62E6, 1.94:1; 3.08:1. -->
      <Color x:Key="FiliPrimaryNonTextColor">#958CED</Color>
      <!-- #FF4081, 2.68:1; 3.06:1. -->
      <Color x:Key="FiliSecondaryNonTextColor">#FF5C94</Color>
      <Color x:Key="FiliTertiaryNonTextColor">#1EC8A5</Color>
      <Color x:Key="FiliInfoNonTextColor">#3299FF</Color>
      <Color x:Key="FiliSuccessNonTextColor">#0BBA83</Color>
      <Color x:Key="FiliWarningNonTextColor">#FFA800</Color>
      <!-- #F64E62, 2.63:1; 3.08:1. -->
      <Color x:Key="FiliErrorNonTextColor">#F7697A</Color>
      <!-- #27272F, 1.17:1; 3.07:1. -->
      <Color x:Key="FiliDarkNonTextColor">#9696A8</Color>

      <Color x:Key="FiliChipHoverColor">#42FFFFFF</Color>
      <sys:Double x:Key="FiliSliderRailOpacity">0.30</sys:Double>
      <sys:Boolean x:Key="FiliFocusRing">True</sys:Boolean>

      <Color x:Key="FiliOverlayHoverColor">#14FFFFFF</Color>
      <Color x:Key="FiliOverlayPressedColor">#29FFFFFF</Color>

      <Color x:Key="FiliInputFilledColor">#17FFFFFF</Color>

      <!-- Same three as Light, same values: varying only in High Contrast. -->
      <Color x:Key="FiliOverlayDarkColor">#80212121</Color>
      <Color x:Key="FiliOverlayLightColor">#80FFFFFF</Color>
      <Color x:Key="FiliTooltipBackgroundColor">#616161</Color>
      <Color x:Key="FiliSwitchThumbColor">#FAFAFA</Color>
      <Color x:Key="FiliScrollbarThumbColor">#C4C4C4</Color>
      <Color x:Key="FiliScrollbarThumbHoverColor">#A6A6A6</Color>


      <!-- GENERATED by ThemeColourGenerator: dark palette brushes, copied from light's. -->
      <SolidColorBrush x:Key="FiliPrimaryBrush"               Color="{DynamicResource FiliPrimaryColor}" />
      <SolidColorBrush x:Key="FiliPrimaryContrastTextBrush"   Color="{DynamicResource FiliPrimaryContrastTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryBrush"             Color="{DynamicResource FiliSecondaryColor}" />
      <SolidColorBrush x:Key="FiliSecondaryContrastTextBrush" Color="{DynamicResource FiliSecondaryContrastTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryBrush"              Color="{DynamicResource FiliTertiaryColor}" />
      <SolidColorBrush x:Key="FiliTertiaryContrastTextBrush"  Color="{DynamicResource FiliTertiaryContrastTextColor}" />

      <SolidColorBrush x:Key="FiliInfoBrush"                Color="{DynamicResource FiliInfoColor}" />
      <SolidColorBrush x:Key="FiliInfoContrastTextBrush"    Color="{DynamicResource FiliInfoContrastTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessBrush"             Color="{DynamicResource FiliSuccessColor}" />
      <SolidColorBrush x:Key="FiliSuccessContrastTextBrush" Color="{DynamicResource FiliSuccessContrastTextColor}" />
      <SolidColorBrush x:Key="FiliWarningBrush"             Color="{DynamicResource FiliWarningColor}" />
      <SolidColorBrush x:Key="FiliWarningContrastTextBrush" Color="{DynamicResource FiliWarningContrastTextColor}" />
      <SolidColorBrush x:Key="FiliErrorBrush"               Color="{DynamicResource FiliErrorColor}" />
      <SolidColorBrush x:Key="FiliErrorContrastTextBrush"   Color="{DynamicResource FiliErrorContrastTextColor}" />
      <SolidColorBrush x:Key="FiliDarkBrush"    Color="{DynamicResource FiliDarkColor}" />
      <SolidColorBrush x:Key="FiliDarkContrastTextBrush" Color="{DynamicResource FiliDarkContrastTextColor}" />

      <SolidColorBrush x:Key="FiliSecondaryHoverBrush" Color="{DynamicResource FiliSecondaryHoverColor}" />
      <SolidColorBrush x:Key="FiliTertiaryHoverBrush" Color="{DynamicResource FiliTertiaryHoverColor}" />
      <SolidColorBrush x:Key="FiliInfoHoverBrush" Color="{DynamicResource FiliInfoHoverColor}" />
      <SolidColorBrush x:Key="FiliSuccessHoverBrush" Color="{DynamicResource FiliSuccessHoverColor}" />
      <SolidColorBrush x:Key="FiliWarningHoverBrush" Color="{DynamicResource FiliWarningHoverColor}" />
      <SolidColorBrush x:Key="FiliErrorHoverBrush" Color="{DynamicResource FiliErrorHoverColor}" />
      <SolidColorBrush x:Key="FiliDarkHoverBrush" Color="{DynamicResource FiliDarkHoverColor}" />
      <SolidColorBrush x:Key="FiliActionDefaultHoverBrush" Color="{DynamicResource FiliActionDefaultHoverColor}" />

      <SolidColorBrush x:Key="FiliPrimaryDarkenBrush" Color="{DynamicResource FiliPrimaryDarkenColor}" />
      <SolidColorBrush x:Key="FiliSecondaryDarkenBrush" Color="{DynamicResource FiliSecondaryDarkenColor}" />
      <SolidColorBrush x:Key="FiliTertiaryDarkenBrush" Color="{DynamicResource FiliTertiaryDarkenColor}" />
      <SolidColorBrush x:Key="FiliInfoDarkenBrush" Color="{DynamicResource FiliInfoDarkenColor}" />
      <SolidColorBrush x:Key="FiliSuccessDarkenBrush" Color="{DynamicResource FiliSuccessDarkenColor}" />
      <SolidColorBrush x:Key="FiliWarningDarkenBrush" Color="{DynamicResource FiliWarningDarkenColor}" />
      <SolidColorBrush x:Key="FiliErrorDarkenBrush" Color="{DynamicResource FiliErrorDarkenColor}" />
      <SolidColorBrush x:Key="FiliDarkDarkenBrush" Color="{DynamicResource FiliDarkDarkenColor}" />
      <SolidColorBrush x:Key="FiliPrimaryLightenBrush" Color="{DynamicResource FiliPrimaryLightenColor}" />
      <SolidColorBrush x:Key="FiliSecondaryLightenBrush" Color="{DynamicResource FiliSecondaryLightenColor}" />
      <SolidColorBrush x:Key="FiliTertiaryLightenBrush" Color="{DynamicResource FiliTertiaryLightenColor}" />
      <SolidColorBrush x:Key="FiliInfoLightenBrush" Color="{DynamicResource FiliInfoLightenColor}" />
      <SolidColorBrush x:Key="FiliSuccessLightenBrush" Color="{DynamicResource FiliSuccessLightenColor}" />
      <SolidColorBrush x:Key="FiliWarningLightenBrush" Color="{DynamicResource FiliWarningLightenColor}" />
      <SolidColorBrush x:Key="FiliErrorLightenBrush" Color="{DynamicResource FiliErrorLightenColor}" />
      <SolidColorBrush x:Key="FiliDarkLightenBrush" Color="{DynamicResource FiliDarkLightenColor}" />
      <SolidColorBrush x:Key="FiliPrimaryAlertTextBrush" Color="{DynamicResource FiliPrimaryAlertTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryAlertTextBrush" Color="{DynamicResource FiliSecondaryAlertTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryAlertTextBrush" Color="{DynamicResource FiliTertiaryAlertTextColor}" />
      <SolidColorBrush x:Key="FiliInfoAlertTextBrush" Color="{DynamicResource FiliInfoAlertTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessAlertTextBrush" Color="{DynamicResource FiliSuccessAlertTextColor}" />
      <SolidColorBrush x:Key="FiliWarningAlertTextBrush" Color="{DynamicResource FiliWarningAlertTextColor}" />
      <SolidColorBrush x:Key="FiliErrorAlertTextBrush" Color="{DynamicResource FiliErrorAlertTextColor}" />
      <SolidColorBrush x:Key="FiliDarkAlertTextBrush" Color="{DynamicResource FiliDarkAlertTextColor}" />
      <SolidColorBrush x:Key="FiliPrimaryTextBrush" Color="{DynamicResource FiliPrimaryTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryTextBrush" Color="{DynamicResource FiliSecondaryTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryTextBrush" Color="{DynamicResource FiliTertiaryTextColor}" />
      <SolidColorBrush x:Key="FiliInfoTextBrush" Color="{DynamicResource FiliInfoTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessTextBrush" Color="{DynamicResource FiliSuccessTextColor}" />
      <SolidColorBrush x:Key="FiliWarningTextBrush" Color="{DynamicResource FiliWarningTextColor}" />
      <SolidColorBrush x:Key="FiliErrorTextBrush" Color="{DynamicResource FiliErrorTextColor}" />
      <SolidColorBrush x:Key="FiliDarkTextBrush" Color="{DynamicResource FiliDarkTextColor}" />
      <SolidColorBrush x:Key="FiliPrimaryNonTextBrush" Color="{DynamicResource FiliPrimaryNonTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryNonTextBrush" Color="{DynamicResource FiliSecondaryNonTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryNonTextBrush" Color="{DynamicResource FiliTertiaryNonTextColor}" />
      <SolidColorBrush x:Key="FiliInfoNonTextBrush" Color="{DynamicResource FiliInfoNonTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessNonTextBrush" Color="{DynamicResource FiliSuccessNonTextColor}" />
      <SolidColorBrush x:Key="FiliWarningNonTextBrush" Color="{DynamicResource FiliWarningNonTextColor}" />
      <SolidColorBrush x:Key="FiliErrorNonTextBrush" Color="{DynamicResource FiliErrorNonTextColor}" />
      <SolidColorBrush x:Key="FiliDarkNonTextBrush" Color="{DynamicResource FiliDarkNonTextColor}" />
      <SolidColorBrush x:Key="FiliChipHoverBrush" Color="{DynamicResource FiliChipHoverColor}" />
      <SolidColorBrush x:Key="FiliBlackBrush"   Color="{DynamicResource FiliBlackColor}" />
      <SolidColorBrush x:Key="FiliWhiteBrush"   Color="{DynamicResource FiliWhiteColor}" />

      <SolidColorBrush x:Key="FiliTextPrimaryBrush"   Color="{DynamicResource FiliTextPrimaryColor}" />
      <SolidColorBrush x:Key="FiliTextSecondaryBrush" Color="{DynamicResource FiliTextSecondaryColor}" />
      <SolidColorBrush x:Key="FiliTextDisabledBrush"  Color="{DynamicResource FiliTextDisabledColor}" />

      <SolidColorBrush x:Key="FiliActionDefaultBrush"            Color="{DynamicResource FiliActionDefaultColor}" />
      <SolidColorBrush x:Key="FiliActionDisabledBrush"           Color="{DynamicResource FiliActionDisabledColor}" />
      <SolidColorBrush x:Key="FiliActionDisabledBackgroundBrush" Color="{DynamicResource FiliActionDisabledBackgroundColor}" />

      <SolidColorBrush x:Key="FiliBackgroundBrush"     Color="{DynamicResource FiliBackgroundColor}" />
      <SolidColorBrush x:Key="FiliBackgroundGrayBrush" Color="{DynamicResource FiliBackgroundGrayColor}" />
      <SolidColorBrush x:Key="FiliSurfaceBrush"        Color="{DynamicResource FiliSurfaceColor}" />

      <SolidColorBrush x:Key="FiliAppbarBackgroundBrush" Color="{DynamicResource FiliAppbarBackgroundColor}" />
      <SolidColorBrush x:Key="FiliAppbarTextBrush"       Color="{DynamicResource FiliAppbarTextColor}" />
      <SolidColorBrush x:Key="FiliDrawerBackgroundBrush" Color="{DynamicResource FiliDrawerBackgroundColor}" />
      <SolidColorBrush x:Key="FiliDrawerTextBrush"       Color="{DynamicResource FiliDrawerTextColor}" />
      <SolidColorBrush x:Key="FiliDrawerIconBrush"       Color="{DynamicResource FiliDrawerIconColor}" />
      <SolidColorBrush x:Key="FiliDrawerBorderBrush"     Color="{DynamicResource FiliDrawerBorderColor}" />

      <SolidColorBrush x:Key="FiliLinesDefaultBrush" Color="{DynamicResource FiliLinesDefaultColor}" />
      <SolidColorBrush x:Key="FiliLinesInputsBrush"  Color="{DynamicResource FiliLinesInputsColor}" />
      <SolidColorBrush x:Key="FiliDividerBrush"      Color="{DynamicResource FiliDividerColor}" />
      <SolidColorBrush x:Key="FiliDividerLightBrush" Color="{DynamicResource FiliDividerLightColor}" />
      <SolidColorBrush x:Key="FiliGrayDefaultBrush" Color="{DynamicResource FiliGrayDefaultColor}" />
      <SolidColorBrush x:Key="FiliGrayLightBrush" Color="{DynamicResource FiliGrayLightColor}" />
      <SolidColorBrush x:Key="FiliGrayLighterBrush" Color="{DynamicResource FiliGrayLighterColor}" />
      <SolidColorBrush x:Key="FiliGrayDarkBrush" Color="{DynamicResource FiliGrayDarkColor}" />
      <SolidColorBrush x:Key="FiliGrayDarkerBrush" Color="{DynamicResource FiliGrayDarkerColor}" />
      <SolidColorBrush x:Key="FiliTableLinesBrush"   Color="{DynamicResource FiliTableLinesColor}" />
      <SolidColorBrush x:Key="FiliTableStripedBrush" Color="{DynamicResource FiliTableStripedColor}" />
      <SolidColorBrush x:Key="FiliTableHoverBrush"   Color="{DynamicResource FiliTableHoverColor}" />
      <SolidColorBrush x:Key="FiliSkeletonBrush"     Color="{DynamicResource FiliSkeletonColor}" />
      <SolidColorBrush x:Key="FiliAvatarTextBrush"     Color="{DynamicResource FiliAvatarTextColor}" />
      <SolidColorBrush x:Key="FiliAvatarBareTextBrush" Color="{DynamicResource FiliAvatarBareTextColor}" />
      <SolidColorBrush x:Key="FiliAvatarBackgroundBrush" Color="{DynamicResource FiliAvatarBackgroundColor}" />
      <SolidColorBrush x:Key="FiliBadgeTextBrush"      Color="{DynamicResource FiliBadgeTextColor}" />
      <LinearGradientBrush x:Key="FiliSkeletonWaveStartBrush" StartPoint="-100%,0%" EndPoint="0%,0%">
        <GradientStop Offset="0" Color="{DynamicResource FiliSkeletonColor}" />
        <GradientStop Offset="0.5" Color="{DynamicResource FiliSkeletonWaveColor}" />
        <GradientStop Offset="1" Color="{DynamicResource FiliSkeletonColor}" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="FiliSkeletonWaveEndBrush" StartPoint="100%,0%" EndPoint="200%,0%">
        <GradientStop Offset="0" Color="{DynamicResource FiliSkeletonColor}" />
        <GradientStop Offset="0.5" Color="{DynamicResource FiliSkeletonWaveColor}" />
        <GradientStop Offset="1" Color="{DynamicResource FiliSkeletonColor}" />
      </LinearGradientBrush>

      <SolidColorBrush x:Key="FiliPrimaryHoverBrush"   Color="{DynamicResource FiliPrimaryHoverColor}" />
      <SolidColorBrush x:Key="FiliOverlayDarkBrush"  Color="{DynamicResource FiliOverlayDarkColor}" />
      <SolidColorBrush x:Key="FiliOverlayLightBrush" Color="{DynamicResource FiliOverlayLightColor}" />

      <SolidColorBrush x:Key="FiliOverlayHoverBrush"   Color="{DynamicResource FiliOverlayHoverColor}" />
      <SolidColorBrush x:Key="FiliOverlayPressedBrush" Color="{DynamicResource FiliOverlayPressedColor}" />

      <SolidColorBrush x:Key="FiliTooltipBackgroundBrush" Color="{DynamicResource FiliTooltipBackgroundColor}" />
      <SolidColorBrush x:Key="FiliSwitchThumbBrush" Color="{DynamicResource FiliSwitchThumbColor}" />
      <SolidColorBrush x:Key="FiliScrollbarThumbBrush" Color="{DynamicResource FiliScrollbarThumbColor}" />
      <SolidColorBrush x:Key="FiliScrollbarThumbHoverBrush" Color="{DynamicResource FiliScrollbarThumbHoverColor}" />

      <SolidColorBrush x:Key="FiliInputFilledBrush"    Color="{DynamicResource FiliInputFilledColor}" />

      <SolidColorBrush x:Key="FiliFocusRingBrush"      Color="{DynamicResource FiliTextPrimaryColor}" />
      <SolidColorBrush x:Key="FiliFocusRingInnerBrush" Color="{DynamicResource FiliWhiteColor}" />
      <!-- END GENERATED -->
    </ResourceDictionary>

    <!-- ========================= HIGH CONTRAST ========================== -->
    <!--
      NOT a MudBlazor palette. MudBlazor ships light and dark and nothing else, so there was
      nothing to transcribe here; this variant is derived from how an app swapping to a
      high-contrast palette expects the theme's own controls to follow it.

      Three rules produced every value below.

      1. SEPARATION COMES FROM LINES, NOT FROM FILLS. Surface sits one step off the page ground
         and is not doing the work - #0D0D0D against #000000 is a difference nobody can see. What
         divides a card, a menu or a dialog from the page is its outline, which Elevation.axaml
         supplies in this variant as a hard ring in place of a shadow. That is the standard
         high-contrast substitution, and it is why this palette needed no control template edits.

      2. NOTHING IS CONVEYED BY ALPHA. Every line and text token here is opaque. The light and
         dark palettes lean on translucent blacks and whites (#1FFFFFFF for a divider), which
         composite against whatever is behind them; on a black ground a 12% white line is
         invisible. Alpha survives in exactly three places, all of them deliberate overlays
         rather than content: the two state layers, the input fill and the scrims.

      3. DISABLED STILL HAS TO BE LEGIBLE. #CFCFDA against black is 13.6:1 - far too strong
         to read as disabled in a normal palette, which is the point. A user who needs this
         variant is not served by a control they cannot read at all, so disabled is signalled by
         being dimmer than enabled rather than by being nearly gone.

      The hues are the MudBlazor ones raised until they clear roughly 10:1 on black, so an app
      that has not overridden anything still looks like this theme rather than like a generic
      black-and-white sheet.
    -->
    <ResourceDictionary x:Key="{x:Static theme:FiliThemeVariants.HighContrast}">

      <Color x:Key="FiliPrimaryColor">#D3C4FF</Color>
      <Color x:Key="FiliPrimaryContrastTextColor">#000000</Color>
      <Color x:Key="FiliSecondaryColor">#FF9DC4</Color>
      <Color x:Key="FiliSecondaryContrastTextColor">#000000</Color>
      <Color x:Key="FiliTertiaryColor">#7BF0D6</Color>
      <Color x:Key="FiliTertiaryContrastTextColor">#000000</Color>

      <!-- Black on every status colour, like the three above. These hues are pastels raised to
           clear 10:1 on black, so white on them falls to about 1.6:1 - the least readable text
           in the variant meant to be the most readable. -->
      <Color x:Key="FiliInfoColor">#9CD4FF</Color>
      <Color x:Key="FiliInfoContrastTextColor">#000000</Color>
      <Color x:Key="FiliSuccessColor">#8CFFC0</Color>
      <Color x:Key="FiliSuccessContrastTextColor">#000000</Color>
      <Color x:Key="FiliWarningColor">#FFD166</Color>
      <Color x:Key="FiliWarningContrastTextColor">#000000</Color>
      <Color x:Key="FiliErrorColor">#FF9AA8</Color>
      <Color x:Key="FiliErrorContrastTextColor">#000000</Color>
      <!-- Not black: black on this black ground was the `dark` class drawn invisible. A grey
           raised, like the hues above, to clear 10:1 on black (11.2:1), with black on it. -->
      <Color x:Key="FiliDarkColor">#BDBDBD</Color>
      <Color x:Key="FiliDarkContrastTextColor">#000000</Color>
      <Color x:Key="FiliBlackColor">#000000</Color>
      <Color x:Key="FiliWhiteColor">#FFFFFF</Color>

      <Color x:Key="FiliTextPrimaryColor">#FFFFFF</Color>
      <Color x:Key="FiliTextSecondaryColor">#E8E8EE</Color>
      <Color x:Key="FiliTextDisabledColor">#CFCFDA</Color>

      <Color x:Key="FiliActionDefaultColor">#E8E8EE</Color>
      <Color x:Key="FiliActionDisabledColor">#CFCFDA</Color>
      <!-- Dark, not the line colour. A disabled field filled at #5A5A66 is the BRIGHTEST thing
           on the page, which reads as emphasis - the exact opposite of what it means. Disabled is
           carried by the label staying legible at #CFCFDA, not by the fill shouting. -->
      <Color x:Key="FiliActionDisabledBackgroundColor">#2B2B33</Color>

      <Color x:Key="FiliBackgroundColor">#000000</Color>
      <Color x:Key="FiliBackgroundGrayColor">#000000</Color>
      <Color x:Key="FiliSurfaceColor">#0D0D0D</Color>

      <Color x:Key="FiliAppbarBackgroundColor">#000000</Color>
      <Color x:Key="FiliAppbarTextColor">#FFFFFF</Color>
      <Color x:Key="FiliDrawerBackgroundColor">#000000</Color>
      <Color x:Key="FiliDrawerTextColor">#E8E8EE</Color>
      <Color x:Key="FiliDrawerIconColor">#E8E8EE</Color>
      <Color x:Key="FiliDrawerBorderColor">#9C9CA8</Color>

      <!--
        Inputs get the SAME line as a default border, unlike light and dark where an input
        outline is stronger than a divider. At this contrast there is no headroom left to make
        one stronger than the other, so the distinction is dropped rather than faked.
      -->
      <Color x:Key="FiliLinesDefaultColor">#E8E8EE</Color>
      <Color x:Key="FiliLinesInputsColor">#E8E8EE</Color>
      <Color x:Key="FiliDividerColor">#9C9CA8</Color>
      <!-- The line colour, opaque: a 6% hairline over black would not exist. -->
      <Color x:Key="FiliDividerLightColor">#E8E8EE</Color>
      <!-- The grays, each one Material step lighter than light and dark, so every one keeps its
           distance from a black ground. -->
      <Color x:Key="FiliGrayDefaultColor">#BDBDBD</Color>
      <Color x:Key="FiliGrayLightColor">#E0E0E0</Color>
      <Color x:Key="FiliGrayLighterColor">#EEEEEE</Color>
      <Color x:Key="FiliGrayDarkColor">#9E9E9E</Color>
      <Color x:Key="FiliGrayDarkerColor">#757575</Color>
      <Color x:Key="FiliTableLinesColor">#9C9CA8</Color>
      <Color x:Key="FiliTableStripedColor">#1F1F1F</Color>
      <Color x:Key="FiliTableHoverColor">#333333</Color>
      <Color x:Key="FiliSkeletonColor">#2A2A2A</Color>
      <!-- 4% black over the opaque skeleton: 0x2A x 0.96. -->
      <Color x:Key="FiliSkeletonWaveColor">#282828</Color>

      <!-- Black, where text-primary and white are white: lines-inputs and gray-light are near-white
           here (#E8E8EE, #E0E0E0), and white on them is the least readable text in the variant. -->
      <Color x:Key="FiliAvatarTextColor">#000000</Color>
      <Color x:Key="FiliAvatarBareTextColor">#000000</Color>
      <Color x:Key="FiliBadgeTextColor">#000000</Color>
      <!-- lines-inputs, as in light and dark: black avatar text on it is 17.2:1. -->
      <Color x:Key="FiliAvatarBackgroundColor">#E8E8EE</Color>

      <!--
        Selection tint at 35%, where light and dark use 6%. Six percent of anything over black
        is black, so the tint that marks a selected row would simply not exist.
      -->
      <Color x:Key="FiliPrimaryHoverColor">#59D3C4FF</Color>

      <!-- At 35% like the primary above. -->
      <Color x:Key="FiliSecondaryHoverColor">#59FF9DC4</Color>
      <Color x:Key="FiliTertiaryHoverColor">#597BF0D6</Color>
      <Color x:Key="FiliInfoHoverColor">#599CD4FF</Color>
      <Color x:Key="FiliSuccessHoverColor">#598CFFC0</Color>
      <Color x:Key="FiliWarningHoverColor">#59FFD166</Color>
      <Color x:Key="FiliErrorHoverColor">#59FF9AA8</Color>
      <Color x:Key="FiliDarkHoverColor">#59BDBDBD</Color>
      <Color x:Key="FiliActionDefaultHoverColor">#33FFFFFF</Color>

      <!-- The same derivation, Dark included. -->
      <Color x:Key="FiliPrimaryDarkenColor">#B399FF</Color>
      <Color x:Key="FiliSecondaryDarkenColor">#FF7AAF</Color>
      <Color x:Key="FiliTertiaryDarkenColor">#5AEDCD</Color>
      <Color x:Key="FiliInfoDarkenColor">#7AC6FF</Color>
      <Color x:Key="FiliSuccessDarkenColor">#66FFAB</Color>
      <Color x:Key="FiliWarningDarkenColor">#FFC53D</Color>
      <Color x:Key="FiliErrorDarkenColor">#FF7588</Color>
      <Color x:Key="FiliDarkDarkenColor">#A9A9A9</Color>
      <Color x:Key="FiliPrimaryLightenColor">#F0EBFF</Color>
      <Color x:Key="FiliSecondaryLightenColor">#FFC2DA</Color>
      <Color x:Key="FiliTertiaryLightenColor">#9AF4E0</Color>
      <Color x:Key="FiliInfoLightenColor">#C2E4FF</Color>
      <Color x:Key="FiliSuccessLightenColor">#ADFFD2</Color>
      <Color x:Key="FiliWarningLightenColor">#FFDC8A</Color>
      <Color x:Key="FiliErrorLightenColor">#FFC2CA</Color>
      <Color x:Key="FiliDarkLightenColor">#D2D2D2</Color>

      <!--
        The LIGHTEN shade here, not the darken: on a 35% tint over black the darken shades fall
        to 3.4:1, and lighten keeps every severity above 5.6:1 on black and on the surface.
      -->
      <Color x:Key="FiliPrimaryAlertTextColor">#F0EBFF</Color>
      <Color x:Key="FiliSecondaryAlertTextColor">#FFC2DA</Color>
      <Color x:Key="FiliTertiaryAlertTextColor">#9AF4E0</Color>
      <Color x:Key="FiliInfoAlertTextColor">#C2E4FF</Color>
      <Color x:Key="FiliSuccessAlertTextColor">#ADFFD2</Color>
      <Color x:Key="FiliWarningAlertTextColor">#FFDC8A</Color>
      <Color x:Key="FiliErrorAlertTextColor">#FFC2CA</Color>
      <Color x:Key="FiliDarkAlertTextColor">#D2D2D2</Color>

      <!-- The colour as text: the colour itself where it reaches 4.5:1 on its own 35% tint and on
           that tint deepened by a selected nav link's hover, 39%, over black and the surface
           (tertiary, info, success and warning). Since 1.2.0 the others are a little lighter, the
           same hue raised to 4.5:1 on the deepened tint, where the colour fell as low as 4.10:1.
           Each line names the colour and the worst ratio before and after. Declared, not
           inherited, as Dark's lightened shades are not this variant's hues (TextContrastTests). -->
      <!-- #D3C4FF, just under 4.5:1; 4.61:1. -->
      <Color x:Key="FiliPrimaryTextColor">#D5C7FF</Color>
      <!-- #FF9DC4, 4.17:1; 4.59:1. -->
      <Color x:Key="FiliSecondaryTextColor">#FFABCC</Color>
      <Color x:Key="FiliTertiaryTextColor">#7BF0D6</Color>
      <Color x:Key="FiliInfoTextColor">#9CD4FF</Color>
      <Color x:Key="FiliSuccessTextColor">#8CFFC0</Color>
      <Color x:Key="FiliWarningTextColor">#FFD166</Color>
      <!-- #FF9AA8, 4.10:1; 4.61:1. -->
      <Color x:Key="FiliErrorTextColor">#FFABB6</Color>
      <!-- #BDBDBD, 4.22:1; 4.60:1. -->
      <Color x:Key="FiliDarkTextColor">#C5C5C5</Color>

      <!-- The colour as a line or glyph: the colour itself, as every one clears 4.5:1 on black,
           the surface, a filled field's fill and its own 35% tint, far past 1.4.11's 3:1.
           Declared, not inherited, as Dark's lightened shades are not this variant's hues. -->
      <Color x:Key="FiliPrimaryNonTextColor">#D3C4FF</Color>
      <Color x:Key="FiliSecondaryNonTextColor">#FF9DC4</Color>
      <Color x:Key="FiliTertiaryNonTextColor">#7BF0D6</Color>
      <Color x:Key="FiliInfoNonTextColor">#9CD4FF</Color>
      <Color x:Key="FiliSuccessNonTextColor">#8CFFC0</Color>
      <Color x:Key="FiliWarningNonTextColor">#FFD166</Color>
      <Color x:Key="FiliErrorNonTextColor">#FF9AA8</Color>
      <Color x:Key="FiliDarkNonTextColor">#BDBDBD</Color>

      <!-- Opaque, where light and dark tint with action-disabled: that is #CFCFDA here, the
           legible disabled grey, and white chip text on it fell to 1.5:1. White on this is 6.8:1,
           and it stands 2:1 off the chip's resting #2B2B33. -->
      <Color x:Key="FiliChipHoverColor">#5A5A66</Color>

      <!-- Half, not 30%: at 30% a pastel rail is 1.9:1 on black. At 50% every colour's rail
           clears 3:1 on black and on the surface, and the track stays 3:1 off the rail. -->
      <sys:Double x:Key="FiliSliderRailOpacity">0.5</sys:Double>

      <!-- On, as in light and dark, and here it matters most: the state layer's tint is no
           indicator a person who needs high contrast can find, and WCAG's 1.4.11 asks 3:1 of one.
           The ring is text-primary, white, 21:1 on black. -->
      <sys:Boolean x:Key="FiliFocusRing">True</sys:Boolean>

      <Color x:Key="FiliOverlayHoverColor">#33FFFFFF</Color>
      <Color x:Key="FiliOverlayPressedColor">#59FFFFFF</Color>

      <Color x:Key="FiliInputFilledColor">#26FFFFFF</Color>

      <!--
        Scrims at 90%, not 50%. A half-strength scrim leaves the page legible behind the dialog,
        which is the exact failure this variant exists to prevent: two competing readable layers
        and no way to tell which one has focus. The tooltip loses its grey chip for the same
        reason - at 90% white on #616161 it is the lowest-contrast text in the theme.
      -->
      <Color x:Key="FiliOverlayDarkColor">#E6000000</Color>
      <Color x:Key="FiliOverlayLightColor">#E6FFFFFF</Color>
      <Color x:Key="FiliTooltipBackgroundColor">#000000</Color>
      <!-- Pure white: the #fafafa thumb is the brightest thing on the black ground. -->
      <Color x:Key="FiliSwitchThumbColor">#FFFFFF</Color>
      <!-- The scroll bar's thumb in this variant's divider and line greys: visible on the black
           ground at rest, and, as MudBlazor's darker hover does on a light page, moving away
           from the ground under the pointer. -->
      <Color x:Key="FiliScrollbarThumbColor">#9C9CA8</Color>
      <Color x:Key="FiliScrollbarThumbHoverColor">#E8E8EE</Color>


      <!-- GENERATED by ThemeColourGenerator: high contrast palette brushes, copied from light's. -->
      <SolidColorBrush x:Key="FiliPrimaryBrush"               Color="{DynamicResource FiliPrimaryColor}" />
      <SolidColorBrush x:Key="FiliPrimaryContrastTextBrush"   Color="{DynamicResource FiliPrimaryContrastTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryBrush"             Color="{DynamicResource FiliSecondaryColor}" />
      <SolidColorBrush x:Key="FiliSecondaryContrastTextBrush" Color="{DynamicResource FiliSecondaryContrastTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryBrush"              Color="{DynamicResource FiliTertiaryColor}" />
      <SolidColorBrush x:Key="FiliTertiaryContrastTextBrush"  Color="{DynamicResource FiliTertiaryContrastTextColor}" />

      <SolidColorBrush x:Key="FiliInfoBrush"                Color="{DynamicResource FiliInfoColor}" />
      <SolidColorBrush x:Key="FiliInfoContrastTextBrush"    Color="{DynamicResource FiliInfoContrastTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessBrush"             Color="{DynamicResource FiliSuccessColor}" />
      <SolidColorBrush x:Key="FiliSuccessContrastTextBrush" Color="{DynamicResource FiliSuccessContrastTextColor}" />
      <SolidColorBrush x:Key="FiliWarningBrush"             Color="{DynamicResource FiliWarningColor}" />
      <SolidColorBrush x:Key="FiliWarningContrastTextBrush" Color="{DynamicResource FiliWarningContrastTextColor}" />
      <SolidColorBrush x:Key="FiliErrorBrush"               Color="{DynamicResource FiliErrorColor}" />
      <SolidColorBrush x:Key="FiliErrorContrastTextBrush"   Color="{DynamicResource FiliErrorContrastTextColor}" />
      <SolidColorBrush x:Key="FiliDarkBrush"    Color="{DynamicResource FiliDarkColor}" />
      <SolidColorBrush x:Key="FiliDarkContrastTextBrush" Color="{DynamicResource FiliDarkContrastTextColor}" />

      <SolidColorBrush x:Key="FiliSecondaryHoverBrush" Color="{DynamicResource FiliSecondaryHoverColor}" />
      <SolidColorBrush x:Key="FiliTertiaryHoverBrush" Color="{DynamicResource FiliTertiaryHoverColor}" />
      <SolidColorBrush x:Key="FiliInfoHoverBrush" Color="{DynamicResource FiliInfoHoverColor}" />
      <SolidColorBrush x:Key="FiliSuccessHoverBrush" Color="{DynamicResource FiliSuccessHoverColor}" />
      <SolidColorBrush x:Key="FiliWarningHoverBrush" Color="{DynamicResource FiliWarningHoverColor}" />
      <SolidColorBrush x:Key="FiliErrorHoverBrush" Color="{DynamicResource FiliErrorHoverColor}" />
      <SolidColorBrush x:Key="FiliDarkHoverBrush" Color="{DynamicResource FiliDarkHoverColor}" />
      <SolidColorBrush x:Key="FiliActionDefaultHoverBrush" Color="{DynamicResource FiliActionDefaultHoverColor}" />

      <SolidColorBrush x:Key="FiliPrimaryDarkenBrush" Color="{DynamicResource FiliPrimaryDarkenColor}" />
      <SolidColorBrush x:Key="FiliSecondaryDarkenBrush" Color="{DynamicResource FiliSecondaryDarkenColor}" />
      <SolidColorBrush x:Key="FiliTertiaryDarkenBrush" Color="{DynamicResource FiliTertiaryDarkenColor}" />
      <SolidColorBrush x:Key="FiliInfoDarkenBrush" Color="{DynamicResource FiliInfoDarkenColor}" />
      <SolidColorBrush x:Key="FiliSuccessDarkenBrush" Color="{DynamicResource FiliSuccessDarkenColor}" />
      <SolidColorBrush x:Key="FiliWarningDarkenBrush" Color="{DynamicResource FiliWarningDarkenColor}" />
      <SolidColorBrush x:Key="FiliErrorDarkenBrush" Color="{DynamicResource FiliErrorDarkenColor}" />
      <SolidColorBrush x:Key="FiliDarkDarkenBrush" Color="{DynamicResource FiliDarkDarkenColor}" />
      <SolidColorBrush x:Key="FiliPrimaryLightenBrush" Color="{DynamicResource FiliPrimaryLightenColor}" />
      <SolidColorBrush x:Key="FiliSecondaryLightenBrush" Color="{DynamicResource FiliSecondaryLightenColor}" />
      <SolidColorBrush x:Key="FiliTertiaryLightenBrush" Color="{DynamicResource FiliTertiaryLightenColor}" />
      <SolidColorBrush x:Key="FiliInfoLightenBrush" Color="{DynamicResource FiliInfoLightenColor}" />
      <SolidColorBrush x:Key="FiliSuccessLightenBrush" Color="{DynamicResource FiliSuccessLightenColor}" />
      <SolidColorBrush x:Key="FiliWarningLightenBrush" Color="{DynamicResource FiliWarningLightenColor}" />
      <SolidColorBrush x:Key="FiliErrorLightenBrush" Color="{DynamicResource FiliErrorLightenColor}" />
      <SolidColorBrush x:Key="FiliDarkLightenBrush" Color="{DynamicResource FiliDarkLightenColor}" />
      <SolidColorBrush x:Key="FiliPrimaryAlertTextBrush" Color="{DynamicResource FiliPrimaryAlertTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryAlertTextBrush" Color="{DynamicResource FiliSecondaryAlertTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryAlertTextBrush" Color="{DynamicResource FiliTertiaryAlertTextColor}" />
      <SolidColorBrush x:Key="FiliInfoAlertTextBrush" Color="{DynamicResource FiliInfoAlertTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessAlertTextBrush" Color="{DynamicResource FiliSuccessAlertTextColor}" />
      <SolidColorBrush x:Key="FiliWarningAlertTextBrush" Color="{DynamicResource FiliWarningAlertTextColor}" />
      <SolidColorBrush x:Key="FiliErrorAlertTextBrush" Color="{DynamicResource FiliErrorAlertTextColor}" />
      <SolidColorBrush x:Key="FiliDarkAlertTextBrush" Color="{DynamicResource FiliDarkAlertTextColor}" />
      <SolidColorBrush x:Key="FiliPrimaryTextBrush" Color="{DynamicResource FiliPrimaryTextColor}" />
      <SolidColorBrush x:Key="FiliSecondaryTextBrush" Color="{DynamicResource FiliSecondaryTextColor}" />
      <SolidColorBrush x:Key="FiliTertiaryTextBrush" Color="{DynamicResource FiliTertiaryTextColor}" />
      <SolidColorBrush x:Key="FiliInfoTextBrush" Color="{DynamicResource FiliInfoTextColor}" />
      <SolidColorBrush x:Key="FiliSuccessTextBrush" Color="{DynamicResource FiliSuccessTextColor}" />
      <SolidColorBrush x:Key="FiliWarningTextBrush" Color="{DynamicResource FiliWarningTextColor}" />
      <SolidColorBrush x:Key="FiliErrorTextBrush" Color="{DynamicResource FiliErrorTextColor}" />
      <SolidColorBrush x:Key="FiliDarkTextBrush" Color="{DynamicResource FiliDarkTextColor}" />
