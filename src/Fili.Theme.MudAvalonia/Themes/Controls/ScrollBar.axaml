<!--
  ScrollBar: the scroll bar MudThemeProvider injects into the page unless its DefaultScrollbar is
  set, which it is not by default (MudThemeProvider.razor, MudThemeProvider.razor.cs
  BuildMudBlazorScrollbar):

    ::-webkit-scrollbar             width: 8px; height: 8px
    ::-webkit-scrollbar-track       background: transparent
    ::-webkit-scrollbar-thumb       background: #c4c4c4; border-radius: 1px
    ::-webkit-scrollbar-thumb:hover background: #a6a6a6
    (Firefox)                       scrollbar-color: #c4c4c4 transparent; scrollbar-width: thin

  An 8px rail, the thumb filling it, no line buttons (an unstyled ::-webkit-scrollbar-button is
  not drawn), and no pressed colour of its own: a dragged thumb is under the pointer, so it keeps
  the hover grey. The greys are literals, the same in light and dark; high contrast has its own.

  Dropping the line buttons is safe. ScrollBar.OnApplyTemplate looks PART_LineUpButton and
  PART_LineDownButton up and wires them if present; the lookups are null-safe, and the scroll
  gestures that matter (wheel, drag, keyboard, touch) are handled by ScrollViewer rather than by
  those buttons. What IS required is a Track named PART_Track - without it the thumb never moves.

  Both orientations need their own Template, as with Slider: width and height swap, and a
  horizontal template on a vertical bar renders a sideways rail.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <!-- The thumb fills the rail, rounded 1px: no transition, as the CSS names none. -->
  <ControlTheme x:Key="FiliScrollBarThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource FiliScrollbarThumbBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder Background="{TemplateBinding Background}"
                CornerRadius="1" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover, ^:pressed">
      <Setter Property="Background" Value="{DynamicResource FiliScrollbarThumbHoverBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliScrollBar" TargetType="ScrollBar">
    <!-- `::-webkit-scrollbar-track { background: transparent }` -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="MinHeight" Value="8" />

    <!-- Vertical is the default orientation for a ScrollBar. -->
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder Background="{TemplateBinding Background}" Width="8">
          <Track x:Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="Vertical"
                 IsDirectionReversed="True">
            <Thumb x:Name="PART_Thumb" Theme="{StaticResource FiliScrollBarThumb}" />
          </Track>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate>
          <theme:PartBorder Background="{TemplateBinding Background}" Height="8">
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="Horizontal">
              <Thumb x:Name="PART_Thumb" Theme="{StaticResource FiliScrollBarThumb}" />
            </Track>
          </theme:PartBorder>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar" BasedOn="{StaticResource FiliScrollBar}" />

</ResourceDictionary>
