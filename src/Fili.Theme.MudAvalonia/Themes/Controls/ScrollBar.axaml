<!--
  ScrollBar: the scroll bar MudThemeProvider injects into the page unless its DefaultScrollbar is
  set, which it is not by default (MudThemeProvider.razor, MudThemeProvider.razor.cs
  BuildMudBlazorScrollbar):

    ::-webkit-scrollbar             width: 8px; height: 8px
    ::-webkit-scrollbar-track       background: transparent
    ::-webkit-scrollbar-thumb       background: #c4c4c4; border-radius: 1px
    ::-webkit-scrollbar-thumb:hover background: #a6a6a6
    (Firefox)                       scrollbar-color: #c4c4c4 transparent; scrollbar-width: thin

  An 8px rail, the thumb filling it, no line buttons (an unstyled ::-webkit-scrollbar-button is
  not drawn), and no pressed colour of its own: a dragged thumb is under the pointer, so it keeps
  the hover grey. The greys are literals, the same in light and dark; high contrast has its own.

  Only the LINE buttons are dropped. ScrollBar.OnApplyTemplate looks PART_LineUpButton and
  PART_LineDownButton up and wires them if present, and the lookups are null-safe; the arrows are
  what an unstyled ::-webkit-scrollbar-button leaves out. Every other part is kept, because each
  carries behaviour an app expects of a scroll bar and loses SILENTLY without it:

    PART_PageUpButton / PART_PageDownButton   Track's decrease and increase buttons: a click on
                                              the trough pages. Transparent, so the rail still
                                              reads as the bare track.
    DeferThumbDrag                            ScrollViewer.IsDeferredScrollingEnabled: the content
                                              moves on release, not during the drag.
    ContextFlyout                             Avalonia's own Scroll here / Top / Page up menu,
                                              the forked base's, in its String* resources.
    PART_Track                                without it the thumb never moves.

  Both orientations need their own Template, as with Slider: width and height swap, and a
  horizontal template on a vertical bar renders a sideways rail.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <!-- The thumb fills the rail, rounded 1px: no transition, as the CSS names none. -->
  <ControlTheme x:Key="FiliScrollBarThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource FiliScrollbarThumbBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder Background="{TemplateBinding Background}"
                CornerRadius="1" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover, ^:pressed">
      <Setter Property="Background" Value="{DynamicResource FiliScrollbarThumbHoverBrush}" />
    </Style>
  </ControlTheme>

  <!-- The trough either side of the thumb: Track's page buttons, invisible as the CSS track is,
       out of the Tab order as Avalonia's are. -->
  <ControlTheme x:Key="FiliScrollBarPageButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="FiliScrollBar" TargetType="ScrollBar">
    <!-- `::-webkit-scrollbar-track { background: transparent }` -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="ContextFlyout" Value="{DynamicResource SimpleVerticalScrollBarContextFlyout}" />

    <!-- Vertical is the default orientation for a ScrollBar. -->
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder Background="{TemplateBinding Background}" Width="8">
          <Track x:Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 DeferThumbDrag="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                 Orientation="Vertical"
                 IsDirectionReversed="True">
            <Track.DecreaseButton>
              <RepeatButton x:Name="PART_PageUpButton" Theme="{StaticResource FiliScrollBarPageButton}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton x:Name="PART_PageDownButton" Theme="{StaticResource FiliScrollBarPageButton}" />
            </Track.IncreaseButton>
            <Thumb x:Name="PART_Thumb" Theme="{StaticResource FiliScrollBarThumb}" />
          </Track>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:horizontal">
      <Setter Property="ContextFlyout" Value="{DynamicResource SimpleHorizontalScrollBarContextFlyout}" />
      <Setter Property="Template">
        <ControlTemplate>
          <theme:PartBorder Background="{TemplateBinding Background}" Height="8">
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   DeferThumbDrag="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                   Orientation="Horizontal">
              <Track.DecreaseButton>
                <RepeatButton x:Name="PART_PageUpButton" Theme="{StaticResource FiliScrollBarPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton x:Name="PART_PageDownButton" Theme="{StaticResource FiliScrollBarPageButton}" />
              </Track.IncreaseButton>
              <Thumb x:Name="PART_Thumb" Theme="{StaticResource FiliScrollBarThumb}" />
            </Track>
          </theme:PartBorder>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar" BasedOn="{StaticResource FiliScrollBar}" />

</ResourceDictionary>
