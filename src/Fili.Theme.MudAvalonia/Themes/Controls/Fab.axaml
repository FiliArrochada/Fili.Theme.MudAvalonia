<!--
  Fab: MudFab. Not a new control - a theme a Button takes with the `fab` class:

    <Button Classes="fab primary"><PathIcon Data="…" /></Button>          a 56px round primary FAB
    <Button Classes="fab extended secondary medium">                      a 40px pill with a label
      <StackPanel Orientation="Horizontal">
        <PathIcon Classes="start-icon" Data="…" /><TextBlock Text="Create" />
      </StackPanel>
    </Button>

  Transcribed from Styles/components/_fab.scss and Components/Button/MudFab.razor(.cs):

    Variant.Filled   the default, unlike MudButton's Text: no class. `outlined` and `text` switch it
    Color.Default    grey: action-default-hover as the fill, action-disabled-background on hover,
                     text-primary as the content. A colour class is only a colour, as on Button
    Size.Large       the default, 56px: no class. `medium` is 48px and `small` 40px
    Label            `extended`: `.mud-fab-extended`, a pill 48 / 40 / 34px high with 16 / 16 / 12px
                     a side, its icon 8px (4px small) from the label
    DropShadow       `flat` is DropShadow="false": no shadow in any state
    IconSize         Size.Medium, 24px, whatever the FAB's own size

  Filled sits at elevation 6 and lifts to 8 on hover and keyboard focus and to 12 on press - the
  layers _fab.scss spells out, which are FiliElevation6, 8 and 12 exactly. Outlined and text never
  cast a shadow; their hover is the colour's 6% tint ({color}-hover), or action-default-hover with
  no colour. Disabled is action-disabled on action-disabled-background, flat; outlined and text
  keep a transparent ground, and outlined's line turns action-disabled-background.

  Color.Inherit draws as Color.Default: MudFab emits `mud-fab-inherit` and `mud-fab-filled-inherit`,
  and _fab.scss has a rule for neither, so there is no `inherit` here either.

  :hover, :focus-visible and :active share one value in _fab.scss for the ground; only the
  shadow tells press apart. The ripple and the uppercase label are the two parts with no Avalonia
  primitive, as on every button.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliFab" TargetType="Button">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- `.mud-fab-size-large`, the default: 56px, and border-radius 50%. -->
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- Every TemplatedControl clips to its bounds in Avalonia 12, which would cut the shadow
         off at the edge it is drawn past. -->
    <Setter Property="ClipToBounds" Value="False" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource FiliElevation6}">
          <Panel>
            <Border x:Name="PART_Ripple"
                    theme:Ripple.IsLayer="True"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              theme:TextTransform.Case="{DynamicResource FiliButtonTextTransform}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter.Content>
                <MultiBinding Converter="{x:Static theme:TextTransform.Converter}">
                  <TemplateBinding Property="Content" />
                  <Binding Path="(theme:TextTransform.Case)" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </ContentPresenter.Content>
            </ContentPresenter>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- GENERATED by ThemeColourGenerator: fab variants, colours and sizes. -->
    <!-- Filled, the default: lifts on hover and focus, more on press. -->
    <Style Selector="^:pointerover /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation12}" />
    </Style>

    <!-- No colour: grey, going to action-disabled-background. -->
    <Style Selector="^:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>

    <!-- `.mud-fab-{color}`: the colour, {color}-text on it, {color}-darken on hover, and the
         ripple at the secondary ripple opacity. -->
    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    </Style>
    <Style Selector="^.tertiary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    </Style>
    <Style Selector="^.info:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    </Style>
    <Style Selector="^.success:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    </Style>
    <Style Selector="^.warning:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    </Style>
    <Style Selector="^.error:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    </Style>
    <Style Selector="^.dark:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>

    <!-- `.mud-fab-text`: no ground and no shadow; the colour as content, its tint on hover. -->
    <Style Selector="^.text">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    </Style>
    <Style Selector="^.text /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.text:pointerover /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.text:focus-visible /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.text:pressed /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.text:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.text:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.text:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.text.primary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.text.primary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.text.primary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.text.primary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.text.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.text.secondary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.text.secondary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.text.secondary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.text.tertiary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.text.tertiary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.text.tertiary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.text.tertiary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.text.info">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.text.info:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.text.info:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.text.info:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.text.success">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.text.success:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.text.success:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.text.success:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.text.warning">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.text.warning:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.text.warning:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.text.warning:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.text.error">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.text.error:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.text.error:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.text.error:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.text.dark">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.text.dark:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.text.dark:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.text.dark:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>

    <!-- `.mud-fab-outlined`: the text look plus a 1px line, text-primary or the colour
         (BorderOpacity is 1.0, so the line IS the colour). -->
    <Style Selector="^.outlined">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    </Style>
    <Style Selector="^.outlined /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.outlined:pointerover /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.outlined:focus-visible /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.outlined:pressed /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.outlined:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.outlined:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.outlined:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.primary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.outlined.primary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.primary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.primary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.info">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.outlined.info:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.info:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.info:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.success">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.outlined.success:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.success:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.success:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.warning">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.outlined.warning:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.warning:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.warning:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.error">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.outlined.error:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.error:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.error:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.dark">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.outlined.dark:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.dark:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.dark:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>

    <!-- `.mud-fab-size-small` / `-medium`: 40px / 48px. -->
    <Style Selector="^.small">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="^.medium">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="CornerRadius" Value="24" />
    </Style>

    <!-- `.mud-fab-extended`: a pill as wide as its label, 48 / 40 / 34px high. -->
    <Style Selector="^.extended">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="48" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="24" />
    </Style>
    <Style Selector="^.extended.medium">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="^.extended.small">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="17" />
    </Style>

    <!-- `flat` is DropShadow="false": `.mud-fab-disable-elevation` drops the shadow in every state. -->
    <Style Selector="^.flat /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.flat:pointerover /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.flat:focus-visible /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.flat:pressed /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>

    <!-- Disabled: action-disabled on action-disabled-background, flat; outlined and text keep
         no ground, and outlined's line turns action-disabled-background. -->
    <Style Selector="^:disabled /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^.text:disabled /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.outlined:disabled /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <!-- END GENERATED -->
  </ControlTheme>

</ResourceDictionary>
