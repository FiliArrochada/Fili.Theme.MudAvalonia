<!--
  NotificationCard and WindowNotificationManager: MudSnackbar.

  Transcribed from _snackbar.scss:

    .mud-snackbar          padding: 6px 16px; margin-top: 16px;
                           min-width: 288px; max-width: 500px;
                           border-radius: the default radius;
                           font-weight: 400; line-height: 1.43;
                           box-shadow: 0 3px 5px -1px rgba(0,0,0,.2),
                                       0 6px 10px 0 rgba(0,0,0,.14),
                                       0 1px 18px 0 rgba(0,0,0,.12)
    .mud-snackbar-content-message   padding: 8px 0
    .mud-snackbar-location-*        24px from the edges it is anchored to

  That box-shadow is character-for-character FiliElevation6, which is how the level was chosen
  rather than eyeballed - a snackbar is elevation 6, not the 8 a menu gets.

  SEVERITY COLOURS come from _alert.scss, since a snackbar is a filled MudAlert:

    .mud-alert-filled-<color>   color: the palette <color>-text token;
                                font-weight: 500;
                                background-color: the palette <color> token

  Every one of those contrast-text tokens is Colors.Shades.White in MudBlazor's palette, which is why
  the foreground below is the palette's white rather than four near-identical contrast tokens.
  Note the weight: 500 on a filled alert, against the 400 the snackbar's own rule gives - the
  more specific one wins there, so these cards are Medium.

  THE CARD IS MudSnackbarElement.razor: the severity icon, the message, then the close button.

    .mud-snackbar-icon            padding: 7px 0; margin-right: 12px; opacity: 0.9 - a 24px glyph,
                                  since the MudIcon's own mud-icon-size-medium beats the 22px
    .mud-snackbar-content-action  padding-left: 16px; margin-right: -8px
    the close button              a small MudIconButton (3px round 18px), `ms-2`, Filled.Close;
                                  `color: currentColor` on a filled card, action-default otherwise

  The variants are classes on the card, passed as WindowNotificationManager.Show's `classes`:
  `text` and `outlined` (SnackbarVariant), `normal` (Severity.Normal), `hide-icon` (HideIcon) and
  `hide-close` (ShowCloseIcon="false"). The colours are GENERATED by ThemeColourGenerator.

  THE ANIMATIONS ARE COPIED FROM THE FORKED TEMPLATE ON PURPOSE. The enter and exit ones are
  Avalonia's, not MudBlazor's, and the exit one is LOAD-BEARING: the key frame that sets
  IsClosed at 100% is what actually removes a card from the manager. A theme that drops it
  renders beautifully and leaves notifications on screen forever.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliNotificationCard" TargetType="NotificationCard">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- Every TemplatedControl clips to its bounds in Avalonia 12, which would cut the shadow
         off at the edge it is drawn past. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Margin" Value="0,16,0,0" />
    <Setter Property="MinWidth" Value="288" />
    <Setter Property="MaxWidth" Value="500" />
    <Setter Property="RenderTransformOrigin" Value="50%,75%" />

    <Setter Property="Template">
      <ControlTemplate>
        <LayoutTransformControl x:Name="PART_LayoutTransformControl" UseRenderTransform="True">
          <theme:PartBorder x:Name="PART_Card"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  BoxShadow="{DynamicResource FiliElevation6}">
            <DockPanel>
              <!-- Paths at 24 with Stretch="None", as every Material glyph here: a PathIcon would
                   stretch the glyph's own bounds to its box, where MudIcon draws the 24px viewBox. -->
              <Path x:Name="PART_Icon"
                    DockPanel.Dock="Left"
                    Width="24" Height="24"
                    Stretch="None"
                    Margin="0,7,12,7"
                    Opacity="0.9"
                    VerticalAlignment="Center"
                    Fill="{TemplateBinding Foreground}"
                    Data="{DynamicResource FiliInfoOutlinedGeometry}" />
              <!-- NotificationCard.CloseOnClick is Avalonia's own: a button carrying it closes
                   the card it is in. The button is `inherit`, so it takes the colour of the panel
                   round it: the card's own, or action-default on a text or outlined card. A style
                   from this template cannot colour the button directly - its own theme wins. -->
              <Panel x:Name="PART_Action"
                     DockPanel.Dock="Right"
                     Margin="24,0,-8,0"
                     VerticalAlignment="Center">
                <Button x:Name="PART_CloseButton"
                        Classes="icon small inherit"
                        NotificationCard.CloseOnClick="True">
                  <!-- 18px, the small icon button's: the 24px glyph scaled to it. -->
                  <Viewbox Width="18" Height="18">
                    <Path Width="24" Height="24"
                          Stretch="None"
                          Data="{DynamicResource FiliCloseGeometry}"
                          Fill="{Binding $parent[Button].Foreground}" />
                  </Viewbox>
                </Button>
              </Panel>
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalContentAlignment="Center" />
            </DockPanel>
          </theme:PartBorder>
        </LayoutTransformControl>
      </ControlTemplate>
    </Setter>

    <!-- Enter: Avalonia's, kept verbatim. -->
    <Style Selector="^">
      <Style.Animations>
        <Animation Easing="QuadraticEaseIn" FillMode="Forward" Duration="0:0:0.45">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="20" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.85" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
          </KeyFrame>
          <KeyFrame Cue="30%">
            <Setter Property="TranslateTransform.Y" Value="-20" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="^[IsClosing=true] /template/ LayoutTransformControl#PART_LayoutTransformControl">
      <Setter Property="RenderTransformOrigin" Value="50%,0%" />
      <Style.Animations>
        <Animation Easing="QuadraticEaseOut" FillMode="Forward" Duration="0:0:0.75">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X" Value="0" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="70%">
            <Setter Property="TranslateTransform.X" Value="800" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleY" Value="0" />
            <Setter Property="TranslateTransform.X" Value="800" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- LOAD-BEARING: this is what closes a card. Drop it and notifications never leave. -->
    <Style Selector="^[IsClosing=true]">
      <Style.Animations>
        <Animation Easing="QuadraticEaseOut" FillMode="Forward" Duration="0:0:1.25">
          <KeyFrame Cue="100%">
            <Setter Property="IsClosed" Value="True" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- GENERATED by ThemeColourGenerator: snackbar variants and colours. -->
    <!-- Filled, the default: the colour, its contrast text, weight 500. -->
    <Style Selector="^:information">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
    </Style>
    <Style Selector="^:success">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
    </Style>
    <Style Selector="^:warning">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
    </Style>
    <Style Selector="^.normal">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
    </Style>

    <!-- Text and outlined: the surface, the text in the colour's darken shade at 400, and an
         outlined card's 1px line in the colour. The close button is action-default. -->
    <Style Selector="^.text">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="^.text:information">
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoDarkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.text:success">
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessDarkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.text:warning">
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningDarkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.text:error">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorDarkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.text.normal">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
    </Style>
    <Style Selector="^.text /template/ Panel#PART_Action">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliActionDefaultBrush}" />
    </Style>
    <Style Selector="^.outlined">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="^.outlined:information">
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoDarkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.outlined:success">
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessDarkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.outlined:warning">
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningDarkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.outlined:error">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorDarkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.outlined.normal">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
    </Style>
    <Style Selector="^.outlined /template/ Panel#PART_Action">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliActionDefaultBrush}" />
    </Style>
    <Style Selector="^.outlined">
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- END GENERATED -->

    <!-- The severity icon: CommonSnackbarOptions' InfoIcon, SuccessIcon, WarningIcon, ErrorIcon
         and NormalIcon. -->
    <Style Selector="^:success /template/ Path#PART_Icon">
      <Setter Property="Data" Value="{DynamicResource FiliAlertSuccessGeometry}" />
    </Style>
    <Style Selector="^:warning /template/ Path#PART_Icon">
      <Setter Property="Data" Value="{DynamicResource FiliReportProblemGeometry}" />
    </Style>
    <Style Selector="^:error /template/ Path#PART_Icon">
      <Setter Property="Data" Value="{DynamicResource FiliErrorOutlineGeometry}" />
    </Style>
    <Style Selector="^.normal /template/ Path#PART_Icon">
      <Setter Property="Data" Value="{DynamicResource FiliEventNoteGeometry}" />
    </Style>

    <Style Selector="^.hide-icon /template/ Path#PART_Icon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.hide-close /template/ Button#PART_CloseButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliWindowNotificationManager" TargetType="WindowNotificationManager">
    <!-- .mud-snackbar-location-* sits 24px from whichever edges it is anchored to. -->
    <Setter Property="Margin" Value="24" />

    <Setter Property="Template">
      <ControlTemplate>
        <ReversibleStackPanel x:Name="PART_Items">
          <ReversibleStackPanel.DataTemplates>
            <DataTemplate DataType="INotification">
              <!-- .mud-snackbar-content-message: 8px above and below, none at the sides, because
                   the card's own 16px horizontal padding already provides those. -->
              <StackPanel Margin="0,8" Spacing="4">
                <TextBlock Text="{Binding Title}"
                           FontWeight="Medium"
                           LineHeight="20" />
                <TextBlock Text="{Binding Message}"
                           MaxHeight="80"
                           TextWrapping="Wrap"
                           FontWeight="Normal"
                           LineHeight="20" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="x:String">
              <TextBlock Text="{Binding}"
                         Margin="0,8"
                         TextWrapping="Wrap"
                         LineHeight="20" />
            </DataTemplate>
          </ReversibleStackPanel.DataTemplates>
        </ReversibleStackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:topleft /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:topright /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="^:topcenter /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:bottomleft /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:bottomright /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="^:bottomcenter /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="NotificationCard" BasedOn="{StaticResource FiliNotificationCard}" />
  <ControlTheme x:Key="{x:Type WindowNotificationManager}" TargetType="WindowNotificationManager" BasedOn="{StaticResource FiliWindowNotificationManager}" />

</ResourceDictionary>
