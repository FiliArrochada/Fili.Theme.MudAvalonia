<!--
  HyperlinkButton: MudLink.

  _link.scss is almost entirely about the underline, and the default is the interesting part:

    .mud-link-underline-none     text-decoration: none
    .mud-link-underline-hover    none, underlined on :hover, :focus-visible and :active
    .mud-link-underline-always   text-decoration: underline
    .mud-link-disabled           colour action-disabled, and no underline unless "always"
    icon-start / icon-end        margin 4px on the inner side

  MudLink.Underline defaults to Underline.Hover, so a bare link here is NOT underlined until the
  pointer is on it. Colour defaults to Color.Primary. Everything else - size, weight, spacing -
  is inherited from the surrounding text, which is why this theme sets no FontSize: a link inside
  body2 should be body2, and a link inside a heading should be the heading.

  The underline is TextBlock.TextDecorations set on the link itself. It is an inherited
  property, so it reaches the AccessText a string makes and any TextBlock the app puts in the
  content alike. A style reaching into the template for a TextBlock reached neither: the string's
  text is an AccessText, which a TextBlock type selector does not match, and the app's own text is
  not a template part, so no link was ever underlined.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliHyperlinkButton" TargetType="HyperlinkButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- MudLink's StartIcon and EndIcon, _link.scss: `.mud-link-icon-start` / `-end` at the
         link's own font size (font-size: inherit) and 4px from the text. An icon in the content
         marked `start-icon` or `end-icon` takes them (IconSlot). -->
    <Setter Property="theme:IconSlot.StartSize" Value="{Binding $self.FontSize}" />
    <Setter Property="theme:IconSlot.StartMargin" Value="0,0,4,0" />
    <Setter Property="theme:IconSlot.EndSize" Value="{Binding $self.FontSize}" />
    <Setter Property="theme:IconSlot.EndMargin" Value="4,0,0,0" />

    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Underline.Hover, the MudLink default. _link.scss puts :focus-visible and :active in the
         same rule as :hover, so a tabbed-to link underlines exactly like a hovered one - which is
         the only focus affordance a link gets, since _reset.scss drops the browser ring. -->
    <Style Selector="^:pointerover">
      <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>

    <!-- Underline.Always -->
    <Style Selector="^.underline">
      <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>

    <!-- Underline.None: still no underline when hovered. -->
    <Style Selector="^.no-underline:pointerover">
      <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
    </Style>
    <Style Selector="^.no-underline:focus-visible">
      <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
    </Style>
    <Style Selector="^.no-underline:pressed">
      <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
    </Style>

    <!-- MudLink's Color is `mud-{color}-text`: the palette colour as the text, primary by default. -->
    <!-- GENERATED by ThemeColourGenerator: link colours. -->
    <Style Selector="^.primary">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <!-- END GENERATED -->
    <!-- Color.Inherit: `color: inherit` - the surrounding text colour, bound because a
         ControlTheme setter cannot withdraw its own Foreground and fall back to inheriting. -->
    <Style Selector="^.inherit">
      <Setter Property="Foreground" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter TextBlock">
      <Setter Property="TextDecorations" Value="{x:Null}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type HyperlinkButton}" TargetType="HyperlinkButton" BasedOn="{StaticResource FiliHyperlinkButton}" />

</ResourceDictionary>
