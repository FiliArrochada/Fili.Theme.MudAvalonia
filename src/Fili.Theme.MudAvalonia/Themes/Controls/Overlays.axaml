<!--
  ToolTip, FlyoutPresenter and MenuFlyoutPresenter: the floating surfaces.

  These three were the FIRST themes in this package keyed by type, back when everything else was
  keyed by a class, and the reason is worth keeping: they are instantiated BY THE FRAMEWORK and
  have no markup site to carry a class at all. `ToolTip.Tip="text"` builds the ToolTip
  internally; `<Flyout>` builds its presenter.

  The rest of the package has since caught up - every theme is keyed by type now - so this file
  is no longer an exception to anything. It is just the place the argument was first made.

  A tooltip CAN carry a class, though: `ToolTip.Tip` takes a `ToolTip` as it is, so
  `<ToolTip.Tip><ToolTip Classes="primary arrow" Content="..." /></ToolTip.Tip>` is MudTooltip's
  `Color` and `Arrow`. The arrow's side depends on the popup's `Placement`, which only a Style in
  FiliTheme.axaml can see (a ControlTheme holds no child selector).

  Each theme below is declared once under a name, so the inventory and the readiness test can see
  it, and then aliased to its type key, which is what makes it take effect.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia"
                    xmlns:conv="using:Fili.Theme.MudAvalonia.Converters">

  <ControlTheme x:Key="FiliToolTip" TargetType="ToolTip">
    <!--
      Deliberately NOT theme-varying. A Material tooltip is a dark chip in light and dark alike -
      it reads as an annotation floating above the UI rather than as another surface of it. The
      palette has no slot for that, so FiliTooltipBackgroundBrush is declared outside the theme
      dictionaries in Palette.axaml, next to the elevation ladder which is non-varying for the
      same kind of reason.
    -->
    <Setter Property="Background" Value="{DynamicResource FiliTooltipBackgroundBrush}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliCaptionFontSize}" />
    <!-- `.mud-tooltip`: font-weight 500. -->
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="8,4" />
    <!-- No MaxWidth: `.mud-tooltip` sets none, so a long tooltip runs on until the viewport stops
         it. A popup measures its content against the screen, or the page in a browser, so the text
         wraps there and nowhere sooner. -->
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <!-- Top, Bottom, Left and Right centred on that side of the target, not Avalonia's 20px down. -->
    <Setter Property="theme:TooltipPlacement.Places" Value="True" />

    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <!--
            `.mud-tooltip-arrow::after`: a 6px CSS border triangle in the tooltip's colour, outside
            the edge that faces the target. FiliTheme.axaml docks and turns it for the four
            placements MudBlazor has, and hides it for Pointer. With the 4px beyond it, it is
            MudBlazor's 10px gap from the target, kept with or without `arrow`: without, it is
            transparent.
          -->
          <Path x:Name="PART_Arrow"
                IsVisible="False"
                DockPanel.Dock="Bottom"
                Width="12"
                Height="6"
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Fill"
                Fill="{TemplateBinding Background}"
                Data="M0,0 L12,0 L6,6 Z" />
          <theme:PartBorder Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <!-- `.mud-tooltip`: `line-height: 1.4em`, 16.8px at 12px, so a one-line chip is
                 4 + 16.8 + 4 = 24.8px, and `text-align: center` for the lines of a long one
                 (_tooltip.scss). Without them the text had its font's own 15px line, start-aligned. -->
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              TextBlock.TextWrapping="Wrap"
                              TextBlock.TextAlignment="Center"
                              TextBlock.LineHeight="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:FactorConverter.Instance}, ConverterParameter=1.4}" />
          </theme:PartBorder>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:not(.arrow) /template/ Path#PART_Arrow">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- `.mud-tooltip.mud-theme-{color}`: the colour and its contrast text; the arrow follows. -->
    <!-- GENERATED by ThemeColourGenerator: tooltip colours. -->
    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
    </Style>
    <!-- END GENERATED -->
  </ControlTheme>

  <!--
    MudPopover: `.mud-popover` and the paper it is - surface, the default radius, elevation 8 - and
    no padding: what sits in a popover brings its own, as `<MudPaper Class="pa-4">` does. A flyout
    whose content wants room sets Padding on the content or through FlyoutPresenterClasses.
  -->
  <ControlTheme x:Key="FiliFlyoutPresenter" TargetType="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />

    <Setter Property="Template">
      <ControlTemplate>
        <!--
          The margin is not decoration: BoxShadow draws OUTSIDE the border's bounds, and the
          popup window is sized to its content. Without room to spill into, the shadow is
          clipped away and the flyout reads as a flat rectangle.
        -->
        <theme:PartBorder x:Name="PART_Border" Margin="8"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource FiliElevation8}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>
    <!--
      MudPopover's Paper, Square, DropShadow and Elevation (MudPopover.razor.cs): `mud-paper` when
      Paper, `mud-paper-square` when Paper and Square, `mud-elevation-{Elevation}` when Paper and
      DropShadow, Elevation defaulting to 8. A flyout takes them through FlyoutPresenterClasses.
    -->
    <!-- GENERATED by ThemeColourGenerator: flyout elevation. -->
    <Style Selector="^.elevation0 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.elevation1 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation1}" />
    </Style>
    <Style Selector="^.elevation2 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation2}" />
    </Style>
    <Style Selector="^.elevation3 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation3}" />
    </Style>
    <Style Selector="^.elevation4 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
    </Style>
    <Style Selector="^.elevation5 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation5}" />
    </Style>
    <Style Selector="^.elevation6 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation6}" />
    </Style>
    <Style Selector="^.elevation7 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation7}" />
    </Style>
    <Style Selector="^.elevation8 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
    </Style>
    <Style Selector="^.elevation9 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation9}" />
    </Style>
    <Style Selector="^.elevation10 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation10}" />
    </Style>
    <Style Selector="^.elevation11 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation11}" />
    </Style>
    <Style Selector="^.elevation12 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation12}" />
    </Style>
    <Style Selector="^.elevation13 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation13}" />
    </Style>
    <Style Selector="^.elevation14 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation14}" />
    </Style>
    <Style Selector="^.elevation15 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation15}" />
    </Style>
    <Style Selector="^.elevation16 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation16}" />
    </Style>
    <Style Selector="^.elevation17 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation17}" />
    </Style>
    <Style Selector="^.elevation18 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation18}" />
    </Style>
    <Style Selector="^.elevation19 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation19}" />
    </Style>
    <Style Selector="^.elevation20 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation20}" />
    </Style>
    <Style Selector="^.elevation21 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation21}" />
    </Style>
    <Style Selector="^.elevation22 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation22}" />
    </Style>
    <Style Selector="^.elevation23 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation23}" />
    </Style>
    <Style Selector="^.elevation24 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation24}" />
    </Style>
    <Style Selector="^.elevation25 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation25}" />
    </Style>
    <!-- END GENERATED -->
    <!-- After the levels, as DropShadow="false" and Paper="false" leave no elevation class at all. -->
    <Style Selector="^.square /template/ theme|PartBorder#PART_Border">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^.flat /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <!-- Paper="false": no `.mud-paper`, so no surface, radius or shadow; the content is the popover. -->
    <Style Selector="^.no-paper /template/ theme|PartBorder#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliMenuFlyoutPresenter" TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliMenuItem}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />

    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Border" Margin="8"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource FiliElevation8}"
                Padding="0,4"
                MinWidth="112">
          <ItemsPresenter x:Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>
    <!--
      MudPopover's Paper, Square, DropShadow and Elevation (MudPopover.razor.cs): `mud-paper` when
      Paper, `mud-paper-square` when Paper and Square, `mud-elevation-{Elevation}` when Paper and
      DropShadow, Elevation defaulting to 8. A flyout takes them through FlyoutPresenterClasses.
    -->
    <!-- GENERATED by ThemeColourGenerator: menu flyout elevation. -->
    <Style Selector="^.elevation0 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.elevation1 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation1}" />
    </Style>
    <Style Selector="^.elevation2 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation2}" />
    </Style>
    <Style Selector="^.elevation3 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation3}" />
    </Style>
    <Style Selector="^.elevation4 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
    </Style>
    <Style Selector="^.elevation5 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation5}" />
    </Style>
    <Style Selector="^.elevation6 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation6}" />
    </Style>
    <Style Selector="^.elevation7 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation7}" />
    </Style>
    <Style Selector="^.elevation8 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
    </Style>
    <Style Selector="^.elevation9 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation9}" />
    </Style>
    <Style Selector="^.elevation10 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation10}" />
    </Style>
    <Style Selector="^.elevation11 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation11}" />
    </Style>
    <Style Selector="^.elevation12 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation12}" />
    </Style>
    <Style Selector="^.elevation13 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation13}" />
    </Style>
    <Style Selector="^.elevation14 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation14}" />
    </Style>
    <Style Selector="^.elevation15 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation15}" />
    </Style>
    <Style Selector="^.elevation16 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation16}" />
    </Style>
    <Style Selector="^.elevation17 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation17}" />
    </Style>
    <Style Selector="^.elevation18 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation18}" />
    </Style>
    <Style Selector="^.elevation19 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation19}" />
    </Style>
    <Style Selector="^.elevation20 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation20}" />
    </Style>
    <Style Selector="^.elevation21 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation21}" />
    </Style>
    <Style Selector="^.elevation22 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation22}" />
    </Style>
    <Style Selector="^.elevation23 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation23}" />
    </Style>
    <Style Selector="^.elevation24 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation24}" />
    </Style>
    <Style Selector="^.elevation25 /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation25}" />
    </Style>
    <!-- END GENERATED -->
    <!-- After the levels, as DropShadow="false" and Paper="false" leave no elevation class at all. -->
    <Style Selector="^.square /template/ theme|PartBorder#PART_Border">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^.flat /template/ theme|PartBorder#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <!-- Paper="false": no `.mud-paper`, so no surface, radius or shadow; the content is the popover. -->
    <Style Selector="^.no-paper /template/ theme|PartBorder#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
  </ControlTheme>

  <!-- The aliases that actually put the three in effect. -->
  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip" BasedOn="{StaticResource FiliToolTip}" />
  <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter" BasedOn="{StaticResource FiliFlyoutPresenter}" />
  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource FiliMenuFlyoutPresenter}" />

</ResourceDictionary>
