<!--
  ToolTip, FlyoutPresenter and MenuFlyoutPresenter: the floating surfaces.

  These three were the FIRST themes in this package keyed by type, back when everything else was
  keyed by a class, and the reason is worth keeping: they are instantiated BY THE FRAMEWORK and
  have no markup site to carry a class at all. `ToolTip.Tip="text"` builds the ToolTip
  internally; `<Flyout>` builds its presenter.

  The rest of the package has since caught up - every theme is keyed by type now - so this file
  is no longer an exception to anything. It is just the place the argument was first made.

  A tooltip CAN carry a class, though: `ToolTip.Tip` takes a `ToolTip` as it is, so
  `<ToolTip.Tip><ToolTip Classes="primary arrow" Content="..." /></ToolTip.Tip>` is MudTooltip's
  `Color` and `Arrow`. The arrow's side depends on the popup's `Placement`, which only a Style in
  FiliTheme.axaml can see (a ControlTheme holds no child selector).

  Each theme below is declared once under a name, so the inventory and the readiness test can see
  it, and then aliased to its type key, which is what makes it take effect.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliToolTip" TargetType="ToolTip">
    <!--
      Deliberately NOT theme-varying. A Material tooltip is a dark chip in light and dark alike -
      it reads as an annotation floating above the UI rather than as another surface of it. The
      palette has no slot for that, so FiliTooltipBackgroundBrush is declared outside the theme
      dictionaries in Palette.axaml, next to the elevation ladder which is non-varying for the
      same kind of reason.
    -->
    <Setter Property="Background" Value="{DynamicResource FiliTooltipBackgroundBrush}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliCaptionFontSize}" />
    <!-- `.mud-tooltip`: font-weight 500. -->
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="8,4" />
    <!-- No MaxWidth: `.mud-tooltip` sets none, so a long tooltip runs on until the viewport stops
         it. A popup measures its content against the screen, or the page in a browser, so the text
         wraps there and nowhere sooner. -->
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />

    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <!--
            `.mud-tooltip-arrow::after`: a 6px CSS border triangle in the tooltip's colour, outside
            the edge that faces the target. Hidden unless `arrow` is on and the placement is one
            of the four MudBlazor draws it for; FiliTheme.axaml docks and turns it. The 4px beyond
            it is the rest of MudBlazor's 10px gap.
          -->
          <Path x:Name="PART_Arrow"
                IsVisible="False"
                DockPanel.Dock="Bottom"
                Width="12"
                Height="6"
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Fill"
                Fill="{TemplateBinding Background}"
                Data="M0,0 L12,0 L6,6 Z" />
          <theme:PartBorder Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              TextBlock.TextWrapping="Wrap" />
          </theme:PartBorder>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <!-- `.mud-tooltip.mud-theme-{color}`: the colour and its contrast text; the arrow follows. -->
    <!-- GENERATED by ThemeColourGenerator: tooltip colours. -->
    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
    </Style>
    <!-- END GENERATED -->
  </ControlTheme>

  <ControlTheme x:Key="FiliFlyoutPresenter" TargetType="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />

    <Setter Property="Template">
      <ControlTemplate>
        <!--
          The margin is not decoration: BoxShadow draws OUTSIDE the border's bounds, and the
          popup window is sized to its content. Without room to spill into, the shadow is
          clipped away and the flyout reads as a flat rectangle.
        -->
        <theme:PartBorder x:Name="PART_Border" Margin="8"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource FiliElevation8}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="FiliMenuFlyoutPresenter" TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliMenuItem}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />

    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Border" Margin="8"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource FiliElevation8}"
                Padding="0,4"
                MinWidth="112">
          <ItemsPresenter x:Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- The aliases that actually put the three in effect. -->
  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip" BasedOn="{StaticResource FiliToolTip}" />
  <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter" BasedOn="{StaticResource FiliFlyoutPresenter}" />
  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource FiliMenuFlyoutPresenter}" />

</ResourceDictionary>
