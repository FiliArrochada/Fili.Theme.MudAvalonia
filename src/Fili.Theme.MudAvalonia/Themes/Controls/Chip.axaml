<!--
  Chip: MudChip, from _chip.scss and MudChip.razor.cs. Not a new control - a theme a Button or a
  ToggleButton takes with the `chip` class:

    <Button Classes="chip" Content="Action" />                 a clickable chip
    <ToggleButton Classes="chip primary" Content="Indie" />    a selectable one, in a chip set
    <ContentControl Classes="chip" Content="Indie" />          one that only shows a value

  The ContentControl is MudChip with neither OnClick nor Href: no `mud-clickable`, so no hover,
  focus, press, ripple or hand cursor, and it takes no focus. FiliStaticChip, at the foot.

  MudChip.Variant defaults to Variant.FILLED (through ChipSet), unlike every button, and Color to
  Color.Default: a grey action-disabled-background pill in text-primary. `outlined` and `text`
  switch the variant; a colour class is only a colour, as on Button; `small` and `large` are the
  24px and 40px chips.

    filled    the colour as fill, {color}-text on it; darkens on hover, focus and press
    outlined  a 1px line (lines-inputs with no colour, the colour otherwise), the colour's tint
    text      the colour at 6% as fill, the colour as text; 12% on hover, focus and press

  Selection is MudChip.GetVariant's swap: a SELECTED filled chip draws as text, a selected text
  chip draws as filled, and a selected outlined chip keeps its line and gains the colour's tint.
  ToggleButton.IsChecked is the selected state.

  The 12% hover of a text chip, `rgba(color, 0.12)`, has no palette token: it is drawn as the
  colour itself on the state layer at Opacity 0.12, which is the same thing.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliChip" TargetType="Button">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- `.mud-chip-size-medium`: 32px tall, a 16px radius, 14px type, 0 12px. -->
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <theme:PartBorder x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="Transparent" />
            <theme:PartBorder x:Name="PART_Ripple"
                    theme:Ripple.IsLayer="True"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <!-- The padding is the row's, so the check mark sits inside it, before the content. -->
            <DockPanel Margin="{TemplateBinding Padding}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <!-- MudChipSet's CheckMark: Icons.Material.Filled.Check where the chip's Icon goes, a
                   MudIcon at Size.Small with `.mud-chip-icon`'s gaps, in the chip's text colour. -->
              <Viewbox x:Name="PART_CheckMark"
                       DockPanel.Dock="Left"
                       Width="20" Height="20"
                       Margin="-4,0,4,0"
                       VerticalAlignment="Center"
                       IsVisible="False">
                <Path Width="24" Height="24"
                      Stretch="None"
                      Data="{DynamicResource FiliCheckGeometry}"
                      Fill="{Binding $parent[Button].Foreground}" />
              </Viewbox>
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </DockPanel>
          </Panel>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <!-- `check-mark`: MudChip.ShowCheckMark, selected in a CheckMark chip set. The check takes
         the place of the chip's own icon, which IconSlot hides while it shows; at the start
         icon's size, 18px small and 24px large. -->
    <Style Selector="^.check-mark:checked /template/ Viewbox#PART_CheckMark">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.check-mark:checked">
      <Setter Property="theme:IconSlot.StartHidden" Value="True" />
    </Style>
    <Style Selector="^.small /template/ Viewbox#PART_CheckMark">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="^.large /template/ Viewbox#PART_CheckMark">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="-6,0,6,0" />
    </Style>

    <!-- GENERATED by ThemeColourGenerator: chip variants, colours, selection and sizes. -->
    <!-- Filled, the default: action-disabled-background, chip-hover (action-disabled) on hover. -->
    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliChipHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliChipHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliChipHoverBrush}" />
    </Style>
    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.primary:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.primary:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.secondary:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.tertiary:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.tertiary:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.tertiary:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
    </Style>
    <Style Selector="^.info:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.info:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.info:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
    </Style>
    <Style Selector="^.success:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.success:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.success:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
    </Style>
    <Style Selector="^.warning:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.warning:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.warning:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
    </Style>
    <Style Selector="^.error:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.error:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.error:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
    </Style>
    <Style Selector="^.dark:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.dark:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.dark:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Outlined: lines-inputs or the colour as a 1px line, the tint on hover. -->
    <Style Selector="^.outlined">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliLinesInputsBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    </Style>
    <Style Selector="^.outlined:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.outlined:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.outlined:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.outlined:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.outlined:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.outlined:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.primary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.outlined.primary:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.primary:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.primary:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.info">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.outlined.info:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.info:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.info:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.success">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.outlined.success:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.success:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.success:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.warning">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.outlined.warning:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.warning:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.warning:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.error">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.outlined.error:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.error:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.error:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.dark">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.outlined.dark:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.dark:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.dark:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>

    <!-- Text: the colour at 6% as fill and the colour as text; 12% on hover. -->
    <Style Selector="^.text">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.text:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^.text:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^.text:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^.text:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text.primary">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.text.primary:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text.primary:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text.primary:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text.primary:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^.text.primary:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^.text.primary:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^.text.secondary">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.text.secondary:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text.secondary:focus-visible /template/ theme|PartBorder#PART_Root">
