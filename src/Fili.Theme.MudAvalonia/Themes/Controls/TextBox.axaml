<!--
  TextBox: the MudBlazor text field, in its three variants.

  STANDARD IS THE BASE, and that ordering mirrors _input.scss, where `.mud-input` carries the box
  model and `.mud-input-filled` / `.mud-input-outlined` are modifiers on top of it.
  MudTextField.Variant defaults to Variant.Text, so standard is also what a bare <TextBox/> gets -
  which is why it is the type-keyed default at the bottom of this file.

  Three things make the field, and none can be reached with setters:

    1. A LABEL THAT FLOATS, driven by :focus and :empty.
    2. AN UNDERLINE THAT ACTIVATES - a 1px resting rule with a 2px accent rule scaling out from
       the centre (_input.scss: transform scaleX(0) -> scaleX(1)).
    3. A FILL WITH ONLY TOP CORNERS ROUNDED, on the filled variant, which is what makes it read
       as paper resting on its rule rather than as a box.

  Transcribed from _input.scss and _inputlabel.scss:

    variant    content padding    label resting        label floated
    standard   6px 0 7px          translate(0, 24)     translate(0, 1.5)  scale(.75)
    filled     12px horizontal    translate(12, 20)    translate(12, 10)  scale(.75)
    outlined   14px horizontal    translate(14, 20)    translate(0, 1.5)  scale(.75)

  Two deliberate deviations, flagged because they are NOT transcriptions:

    * The label shrinks by FontSize 16 -> 12 rather than MudBlazor's scale(0.75) with
      transform-origin top-left. On 16px text those give the same 12px result, and FontSize keeps
      native hinting where a scale transform would blur the glyphs.
    * The outlined label masks the stroke with an opaque patch. MudBlazor cuts a real notch
      through a fieldset legend; Avalonia has no fieldset, and the mask only blends on
      FiliSurface.

  Margin.Dense is `dense`, from the .mud-input-root-margin-dense and .mud-input-label-margin-dense
  rules: standard loses 3px above the text, filled 4px above and below, outlined 8px above and
  below, and each label rests and floats correspondingly higher. The label is centred in the
  field, so its translations below are those deltas less half the change in height.

    variant    height     content margin     label resting    label floated
    standard   48 -> 45   0,20,0,7 -> 0,17,0,7     0 -> -1.5       -14 -> -12.5
    filled     56 -> 48   12,20,12,8 -> 12,16,12,4  0 -> 1         -10 -> -9
    outlined   56 -> 40   14,16,14,12 -> 14,8,14,4  0 -> 0         -26 -> -18

  PlaceholderText DOUBLES AS THE LABEL. Avalonia's TextBox has no Label property, and adding an
  attached one would be the first real API in a package whose point is not having any. The cost
  is that these variants have no separate placeholder.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fili="using:Fili.Theme.MudAvalonia.Converters"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <!-- Standard / Variant.Text: no fill, no box, just the rule. MudTextField's default. -->
  <ControlTheme x:Key="FiliStandardTextBox" TargetType="TextBox">
    <!-- Avalonia clips a TextBox to its bounds by default, and the outlined label floats onto the
         stroke - MudBlazor's translate(14px, -6px) - so its top 6px, mask and all, sat outside and
         were cut off. The text itself still scrolls inside PART_ScrollViewer, which clips on its
         own; nothing else in the template reaches past the field. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="MinWidth" Value="{DynamicResource FiliInputMinWidth}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="CaretBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="IBeam" />
    <!-- :start-adornment and :end-adornment, for the float condition and the gaps below. -->
    <Setter Property="theme:Adornments.Tracks" Value="True" />
    <!-- MudInput's AdornmentIcon is a MudIcon at IconSize Medium, 24px: an icon in
         InnerLeftContent marked `start-icon`, or in InnerRightContent marked `end-icon`, takes it
         (IconSlot). Its colour is the field's text, as MudBlazor's is. -->
    <Setter Property="theme:IconSlot.StartSize" Value="24" />
    <Setter Property="theme:IconSlot.EndSize" Value="24" />

    <Setter Property="Template">
      <ControlTemplate>
        <!--
          The helper line: MudInputControl's one row under the field. The error replaces the
          helper text on the left and the counter sits on the right, so each part carries its own
          3px top margin and an empty line takes no room at all.

          Helper text is AutomationProperties.HelpText, Avalonia's own attached property, so it
          needs no API of this package's and reaches a screen reader too, as MudBlazor wires
          HelperText into aria-describedby. The counter is the `counter` class over MaxLength:
          "12 / 50", or "12" when MaxLength is 0, MudBlazor's Counter="0".
        -->
        <DockPanel>
          <Grid x:Name="PART_HelperLine"
                DockPanel.Dock="Bottom"
                ColumnDefinitions="*,Auto"
                TextElement.Foreground="{DynamicResource FiliTextSecondaryBrush}">
            <ContentControl x:Name="PART_Errors"
                            Margin="0,3,0,0"
                            Content="{TemplateBinding (DataValidationErrors.Errors)}"
                            ContentTemplate="{DynamicResource FiliValidationErrorsTemplate}"
                            IsVisible="{TemplateBinding (DataValidationErrors.HasErrors)}" />
            <!-- The binding is on this Panel, not on the TextBlock: a {Binding} in a template
                 binds at LocalValue and outranks every style, so the error could not hide it. -->
            <Panel IsVisible="{Binding $parent[TextBox].(AutomationProperties.HelpText), Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock x:Name="PART_HelperText"
                         Margin="0,3,0,0"
                         FontFamily="{DynamicResource FiliFontFamily}"
                         FontSize="{DynamicResource FiliCaptionFontSize}"
                         FontWeight="Normal"
                         LineHeight="20"
                         LetterSpacing="0.4"
                         TextWrapping="Wrap"
                         Text="{TemplateBinding (AutomationProperties.HelpText)}" />
            </Panel>
            <StackPanel x:Name="PART_Counter" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,0" IsVisible="False">
              <TextBlock Text="{Binding $parent[TextBox].Text, Converter={x:Static fili:TextLengthConverter.Instance}}"
                         FontFamily="{DynamicResource FiliFontFamily}"
                         FontSize="{DynamicResource FiliCaptionFontSize}"
                         FontWeight="Normal"
                         LineHeight="20"
                         LetterSpacing="0.4" />
              <TextBlock x:Name="PART_CounterLimit"
                         FontFamily="{DynamicResource FiliFontFamily}"
                         FontSize="{DynamicResource FiliCaptionFontSize}"
                         FontWeight="Normal"
                         LineHeight="20"
                         LetterSpacing="0.4"
                         Text="{Binding $parent[TextBox].MaxLength, StringFormat=' / {0}'}" />
            </StackPanel>
          </Grid>
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                MinHeight="{TemplateBinding MinHeight}">
          <Panel>

            <!-- Named so the variants below can change the box model without a new template. -->
            <DockPanel x:Name="PART_ContentArea">
              <ContentPresenter x:Name="PART_InnerLeftContent"
                                Content="{TemplateBinding InnerLeftContent}"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center" />
              <ContentPresenter x:Name="PART_InnerRightContent"
                                Content="{TemplateBinding InnerRightContent}"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center" />
              <ScrollViewer x:Name="PART_ScrollViewer"
                            HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                            VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                <TextPresenter x:Name="PART_TextPresenter"
                               Text="{TemplateBinding Text, Mode=TwoWay}"
                               CaretIndex="{TemplateBinding CaretIndex}"
                               SelectionStart="{TemplateBinding SelectionStart}"
                               SelectionEnd="{TemplateBinding SelectionEnd}"
                               TextAlignment="{TemplateBinding TextAlignment}"
                               TextWrapping="{TemplateBinding TextWrapping}"
                               PasswordChar="{TemplateBinding PasswordChar}"
                               RevealPassword="{TemplateBinding RevealPassword}"
                               SelectionBrush="{TemplateBinding SelectionBrush}"
                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                               CaretBrush="{TemplateBinding CaretBrush}"
                               VerticalAlignment="Center" />
              </ScrollViewer>
            </DockPanel>

            <!-- The label's band. A single-line field's text is centred, and so is the label, in
                 the whole field. A multi-line field's text starts at the top, as a textarea's
                 does, and its band is then a single-line field's height at the top, so the label
                 stays above the first line rather than centred over the text. -->
            <Panel x:Name="PART_LabelArea">
              <!-- RenderTransform is written in the CSS-like form so TransformOperationsTransition
                   can interpolate it; a TranslateTransform object cannot be transitioned. The text
                   is PlaceholderText then the Tag, which `required` sets to MudBlazor's "*". -->
              <TextBlock x:Name="PART_FloatingLabel"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         IsHitTestVisible="False"
                         FontSize="{DynamicResource FiliBody1FontSize}"
                         LineHeight="NaN"
                         Foreground="{DynamicResource FiliTextSecondaryBrush}"
                         RenderTransform="translateY(0px)">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}{1}">
                    <Binding Path="PlaceholderText" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                  </MultiBinding>
                </TextBlock.Text>
                <TextBlock.Transitions>
                  <Transitions>
                    <DoubleTransition Property="FontSize" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                  </Transitions>
                </TextBlock.Transitions>
              </TextBlock>
            </Panel>

            <theme:PartBorder x:Name="PART_Underline"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource FiliLinesInputsBrush}" />

            <theme:PartBorder x:Name="PART_UnderlineActive"
                    Height="2"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource FiliPrimaryBrush}"
                    RenderTransformOrigin="50%,50%"
                    RenderTransform="scaleX(0)">
              <theme:PartBorder.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </theme:PartBorder.Transitions>
            </theme:PartBorder>

          </Panel>
        </theme:PartBorder>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <!--
      The content area's margin is a STYLE, not inline in the template, and so is everything else
      a variant moves. A literal written in a ControlTemplate binds at Template priority, which a
      plain `^ /template/` style in a derived theme cannot override - only one with an activator
      can. That is how filled and outlined fields shipped with none of their 12px / 14px
      horizontal padding while their `.dense` margins, which do carry an activator, applied fine.
    -->
    <Style Selector="^ /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="0,20,0,7" />
    </Style>
    <!-- Multi-line: the text from the top, and the label's band a single-line field's height
         above it. Each needs the activator: the presenter's alignment is inline in the template. -->
    <!-- The first line starts where a single-line field's text sits, centred in its content
         area: 1px down here, 4.5 filled, 3.5 outlined inside its stroke. Flush with the top, a
         filled field's first line met its floated label. -->
    <Style Selector="^[AcceptsReturn=True] /template/ TextPresenter#PART_TextPresenter">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="^[AcceptsReturn=True] /template/ Panel#PART_LabelArea">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Height" Value="48" />
    </Style>

    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_Underline">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultBrush}" />
    </Style>

    <Style Selector="^:focus /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="RenderTransform" Value="scaleX(1)" />
    </Style>

    <!-- The float condition: focused OR carrying content, or ShrinkLabel (`shrink-label`), or a
         start adornment (`:start-adornment`, from Adornments) - each of which is
         `.mud-shrink` or `:focus-within` in MudBlazor. Avalonia's :empty pseudo-class
         on TextBox is what makes the second one expressible in a selector at all. A shrunk label
         is text-primary (`.mud-shrink ~ label`), and primary while the field has focus, so focus
         comes second. -->
    <Style Selector="^:not(:empty) /template/ TextBlock#PART_FloatingLabel, ^.shrink-label /template/ TextBlock#PART_FloatingLabel, ^:start-adornment /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="FontSize" Value="{DynamicResource FiliCaptionFontSize}" />
      <Setter Property="RenderTransform" Value="translateY(-14px)" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    </Style>
    <Style Selector="^:focus /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="FontSize" Value="{DynamicResource FiliCaptionFontSize}" />
      <Setter Property="RenderTransform" Value="translateY(-14px)" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>

    <!-- Required: `.mud-input-required > … > .mud-input-label::after { content: "*" }`. -->
    <Style Selector="^.required /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Tag" Value="*" />
    </Style>

    <!-- Set on the TextBox, not on PART_TextPresenter: TextPresenter has no Foreground
         AvaloniaProperty of its own and a setter targeting the part fails with AVLN3000. -->
    <!-- `.mud-input.mud-disabled`, its label and its helper text: text-disabled. The line keeps
         lines-inputs and turns `border-bottom-style: dotted`. -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Underline">
      <Setter Property="OpacityMask">
        <!-- 1px on, 1px off: a 1px CSS dotted border. A mask, so the line keeps its colour and
             its other states: the brush holds no resource. -->
        <DrawingBrush TileMode="Tile" DestinationRect="0,0,2,1" SourceRect="0,0,2,1" Stretch="None" AlignmentX="Left" AlignmentY="Top">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Brush="Transparent" Geometry="M0,0 H2 V1 H0 Z" />
              <GeometryDrawing Brush="Black" Geometry="M0,0 H1 V1 H0 Z" />
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Setter>
    </Style>
    <Style Selector="^:disabled /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ TextBlock#PART_HelperText">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>

    <!--
      Two ways to be invalid, and both paint the same.

      `.error` is the class an app sets by hand - MudTextField's Error parameter. The attribute
      selector is the one that fires on its own, when a BINDING fails validation and Avalonia
      sets DataValidationErrors.HasErrors. Before this was here, a failing binding recoloured
      nothing: the app looked fine and the value was rejected silently.
    -->
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ theme|PartBorder#PART_Underline">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>

    <Style Selector="^.error /template/ theme|PartBorder#PART_Underline">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>

    <!-- Underline="false": `.mud-input-underline` is left off, so neither rule is drawn. -->
    <Style Selector="^.no-underline /template/ theme|PartBorder#PART_Underline">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.no-underline /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- The helper line's type is inline in the template, from _inputcontrol.scss's
         .mud-input-helper-text: caption size at weight 400, line-height 1.66 (20px), 0.03333em
         (0.4px) and text-secondary. In error the whole row takes the error colour, and the error
         takes the helper text's place. -->
    <Style Selector="^.counter /template/ StackPanel#PART_Counter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[MaxLength=0] /template/ TextBlock#PART_CounterLimit">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ TextBlock#PART_HelperText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.error /template/ TextBlock#PART_HelperText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- HelperTextOnFocus: `helper-on-focus`. The helper text keeps its room and shows only while
         the field has focus, as MudBlazor's slides into view inside a container that keeps its
         height. An error still takes its place. -->
    <Style Selector="^.helper-on-focus:not(:focus-within) /template/ TextBlock#PART_HelperText">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ Grid#PART_HelperLine">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error /template/ Grid#PART_HelperLine">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>

    <!-- Margin.Dense. -->
    <Style Selector="^.dense">
      <Setter Property="MinHeight" Value="45" />
    </Style>
    <Style Selector="^.dense /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="0,17,0,7" />
    </Style>
    <Style Selector="^.dense[AcceptsReturn=True] /template/ Panel#PART_LabelArea">
      <Setter Property="Height" Value="45" />
    </Style>
    <Style Selector="^.dense /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-1.5px)" />
    </Style>
    <Style Selector="^.dense:focus /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-12.5px)" />
    </Style>
    <Style Selector="^.dense:not(:empty) /template/ TextBlock#PART_FloatingLabel, ^.dense.shrink-label /template/ TextBlock#PART_FloatingLabel, ^.dense:start-adornment /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-12.5px)" />
    </Style>
    <!-- A NumericUpDown's spin column over the input box: `.mud-input-showspin` input
         padding-right: 24px from the box's edge, all of it here (SpinColumn.cs). -->
    <Style Selector="^:spin-end /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="0,0,24,0" />
    </Style>
    <Style Selector="^:spin-start /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="24,0,0,0" />
    </Style>
    <!-- `.mud-input-adornment-start` / `-end`: 8px between an adornment and the text; beside a
         spin column the adornment keeps the column's 24px too. -->
    <Style Selector="^:start-adornment /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="^:end-adornment /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="^:spin-end:end-adornment /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,0,24,0" />
    </Style>
    <Style Selector="^:spin-start:start-adornment /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="24,0,8,0" />
    </Style>

    <!-- No label, MudInput: no `mud-input-text-with-label`, so no 16px above the text - 6px and
         7px round a 21px line, 32px; dense, 3px above, 29px. Every variant derives from this one
         and so inherits these rules; each puts back its own below. -->
    <Style Selector="^:no-label">
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="^:no-label /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="0,4,0,7" />
    </Style>
    <Style Selector="^.dense:no-label">
      <Setter Property="MinHeight" Value="29" />
    </Style>
    <Style Selector="^.dense:no-label /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="0,1,0,7" />
    </Style>
  </ControlTheme>

  <!-- Filled: the standard field on a tinted sheet, top corners only. -->
  <ControlTheme x:Key="FiliFilledTextBox" TargetType="TextBox" BasedOn="{StaticResource FiliStandardTextBox}">
    <Setter Property="Background" Value="{DynamicResource FiliInputFilledBrush}" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="MinHeight" Value="56" />

    <Style Selector="^ /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="12,20,12,8" />
    </Style>
    <Style Selector="^[AcceptsReturn=True] /template/ Panel#PART_LabelArea">
      <Setter Property="Height" Value="56" />
    </Style>
    <Style Selector="^[AcceptsReturn=True] /template/ TextPresenter#PART_TextPresenter">
      <Setter Property="Margin" Value="0,4.5,0,0" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Margin" Value="12,0" />
    </Style>

    <!-- Filled floats 20 -> 10, a 10px rise. Standard travels further because it starts lower. -->
    <Style Selector="^:focus /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-10px)" />
    </Style>
    <Style Selector="^:not(:empty) /template/ TextBlock#PART_FloatingLabel, ^.shrink-label /template/ TextBlock#PART_FloatingLabel, ^:start-adornment /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-10px)" />
    </Style>

    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>

    <!-- MudInputControl's helper container is px-1 under a filled field. -->
    <Style Selector="^ /template/ Grid#PART_HelperLine">
      <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style Selector="^.dense">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="^.dense /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="12,16,12,4" />
    </Style>
    <Style Selector="^.dense[AcceptsReturn=True] /template/ Panel#PART_LabelArea">
      <Setter Property="Height" Value="48" />
    </Style>
    <Style Selector="^.dense /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(1px)" />
    </Style>
    <Style Selector="^.dense:focus /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-9px)" />
    </Style>
    <Style Selector="^.dense:not(:empty) /template/ TextBlock#PART_FloatingLabel, ^.dense.shrink-label /template/ TextBlock#PART_FloatingLabel, ^.dense:start-adornment /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-9px)" />
    </Style>
    <!-- A NumericUpDown's spin column over the input box: `.mud-input-showspin` input
         padding-right: 24px from the box's edge, which with the 12px of padding is 24 (SpinColumn.cs). -->
    <Style Selector="^:spin-end /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="^:spin-start /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <!-- `.mud-input-adornment-start` / `-end`: 8px between an adornment and the text; beside a
         spin column the adornment keeps the column's 12px too. The end adornment is centred on
         the box, not the text line: the filled padding is the input's, and `.mud-input` centres
         its children. The text area sits 12px further from the top than the bottom, in both
         densities, so the end adornment reaches 12px up. The start one stays on the text line,
         as `.mud-input-root-filled-shrink`'s margin-top keeps it. -->
    <Style Selector="^:start-adornment /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="^:end-adornment /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,-12,0,0" />
    </Style>
    <Style Selector="^:spin-end:end-adornment /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,-12,12,0" />
    </Style>
    <Style Selector="^:spin-start:start-adornment /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="12,0,8,0" />
    </Style>
    <!-- A text adornment, a unit such as "kg", stays on the text line it is read with: centred on
         the box it would sit above the value. A departure from `.mud-input`, which centres text
         and icons alike (Adornments.cs). -->
    <Style Selector="^:end-text-adornment /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="^:spin-end:end-text-adornment /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,0,12,0" />
    </Style>

    <!-- No label: `.mud-input-root-hidden-label`, 18px above and 19px below in place of 27 and
         10, the text centred in the same 56px; dense, 10 and 11 in place of 23 and 6. -->
    <Style Selector="^:no-label">
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="^:no-label /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="12,11,12,17" />
    </Style>
    <Style Selector="^.dense:no-label">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="^.dense:no-label /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="12,3,12,9" />
    </Style>
  </ControlTheme>

  <!-- Outlined: boxed, no rules at all, and the floated label sits on the stroke. -->
  <ControlTheme x:Key="FiliOutlinedTextBox" TargetType="TextBox" BasedOn="{StaticResource FiliStandardTextBox}">
    <Setter Property="BorderBrush" Value="{DynamicResource FiliLinesInputsBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="MinHeight" Value="56" />

    <Style Selector="^ /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="14,16,14,12" />
    </Style>
    <!-- The band is the inside of the stroke, which is 2px once focused: as tall as the box it
         was centred in before, so the label sits where it did and the field never grows. -->
    <Style Selector="^[AcceptsReturn=True] /template/ Panel#PART_LabelArea">
      <Setter Property="Height" Value="54" />
    </Style>
    <Style Selector="^[AcceptsReturn=True] /template/ TextPresenter#PART_TextPresenter">
      <Setter Property="Margin" Value="0,3.5,0,0" />
    </Style>
    <Style Selector="^[AcceptsReturn=True]:focus /template/ Panel#PART_LabelArea">
      <Setter Property="Height" Value="52" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Margin" Value="14,0" />
    </Style>

    <Style Selector="^ /template/ theme|PartBorder#PART_Underline">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^ /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
    </Style>
    <Style Selector="^:focus /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- The mask, and its limit: painted with FiliSurfaceBrush, so on any other ground the
         floated label sits on a visible rectangle of the wrong shade. -->
    <Style Selector="^:focus /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="RenderTransform" Value="translateY(-26px)" />
    </Style>
    <Style Selector="^:not(:empty) /template/ TextBlock#PART_FloatingLabel, ^.shrink-label /template/ TextBlock#PART_FloatingLabel, ^:start-adornment /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="RenderTransform" Value="translateY(-26px)" />
    </Style>

    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^.error /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>

    <!-- MudInputControl's helper container is px-2 under an outlined field. -->
    <Style Selector="^ /template/ Grid#PART_HelperLine">
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style Selector="^.dense">
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="^.dense /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="14,8,14,4" />
    </Style>
    <Style Selector="^.dense[AcceptsReturn=True] /template/ Panel#PART_LabelArea">
      <Setter Property="Height" Value="38" />
    </Style>
    <Style Selector="^.dense[AcceptsReturn=True]:focus /template/ Panel#PART_LabelArea">
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="^.dense /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="^.dense:focus /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-18px)" />
    </Style>
    <Style Selector="^.dense:not(:empty) /template/ TextBlock#PART_FloatingLabel, ^.dense.shrink-label /template/ TextBlock#PART_FloatingLabel, ^.dense:start-adornment /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-18px)" />
    </Style>
    <!-- A NumericUpDown's spin column over the input box: `.mud-input-showspin` input
         padding-right: 24px from the box's edge, which with the 14px of padding is 24 (SpinColumn.cs). -->
    <Style Selector="^:spin-end /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="^:spin-start /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <!-- `.mud-input-adornment-start` / `-end`: 8px between an adornment and the text; beside a
         spin column the adornment keeps the column's 10px too. Both are centred on the box, not
         the text line, as `.mud-input` centres them: the text area sits 4px further from the top
         than the bottom, in both densities, so they reach 4px up. -->
    <Style Selector="^:start-adornment /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="0,-4,8,0" />
    </Style>
    <Style Selector="^:end-adornment /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,-4,0,0" />
    </Style>
    <Style Selector="^:spin-end:end-adornment /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,-4,10,0" />
    </Style>
    <Style Selector="^:spin-start:start-adornment /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="10,-4,8,0" />
    </Style>
    <!-- A text adornment stays on the text line, as in the filled field. -->
    <Style Selector="^:start-text-adornment /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="^:end-text-adornment /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="^:spin-end:end-text-adornment /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,0,10,0" />
    </Style>
    <Style Selector="^:spin-start:start-text-adornment /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="10,0,8,0" />
    </Style>

    <!-- No label: the box is the same, its label's room being the 8px MudBlazor puts outside it,
         which this theme leaves to the layout. Its own values again, over the standard field's. -->
    <Style Selector="^:no-label">
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="^:no-label /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="14,16,14,12" />
    </Style>
    <Style Selector="^.dense:no-label">
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="^.dense:no-label /template/ DockPanel#PART_ContentArea">
      <Setter Property="Margin" Value="14,8,14,4" />
    </Style>
  </ControlTheme>

  <!-- MudTextField.Variant defaults to Variant.Text, so a bare TextBox is the standard field. -->
  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox" BasedOn="{StaticResource FiliStandardTextBox}" />

</ResourceDictionary>
