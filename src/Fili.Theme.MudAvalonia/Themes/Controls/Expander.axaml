<!--
  Expander: MudExpansionPanel.

  Transcribed from _expansionpanel.scss:

    .mud-expand-panel                colour text-primary, background surface
    .mud-expand-panel-header         min-height: 48px; padding: 16px 0; font-size: .9375rem
    .mud-expand-panel-header-gutters padding-left / padding-right: 24px   (on by default)
    header :focus-visible            background: action-default-hover
    .mud-expand-panel-icon           transition: .3s cubic-bezier(.25,.8,.5,1)
    .mud-expand-panel-icon.mud-transform  transform: rotate(-180deg)
    .mud-expand-panel-content        padding-bottom: 16px, gutters 24px
    .mud-expansion-panels            border-radius: the default radius
    MudExpansionPanel                mud-elevation-{group's Elevation}, 1 by default, on each panel

  .9375rem is 15px, which is neither body1 (16) nor body2 (14) - MudBlazor sizes this header on
  its own. It is written as a literal here for that reason, not pulled from the type scale.

  The panel carries the surface and the elevation because each MudExpansionPanel does: a bare
  expander on a page ground would otherwise have nothing to sit on. What is NOT carried over is
  the group behaviour - the 1px separators between stacked panels (Outlined, on by default) and
  the 16px margin an expanded one grows - because those are relationships between siblings, and
  an Avalonia Expander has no group to be a sibling in. The options that act on one panel are
  classes, at the foot of the theme.

  All four ExpandDirections are templated. MudBlazor only expands downward, so Up/Left/Right are
  the same parts rearranged rather than anything transcribed; templating them is what stops an
  app that uses one from getting a downward layout with the chevron pointing the wrong way.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="FiliExpanderToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="24,16" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_StateLayer" Background="Transparent" />
          <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{Binding $parent[Expander].HeaderTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

            <Path x:Name="PART_Chevron"
                  Grid.Column="1"
                  Margin="8,0,0,0"
                  Width="24" Height="24"
                  Stretch="None"
                  Data="{DynamicResource FiliExpandMoreGeometry}"
                  Fill="{DynamicResource FiliActionDefaultBrush}"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="50%,50%"
                  RenderTransform="rotate(0deg)">
              <Path.Transitions>
                <Transitions>
                  <!-- .3s cubic-bezier(.25,.8,.5,1), MudBlazor's own curve for this icon. -->
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3">
                    <TransformOperationsTransition.Easing>
                      <SplineEasing X1="0.25" Y1="0.8" X2="0.5" Y2="1" />
                    </TransformOperationsTransition.Easing>
                  </TransformOperationsTransition>
                </Transitions>
              </Path.Transitions>
            </Path>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <!-- Keyboard focus paints the hover layer. That IS the affordance in MudBlazor: _reset.scss
         drops the browser ring, and every component sets `:focus-visible` to the hover tint. -->
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>

    <!-- rotate(-180deg), not 180: the two land in the same place but spin opposite ways. -->
    <Style Selector="^:checked /template/ Path#PART_Chevron">
      <Setter Property="RenderTransform" Value="rotate(-180deg)" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!-- MudExpansionPanel.HideIcon: the same header with no chevron. A theme of its own, because
       `hide-icon` is on the Expander and the chevron is two templates down from it. -->
  <ControlTheme x:Key="FiliExpanderToggleNoIcon" TargetType="ToggleButton" BasedOn="{StaticResource FiliExpanderToggle}">
    <Style Selector="^ /template/ Path#PART_Chevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliExpander" TargetType="Expander">
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="Padding" Value="24,0,24,16" />
    <!-- Every TemplatedControl clips to its bounds in Avalonia 12, which would cut the shadow
         off at the edge it is drawn past. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="ContentTransition">
      <Setter.Value>
        <CrossFade Duration="0:0:0.25" />
      </Setter.Value>
    </Setter>

    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource FiliElevation1}">
          <Grid RowDefinitions="Auto,*">
            <ToggleButton x:Name="PART_toggle"
                          Grid.Row="0"
                          Theme="{StaticResource FiliExpanderToggle}"
                          Content="{TemplateBinding Header}"
                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Row="1"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              IsVisible="{TemplateBinding IsExpanded}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[ExpandDirection=Up]">
      <Setter Property="Padding" Value="24,16,24,0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource FiliElevation1}">
            <Grid RowDefinitions="*,Auto">
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Grid.Row="0"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                IsVisible="{TemplateBinding IsExpanded}" />
              <ToggleButton x:Name="PART_toggle"
                            Grid.Row="1"
                            Theme="{StaticResource FiliExpanderToggle}"
                            Content="{TemplateBinding Header}"
                            IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <!-- The chevron starts pointing up, so the resting and expanded rotations swap. -->
      <Style Selector="^ /template/ ToggleButton#PART_toggle /template/ Path#PART_Chevron">
        <Setter Property="RenderTransform" Value="rotate(-180deg)" />
      </Style>
      <Style Selector="^:expanded /template/ ToggleButton#PART_toggle /template/ Path#PART_Chevron">
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
      </Style>
    </Style>

    <Style Selector="^[ExpandDirection=Right]">
      <Setter Property="Padding" Value="0,16,24,16" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource FiliElevation1}">
            <Grid ColumnDefinitions="Auto,*">
              <ToggleButton x:Name="PART_toggle"
                            Grid.Column="0"
                            Theme="{StaticResource FiliExpanderToggle}"
                            Content="{TemplateBinding Header}"
                            IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Grid.Column="1"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                IsVisible="{TemplateBinding IsExpanded}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ ToggleButton#PART_toggle /template/ Path#PART_Chevron">
        <Setter Property="RenderTransform" Value="rotate(-90deg)" />
      </Style>
      <Style Selector="^:expanded /template/ ToggleButton#PART_toggle /template/ Path#PART_Chevron">
        <Setter Property="RenderTransform" Value="rotate(-180deg)" />
      </Style>
    </Style>

    <Style Selector="^[ExpandDirection=Left]">
      <Setter Property="Padding" Value="24,16,0,16" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource FiliElevation1}">
            <Grid ColumnDefinitions="*,Auto">
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Grid.Column="0"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                IsVisible="{TemplateBinding IsExpanded}" />
              <ToggleButton x:Name="PART_toggle"
                            Grid.Column="1"
                            Theme="{StaticResource FiliExpanderToggle}"
                            Content="{TemplateBinding Header}"
                            IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ ToggleButton#PART_toggle /template/ Path#PART_Chevron">
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
      </Style>
      <Style Selector="^:expanded /template/ ToggleButton#PART_toggle /template/ Path#PART_Chevron">
        <Setter Property="RenderTransform" Value="rotate(-180deg)" />
      </Style>
    </Style>

    <!--
      MudExpansionPanels' options, on the panel. Last, so they beat the ExpandDirection paddings
      above; each direction keeps its own sides.
        Elevation  elevation0 ... elevation25, `mud-elevation-{n}` on the panel; 1 by default
        Square     `square`: `.mud-expansion-panels-square`, no radius
        Dense      `dense`: `.mud-expand-panel-dense`, the content loses its 16px top and bottom
        Gutters    `no-gutters`: Gutters="false", the header and the content lose their 24px sides
    -->
    <!-- GENERATED by ThemeColourGenerator: expander elevation. -->
    <Style Selector="^.elevation0 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.elevation1 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation1}" />
    </Style>
    <Style Selector="^.elevation2 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation2}" />
    </Style>
    <Style Selector="^.elevation3 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation3}" />
    </Style>
    <Style Selector="^.elevation4 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
    </Style>
    <Style Selector="^.elevation5 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation5}" />
    </Style>
    <Style Selector="^.elevation6 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation6}" />
    </Style>
    <Style Selector="^.elevation7 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation7}" />
    </Style>
    <Style Selector="^.elevation8 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
    </Style>
    <Style Selector="^.elevation9 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation9}" />
    </Style>
    <Style Selector="^.elevation10 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation10}" />
    </Style>
    <Style Selector="^.elevation11 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation11}" />
    </Style>
    <Style Selector="^.elevation12 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation12}" />
    </Style>
    <Style Selector="^.elevation13 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation13}" />
    </Style>
    <Style Selector="^.elevation14 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation14}" />
    </Style>
    <Style Selector="^.elevation15 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation15}" />
    </Style>
    <Style Selector="^.elevation16 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation16}" />
    </Style>
    <Style Selector="^.elevation17 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation17}" />
    </Style>
    <Style Selector="^.elevation18 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation18}" />
    </Style>
    <Style Selector="^.elevation19 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation19}" />
    </Style>
    <Style Selector="^.elevation20 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation20}" />
    </Style>
    <Style Selector="^.elevation21 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation21}" />
    </Style>
    <Style Selector="^.elevation22 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation22}" />
    </Style>
    <Style Selector="^.elevation23 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation23}" />
    </Style>
    <Style Selector="^.elevation24 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation24}" />
    </Style>
    <Style Selector="^.elevation25 /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation25}" />
    </Style>
    <!-- END GENERATED -->
    <Style Selector="^.square">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^.dense">
      <Setter Property="Padding" Value="24,0,24,0" />
    </Style>
    <Style Selector="^.no-gutters">
      <Setter Property="Padding" Value="0,0,0,16" />
    </Style>
    <Style Selector="^.dense.no-gutters">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^[ExpandDirection=Up].dense">
      <Setter Property="Padding" Value="24,0,24,0" />
    </Style>
    <Style Selector="^[ExpandDirection=Up].no-gutters">
      <Setter Property="Padding" Value="0,16,0,0" />
    </Style>
    <Style Selector="^[ExpandDirection=Up].dense.no-gutters">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^[ExpandDirection=Right].dense">
      <Setter Property="Padding" Value="0,0,24,0" />
    </Style>
    <Style Selector="^[ExpandDirection=Right].no-gutters">
      <Setter Property="Padding" Value="0,16,0,16" />
    </Style>
    <Style Selector="^[ExpandDirection=Right].dense.no-gutters">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^[ExpandDirection=Left].dense">
      <Setter Property="Padding" Value="24,0,0,0" />
    </Style>
    <Style Selector="^[ExpandDirection=Left].no-gutters">
      <Setter Property="Padding" Value="0,16,0,16" />
    </Style>
    <Style Selector="^[ExpandDirection=Left].dense.no-gutters">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^.no-gutters /template/ ToggleButton#PART_toggle">
      <Setter Property="Padding" Value="0,16" />
    </Style>

    <Style Selector="^.hide-icon /template/ ToggleButton#PART_toggle">
      <Setter Property="Theme" Value="{StaticResource FiliExpanderToggleNoIcon}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander" BasedOn="{StaticResource FiliExpander}" />

</ResourceDictionary>
