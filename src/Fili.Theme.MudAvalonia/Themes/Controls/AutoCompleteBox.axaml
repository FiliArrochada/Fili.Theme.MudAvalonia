<!--
  AutoCompleteBox: MudAutocomplete.

  Like MudSelect, MudAutocomplete has no box model of its own - it is a MudInput with a popup of
  MudListItems under it. Both halves are already themed: the inner TextBox wears
  Controls/TextBox.axaml and the inner ListBox wears Controls/ListBox.axaml.

  The field's options are the text field's classes - `filled`, `outlined`, `dense`, `error`,
  `counter`, `helper-on-focus` - set on the AutoCompleteBox and mirrored onto the TextBox inside
  by FieldClasses, which also gets the helper text; a class on the outer control would not reach
  it otherwise.

  So this theme exists for the third thing, which neither of those covers: the popup SURFACE.
  MudBlazor renders it through MudPopover, which is a MudPaper - surface colour, the default 4px
  radius and elevation 8, the same drop the select and the menu use. The substrate's version is a
  1px grey rectangle with no shadow, which reads as a different component entirely. And the
  drop-down arrow MudAutocomplete adds as its end adornment, which an AutoCompleteBox has none of.

  PART_TextBox, PART_Popup and PART_SelectingItemsControl are all required by name.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliAutoCompleteBox" TargetType="AutoCompleteBox">
    <!-- Avalonia clips this control to its bounds, and the outlined label of the text field
         inside it floats onto the stroke, 6px above the field, as a TextBox's does. Clipped, its
         top was cut off. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="MinWidth" Value="{DynamicResource FiliInputMinWidth}" />
    <!-- MudAutocomplete.MaxHeight defaults to 300; Avalonia's to 200. -->
    <Setter Property="MaxDropDownHeight" Value="300" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <!-- MudAutocomplete.MinCharacters defaults to 0, so the arrow opens the whole list over an
         empty field; Avalonia's MinimumPrefixLength defaults to 1, which refuses to open. A
         setter, so an app's own value still wins. -->
    <Setter Property="MinimumPrefixLength" Value="0" />
    <!-- MudAutocomplete's Adornment.End: OpenIcon ArrowDropDown, CloseIcon ArrowDropUp while open,
         in the clickable adornment's MudIconButton - Edge.End, action-default, tabindex -1 - which
         toggles the list (AutoCompleteField). Pulled into the text line as the date picker's
         button is. A setter, built per field, so an app's own InnerRightContent replaces it and
         InnerRightContent="{x:Null}" is Adornment.None. The glyphs are the select's two keys, so
         FiliArrowDropDownGeometry in the field's Resources is AdornmentIcon with the toggle kept.
         Raw to automation: the AutoCompleteBox's own peer already expands and collapses, and an
         icon has no name to give a second control. Disabled, its colour is FiliTheme.axaml's. -->
    <Setter Property="InnerRightContent">
      <Template>
        <Button Name="PART_DropDownArrow"
                Classes="icon"
                Margin="0,-14,-12,-14"
                Focusable="False"
                AutomationProperties.AccessibilityView="Raw"
                theme:AutoCompleteField.TogglesDropDown="True">
          <Panel>
            <PathIcon Data="{DynamicResource FiliArrowDropDownGeometry}"
                      IsVisible="{Binding !$parent[AutoCompleteBox].IsDropDownOpen}" />
            <PathIcon Data="{DynamicResource FiliArrowDropUpGeometry}"
                      IsVisible="{Binding $parent[AutoCompleteBox].IsDropDownOpen}" />
          </Panel>
        </Button>
      </Template>
    </Setter>

    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- No Background or BorderThickness here: a local value would beat the filled and
               outlined variants' own, and the standard field's are already none. -->
          <TextBox x:Name="PART_TextBox"
                   theme:FieldClasses.Mirrors="True"
                   theme:AutoCompleteField.IsSelectInput="True"
                   AutomationProperties.HelpText="{TemplateBinding (AutomationProperties.HelpText)}"
                   Padding="{TemplateBinding Padding}"
                   CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                   ClearSelectionOnLostFocus="{TemplateBinding ClearSelectionOnLostFocus}"
                   DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                   PlaceholderText="{TemplateBinding PlaceholderText}"
                   MaxLength="{TemplateBinding MaxLength}"
                   InnerLeftContent="{TemplateBinding InnerLeftContent}"
                   InnerRightContent="{TemplateBinding InnerRightContent}" />

          <Popup x:Name="PART_Popup"
                 MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                 MaxHeight="{TemplateBinding MaxDropDownHeight}"
                 IsLightDismissEnabled="True"
                 WindowManagerAddShadowHint="False"
                 PlacementTarget="{TemplateBinding}">
            <theme:PartBorder x:Name="PART_PopupBorder" Background="{DynamicResource FiliSurfaceBrush}"
                    CornerRadius="{DynamicResource FiliCornerRadius}"
                    BoxShadow="{DynamicResource FiliElevation8}"
                    Margin="8">
              <ListBox x:Name="PART_SelectingItemsControl"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{TemplateBinding Foreground}"
                       ItemTemplate="{TemplateBinding ItemTemplate}"
                       ScrollViewer.IsScrollChainingEnabled="False"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </theme:PartBorder>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type AutoCompleteBox}" TargetType="AutoCompleteBox" BasedOn="{StaticResource FiliAutoCompleteBox}" />

</ResourceDictionary>
