<!--
  TreeView and TreeViewItem: MudTreeView.

  Transcribed from _treeview.scss:

    .mud-treeview              margin: 0; padding: 0; overflow: auto
    .mud-treeview-group        margin-left: 17px          (the per-level indent)
    .mud-treeview-item         min-height: 2rem           (32px)
    .mud-treeview-item-content padding: 4px 8px;
                               transition: background-color 150ms cubic-bezier(.4,0,.2,1)
    .mud-treeview-hover        ... .mud-treeview-item-content:hover
                               background: action-default-hover (Hover, off by default)
    selected                   colour <palette colour>, background <that colour>-hover
    .mud-treeview-item-arrow   width: 2rem; margin: 0 4px; min-height: 32px
    arrow .mud-icon-button     padding: 4px
    arrow expanded             transform: rotate(90deg)
    disabled                   colour action-disabled

  Two details that are easy to get wrong:

  The arrow ROTATES 90 DEGREES, not 180, because MudTreeView's ExpandButtonIcon is ChevronRight -
  it points right when closed and down when open. An expansion panel's chevron points down already
  and turns through 180. Reusing one glyph for both reads as a different component.

  Selection is the MudList rule again: the label takes the colour and the ground takes that colour
  at 6%. Not a filled bar, and not the grey hover tint either.

  The INDENT is Avalonia's mechanism rather than MudBlazor's. A TreeViewItem does not nest its
  children's margins; it multiplies its own Level by an indent resource through
  TreeViewItemIndentConverter. So the 17px goes in a resource this file declares, and every level
  gets Level x 17 of left margin from one binding.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia"
                    xmlns:converters="using:Avalonia.Controls.Converters">

  <!-- .mud-treeview-group margin-left. Declared here rather than reused from the forked base,
       whose own TreeViewItemIndent is 16 and is not in scope from this dictionary. -->
  <x:Double x:Key="FiliTreeViewItemIndent">17</x:Double>

  <!-- The disclosure arrow: a 32px column with a 24px glyph in it, per .mud-treeview-item-arrow. -->
  <ControlTheme x:Key="FiliTreeViewChevron" TargetType="ToggleButton">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Width" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <theme:PartBorder x:Name="PART_StateLayer"
                  Background="Transparent"
                  CornerRadius="16" />
          <theme:PartBorder x:Name="PART_Ripple"
                  theme:Ripple.IsLayer="True"
                  CornerRadius="16" />
          <Path x:Name="PART_Chevron"
                Width="24" Height="24"
                Stretch="None"
                Data="{DynamicResource FiliChevronRightGeometry}"
                Fill="{DynamicResource FiliActionDefaultBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="50%,50%"
                RenderTransform="rotate(0deg)">
            <Path.Transitions>
              <Transitions>
                <!-- .3s cubic-bezier(.25,.8,.5,1), the same curve the expansion panel uses. -->
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3">
                  <TransformOperationsTransition.Easing>
                    <SplineEasing X1="0.25" Y1="0.8" X2="0.5" Y2="1" />
                  </TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
              </Transitions>
            </Path.Transitions>
          </Path>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Path#PART_Chevron">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliTreeViewItem" TargetType="TreeViewItem">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="32" />

    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <theme:PartBorder x:Name="SelectionBorder"
                  Background="{TemplateBinding Background}"
                  MinHeight="{TemplateBinding MinHeight}"
                  Focusable="True"
                  TemplatedControl.IsTemplateFocusTarget="True">
            <theme:PartBorder.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
              </Transitions>
            </theme:PartBorder.Transitions>

            <Panel>
              <theme:PartBorder x:Name="PART_Ripple" theme:Ripple.IsLayer="True" />
              <!-- Level x 17px of left margin. Avalonia computes it; the converter is the framework's
                   own, and without it every level would sit at the same indent. -->
              <Grid x:Name="PART_Header" ColumnDefinitions="Auto,Auto,*">
                <Grid.Margin>
                  <MultiBinding Converter="{x:Static converters:TreeViewItemIndentConverter.Instance}">
                    <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}" />
                    <DynamicResource ResourceKey="FiliTreeViewItemIndent" />
                  </MultiBinding>
                </Grid.Margin>

                <ToggleButton x:Name="PART_ExpandCollapseChevron"
                              Grid.Column="0"
                              Focusable="False"
                              Theme="{StaticResource FiliTreeViewChevron}"
                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />

                <!--
                  MudTreeView's MultiSelection checkbox, shown by `multi-selection` on the TreeView
                  (FiliTheme.axaml): `.mud-treeview-item-checkbox` pads its icon button 4px, so 32px
                  (24 dense). A click on it is a click on the row.
                -->
                <Panel x:Name="PART_CheckBox"
                       Grid.Column="1"
                       IsVisible="False"
                       Width="32" Height="32"
                       VerticalAlignment="Center">
                  <Ellipse x:Name="PART_CheckHalo" Fill="Transparent" />
                  <Path x:Name="PART_CheckUnchecked"
                        Width="24" Height="24"
                        Stretch="None"
                        Data="{DynamicResource FiliCheckBoxUncheckedGeometry}"
                        Fill="{DynamicResource FiliActionDefaultBrush}"
                        FlowDirection="LeftToRight"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                  <Path x:Name="PART_CheckChecked"
                        Width="24" Height="24"
                        Stretch="None"
                        Data="{DynamicResource FiliCheckBoxCheckedGeometry}"
                        Fill="{DynamicResource FiliActionDefaultBrush}"
                        FlowDirection="LeftToRight"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="False" />
                </Panel>

                <ContentPresenter x:Name="PART_HeaderPresenter"
                                  Grid.Column="2"
                                  Background="Transparent"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  VerticalAlignment="Center"
                                  Focusable="False" />
              </Grid>
            </Panel>
          </theme:PartBorder>

          <ItemsPresenter x:Name="PART_ItemsPresenter"
                          IsVisible="{TemplateBinding IsExpanded}"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <!-- A leaf has nothing to disclose, so it keeps the arrow's 40px slot for alignment and hides
         the glyph: MudBlazor renders an empty `.mud-treeview-item-arrow` there, 2rem with 4px
         either side. Transparent, not collapsed, or a leaf's text would sit left of its siblings'. -->
    <Style Selector="^[ItemCount=0] /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="^:focus-visible /template/ theme|PartBorder#SelectionBorder">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>

    <Style Selector="^:selected /template/ theme|PartBorder#SelectionBorder">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!-- The tree without a text colour: the plain tree sets text-primary, the nav menu inherits. -->
  <ControlTheme x:Key="FiliTreeViewBase" TargetType="TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliTreeViewItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />

    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
            <ItemsPresenter x:Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="{TemplateBinding Padding}" />
          </ScrollViewer>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <!-- The `hover` class's row tint is a Style in FiliTheme.axaml: it reaches from the tree to
         its items, and a ControlTheme may not hold a descendant selector. -->

    <!-- Same opt-in as the list: a tree inside a drawer already has a ground. -->
    <Style Selector="^.paper">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliTreeView" TargetType="TreeView" BasedOn="{StaticResource FiliTreeViewBase}">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
  </ControlTheme>

  <!--
    `nav` on a TreeView: MudNavMenu. A link is a row without children and the active link is the
    selected row; a group (MudNavGroup) is a row with children, expanded by a click anywhere on
    it. From _navmenu.scss:

      .mud-nav-link            padding: 8px 16px; line-height: 1.75; font-weight: 400
      .mud-nav-link-text       margin-inline-start: 12px; letter-spacing: 0
      :hover, :focus-visible   action-default-hover
      .active                  font-weight: 500; the navmenu's colour as the text over its
                               hover tint, primary over action-default-hover by default, and the
                               colour at 12% under the pointer
      .mud-nav-link-icon       drawer-icon, the navmenu's colour when active
      .mud-nav-link-expand-icon  ExpandMore in drawer-icon, turned 180 degrees and in the
                               colour once open
      .mud-nav-group > link    font-weight 500; a nested group's title 400 until it opens
      nested                   links in a group start at 36px, then 48, 60 and 72

    The indent is the row's Level: 16px plus 20, 32, 44 or 56. `dense`, `rounded`, `bordered`
    and the colours are Styles in FiliTheme.axaml, where they reach from the tree to its rows.
  -->
  <ControlTheme x:Key="FiliNavGroupToggle" TargetType="ToggleButton">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_StateLayer"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <theme:PartBorder x:Name="PART_Ripple"
                  theme:Ripple.IsLayer="True"
                  CornerRadius="{TemplateBinding CornerRadius}" />
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliNavItem" TargetType="TreeViewItem">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <!-- No Foreground: `.mud-nav-link` is `color: inherit`, so a link is the drawer's text colour,
         drawer-text or a coloured drawer's contrast text, and text-primary outside a drawer. -->
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <Panel>
            <!-- The row's ground; its child takes the pointer, so the whole row tints. -->
            <theme:PartBorder x:Name="SelectionBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Focusable="True"
                    TemplatedControl.IsTemplateFocusTarget="True">
              <theme:PartBorder.Transitions>
                <Transitions>
                  <!-- background-color 250ms cubic-bezier(0.4, 0, 0.2, 1) -->
                  <BrushTransition Property="Background" Duration="0:0:0.25" />
                </Transitions>
              </theme:PartBorder.Transitions>
              <theme:PartBorder x:Name="PART_Tint"
                      Background="Transparent"
                      CornerRadius="{TemplateBinding CornerRadius}">
                <theme:PartBorder x:Name="PART_Ripple"
                        theme:Ripple.IsLayer="True"
                        CornerRadius="{TemplateBinding CornerRadius}" />
              </theme:PartBorder>
            </theme:PartBorder>

            <Grid x:Name="PART_Header"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="{TemplateBinding Padding}"
                  IsHitTestVisible="False">
              <theme:PartBorder x:Name="PART_Indent" Grid.Column="0" Width="0" />
              <!-- `.mud-nav-link`'s line-height is 1.75, a 28px line whatever the header holds: a
                   control written in the Header is not styled from here, so the floor is the
                   presenter's, and every row is 44px. -->
              <ContentPresenter x:Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                MinHeight="28"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                FontWeight="Normal"
                                LetterSpacing="0"
                                VerticalAlignment="Center">
                <ContentPresenter.Styles>
                  <!-- `.mud-nav-link-text` wraps a label too long for the drawer. -->
                  <Style Selector="TextBlock">
                    <Setter Property="LineHeight" Value="28" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </ContentPresenter.Styles>
              </ContentPresenter>
              <Path x:Name="PART_ExpandIcon"
                    Grid.Column="2"
                    Width="24" Height="24"
                    Stretch="None"
                    Data="{DynamicResource FiliExpandMoreGeometry}"
                    Fill="{DynamicResource FiliDrawerIconBrush}"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="50%,50%"
                    RenderTransform="rotate(0deg)">
                <Path.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3">
                      <TransformOperationsTransition.Easing>
                        <SplineEasing X1="0.25" Y1="0.8" X2="0.5" Y2="1" />
                      </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                  </Transitions>
                </Path.Transitions>
              </Path>
            </Grid>

            <!-- A group opens on a click anywhere on its row, as MudNavGroup does. -->
            <ToggleButton x:Name="PART_ExpandCollapseChevron"
                          Theme="{StaticResource FiliNavGroupToggle}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
          </Panel>

          <ItemsPresenter x:Name="PART_ItemsPresenter"
                          IsVisible="{TemplateBinding IsExpanded}"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <!-- A link has nothing to open: no arrow, and the row is the link's own. -->
    <Style Selector="^[ItemCount=0] /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[ItemCount=0] /template/ Path#PART_ExpandIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- MudNavGroup.HideExpandIcon: `hide-icon` on the group's row. -->
    <Style Selector="^.hide-icon /template/ Path#PART_ExpandIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[IsExpanded=True] /template/ Path#PART_ExpandIcon">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>

    <!-- The indent beyond the 16px padding, by depth: 36, 48, 60 and 72px in all. -->
    <Style Selector="^[Level=1] /template/ theme|PartBorder#PART_Indent">
      <Setter Property="Width" Value="20" />
    </Style>
    <Style Selector="^[Level=2] /template/ theme|PartBorder#PART_Indent">
      <Setter Property="Width" Value="32" />
    </Style>
    <Style Selector="^[Level=3] /template/ theme|PartBorder#PART_Indent">
      <Setter Property="Width" Value="44" />
    </Style>
    <Style Selector="^[Level=4] /template/ theme|PartBorder#PART_Indent">
      <Setter Property="Width" Value="56" />
    </Style>

    <!-- A top-level group's title is 500; a nested group's is 400 until it opens. -->
    <Style Selector="^[Level=0]:not(:empty) /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="^[IsExpanded=True]:not(:empty) /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="^ /template/ theme|PartBorder#PART_Tint:pointerover">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ theme|PartBorder#SelectionBorder">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>

    <!-- The active link: 500, primary over action-default-hover, which hovering keeps. -->
    <Style Selector="^:selected /template/ theme|PartBorder#SelectionBorder">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^:selected /template/ theme|PartBorder#PART_Tint:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_ExpandIcon">
      <Setter Property="Fill" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!-- MudDrawer scrolls up and down, never sideways: the menu lays out at the drawer's width, and
       a label too long for it wraps rather than pushing the row past the edge. -->
  <ControlTheme x:Key="FiliNavMenu" TargetType="TreeView" BasedOn="{StaticResource FiliTreeViewBase}">
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TreeView}" TargetType="TreeView" BasedOn="{StaticResource FiliTreeView}" />
  <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem" BasedOn="{StaticResource FiliTreeViewItem}" />

</ResourceDictionary>
