<!--
  RadioButton, re-derived from MudBlazor.

  Same correction as CheckBox: MudRadio renders Material icon glyphs
  (RadioButtonChecked / RadioButtonUnchecked) rather than drawing a ring and a disc.

  That difference is not cosmetic here. The earlier hand-drawn version grew a separate inner
  disc with a scale transition - which reads well, but is not what MudBlazor does. The checked
  glyph is one path containing both ring and dot, so selection is a glyph swap and a colour
  change, with no independent animation.

  Transcribed from:
    Components/Radio/MudRadio.razor.cs   the two icon constants
    Styles/components/_radio.scss        padding: 4px around the icon
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliRadioButton" TargetType="RadioButton">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">

          <!-- Size scales the glyph: MudIcon is 20 / 24 / 36px. The halo is the box, sized below. -->
          <Panel x:Name="PART_Box" Grid.Column="0" Width="48" Height="48">

            <Ellipse x:Name="PART_StateLayer" Fill="Transparent" />
            <!-- The ripple, clipped to the halo: every corner is clamped to half the box. -->
            <theme:PartBorder x:Name="PART_Ripple" theme:Ripple.IsLayer="True" CornerRadius="999" />

            <LayoutTransformControl x:Name="PART_Scale"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
              <Panel>
                <Path x:Name="PART_Unchecked"
                      Width="24" Height="24"
                      Stretch="None"
                      Data="{DynamicResource FiliRadioUncheckedGeometry}"
                      Fill="{DynamicResource FiliActionDefaultBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

                <Path x:Name="PART_Checked"
                      Width="24" Height="24"
                      Stretch="None"
                      Data="{DynamicResource FiliRadioCheckedGeometry}"
                      Fill="{DynamicResource FiliActionDefaultBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="False" />
              </Panel>
            </LayoutTransformControl>
          </Panel>

          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Path#PART_Unchecked">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked /template/ Path#PART_Checked">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The icon button round the glyph: `.mud-icon-button` pads it 12px at every size, so the halo is
         44 / 48 / 60px for a 20 / 24 / 36px glyph; `.mud-radio-dense` pads it 4px, so 28 / 32 / 44. -->
    <Style Selector="^.small /template/ Panel#PART_Box">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
    </Style>
    <Style Selector="^.large /template/ Panel#PART_Box">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="60" />
    </Style>
    <Style Selector="^.dense /template/ Panel#PART_Box">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="^.dense.small /template/ Panel#PART_Box">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="^.dense.large /template/ Panel#PART_Box">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
    </Style>

    <!--
      MudRadio.LabelPlacement, `.mud-input-content-placement-*`: `label-start` is row-reverse, the
      label before the glyph; `label-top` column-reverse and `label-bottom` column, the two centred
      on each other. End, the default, needs no class.
    -->
    <Style Selector="^.label-start /template/ Panel#PART_Box">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^.label-start /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="^.label-top /template/ Panel#PART_Box">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.label-bottom /template/ Panel#PART_Box">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.label-top /template/ ContentPresenter#PART_ContentPresenter, ^.label-bottom /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.label-bottom /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Row" Value="1" />
    </Style>

    <!-- GENERATED by ThemeColourGenerator: radio colours and sizes. -->
    <!-- No colour: the action-default halo. -->
    <Style Selector="^:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>

    <!-- Colours: every glyph, checked or not, the halo, and the ripple (`.mud-{color}-text`'s
         ripple colour). With no colour the ripple is text-primary, the control's own. -->
    <Style Selector="^.primary /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.secondary /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.tertiary /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.info /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.success /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.warning /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.error /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.dark /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>

    <!-- UncheckedColor: `unchecked-{colour}`, the colour of the glyph and its halo while NOT
         checked (MudCheckBox: false or null), in place of the colour class. -->
    <Style Selector="^.unchecked-primary /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:unchecked:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:unchecked:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:unchecked:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:unchecked /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:unchecked:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:unchecked:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:unchecked:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:unchecked /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:unchecked:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:unchecked:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:unchecked:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:unchecked /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-info /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:unchecked:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:unchecked:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:unchecked:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:unchecked /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.unchecked-success /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:unchecked:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:unchecked:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:unchecked:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:unchecked /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:unchecked:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:unchecked:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:unchecked:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:unchecked /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.unchecked-error /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:unchecked:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:unchecked:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:unchecked:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:unchecked /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:unchecked:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:unchecked:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:unchecked:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:unchecked /template/ theme|PartBorder#PART_Ripple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>

    <!-- `mud-icon-size-small` / `-large`: 1.25rem and 2.25rem against 1.5rem. -->
    <Style Selector="^.small /template/ LayoutTransformControl#PART_Scale">
      <Setter Property="LayoutTransform" Value="scale(0.8333333)" />
    </Style>
    <Style Selector="^.large /template/ LayoutTransformControl#PART_Scale">
      <Setter Property="LayoutTransform" Value="scale(1.5)" />
    </Style>
    <!-- END GENERATED -->

    <Style Selector="^:disabled /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <!-- `.mud-radio.mud-disabled *`: the glyph and the label both in text-disabled. -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton" BasedOn="{StaticResource FiliRadioButton}" />

</ResourceDictionary>
