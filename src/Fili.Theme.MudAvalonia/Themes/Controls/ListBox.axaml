<!--
  ListBox and ListBoxItem: MudList / MudListItem.

  Transcribed from _list.scss:

    .mud-list                 margin: 0; padding: 0
    .mud-list-padding         padding-top / padding-bottom: 8px      (on by default)
    .mud-list-item            padding-top / padding-bottom: 8px, align-items: center
    .mud-list-item-dense      padding-top / padding-bottom: 4px
    .mud-list-item-gutters    padding-left / padding-right: 16px     (on by default)
    .mud-list-item-text       margin-top / margin-bottom: 4px, round any content: 48px rows
    .mud-list-item-clickable  hover background: action-default-hover
    .mud-list-item-disabled   colour: action-disabled
    the text                  body1, or body2 when dense (MudListItem's TextClassname)

  Selection is the one part that is not in this file. MudList marks the chosen row with
  `mud-selected-item mud-primary-text mud-primary-hover`, which is primary TEXT over primary at
  6% - a tint and a colour change, never a filled bar. That is what FiliPrimaryHoverBrush is for,
  and it is why a selected row here stays as readable as an unselected one.

  The same row shape feeds Controls/ComboBox.axaml, because a MudSelect's options ARE list items.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliListBoxItem" TargetType="ListBoxItem">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="Padding" Value="16,8" />
    <!-- body1's 24px line inside 8 + 4px each side: 48px, and 36 dense (20 + 4 + 4 each side). A
         TextBlock has no CSS line box, so the height is held here, as a menu row's is. -->
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />

    <!-- `.mud-list-item-icon`, MudListItem's Icon: a start-icon is 24px in a 56px column, 32px to
         the text, in action-default, action-disabled on a disabled row; IconSlot sizes, colours
         and centres it with the text beside it. -->
    <Setter Property="theme:IconSlot.StartSize" Value="24" />
    <Setter Property="theme:IconSlot.StartMargin" Value="0,0,32,0" />
    <Setter Property="theme:IconSlot.Brush" Value="{DynamicResource FiliActionDefaultBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <theme:PartBorder x:Name="PART_StateLayer" Background="Transparent">
            <theme:PartBorder.Transitions>
              <Transitions>
                <!-- transition: background-color 150ms cubic-bezier(0.4, 0, 0.2, 1) -->
                <BrushTransition Property="Background" Duration="0:0:0.15" />
              </Transitions>
            </theme:PartBorder.Transitions>
          </theme:PartBorder>
          <theme:PartBorder x:Name="PART_Ripple"
                  theme:Ripple.IsLayer="True" />
          <!-- `.mud-list-item-text`: 4px above and below whatever the row holds. The row's
               Padding is the presenter's own, not a panel round it: one visual less a row. -->
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,4"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- The template again, with MudList's MultiSelection checkbox before the content.
         Only the rows of a `multi-selection` list carry it; every other row is built
         without it (MultiSelection.cs). -->
    <Style Selector="^[(theme|MultiSelection.IsOn)=True]">
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <theme:PartBorder x:Name="PART_StateLayer" Background="Transparent">
              <theme:PartBorder.Transitions>
                <Transitions>
                  <!-- transition: background-color 150ms cubic-bezier(0.4, 0, 0.2, 1) -->
                  <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
              </theme:PartBorder.Transitions>
            </theme:PartBorder>
            <theme:PartBorder x:Name="PART_Ripple"
                    theme:Ripple.IsLayer="True" />
            <DockPanel Margin="{TemplateBinding Padding}">
              <!--
                MudList's MultiSelection checkbox, shown by `multi-selection` on the ListBox
                (FiliTheme.axaml): a 48px icon button pulled 8px into the gutter and 8px out of the
                row above and below (`my-n2 ms-n2`), the text straight after it. Drawn here rather
                than as a CheckBox so the list's colour can reach it across one template boundary;
                a click on it is a click on the row, which toggles the selection.
              -->
              <Panel x:Name="PART_CheckBox"
                     DockPanel.Dock="Left"
                     Width="48" Height="48"
                     Margin="-8,-8,0,-8"
                     VerticalAlignment="Center">
                <Ellipse x:Name="PART_CheckHalo" Fill="Transparent" />
                <Path x:Name="PART_CheckUnchecked"
                      Width="24" Height="24"
                      Stretch="None"
                      Data="{DynamicResource FiliCheckBoxUncheckedGeometry}"
                      Fill="{DynamicResource FiliActionDefaultBrush}"
                      FlowDirection="LeftToRight"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                <Path x:Name="PART_CheckChecked"
                      Width="24" Height="24"
                      Stretch="None"
                      Data="{DynamicResource FiliCheckBoxCheckedGeometry}"
                      Fill="{DynamicResource FiliActionDefaultBrush}"
                      FlowDirection="LeftToRight"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="False" />
              </Panel>
              <!-- `.mud-list-item-text`: 4px above and below whatever the row holds. -->
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                Margin="0,4"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </DockPanel>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- .mud-list-item-dense, in body2; Gutters="false" drops the 16px sides. The same on the
         ListBox reach every row: they are Styles in FiliTheme.axaml. -->
    <Style Selector="^.dense">
      <Setter Property="Padding" Value="16,4" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    </Style>
    <Style Selector="^.no-gutters">
      <Setter Property="Padding" Value="0,8" />
    </Style>
    <Style Selector="^.dense.no-gutters">
      <Setter Property="Padding" Value="0,4" />
    </Style>

    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>

    <!-- MudBlazor excludes the selected row from the focus tint - _list.scss is
         `&:focus:not(.mud-selected-item)` - because arrow keys move focus and selection
         together, so tinting both would just be the selection tint twice. -->
    <Style Selector="^:focus-visible:not(:selected) /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>

    <!-- The list's colour, inherited from it (Accent.RowColour and RowHover): primary, or its
         colour class's. -->
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{Binding $self.(theme:Accent.RowColour)}" />
    </Style>
    <Style Selector="^:selected /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{Binding $self.(theme:Accent.RowHover)}" />
    </Style>
    <!-- Hovering an already-selected row deepens the same tint rather than swapping to grey. -->
    <Style Selector="^:selected:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayPressedBrush}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
      <Setter Property="theme:IconSlot.Brush" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- .mud-list-padding: vertical only. The 16px gutters belong to the ROW, so that a hover
         or a selection tint runs the full width of the list rather than stopping short. -->
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliListBoxItem}" />
    <!-- MudList's Color, primary by default: its rows read it, and a colour class sets it. -->
    <Setter Property="theme:Accent.RowColour" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="theme:Accent.RowHover" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />

    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
            <ItemsPresenter x:Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="{TemplateBinding Padding}" />
          </ScrollViewer>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <!-- A list inside a card or a drawer has no ground of its own; one that needs a surface says
         so. This mirrors MudPaper wrapping a MudList rather than MudList painting itself. -->
    <Style Selector="^.paper">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    </Style>
  </ControlTheme>

  <!--
    MudListItem with OnClick or Href, outside a selecting list: a row that does something rather
    than one that is chosen. `list-item` on a Button. The row's look - body1 on 48px, 16px sides,
    `.mud-list-item-text`'s 4px, the hover tint and the ripple - with no selected state, and the
    label in its own case: a list item is not a MudButton, so no button typography.
  -->
  <ControlTheme x:Key="FiliListItemButton" TargetType="Button">
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- `.mud-list-item-icon`, MudListItem's Icon: a start-icon is 24px in a 56px column, 32px to
         the text, in action-default, action-disabled on a disabled row; IconSlot sizes, colours
         and centres it with the text beside it. -->
    <Setter Property="theme:IconSlot.StartSize" Value="24" />
    <Setter Property="theme:IconSlot.StartMargin" Value="0,0,32,0" />
    <Setter Property="theme:IconSlot.Brush" Value="{DynamicResource FiliActionDefaultBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <theme:PartBorder x:Name="PART_StateLayer" Background="Transparent">
            <theme:PartBorder.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
              </Transitions>
            </theme:PartBorder.Transitions>
          </theme:PartBorder>
          <theme:PartBorder x:Name="PART_Ripple"
                  theme:Ripple.IsLayer="True" />
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Margin="{TemplateBinding Padding}"
                            Padding="0,4"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.dense">
      <Setter Property="Padding" Value="16,4" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    </Style>
    <Style Selector="^.no-gutters">
      <Setter Property="Padding" Value="0,8" />
    </Style>
    <Style Selector="^.dense.no-gutters">
      <Setter Property="Padding" Value="0,4" />
    </Style>

    <!-- `.mud-list-item-clickable`: the row's tint under the pointer, on keyboard focus and
         while pressed. -->
    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="theme:IconSlot.Brush" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox" BasedOn="{StaticResource FiliListBox}" />
  <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem" BasedOn="{StaticResource FiliListBoxItem}" />

</ResourceDictionary>
