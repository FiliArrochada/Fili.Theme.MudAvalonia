<!--
  TabStrip and TabStripItem: MudTabs, again.

  A TabStrip is a TabControl's header row with no content area - Avalonia splits them into two
  control types, MudBlazor does not. So the metrics here are the same ones Controls/TabControl
  .axaml already transcribed from _tabs.scss, and they are deliberately written out rather than
  shared: a ControlTheme cannot be BasedOn another whose TargetType differs, and inventing a
  shared resource for four values would be more indirection than repetition.

    48px minimum height, 12px/6px padding, button type at Medium
    160px minimum width, MudTabs.MinimumTabWidth
    label text-primary, going to primary when selected
    a 2px indicator in primary under the selected item, on a surface bar, sliding between items
    (SlidingIndicator, as in TabControl.axaml)
    the same classes: a colour, border, outlined, rounded, centered, material-fixed-tabs, elevation*, indicator-{colour}
    (a strip has no TabStripPlacement; place it with ordinary layout)

  If either file changes, change both. The gallery shows them side by side for that reason.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliTabStripItem" TargetType="TabStripItem">
    <!-- MudTabPanel's Icon beside its Text: a MudIcon at its default 24px, `.mud-tab-icon-text`
         8px from the text (_tabs.scss). An icon in the header marked `start-icon` takes them
         (IconSlot). -->
    <Setter Property="theme:IconSlot.StartSize" Value="24" />
    <Setter Property="theme:IconSlot.StartMargin" Value="0,0,8,0" />
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- A sliding indicator starts over the item it leaves. -->
    <Setter Property="ClipToBounds" Value="False" />

    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <theme:PartBorder x:Name="PART_StateLayer" Background="Transparent" />
          <theme:PartBorder x:Name="PART_Ripple"
                  theme:Ripple.IsLayer="True" />

          <ContentPresenter x:Name="PART_ContentPresenter"
                            theme:TextTransform.Case="{DynamicResource FiliButtonTextTransform}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
            <ContentPresenter.Content>
              <MultiBinding Converter="{x:Static theme:TextTransform.Converter}">
                <TemplateBinding Property="Content" />
                <Binding Path="(theme:TextTransform.Case)" RelativeSource="{RelativeSource Self}" />
              </MultiBinding>
            </ContentPresenter.Content>
          </ContentPresenter>

          <theme:PartBorder x:Name="PART_Indicator"
                  Height="2"
                  VerticalAlignment="Bottom"
                  Background="Transparent">
            <theme:PartBorder.Transitions>
              <Transitions>
                <!-- `.mud-tab-slider`: .3s cubic-bezier(.64,.09,.08,1). -->
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="0.64,0.09,0.08,1" />
              </Transitions>
            </theme:PartBorder.Transitions>
          </theme:PartBorder>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- _tabs.scss: action-default-hover on a tab, primary-hover on the active one. -->
    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^:selected:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>

    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^:selected /template/ theme|PartBorder#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliTabStrip" TargetType="TabStrip">
    <!-- The strip IS the bar, so its own Background paints it: surface, or a colour class. -->
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliTabStripItem}" />
    <Setter Property="theme:SlidingIndicator.Slides" Value="True" />
    <Setter Property="theme:TabBarScroll.Scrolls" Value="True" />

    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_TabBarHost">
          <theme:PartBorder x:Name="PART_TabBar" Background="{TemplateBinding Background}">
            <!-- MudTabs' scroll buttons, at the bar's ends while the tabs overflow it: icon buttons with
                 ChevronLeft and ChevronRight (NavigateBefore is the same path). TabBarScroll shows them,
                 disables each at its end and scrolls a bar's length per click. -->
            <DockPanel>
              <Button x:Name="PART_ScrollPrev" Classes="icon" DockPanel.Dock="Left" Focusable="False" IsVisible="False">
                <Path x:Name="PART_PrevIcon" Width="24" Height="24" Stretch="None" RenderTransformOrigin="50%,50%" Fill="{Binding $parent[Button].Foreground}"
                      Data="{DynamicResource FiliNavigateBeforeGeometry}" />
              </Button>
              <Button x:Name="PART_ScrollNext" Classes="icon" DockPanel.Dock="Right" Focusable="False" IsVisible="False">
                <Path x:Name="PART_NextIcon" Width="24" Height="24" Stretch="None" RenderTransformOrigin="50%,50%" Fill="{Binding $parent[Button].Foreground}"
                      Data="{DynamicResource FiliChevronRightGeometry}" />
              </Button>
              <ScrollViewer x:Name="PART_TabScroller"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled">
                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </DockPanel>
          </theme:PartBorder>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <!--
      The bar, from .mud-tabs-tabbar: surface, and no line under it unless asked. Each of these is
      a style rather than a value inline in the template, because a value written there binds at
      Template priority and the classes below could not move it.
    -->
    <Style Selector="^ /template/ theme|PartBorder#PART_TabBar">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliLinesDefaultBrush}" />
    </Style>
    <!-- Border: .mud-tabs-border-top, a lines-default rule on the content side. -->
    <Style Selector="^.border /template/ theme|PartBorder#PART_TabBar">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <!-- Outlined: .mud-paper-outlined on the bar. -->
    <Style Selector="^.outlined /template/ theme|PartBorder#PART_TabBar">
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Rounded: .mud-tabs-rounded, default-borderradius, with the tabs' tints clipped to it. -->
    <Style Selector="^.rounded /template/ theme|PartBorder#PART_TabBar">
      <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Centered: .mud-tabs-centered, `margin: auto` on the tab row. -->
    <Style Selector="^.centered /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- material-fixed-tabs: the tabs share the bar equally and never scroll, as on a TabControl. -->
    <Style Selector="^.material-fixed-tabs">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="^.material-fixed-tabs /template/ ScrollViewer#PART_TabScroller">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="^.material-fixed-tabs /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Elevation: `.mud-elevation-{n}` on the bar. The shadow is on the host, outside the bar,
         because `rounded` clips the bar and would clip its own shadow away. -->
    <!-- GENERATED by ThemeColourGenerator: tab bar elevation. -->
    <Style Selector="^.elevation0 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.elevation1 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation1}" />
    </Style>
    <Style Selector="^.elevation2 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation2}" />
    </Style>
    <Style Selector="^.elevation3 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation3}" />
    </Style>
    <Style Selector="^.elevation4 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
    </Style>
    <Style Selector="^.elevation5 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation5}" />
    </Style>
    <Style Selector="^.elevation6 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation6}" />
    </Style>
    <Style Selector="^.elevation7 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation7}" />
    </Style>
    <Style Selector="^.elevation8 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
    </Style>
    <Style Selector="^.elevation9 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation9}" />
    </Style>
    <Style Selector="^.elevation10 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation10}" />
    </Style>
    <Style Selector="^.elevation11 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation11}" />
    </Style>
    <Style Selector="^.elevation12 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation12}" />
    </Style>
    <Style Selector="^.elevation13 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation13}" />
    </Style>
    <Style Selector="^.elevation14 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation14}" />
    </Style>
    <Style Selector="^.elevation15 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation15}" />
    </Style>
    <Style Selector="^.elevation16 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation16}" />
    </Style>
    <Style Selector="^.elevation17 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation17}" />
    </Style>
    <Style Selector="^.elevation18 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation18}" />
    </Style>
    <Style Selector="^.elevation19 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation19}" />
    </Style>
    <Style Selector="^.elevation20 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation20}" />
    </Style>
    <Style Selector="^.elevation21 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation21}" />
    </Style>
    <Style Selector="^.elevation22 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation22}" />
    </Style>
    <Style Selector="^.elevation23 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation23}" />
    </Style>
    <Style Selector="^.elevation24 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation24}" />
    </Style>
    <Style Selector="^.elevation25 /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation25}" />
    </Style>
    <!-- END GENERATED -->
    <Style Selector="^.rounded /template/ theme|PartBorder#PART_TabBarHost">
      <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip" BasedOn="{StaticResource FiliTabStrip}" />
  <ControlTheme x:Key="{x:Type TabStripItem}" TargetType="TabStripItem" BasedOn="{StaticResource FiliTabStripItem}" />

</ResourceDictionary>
