<!--
  ToggleButton and RepeatButton: MudToggleItem, and a Button that repeats.

  In MudBlazor 9.11 a MudToggleItem renders a MudButton in the group's colour (Color.Primary by
  default): Variant.Outlined while unselected and Variant.Filled once selected. _togglegroup.scss
  then takes away what makes it a button:

    .mud-toggle-item              padding: 6px; min-width: auto; border-style: none
    .mud-toggle-item > label      min-height: 20px
    .mud-toggle-item-size-small   padding: 4px
    .mud-toggle-item-size-large   padding: 8px
    .mud-toggle-group > item      box-shadow: none; border-radius: 0
    .mud-toggle-group-outlined    1px in the colour at border-opacity (1), absorbed into the item
                                  padding: 5px, 3px small, 7px large

  So an unselected item is the colour as text on no ground, tinted `{color}-hover` under the
  pointer; a selected one is the colour with its contrast text, `{color}-darken` under the
  pointer, and never lifts. `min-width: auto` matters too: a group of toggles is usually icons
  or single words, so the button's 64px minimum is gone.

  A ToggleButton is one item, not a group, so the group's options are classes on each item: a
  colour, `small` / `large`, and `outlined` for the group's line. With no class an item is the
  group's default, Primary, so Color.Default needs a word of its own here, `default`: MudButton
  with no colour, text-primary while unselected, its grey fill (action-default-hover) once
  selected and action-disabled-background under the pointer. The colours, selection and
  sizes are GENERATED by ThemeColourGenerator.

  RepeatButton has no MudBlazor counterpart at all - it is an Avalonia primitive used inside
  spinners and scroll bars. It gets the text button verbatim so that the two places it shows up
  unstyled (NumericUpDown's spinners) do not look foreign.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia"
                    xmlns:conv="using:Fili.Theme.MudAvalonia.Converters">

  <ControlTheme x:Key="FiliToggleButton" TargetType="ToggleButton">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <theme:PartBorder x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="Transparent" />
            <theme:PartBorder x:Name="PART_Ripple"
                    theme:Ripple.IsLayer="True"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <!-- MudToggleItem is a MudButton, so its label is on the button's 1.75 line:
                 6 + 24.5 + 6 = 36.5px, "so the overall height matches MudButton"
                 (_togglegroup.scss). Nothing is drawn; it only holds the height (Button.axaml). -->
            <Rectangle x:Name="PART_LineBox"
                       Margin="{TemplateBinding Padding}"
                       Height="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:FactorConverter.Instance}, ConverterParameter=1.75}"
                       IsHitTestVisible="False" />
            <!-- The padding is the row's, so the check mark sits inside it, before the content. -->
            <DockPanel Margin="{TemplateBinding Padding}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <!-- MudToggleGroup's CheckMark: MudToggleItem's SelectedIcon, Icons.Material.Filled.Check,
                   before the content as `.mud-toggle-item-check-icon`, 20px with 6px each side. -->
              <Viewbox x:Name="PART_CheckMark"
                       DockPanel.Dock="Left"
                       Width="20" Height="20"
                       Margin="6,0,6,0"
                       VerticalAlignment="Center"
                       IsVisible="False">
                <Path x:Name="PART_CheckGlyph"
                      Width="24" Height="24"
                      Stretch="None"
                      Data="{DynamicResource FiliCheckGeometry}"
                      Fill="{TemplateBinding Foreground}" />
              </Viewbox>
              <ContentPresenter x:Name="PART_ContentPresenter"
                                theme:TextTransform.Case="{DynamicResource FiliButtonTextTransform}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.Content>
                  <MultiBinding Converter="{x:Static theme:TextTransform.Converter}">
                    <TemplateBinding Property="Content" />
                    <Binding Path="(theme:TextTransform.Case)" RelativeSource="{RelativeSource Self}" />
                  </MultiBinding>
                </ContentPresenter.Content>
              </ContentPresenter>
            </DockPanel>
          </Panel>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <!-- GENERATED by ThemeColourGenerator: toggle item colours, selection and sizes. -->
    <!-- Unselected, Variant.Outlined: the colour as text, `{color}-hover` under the pointer. -->
    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <!-- Color.Default, `default`: `.mud-button-outlined` with no colour, text-primary tinted
         action-default-hover, since a toggle with no class is the group's default, primary. -->
    <Style Selector="^.default">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    </Style>
    <Style Selector="^.default:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.default:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.default:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>

    <!-- Selected, Variant.Filled: the colour with its contrast text, `{color}-darken` under the
         pointer, and no shadow (`.mud-toggle-group > .mud-toggle-item { box-shadow: none }`). -->
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^:checked:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:checked">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.primary:checked:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:checked:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:checked:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:checked">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.info:checked">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
    </Style>
    <Style Selector="^.info:checked:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:checked:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:checked:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.success:checked">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
    </Style>
    <Style Selector="^.success:checked:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:checked:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:checked:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:checked">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
    </Style>
    <Style Selector="^.warning:checked:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:checked:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:checked:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.error:checked">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
    </Style>
    <Style Selector="^.error:checked:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:checked:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:checked:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:checked">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
    </Style>
    <Style Selector="^.dark:checked:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:checked:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:checked:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <!-- `default` selected: `.mud-button-filled` with no colour, text-primary on
         action-default-hover, action-disabled-background under the pointer. -->
    <Style Selector="^.default:checked">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    </Style>
    <Style Selector="^.default:checked:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^.default:checked:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^.default:checked:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:checked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:checked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- `.mud-toggle-group-outlined`: a 1px line in the colour (`border-opacity` is 1), absorbed
         into the padding, so an outlined item is 5px (3px small, 7px large). -->
    <Style Selector="^.outlined">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="5" />
    </Style>
    <Style Selector="^.outlined.primary">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.outlined.info">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.outlined.success">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.outlined.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.outlined.error">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.outlined.dark">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.outlined.default">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
    </Style>

    <!-- `.mud-toggle-item-size-*`: 4px / 8px, at the button's 13px / 15px. -->
    <Style Selector="^.small">
      <Setter Property="Padding" Value="4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="8" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="^">
      <Setter Property="theme:IconSlot.StartSize" Value="20" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-4,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="20" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-4,0" />
      <Setter Property="theme:IconSlot.Brush" Value="{x:Null}" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="theme:IconSlot.StartSize" Value="18" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-2,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="18" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-2,0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="theme:IconSlot.StartSize" Value="22" />
      <Setter Property="theme:IconSlot.EndSize" Value="22" />
    </Style>
    <Style Selector="^.outlined.small">
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="^.outlined.large">
      <Setter Property="Padding" Value="7" />
    </Style>

    <!-- Disabled, as MudButton: action-disabled text, and an action-disabled-background ground
         or line where the variant has one. -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:checked:disabled">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^.outlined:disabled">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <!-- END GENERATED -->

    <!-- `check-mark`: MudToggleGroup.CheckMark, the check before a selected item's content
         (MudToggleItem.GetCurrentIcon), at `.mud-toggle-item-check-icon`'s 18px with 4px small
         and 22px with 8px large, in the item's text colour, action-disabled when disabled. -->
    <Style Selector="^.check-mark:checked /template/ Viewbox#PART_CheckMark">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.small /template/ Viewbox#PART_CheckMark">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="4,0,4,0" />
    </Style>
    <Style Selector="^.large /template/ Viewbox#PART_CheckMark">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="8,0,8,0" />
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliRepeatButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <theme:PartBorder x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="Transparent" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <!-- Keyboard focus paints the hover layer. That IS the affordance in MudBlazor: _reset.scss
         drops the browser ring, and every component sets `:focus-visible` to the hover tint. -->
    <Style Selector="^:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayPressedBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!--
    MudToggleIconButton: `icon` on a ToggleButton switches to these (FiliTheme.axaml). They are
    MudIconButton's three themes from Controls/Button.axaml, retargeted, with each colour's rules
    hung on `:checked` for ToggledColor and on `unchecked-{color}` while unchecked for Color.
  -->
  <!-- GENERATED by ThemeColourGenerator: toggle icon button variants, colours and sizes. -->

  <!-- Text: `.mud-button-text`. No fill, no elevation, ever. -->
  <ControlTheme x:Key="FiliToggleIconButton" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <!-- State layer. Sits under the content, over the fill. -->
            <theme:PartBorder x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="Transparent" />
            <theme:PartBorder x:Name="PART_Ripple"
                    theme:Ripple.IsLayer="True"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              theme:TextTransform.Case="{DynamicResource FiliButtonTextTransform}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter.Content>
                <MultiBinding Converter="{x:Static theme:TextTransform.Converter}">
                  <TemplateBinding Property="Content" />
                  <Binding Path="(theme:TextTransform.Case)" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </ContentPresenter.Content>
            </ContentPresenter>
          </Panel>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <!-- No colour: action-default-hover. Keyboard focus paints the same tint - that IS the
         affordance in MudBlazor, whose _reset.scss drops the browser focus ring. -->
    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>

    <!-- MudIconButton, Variant.Text: round, 12px round a 24px icon, and action-default rather
         than text-primary - `.mud-icon-button` comes after `.mud-button` in MudBlazor's
         bundle, so its colour wins. Before the colours, so a colour class still beats it. -->
    <Style Selector="^.icon">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDefaultBrush}" />
    </Style>

    <Style Selector="^.primary:checked">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary:checked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:checked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:checked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:unchecked">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:unchecked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:unchecked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:unchecked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:checked">
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:unchecked">
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:unchecked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:unchecked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:unchecked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked">
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:unchecked">
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:unchecked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:unchecked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:unchecked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.info:checked">
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info:checked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:checked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:checked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:unchecked">
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:unchecked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:unchecked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:unchecked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.success:checked">
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success:checked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:checked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:checked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:unchecked">
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:unchecked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:unchecked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:unchecked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.warning:checked">
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning:checked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:checked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:checked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:unchecked">
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:unchecked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:unchecked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:unchecked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.error:checked">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error:checked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:checked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:checked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:unchecked">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:unchecked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:unchecked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:unchecked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.dark:checked">
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark:checked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:checked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:checked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:unchecked">
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:unchecked:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:unchecked:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:unchecked:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>

    <!-- Color.Inherit: `color: inherit`. Bound to the parent's inherited text colour, because a
         ControlTheme setter cannot withdraw its own Foreground and fall back to inheriting. -->
    <Style Selector="^.inherit">
      <Setter Property="Foreground" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
    </Style>

    <!-- `.mud-button-text-size-*`: 4px 5px / 8px 11px at 0.8125rem / 0.9375rem. -->
    <Style Selector="^.small">
      <Setter Property="Padding" Value="5,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="^">
      <Setter Property="theme:IconSlot.StartSize" Value="20" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-4,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="20" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-4,0" />
      <Setter Property="theme:IconSlot.Brush" Value="{x:Null}" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="theme:IconSlot.StartSize" Value="18" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-2,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="18" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-2,0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="theme:IconSlot.StartSize" Value="22" />
      <Setter Property="theme:IconSlot.EndSize" Value="22" />
    </Style>

    <!-- `.mud-icon-button-size-small`: 3px; large keeps 12px and grows the icon instead. -->
    <Style Selector="^.icon.small">
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="^.icon.large">
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

  <!--
    Outlined: `.mud-button-outlined`. The text button plus a 1px line, at 5px 15px so the line
    does not grow the button. The line is text-primary at BorderOpacity, which Palette.cs sets to
    1.0 - a hard line in the text colour, not the faint input outline.
  -->
  <ControlTheme x:Key="FiliOutlinedToggleIconButton" TargetType="ToggleButton" BasedOn="{StaticResource FiliToggleIconButton}">
    <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="15,5" />

    <Style Selector="^.primary:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:unchecked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.secondary:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:unchecked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:unchecked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.info:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:unchecked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.success:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:unchecked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.warning:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:unchecked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.error:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:unchecked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.dark:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:unchecked">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>

    <!-- `.mud-button-outlined-inherit`: `border-color: currentColor`. -->
    <Style Selector="^.inherit">
      <Setter Property="BorderBrush" Value="{Binding $self.Foreground}" />
    </Style>

    <!-- `.mud-button-outlined-size-*`: 3px 9px / 7px 21px. -->
    <Style Selector="^.small">
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="21,7" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="^">
      <Setter Property="theme:IconSlot.StartSize" Value="20" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-4,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="20" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-4,0" />
      <Setter Property="theme:IconSlot.Brush" Value="{x:Null}" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="theme:IconSlot.StartSize" Value="18" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-2,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="18" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-2,0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="theme:IconSlot.StartSize" Value="22" />
      <Setter Property="theme:IconSlot.EndSize" Value="22" />
    </Style>

    <!-- `.mud-button-outlined.mud-icon-button`: the default radius again, 5px; 4px small or large. -->
    <Style Selector="^.icon">
      <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
      <Setter Property="Padding" Value="5" />
    </Style>
    <Style Selector="^.icon.small">
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="^.icon.large">
      <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
  </ControlTheme>

  <!--
    Filled: `.mud-button-filled`. The elevation change across rest -> hover -> press is the one
    thing a style on Button cannot do, because Button has no BoxShadow - only the Border inside
    its template does. The three shadows are the layers _button.scss spells out, which are
    FiliElevation2, 4 and 8 exactly.
  -->
  <ControlTheme x:Key="FiliFilledToggleIconButton" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,6" />
    <!-- Every TemplatedControl clips to its bounds in Avalonia 12, which would cut the shadow
         off at the edge it is drawn past. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource FiliElevation2}">
          <Panel>
            <!-- State layer. Sits under the content, over the fill. -->
            <theme:PartBorder x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="Transparent" />
            <theme:PartBorder x:Name="PART_Ripple"
                    theme:Ripple.IsLayer="True"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              theme:TextTransform.Case="{DynamicResource FiliButtonTextTransform}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter.Content>
                <MultiBinding Converter="{x:Static theme:TextTransform.Converter}">
                  <TemplateBinding Property="Content" />
                  <Binding Path="(theme:TextTransform.Case)" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </ContentPresenter.Content>
            </ContentPresenter>
          </Panel>
        </theme:PartBorder>
