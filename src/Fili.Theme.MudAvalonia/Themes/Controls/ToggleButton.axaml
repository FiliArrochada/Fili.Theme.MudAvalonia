      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>

    <!-- `.mud-button-color-inherit`: the text inherits and the grey fill stays, as in MudBlazor,
         which generates no filled-inherit class. -->
    <Style Selector="^.inherit">
      <Setter Property="Foreground" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
    </Style>

    <!-- `.mud-button-filled-size-*`: 4px 10px / 8px 22px. -->
    <Style Selector="^.small">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="22,8" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="^">
      <Setter Property="theme:IconSlot.StartSize" Value="20" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-4,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="20" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-4,0" />
      <Setter Property="theme:IconSlot.Brush" Value="{x:Null}" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="theme:IconSlot.StartSize" Value="18" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-2,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="18" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-2,0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="theme:IconSlot.StartSize" Value="22" />
      <Setter Property="theme:IconSlot.EndSize" Value="22" />
    </Style>
    <Style Selector="^.icon.small">
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="^.icon.large">
      <Setter Property="Padding" Value="4" />
    </Style>

    <!-- `flat` is DropShadow="false": `.mud-button-disable-elevation` drops the shadow in every state. -->
    <Style Selector="^.flat /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.flat:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.flat:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.flat:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>

    <!-- Disabled drops to the ground: no shadow at all, not a dimmed one. -->
    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!-- END GENERATED -->

  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource FiliToggleButton}" />
  <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton" BasedOn="{StaticResource FiliRepeatButton}" />

</ResourceDictionary>
