<!--
  ComboBox and ComboBoxItem: MudSelect.

  The important finding from _select.scss is a NEGATIVE one: `.mud-select` has no box model at
  all. It is `display: block; position: relative` and nothing else - every visual comes from
  `.mud-select-input`, which is a MudInput. So a select in MudBlazor IS a text field, with a
  dropdown arrow as an end adornment.

  That settles the design: this mirrors Controls/TextBox.axaml's standard variant - transparent
  ground, a 1px resting rule, a 2px accent rule scaling from the centre on focus, and the same
  floating label. Anything else would make selects and fields disagree in the same form.

  The popup surface and the rows come from _list.scss, which also feeds Controls/Menu.axaml:
    padding-left / padding-right: 16px   on a row
    padding-top / padding-bottom: 8px    on the list

  Variant and Margin follow the text field's exactly, because a select IS one: `filled` and
  `outlined` switch to the two themes below (FiliTheme.axaml), `dense` is Margin.Dense, `error`
  is Error, and the helper line under the field carries the validation error or
  AutomationProperties.HelpText. The metrics and their derivation are in Controls/TextBox.axaml.

  Avalonia requires PART_Popup and PART_ItemsPresenter by name; PART_EditableTextBox is only
  needed for IsEditable, which this theme does not style differently.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliComboBoxItem" TargetType="ComboBoxItem">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <!-- MudSelectItem is a MudListItem, so body1. -->
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="Padding" Value="16,8" />
    <!-- A MudListItem's 48px, and 36 dense: see Controls/ListBox.axaml. -->
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <theme:PartBorder x:Name="PART_StateLayer" Background="Transparent" />
          <theme:PartBorder x:Name="PART_Ripple"
                  theme:Ripple.IsLayer="True" />
          <!-- MudSelectItem is a MudListItem: `.mud-list-item-text`'s 4px above and below. -->
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,4"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- MudSelect's Dense is MudList's, `.mud-list-item-dense`: 4px top and bottom in body2.
         `dense` on an item, or `dense-items` on the ComboBox for every row (FiliTheme.axaml);
         `dense` on the ComboBox is the field's Margin.Dense. -->
    <Style Selector="^.dense">
      <Setter Property="Padding" Value="16,4" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    </Style>

    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <!-- MudBlazor excludes the selected row from the focus tint - _list.scss is
         `&:focus:not(.mud-selected-item)` - because arrow keys move focus and selection
         together, so tinting both would just be the selection tint twice. -->
    <Style Selector="^:focus-visible:not(:selected) /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <!-- Selection is a tint plus a colour change, never a filled bar: MudList marks the chosen
         row with `mud-selected-item mud-primary-text mud-primary-hover`. Same rule as
         Controls/ListBox.axaml, because a select's options ARE list items. -->
    <Style Selector="^:selected /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayPressedBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!--
    The helper line, as Controls/TextBox.axaml has it: the error list, or else
    AutomationProperties.HelpText. Before it was here a select had no error host at all, so a
    failing binding showed nothing, not even the red rule. MudSelect has no counter.

    A template the select's PART_HelperLine builds only when the select has helper text or an
    error. Its parts are that presenter's content, not the select's template, so the select's
    state reaches them through the styles here; a value written on them is a local value, which
    no style outranks.
  -->
  <DataTemplate x:Key="FiliSelectHelperLine">
    <Grid>
      <Grid.Styles>
        <Style Selector="ComboBox:disabled TextBlock#PART_HelperText">
          <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
        </Style>
        <!-- In error the error replaces the helper text. -->
        <Style Selector="ComboBox[(DataValidationErrors.HasErrors)=True] TextBlock#PART_HelperText">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ComboBox.error TextBlock#PART_HelperText">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- HelperTextOnFocus: `helper-on-focus`. The helper text keeps its room and shows only
             while the select has focus or is open, as MudBlazor's slides into view inside a
             container that keeps its height. An error still takes its place. -->
        <Style Selector="ComboBox.helper-on-focus:not(:focus-within) TextBlock#PART_HelperText">
          <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ComboBox.helper-on-focus:dropdownopen TextBlock#PART_HelperText">
          <Setter Property="Opacity" Value="1" />
        </Style>
      </Grid.Styles>
      <ContentControl x:Name="PART_Errors"
                      Margin="0,3,0,0"
                      Content="{Binding $parent[ComboBox].(DataValidationErrors.Errors)}"
                      ContentTemplate="{DynamicResource FiliValidationErrorsTemplate}"
                      IsVisible="{Binding $parent[ComboBox].(DataValidationErrors.HasErrors)}" />
      <!-- The binding is on this Panel, not on the TextBlock: a {Binding} binds at LocalValue and
           outranks every style, so the error could not hide it. -->
      <Panel IsVisible="{Binding $parent[ComboBox].(AutomationProperties.HelpText), Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock x:Name="PART_HelperText"
                   Margin="0,3,0,0"
                   FontFamily="{DynamicResource FiliFontFamily}"
                   FontSize="{DynamicResource FiliCaptionFontSize}"
                   FontWeight="Normal"
                   LineHeight="20"
                   LetterSpacing="0.4"
                   TextWrapping="Wrap"
                   Text="{Binding $parent[ComboBox].(AutomationProperties.HelpText)}" />
      </Panel>
    </Grid>
  </DataTemplate>

  <ControlTheme x:Key="FiliComboBox" TargetType="ComboBox">
    <!-- Marks :helper-text, on which the helper line is built (Adornments). -->
    <Setter Property="theme:Adornments.TracksHelpText" Value="True" />
    <!-- Avalonia clips a ComboBox to its bounds by default, and the outlined label floats onto the
         stroke - MudBlazor's translate(14px, -6px) - so its top 6px, mask and all, sat outside and
         were cut off. The selected item clips itself instead (PART_ContentPresenter), as
         `.mud-select-input .mud-input-slot` hides its overflow, and the popup is a separate
         surface. -->
    <Setter Property="ClipToBounds" Value="False" />
    <!-- MudSelect.MaxHeight defaults to 300; Avalonia's to 200. -->
    <Setter Property="MaxDropDownHeight" Value="300" />
    <Setter Property="MinWidth" Value="{DynamicResource FiliInputMinWidth}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliComboBoxItem}" />

    <Setter Property="Template">
      <ControlTemplate>
        <!-- The helper line, built from FiliSelectHelperLine above only on a select with helper
             text or an error, as the text field's is. -->
        <DockPanel>
          <ContentPresenter x:Name="PART_HelperLine"
                            DockPanel.Dock="Bottom"
                            IsVisible="False"
                            TextElement.Foreground="{DynamicResource FiliTextSecondaryBrush}"
                            ContentTemplate="{StaticResource FiliSelectHelperLine}" />
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                MinHeight="{TemplateBinding MinHeight}">
          <Panel>

            <Grid x:Name="PART_ContentArea" ColumnDefinitions="*,Auto">
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Grid.Column="0"
                                ClipToBounds="True"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

              <!-- The end adornment: MudSelect's is ArrowDropDown, a SOLID triangle, not the
                   thin chevron an expander uses. Drawn at 24 with Stretch="None", like every
                   other Material glyph in Themes/Icons.axaml. Pulled 2px in at the top and
                   bottom, so its 20px sits inside the text line's 21px and a standard select is a
                   text field's height, as the icon is in MudInput's 32px slot; the triangle is
                   the middle 5px, so nothing of it is lost. -->
              <Path x:Name="PART_Chevron"
                    Grid.Column="1"
                    Margin="8,-2,0,-2"
                    Width="24" Height="24"
                    Stretch="None"
                    Data="{DynamicResource FiliArrowDropDownGeometry}"
                    Fill="{DynamicResource FiliActionDefaultBrush}"
                    VerticalAlignment="Center" />
            </Grid>

            <!--
              The label is TWO TextBlocks at the same place, and the reason is worth knowing.

              A select has to float its label when it holds a value, not only when it has focus -
              otherwise the resting label sits on top of the selected text. Avalonia gives no
              pseudoclass for "has a selection" (`:empty` on an ItemsControl means no ITEMS, which
              is why the first attempt floated every label permanently), and a Style selector is
              the only thing that can drive an animation.

              So: PART_FloatingLabel is the animated one and exists only while nothing is selected,
              rising on focus exactly as the TextBox's does. PART_SelectedLabel is a static copy
              already in the floated position, shown once there is a selection. They share
              position, size and colour, so the handover is invisible.
            -->
            <TextBlock x:Name="PART_FloatingLabel"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       IsHitTestVisible="False"
                       FontSize="{DynamicResource FiliBody1FontSize}"
                       LineHeight="NaN"
                       Foreground="{DynamicResource FiliTextSecondaryBrush}"
                       RenderTransform="translateY(0px)"
                       IsVisible="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNull}}">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0}{1}">
                  <Binding Path="PlaceholderText" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </TextBlock.Text>
              <TextBlock.Transitions>
                <Transitions>
                  <DoubleTransition Property="FontSize" Duration="0:0:0.15" Easing="CubicEaseOut" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </TextBlock.Transitions>
            </TextBlock>

            <!-- Shrunk by its value, so text-primary (`.mud-shrink ~ label`). -->
            <TextBlock x:Name="PART_SelectedLabel"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       IsHitTestVisible="False"
                       FontSize="{DynamicResource FiliCaptionFontSize}"
                       LineHeight="NaN"
                       Foreground="{DynamicResource FiliTextPrimaryBrush}"
                       IsVisible="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0}{1}">
                  <Binding Path="PlaceholderText" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>

            <theme:PartBorder x:Name="PART_Underline"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource FiliLinesInputsBrush}" />

            <theme:PartBorder x:Name="PART_UnderlineActive"
                    Height="2"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource FiliPrimaryBrush}"
                    RenderTransformOrigin="50%,50%"
                    RenderTransform="scaleX(0)">
              <theme:PartBorder.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </theme:PartBorder.Transitions>
            </theme:PartBorder>

            <Popup x:Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   PlacementTarget="{TemplateBinding}"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}">
              <theme:PartBorder x:Name="PART_PopupBorder" Background="{DynamicResource FiliSurfaceBrush}"
                      CornerRadius="{DynamicResource FiliCornerRadius}"
                      BoxShadow="{DynamicResource FiliElevation8}"
                      Padding="0,8"
                      Margin="8"
                      MinWidth="{Binding $parent[ComboBox].Bounds.Width}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer>
                  <ItemsPresenter x:Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </theme:PartBorder>
            </Popup>

          </Panel>
        </theme:PartBorder>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <!--
      The content area's margin is a STYLE, not inline in the template, and so is everything else
      a variant moves. A literal written in a ControlTemplate binds at Template priority, which a
      plain `^ /template/` style in a derived theme cannot override - only one with an activator
      can. That is how filled and outlined fields shipped with none of their 12px / 14px
      horizontal padding while their `.dense` margins, which do carry an activator, applied fine.
    -->
    <Style Selector="^ /template/ Grid#PART_ContentArea">
      <Setter Property="Margin" Value="0,20,0,7" />
    </Style>

    <!-- The selected label's floated position is a style, NOT inline in the template: a value
         written there binds at Template priority, which a plain style cannot override, and the
         filled and outlined themes need to move it. -->
    <Style Selector="^ /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="RenderTransform" Value="translateY(-14px)" />
    </Style>

    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_Underline">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultBrush}" />
    </Style>

    <!-- A select signals focus when its drop-down is open, not only on keyboard focus. -->
    <Style Selector="^:focus /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="RenderTransform" Value="scaleX(1)" />
    </Style>
    <Style Selector="^:dropdownopen /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="RenderTransform" Value="scaleX(1)" />
    </Style>

    <!-- ShrinkLabel (`shrink-label`): floated with nothing selected too, in text-primary. -->
    <Style Selector="^.shrink-label /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="FontSize" Value="{DynamicResource FiliCaptionFontSize}" />
      <Setter Property="RenderTransform" Value="translateY(-14px)" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    </Style>
    <Style Selector="^:focus /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="FontSize" Value="{DynamicResource FiliCaptionFontSize}" />
      <Setter Property="RenderTransform" Value="translateY(-14px)" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^:dropdownopen /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="FontSize" Value="{DynamicResource FiliCaptionFontSize}" />
      <Setter Property="RenderTransform" Value="translateY(-14px)" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^:focus /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^:dropdownopen /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>

    <!-- OpenIcon: MudSelect swaps ArrowDropDown for ArrowDropUp while the list is open. -->
    <Style Selector="^:dropdownopen /template/ Path#PART_Chevron">
      <Setter Property="Data" Value="{DynamicResource FiliArrowDropUpGeometry}" />
    </Style>

    <!-- Required: the label's "*", as on a text field. -->
    <Style Selector="^.required /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Tag" Value="*" />
    </Style>
    <Style Selector="^.required /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="Tag" Value="*" />
    </Style>

    <!-- Underline="false": neither rule. -->
    <Style Selector="^.no-underline /template/ theme|PartBorder#PART_Underline">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.no-underline /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- AdornmentColor: `adornment-{colour}` colours the drop-down arrow, and `adornment-inherit`
         gives it the colour round the field. Default is action-default, as above. -->
    <!-- GENERATED by ThemeColourGenerator: select adornment colours. -->
    <Style Selector="^.adornment-primary /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.adornment-secondary /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.adornment-tertiary /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.adornment-info /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.adornment-success /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.adornment-warning /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.adornment-error /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.adornment-dark /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.adornment-inherit">
      <Setter Property="theme:InheritedColour.Brush" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
    </Style>
    <Style Selector="^.adornment-inherit /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{Binding $parent[ComboBox].(theme:InheritedColour.Brush)}" />
    </Style>
    <!-- END GENERATED -->

    <!-- As a disabled text field: text-disabled for the text, label, adornment and helper text,
         and the line dotted. -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Underline">
      <Setter Property="OpacityMask">
        <!-- 1px on, 1px off: a 1px CSS dotted border. A mask, so the line keeps its colour and
             its other states: the brush holds no resource. -->
        <DrawingBrush TileMode="Tile" DestinationRect="0,0,2,1" SourceRect="0,0,2,1" Stretch="None" AlignmentX="Left" AlignmentY="Top">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Brush="Transparent" Geometry="M0,0 H2 V1 H0 Z" />
              <GeometryDrawing Brush="Black" Geometry="M0,0 H1 V1 H0 Z" />
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Setter>
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>

    <Style Selector="^.error /template/ theme|PartBorder#PART_Underline">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ theme|PartBorder#PART_Underline">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>

    <!-- The helper line (FiliSelectHelperLine), built on a select with helper text or an error;
         in error the row takes the error colour. Its content is any non-null value, for the
         template to show; the parts bind to the select itself. -->
    <Style Selector="^:helper-text /template/ ContentPresenter#PART_HelperLine, ^[(DataValidationErrors.HasErrors)=True] /template/ ContentPresenter#PART_HelperLine">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Content" Value="helper" />
    </Style>
    <Style Selector="^.error /template/ ContentPresenter#PART_HelperLine">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>

    <!-- Margin.Dense, as Controls/TextBox.axaml derives it. -->
    <Style Selector="^.dense">
      <Setter Property="MinHeight" Value="45" />
    </Style>
    <Style Selector="^.dense /template/ Grid#PART_ContentArea">
      <Setter Property="Margin" Value="0,17,0,7" />
    </Style>
    <Style Selector="^.dense /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-1.5px)" />
    </Style>
    <Style Selector="^.dense:focus /template/ TextBlock#PART_FloatingLabel, ^.dense.shrink-label /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-12.5px)" />
    </Style>
    <Style Selector="^.dense:dropdownopen /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-12.5px)" />
    </Style>
    <Style Selector="^.dense /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="RenderTransform" Value="translateY(-12.5px)" />
    </Style>
  </ControlTheme>

  <!-- Filled: Controls/TextBox.axaml's filled field, with the drop-down adornment. -->
  <ControlTheme x:Key="FiliFilledComboBox" TargetType="ComboBox" BasedOn="{StaticResource FiliComboBox}">
    <Setter Property="Background" Value="{DynamicResource FiliInputFilledBrush}" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="MinHeight" Value="56" />

    <Style Selector="^ /template/ Grid#PART_ContentArea">
      <Setter Property="Margin" Value="12,20,12,8" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Margin" Value="12,0" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="Margin" Value="12,0" />
    </Style>
    <Style Selector="^:focus /template/ TextBlock#PART_FloatingLabel, ^.shrink-label /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-10px)" />
    </Style>
    <Style Selector="^:dropdownopen /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-10px)" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="RenderTransform" Value="translateY(-10px)" />
    </Style>

    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_HelperLine">
      <Setter Property="Margin" Value="4,0" />
    </Style>

    <!-- Margin.Dense, as Controls/TextBox.axaml derives it. -->
    <Style Selector="^.dense">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="^.dense /template/ Grid#PART_ContentArea">
      <Setter Property="Margin" Value="12,16,12,4" />
    </Style>
    <Style Selector="^.dense /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(1px)" />
    </Style>
    <Style Selector="^.dense:focus /template/ TextBlock#PART_FloatingLabel, ^.dense.shrink-label /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-9px)" />
    </Style>
    <Style Selector="^.dense:dropdownopen /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-9px)" />
    </Style>
    <Style Selector="^.dense /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="RenderTransform" Value="translateY(-9px)" />
    </Style>
  </ControlTheme>

  <!-- Outlined: Controls/TextBox.axaml's outlined field, with the drop-down adornment. -->
  <ControlTheme x:Key="FiliOutlinedComboBox" TargetType="ComboBox" BasedOn="{StaticResource FiliComboBox}">
    <Setter Property="BorderBrush" Value="{DynamicResource FiliLinesInputsBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="MinHeight" Value="56" />

    <Style Selector="^ /template/ Grid#PART_ContentArea">
      <Setter Property="Margin" Value="14,16,14,12" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Margin" Value="14,0" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="Margin" Value="14,0" />
    </Style>
    <Style Selector="^ /template/ theme|PartBorder#PART_Underline">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^ /template/ theme|PartBorder#PART_UnderlineActive">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
    </Style>
    <Style Selector="^:focus /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^:dropdownopen /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- The floated label sits on the stroke behind a surface-coloured mask, with the same limit
         as the text field's: on any ground but FiliSurface the patch shows. -->
    <Style Selector="^:focus /template/ TextBlock#PART_FloatingLabel, ^.shrink-label /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="RenderTransform" Value="translateY(-26px)" />
    </Style>
    <Style Selector="^:dropdownopen /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="RenderTransform" Value="translateY(-26px)" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="RenderTransform" Value="translateY(-26px)" />
    </Style>

    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^.error /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^[(DataValidationErrors.HasErrors)=True] /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_HelperLine">
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <!-- Margin.Dense, as Controls/TextBox.axaml derives it. -->
    <Style Selector="^.dense">
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="^.dense /template/ Grid#PART_ContentArea">
      <Setter Property="Margin" Value="14,8,14,4" />
    </Style>
    <Style Selector="^.dense /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="^.dense:focus /template/ TextBlock#PART_FloatingLabel, ^.dense.shrink-label /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-18px)" />
    </Style>
    <Style Selector="^.dense:dropdownopen /template/ TextBlock#PART_FloatingLabel">
      <Setter Property="RenderTransform" Value="translateY(-18px)" />
    </Style>
    <Style Selector="^.dense /template/ TextBlock#PART_SelectedLabel">
      <Setter Property="RenderTransform" Value="translateY(-18px)" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox" BasedOn="{StaticResource FiliComboBox}" />
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem" BasedOn="{StaticResource FiliComboBoxItem}" />

</ResourceDictionary>
