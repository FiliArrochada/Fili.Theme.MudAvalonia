<!--
  TabControl and TabItem: the Material tab strip.

  Two themes, wired together by ItemContainerTheme on the TabControl - that is what makes a bare
  <TabItem> inside a themed TabControl pick the matching header theme up without the app naming
  it. Setting the TabControl theme alone would leave the headers on the substrate.

  The Material tab is a flat strip with a 2px indicator under the selected header, in primary,
  and an uppercase-weight label that goes from secondary text to primary on selection. Fluent's
  own tab happens to be close to this already, which is part of why it is a better substrate
  than Simple - but "close" still means the wrong height, the wrong tracking and an indicator
  that is not the right thickness.

  Transcribed from _tabs.scss and MudTabs.razor.cs, whose defaults decide most of it: the bar is
  surface with no rule under it (Border defaults to false), a tab inherits the text colour, which
  is text-primary, and goes primary when active, and MinimumTabWidth defaults to 160px.

    MudTabs        here
    Color          a colour class on the TabControl: the bar in the colour, tabs in its contrast
                   text, the indicator too, and {color}-lighten on the active tab's hover
    Border         border      a lines-default rule under the bar
    Outlined       outlined    a lines-default ring round the bar
    Rounded        rounded     default-borderradius on the bar
    Centered       centered    the tab row centred in the bar
    Elevation      elevation0 ... elevation24, the shadow under the bar
    SliderColor    slider-{colour}: the indicator in that colour, whatever the bar's
    Position       TabStripPlacement - Top, Bottom, Left or Right. The bar docks to that edge,
                   `border` draws its rule on the content side, the tabs stack for Left and
                   Right, and each tab moves its indicator to the content side: a TabItem knows
                   its own TabStripPlacement, so it needs nothing from its parent.

  The colours are generated, into a region of FiliTheme.axaml: a TabItem's theme cannot see its
  TabControl's class, so they are `TabControl.primary > TabItem` styles there.

  The indicator does NOT slide between tabs. A sliding indicator has to measure the previous and
  next header and animate between them, which needs code-behind and a custom panel; a per-item
  indicator that fades is the honest 90% and stays declarative.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="FiliTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root" Background="Transparent">
          <Panel>
            <Border x:Name="PART_StateLayer" Background="Transparent" />

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

            <!-- Indicator. Present always, revealed on selection, so the header does not resize. -->
            <Border x:Name="PART_Indicator"
                    Height="2"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource FiliPrimaryBrush}"
                    Opacity="0">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Indicator">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- `.mud-tab-slider-horizontal-reverse` / `-vertical` / `-vertical-reverse`: the indicator
         sits on the side that faces the content. -->
    <Style Selector="^[TabStripPlacement=Bottom] /template/ Border#PART_Indicator">
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ Border#PART_Indicator">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Width" Value="2" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ Border#PART_Indicator">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Width" Value="2" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- _tabs.scss: action-default-hover on a tab, primary-hover on the active one. Keyboard
         focus paints the same tint - that IS the affordance in MudBlazor, where _reset.scss drops
         the browser ring. -->
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^:selected:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayPressedBrush}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <!-- This is the line that carries the header theme down to bare <TabItem> children. -->
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliTabItem}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <DockPanel>
            <Border x:Name="PART_TabBarHost">
              <Border x:Name="PART_TabBar">
                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </Border>
            </Border>

            <ContentPresenter x:Name="PART_SelectedContentHost"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                              Margin="{TemplateBinding Padding}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!--
      The bar, from .mud-tabs-tabbar: surface, and no line under it unless asked. Each of these is
      a style rather than a value inline in the template, because a value written there binds at
      Template priority and the classes below could not move it.
    -->
    <Style Selector="^ /template/ Border#PART_TabBar">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliLinesDefaultBrush}" />
    </Style>
    <!-- Border: .mud-tabs-border-top, a lines-default rule on the content side. -->
    <Style Selector="^.border /template/ Border#PART_TabBar">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <!-- Outlined: .mud-paper-outlined on the bar. -->
    <Style Selector="^.outlined /template/ Border#PART_TabBar">
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Rounded: .mud-tabs-rounded, default-borderradius, with the tabs' tints clipped to it. -->
    <Style Selector="^.rounded /template/ Border#PART_TabBar">
      <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Centered: .mud-tabs-centered, `margin: auto` on the tab row. -->
    <Style Selector="^.centered /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Elevation: `.mud-elevation-{n}` on the bar. The shadow is on the host, outside the bar,
         because `rounded` clips the bar and would clip its own shadow away. -->
    <Style Selector="^.elevation0 /template/ Border#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.elevation1 /template/ Border#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation1}" />
    </Style>
    <Style Selector="^.elevation2 /template/ Border#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation2}" />
    </Style>
    <Style Selector="^.elevation4 /template/ Border#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
    </Style>
    <Style Selector="^.elevation6 /template/ Border#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation6}" />
    </Style>
    <Style Selector="^.elevation8 /template/ Border#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
    </Style>
    <Style Selector="^.elevation12 /template/ Border#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation12}" />
    </Style>
    <Style Selector="^.elevation16 /template/ Border#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation16}" />
    </Style>
    <Style Selector="^.elevation24 /template/ Border#PART_TabBarHost">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation24}" />
    </Style>
    <Style Selector="^.rounded /template/ Border#PART_TabBarHost">
      <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    </Style>

    <!--
      Position. The dock is a style, not inline in the template, so these can move it. MudTabs'
      Bottom reverses the column, Left and Right turn it into a row with the tabs stacked, and
      `.mud-tabs-border-{position}` puts the rule on the side that faces the content.
    -->
    <Style Selector="^ /template/ Border#PART_TabBarHost">
      <Setter Property="DockPanel.Dock" Value="Top" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ Border#PART_TabBarHost">
      <Setter Property="DockPanel.Dock" Value="Bottom" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ Border#PART_TabBarHost">
      <Setter Property="DockPanel.Dock" Value="Left" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ Border#PART_TabBarHost">
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>

    <Style Selector="^[TabStripPlacement=Left]">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="^[TabStripPlacement=Right]">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>

    <Style Selector="^.border[TabStripPlacement=Bottom] /template/ Border#PART_TabBar">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="^.border[TabStripPlacement=Left] /template/ Border#PART_TabBar">
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="^.border[TabStripPlacement=Right] /template/ Border#PART_TabBar">
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>

    <!-- A vertical bar centres its tabs vertically. -->
    <Style Selector="^.centered[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.centered[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl" BasedOn="{StaticResource FiliTabControl}" />

  <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem" BasedOn="{StaticResource FiliTabItem}" />

</ResourceDictionary>
