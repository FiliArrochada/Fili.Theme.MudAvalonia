<!--
  ToggleSwitch: the Material switch.

  The shape is the point, and it is unlike Fluent's. Material puts a 20px thumb that is LARGER
  than its 14px track, overhanging it above and below, with elevation under the thumb. Fluent
  puts a smaller thumb inside a taller capsule. Nothing about that is reachable with setters.

  Colour is MudSwitch's, from _switch.scss and MudSwitch.razor.cs. MudSwitch.Color defaults to
  Color.Default, which adds no colour at all: the thumb stays the literal #fafafa of
  `.mud-switch-base`, on and off, over the action-default track at 48% (50% when on). A colour
  class paints the thumb and the track only when ON - `mud-{color}-text` and `mud-{color}` are
  added for BoolValue == true - with the colour's hover tint as the halo.

  PART NAMES ARE LOAD-BEARING. ToggleSwitch.OnApplyTemplate looks up PART_SwitchKnob and
  PART_MovingKnobs to wire knob dragging. The lookups are null-safe, so omitting them costs the
  drag gesture rather than crashing - but then the switch only responds to clicks, which is a
  silent downgrade. They are kept, and the checked-state transform is applied to PART_Thumb
  INSIDE PART_MovingKnobs so it composes with the drag transform instead of fighting it.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliToggleSwitch" TargetType="ToggleSwitch">
    <!-- MudBlazor's ripple, drawn in PART_ThumbRipple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="40" />

    <Setter Property="Template">
      <ControlTemplate>
        <!-- Centred in the control, as MudSwitch's inline-flex is: a switch stretched to a 48px
             row - beside a checkbox - had its 40px drawn at the top and its label 4px high. -->
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

          <Panel x:Name="PART_SwitchArea" Grid.Column="0" Width="52" Height="40">

            <!-- Track: 34x14, sits behind and is overhung by the thumb. -->
            <theme:PartBorder x:Name="PART_Track"
                    Width="34" Height="14"
                    CornerRadius="9"
                    Background="{DynamicResource FiliActionDefaultBrush}"
                    Opacity="0.48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            <!-- Travel area. Width is track width, so the thumb can sit at either end. -->
            <Panel x:Name="PART_SwitchKnob"
                   Width="34" Height="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

              <!-- Avalonia translates THIS panel while a drag is in progress. -->
              <Panel x:Name="PART_MovingKnobs">

                <Ellipse x:Name="PART_ThumbStateLayer"
                         Width="40" Height="40"
                         Fill="Transparent"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="-10,0,0,0"
                         RenderTransform="translateX(0px)">
                  <Ellipse.Transitions>
                    <Transitions>
                      <TransformOperationsTransition Property="RenderTransform"
                                                     Duration="0:0:0.15"
                                                     Easing="CubicEaseOut" />
                    </Transitions>
                  </Ellipse.Transitions>
                </Ellipse>

                <!-- `.mud-ripple-switch`: the ripple in the halo's circle, moving with it. -->
                <theme:PartBorder x:Name="PART_ThumbRipple"
                        theme:Ripple.IsLayer="True"
                        Width="40" Height="40"
                        CornerRadius="999"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="-10,0,0,0"
                        RenderTransform="translateX(0px)">
                  <theme:PartBorder.Transitions>
                    <Transitions>
                      <TransformOperationsTransition Property="RenderTransform"
                                                     Duration="0:0:0.15"
                                                     Easing="CubicEaseOut" />
                    </Transitions>
                  </theme:PartBorder.Transitions>
                </theme:PartBorder>

                <theme:PartBorder x:Name="PART_Thumb"
                        Width="20" Height="20"
                        CornerRadius="10"
                        Background="{DynamicResource FiliSwitchThumbBrush}"
                        BoxShadow="{DynamicResource FiliElevation2}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        RenderTransform="translateX(0px)">
                  <theme:PartBorder.Transitions>
                    <Transitions>
                      <TransformOperationsTransition Property="RenderTransform"
                                                     Duration="0:0:0.15"
                                                     Easing="CubicEaseOut" />
                      <BrushTransition Property="Background" Duration="0:0:0.15" />
                    </Transitions>
                  </theme:PartBorder.Transitions>
                  <!--
                    MudSwitch's ThumbIcon: a MudIcon filling the thumb with 2px padding, so its
                    24px viewBox drawn at 16 / 10 / 22px. The glyph is FiliSwitchThumbIconGeometry,
                    empty unless the app sets that key in the switch's Resources; its colour is
                    ThumbIconColor, text-secondary (`.mud-icon-default`) or a `thumb-*` class.
                  -->
                  <Viewbox Margin="2">
                    <Path x:Name="PART_ThumbIcon"
                          Width="24" Height="24"
                          Stretch="None"
                          Data="{DynamicResource FiliSwitchThumbIconGeometry}"
                          Fill="{DynamicResource FiliTextSecondaryBrush}" />
                  </Viewbox>
                </theme:PartBorder>
              </Panel>
            </Panel>
          </Panel>

          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!--
      MudSwitch.LabelPlacement, `.mud-input-content-placement-*`: `label-start` is row-reverse, the
      label before the glyph; `label-top` column-reverse and `label-bottom` column, the two centred
      on each other. End, the default, needs no class.
    -->
    <Style Selector="^.label-start /template/ Panel#PART_SwitchArea">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^.label-start /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="^.label-top /template/ Panel#PART_SwitchArea">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.label-bottom /template/ Panel#PART_SwitchArea">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.label-top /template/ ContentPresenter#PART_ContentPresenter, ^.label-bottom /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.label-bottom /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Row" Value="1" />
    </Style>

    <!-- GENERATED by ThemeColourGenerator: switch colours and sizes. -->
    <!-- On: the thumb travels the track width minus its own, 34 - 20 = 14px, and the
         track lifts from 48% to 50%. -->
    <Style Selector="^:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="RenderTransform" Value="translateX(14px)" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_ThumbStateLayer, ^:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="RenderTransform" Value="translateX(14px)" />
    </Style>
    <Style Selector="^:checked /template/ theme|PartBorder#PART_Track">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- `.mud-switch-base:hover`: action-default-hover; keyboard focus and press the same. -->
    <Style Selector="^:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>

    <!-- `.mud-switch-span-small`: a 30x10 track and a 14px thumb. -->
    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="^.small /template/ Panel#PART_SwitchArea">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="^.small /template/ theme|PartBorder#PART_Track">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="^.small /template/ Panel#PART_SwitchKnob">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="^.small /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="^.small /template/ Ellipse#PART_ThumbStateLayer, ^.small /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="^.small:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="RenderTransform" Value="translateX(16px)" />
    </Style>
    <Style Selector="^.small:checked /template/ Ellipse#PART_ThumbStateLayer, ^.small:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="RenderTransform" Value="translateX(16px)" />
    </Style>

    <!-- `.mud-switch-span-large`: a 38x18 track and a 26px thumb. -->
    <Style Selector="^.large">
      <Setter Property="MinHeight" Value="46" />
    </Style>
    <Style Selector="^.large /template/ Panel#PART_SwitchArea">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="46" />
    </Style>
    <Style Selector="^.large /template/ theme|PartBorder#PART_Track">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="^.large /template/ Panel#PART_SwitchKnob">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="^.large /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
    </Style>
    <Style Selector="^.large /template/ Ellipse#PART_ThumbStateLayer, ^.large /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
    </Style>
    <Style Selector="^.large:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="RenderTransform" Value="translateX(12px)" />
    </Style>
    <Style Selector="^.large:checked /template/ Ellipse#PART_ThumbStateLayer, ^.large:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="RenderTransform" Value="translateX(12px)" />
    </Style>

    <!-- Colours paint the thumb and the track only when ON, with the colour's hover tint and
         ripple. -->
    <Style Selector="^.primary:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary:checked /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.secondary:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary:checked /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.info:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info:checked /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.success:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success:checked /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.warning:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning:checked /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.error:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error:checked /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.dark:checked /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark:checked /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:checked /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>

    <!-- UncheckedColor: `unchecked-{colour}`, the thumb and the track while OFF, with the
         colour's hover tint and ripple. -->
    <Style Selector="^.unchecked-primary:not(:checked) /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:not(:checked) /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:not(:checked):pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:not(:checked):focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:not(:checked):pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-primary:not(:checked) /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:not(:checked) /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:not(:checked) /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:not(:checked):pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:not(:checked):focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:not(:checked):pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary:not(:checked) /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:not(:checked) /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:not(:checked) /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:not(:checked):pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:not(:checked):focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:not(:checked):pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary:not(:checked) /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:not(:checked) /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:not(:checked) /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:not(:checked):pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:not(:checked):focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:not(:checked):pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-info:not(:checked) /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:not(:checked) /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:not(:checked) /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:not(:checked):pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:not(:checked):focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:not(:checked):pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-success:not(:checked) /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:not(:checked) /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:not(:checked) /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:not(:checked):pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:not(:checked):focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:not(:checked):pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning:not(:checked) /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:not(:checked) /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:not(:checked) /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:not(:checked):pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:not(:checked):focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:not(:checked):pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-error:not(:checked) /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:not(:checked) /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:not(:checked) /template/ theme|PartBorder#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:not(:checked):pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:not(:checked):focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:not(:checked):pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark:not(:checked) /template/ theme|PartBorder#PART_ThumbRipple">
      <Setter Property="theme:Ripple.Brush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <!-- END GENERATED -->

    <!-- GENERATED by ThemeColourGenerator: switch thumb icon colours. -->
    <Style Selector="^.thumb-primary /template/ Path#PART_ThumbIcon">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.thumb-secondary /template/ Path#PART_ThumbIcon">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.thumb-tertiary /template/ Path#PART_ThumbIcon">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.thumb-info /template/ Path#PART_ThumbIcon">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.thumb-success /template/ Path#PART_ThumbIcon">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.thumb-warning /template/ Path#PART_ThumbIcon">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.thumb-error /template/ Path#PART_ThumbIcon">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.thumb-dark /template/ Path#PART_ThumbIcon">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <!-- END GENERATED -->

    <!--
      `.mud-switch-base.mud-switch-disabled`: the thumb gray-default, the track keeping its colour
      at 12% (`mud-{color}` stays on the track while disabled), and `.mud-switch.mud-disabled`
      puts the label in text-disabled.
    -->
    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliGrayDefaultBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Track">
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch" BasedOn="{StaticResource FiliToggleSwitch}" />

</ResourceDictionary>
