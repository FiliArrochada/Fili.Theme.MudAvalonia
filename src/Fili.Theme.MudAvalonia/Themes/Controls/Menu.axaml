<!--
  Menu, MenuItem and the flyout surface behind a submenu.

  MenuItem is the most state-heavy control in this package, because one type plays three roles:
  a top-level strip item, a nested row with an icon column and a gesture hint, and a separator.
  Avalonia distinguishes them with pseudo-classes - :separator, :empty (no children, so no
  chevron), :selected, :open - which is what lets all three live in one template.

  PART_Popup is required: MenuItem.OnApplyTemplate wires submenu opening to it by name. A submenu
  therefore gets its elevation from the Border INSIDE that popup rather than from the popup
  itself, which is a plain host with no visual of its own.

  A dropdown row is MudMenuItem, from _menu.scss and MudMenuItem.razor:

    .mud-menu-list              padding: 4px 0; min-width: 112px
    .mud-menu-list > .mud-divider   margin: 4px 0
    .mud-menu-item              padding: 8px 12px
    .mud-menu-item-text         margin: 4px 0; body1 (body2 when dense)
    .mud-menu-item-icon         a 24px MudIcon in action-default; margin-inline-end: 12px

  So a row is 48px. The icon column opens for an item with an icon (Avalonia's :icon) and, so
  the labels line up, for every other row in a list that has one - MudMenu's
  `.mud-menu-list:has(.mud-menu-item-icon)` rule, which MenuIconGutter keeps as :icon-gutter. A
  list with no icons has no column at all.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia"
                    xmlns:sys="using:System">

  <ControlTheme x:Key="FiliMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="theme:MenuIconGutter.Aligns" Value="True" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root" Background="Transparent" CornerRadius="{DynamicResource FiliCornerRadius}">
          <Panel>
            <Border x:Name="PART_StateLayer"
                    Background="Transparent"
                    CornerRadius="{DynamicResource FiliCornerRadius}" />

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="{TemplateBinding Padding}">
              <!-- The icon column: 24px and 12px after it, open for :icon and :icon-gutter. -->
              <ContentPresenter x:Name="PART_IconPresenter"
                                Grid.Column="0"
                                Width="24"
                                Margin="0,0,12,0"
                                IsVisible="False"
                                Foreground="{DynamicResource FiliActionDefaultBrush}"
                                Content="{TemplateBinding Icon}"
                                VerticalAlignment="Center" />

              <!-- A string header is an AccessText, as the base's is: "_Open" is Open, Alt+O. -->
              <ContentPresenter x:Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                Margin="0,4"
                                VerticalAlignment="Center">
                <ContentPresenter.DataTemplates>
                  <DataTemplate DataType="sys:String">
                    <AccessText Text="{Binding}" />
                  </DataTemplate>
                </ContentPresenter.DataTemplates>
              </ContentPresenter>

              <!-- No converter on InputGesture: Avalonia 12 exposes no public KeyGesture
                   converter, and the binding stringifies the gesture on its own. -->
              <TextBlock x:Name="PART_GestureText"
                         Grid.Column="2"
                         Classes="caption"
                         Margin="24,0,0,0"
                         Text="{TemplateBinding InputGesture}"
                         VerticalAlignment="Center" />

              <!--
                `.mud-menu-submenu-icon`: Filled.ArrowRight at 24px in action-default, as
                `.mud-menu-item > .mud-icon-root` colours it; mirrored under RTL, where MudBlazor
                swaps in ArrowLeft. Hidden when the item has no children, or with `hide-icon`.
              -->
              <Path x:Name="PART_Chevron"
                    Grid.Column="3"
                    Width="24" Height="24"
                    Stretch="None"
                    Data="{DynamicResource FiliArrowRightGeometry}"
                    Fill="{DynamicResource FiliActionDefaultBrush}"
                    VerticalAlignment="Center" />
            </Grid>

            <Popup x:Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   Placement="RightEdgeAlignedTop"
                   HorizontalOffset="-4"
                   IsLightDismissEnabled="False"
                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
              <Border Background="{DynamicResource FiliSurfaceBrush}"
                      CornerRadius="{DynamicResource FiliCornerRadius}"
                      BoxShadow="{DynamicResource FiliElevation8}"
                      Padding="0,4"
                      MinWidth="112"
                      Margin="8">
                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </Border>
            </Popup>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:icon /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:icon-gutter /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- A leaf item carries no chevron, and MudMenu's HideSubMenuArrow is `hide-icon`. -->
    <Style Selector="^:empty /template/ Path#PART_Chevron, ^.hide-icon /template/ Path#PART_Chevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_Chevron">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>

    <Style Selector="^:selected /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <!-- Keyboard focus paints the hover layer. That IS the affordance in MudBlazor: _reset.scss
         drops the browser ring, and every component sets `:focus-visible` to the hover tint. -->
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <Style Selector="^:open /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayPressedBrush}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>

    <!-- Separator: one hairline, the whole row, 4px either side. -->
    <Style Selector="^:separator">
      <Setter Property="MinHeight" Value="1" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Height="1" Background="{DynamicResource FiliDividerBrush}" />
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <!--
    Top-level strip item. A separate theme from the dropdown row on purpose: the two look alike
    in a markup tree and are different controls on screen.

    A strip item has NO chevron - the first render of this menu showed "Library >  View >" across
    the top, because the dropdown template hides its chevron only for leaf items and a top-level
    item always has children. It also has no icon column, since there is nothing below it to
    align with, and its popup drops DOWNWARD rather than to the right.

    Its own ItemContainerTheme is the dropdown row, which is what makes one level of the menu
    strip-shaped and every level under it row-shaped.
  -->
  <ControlTheme x:Key="FiliTopLevelMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliMenuItem}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root" Background="Transparent" CornerRadius="{DynamicResource FiliCornerRadius}">
          <Panel>
            <Border x:Name="PART_StateLayer"
                    Background="Transparent"
                    CornerRadius="{DynamicResource FiliCornerRadius}" />

            <ContentPresenter x:Name="PART_HeaderPresenter"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center">
              <ContentPresenter.DataTemplates>
                <DataTemplate DataType="sys:String">
                  <AccessText Text="{Binding}" />
                </DataTemplate>
              </ContentPresenter.DataTemplates>
            </ContentPresenter>

            <Popup x:Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True"
                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
              <Border Background="{DynamicResource FiliSurfaceBrush}"
                      CornerRadius="{DynamicResource FiliCornerRadius}"
                      BoxShadow="{DynamicResource FiliElevation8}"
                      Padding="0,4"
                      MinWidth="112"
                      Margin="8">
                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </Border>
            </Popup>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <!-- Keyboard focus paints the hover layer. That IS the affordance in MudBlazor: _reset.scss
         drops the browser ring, and every component sets `:focus-visible` to the hover tint. -->
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
    </Style>
    <Style Selector="^:open /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayPressedBrush}" />
    </Style>
    <Style Selector="^:open">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliMenu" TargetType="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliTopLevelMenuItem}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <ItemsPresenter x:Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}"
                          KeyboardNavigation.TabNavigation="Continue" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="FiliContextMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliMenuItem}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource FiliCornerRadius}"
                BoxShadow="{DynamicResource FiliElevation8}"
                Padding="0,4"
                MinWidth="112">
          <ItemsPresenter x:Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    The dropdown row is MenuItem's theme by type; only a Menu's strip names another. A row that no
    menu of this theme placed - a MenuFlyout's, which binds its own null ItemContainerTheme over
    its presenter's, a submenu's own rows, or an app's ItemContainerTheme BasedOn {x:Type MenuItem}
    - had fallen through to the base's Simple row: 24px, no state layer, a dashed outline.
  -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem" BasedOn="{StaticResource FiliMenuItem}" />

  <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu" BasedOn="{StaticResource FiliMenu}" />

  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu" BasedOn="{StaticResource FiliContextMenu}" />

</ResourceDictionary>
