<!--
  CheckBox, re-derived from MudBlazor rather than from Material Design.

  The distinction matters and the first version got it wrong. Material's *spec* describes an 18px
  box with a 2px stroke; MudBlazor's *implementation* renders a 24px Material icon glyph and tints
  it. Those produce visibly different corners, a different tick, and a completely different
  indeterminate state - a bar inside the box, not a dash floating in it.

  Transcribed from:
    Components/CheckBox/MudCheckBox.razor      <MudIcon Icon="@GetIcon()" Color=... Size=... />
    Components/CheckBox/MudCheckBox.razor.cs   CheckedIcon / UncheckedIcon / IndeterminateIcon
    Styles/components/_checkbox.scss           padding: 4px around the icon
    Styles/components/_button.scss             the ripple/state layer the icon button sits in

  So: a 24px glyph with 4px padding, and the circular state layer around it.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliCheckBox" TargetType="CheckBox">
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">

          <!-- Size scales the glyph: MudIcon is 20 / 24 / 36px. The halo is the box, sized below. -->
          <Panel x:Name="PART_Box" Grid.Column="0" Width="48" Height="48">

            <!-- The halo: Accent's colour for the state, shown on hover, focus and press. -->
            <Ellipse x:Name="PART_StateLayer" Fill="{TemplateBinding (theme:Accent.Halo)}" Opacity="0" />
            <!-- The ripple, clipped to the halo: every corner is clamped to half the box. -->
            <theme:PartBorder x:Name="PART_Ripple" theme:Ripple.IsLayer="True" theme:Ripple.Brush="{TemplateBinding (theme:Accent.RippleNow)}" CornerRadius="999" />

            <LayoutTransformControl x:Name="PART_Scale"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
              <Panel>
                <!--
                  Unchecked and checked are separate glyphs, not one box that fills.

                  FlowDirection="LeftToRight" on each is the RIGHT-TO-LEFT opt-out. Avalonia mirrors
                  a whole subtree with one transform wherever the flow direction changes, so under RTL
                  the tick would come out reversed - and a checkmark is not a directional symbol, so
                  Material's bidirectionality guidance says it must not mirror. Avalonia's own Simple
                  theme pins its check path the same way, which is how this was found.

                  Arrows and chevrons are deliberately NOT opted out: a tree's disclosure arrow SHOULD
                  point left in RTL, and the mirror gives that for free.
                -->
                <Path x:Name="PART_Unchecked"
                      Width="24" Height="24"
                      Stretch="None"
                      Data="{DynamicResource FiliCheckBoxUncheckedGeometry}"
                      Fill="{TemplateBinding (theme:Accent.OffColour)}"
                      FlowDirection="LeftToRight"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

                <Path x:Name="PART_Checked"
                      Width="24" Height="24"
                      Stretch="None"
                      Data="{DynamicResource FiliCheckBoxCheckedGeometry}"
                      Fill="{TemplateBinding (theme:Accent.Colour)}"
                      FlowDirection="LeftToRight"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="False" />

                <Path x:Name="PART_Indeterminate"
                      Width="24" Height="24"
                      Stretch="None"
                      Data="{DynamicResource FiliCheckBoxIndeterminateGeometry}"
                      Fill="{TemplateBinding (theme:Accent.OffColour)}"
                      FlowDirection="LeftToRight"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="False" />
              </Panel>
            </LayoutTransformControl>
          </Panel>

          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Path#PART_Unchecked">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked /template/ Path#PART_Checked">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:indeterminate /template/ Path#PART_Unchecked">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:indeterminate /template/ Path#PART_Indeterminate">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The icon button round the glyph: `.mud-icon-button` pads it 12px at every size, so the halo is
         44 / 48 / 60px for a 20 / 24 / 36px glyph; `.mud-checkbox-dense` pads it 4px, so 28 / 32 / 44. -->
    <Style Selector="^.small /template/ Panel#PART_Box">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
    </Style>
    <Style Selector="^.large /template/ Panel#PART_Box">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="60" />
    </Style>
    <Style Selector="^.dense /template/ Panel#PART_Box">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="^.dense.small /template/ Panel#PART_Box">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="^.dense.large /template/ Panel#PART_Box">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
    </Style>

    <!--
      MudCheckBox.LabelPlacement, `.mud-input-content-placement-*`: `label-start` is row-reverse, the
      label before the glyph; `label-top` column-reverse and `label-bottom` column, the two centred
      on each other. End, the default, needs no class.
    -->
    <Style Selector="^.label-start /template/ Panel#PART_Box">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^.label-start /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="^.label-top /template/ Panel#PART_Box">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.label-bottom /template/ Panel#PART_Box">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.label-top /template/ ContentPresenter#PART_ContentPresenter, ^.label-bottom /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.label-bottom /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Row" Value="1" />
    </Style>

    <!-- GENERATED by ThemeColourGenerator: checkbox colours and sizes. -->
    <!-- No colour: action-default glyphs and halo; the ripple is the control's own text-primary. -->
    <Style Selector="^">
      <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliActionDefaultBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Colours: every glyph, checked or not, the halo, and the ripple (`.mud-{color}-text`'s
         ripple colour). -->
    <Style Selector="^.primary">
      <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliPrimaryHoverBrush}" />
      <Setter Property="theme:Accent.Ripple" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliSecondaryHoverBrush}" />
      <Setter Property="theme:Accent.Ripple" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliTertiaryHoverBrush}" />
      <Setter Property="theme:Accent.Ripple" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliInfoHoverBrush}" />
      <Setter Property="theme:Accent.Ripple" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliSuccessHoverBrush}" />
      <Setter Property="theme:Accent.Ripple" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliWarningHoverBrush}" />
      <Setter Property="theme:Accent.Ripple" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliErrorHoverBrush}" />
      <Setter Property="theme:Accent.Ripple" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliDarkHoverBrush}" />
      <Setter Property="theme:Accent.Ripple" Value="{DynamicResource FiliDarkBrush}" />
    </Style>

    <!-- `inherit`: Color.Inherit, the colour round the control, and the action-default halo
         `.mud-icon-button` keeps, as `hover:mud-inherit-hover` names no rule. -->
    <Style Selector="^.inherit">
      <Setter Property="theme:Accent.Colour" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>

    <!-- UncheckedColor: `unchecked-{colour}`, the colour of the glyph, its halo and its ripple
         while NOT checked (MudCheckBox: false or null), in place of the colour class. -->
    <Style Selector="^.unchecked-primary">
      <Setter Property="theme:Accent.UncheckedColour" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="theme:Accent.UncheckedHover" Value="{DynamicResource FiliPrimaryHoverBrush}" />
      <Setter Property="theme:Accent.UncheckedRipple" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-secondary">
      <Setter Property="theme:Accent.UncheckedColour" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="theme:Accent.UncheckedHover" Value="{DynamicResource FiliSecondaryHoverBrush}" />
      <Setter Property="theme:Accent.UncheckedRipple" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-tertiary">
      <Setter Property="theme:Accent.UncheckedColour" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="theme:Accent.UncheckedHover" Value="{DynamicResource FiliTertiaryHoverBrush}" />
      <Setter Property="theme:Accent.UncheckedRipple" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.unchecked-info">
      <Setter Property="theme:Accent.UncheckedColour" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="theme:Accent.UncheckedHover" Value="{DynamicResource FiliInfoHoverBrush}" />
      <Setter Property="theme:Accent.UncheckedRipple" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.unchecked-success">
      <Setter Property="theme:Accent.UncheckedColour" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="theme:Accent.UncheckedHover" Value="{DynamicResource FiliSuccessHoverBrush}" />
      <Setter Property="theme:Accent.UncheckedRipple" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.unchecked-warning">
      <Setter Property="theme:Accent.UncheckedColour" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="theme:Accent.UncheckedHover" Value="{DynamicResource FiliWarningHoverBrush}" />
      <Setter Property="theme:Accent.UncheckedRipple" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.unchecked-error">
      <Setter Property="theme:Accent.UncheckedColour" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="theme:Accent.UncheckedHover" Value="{DynamicResource FiliErrorHoverBrush}" />
      <Setter Property="theme:Accent.UncheckedRipple" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.unchecked-dark">
      <Setter Property="theme:Accent.UncheckedColour" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="theme:Accent.UncheckedHover" Value="{DynamicResource FiliDarkHoverBrush}" />
      <Setter Property="theme:Accent.UncheckedRipple" Value="{DynamicResource FiliDarkBrush}" />
    </Style>

    <!-- `unchecked-inherit`: Color.Inherit, the colour round the control, and the action-default halo
         `.mud-icon-button` keeps, as `hover:mud-inherit-hover` names no rule. -->
    <Style Selector="^.unchecked-inherit">
      <Setter Property="theme:Accent.UncheckedColour" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
      <Setter Property="theme:Accent.UncheckedHover" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>

    <!-- `mud-icon-size-small` / `-large`: 1.25rem and 2.25rem against 1.5rem. -->
    <Style Selector="^.small /template/ LayoutTransformControl#PART_Scale">
      <Setter Property="LayoutTransform" Value="scale(0.8333333)" />
    </Style>
    <Style Selector="^.large /template/ LayoutTransformControl#PART_Scale">
      <Setter Property="LayoutTransform" Value="scale(1.5)" />
    </Style>
    <!-- END GENERATED -->

    <Style Selector="^:disabled /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_Indeterminate">
      <Setter Property="Fill" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
    <!-- `.mud-checkbox.mud-disabled *`: the glyph and the label both in text-disabled. -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox" BasedOn="{StaticResource FiliCheckBox}" />

</ResourceDictionary>
