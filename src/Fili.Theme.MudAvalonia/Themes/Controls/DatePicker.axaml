<!--
  CalendarDatePicker and Calendar: MudDatePicker.

  MudPicker.razor draws the closed picker as a MudTextField with an end adornment, and
  MudBaseDatePicker.razor its popover: a MudPickerToolbar over the calendar, in a MudPaper at
  elevation 8 (MudPicker.razor.cs, `mud-elevation-{Elevation ?? 8}`). So:

    the field     the TextBox inside, wearing Controls/TextBox.axaml as it is - this file adds no
                  style to it. Its classes (`outlined`, `filled`, `dense`, `error`, ...) are set on
                  the CalendarDatePicker and mirrored onto it by FieldClasses, as a number field's
                  are. The adornment is MudPicker's AdornmentIcon, Icons.Material.Filled.Event, in
                  a MudIconButton (MudInputAdornment draws one when the adornment is clickable),
                  Edge.End: 12px pulled out on the right, and out of the line's height, as
                  `.mud-input-adornment` is .01em tall.
    the toolbar   `.mud-picker-toolbar` 100px, `mud-theme-{Color}` (Color defaults to Primary),
                  MudToolBar's 24px gutters, `.mud-picker-datepicker-toolbar` a column from the
                  start: the year as a text button at 1rem/400/1.75/.00938em, the date at
                  2.125rem/400/1.17/.00735em with text-transform none, TitleDateFormat
                  "ddd, dd MMM".
    the calendar  `.mud-picker-calendar-container` 310px wide (_pickerdate.scss).

  Avalonia requires PART_TextBox, PART_Button, PART_Popup and PART_Calendar on the
  CalendarDatePicker; PART_HeaderButton, PART_PreviousButton, PART_NextButton, PART_MonthView
  (seven rows by seven columns: the day names, then six weeks) and PART_YearView (three rows by
  four columns) on the CalendarItem. The CalendarItem fills those grids itself.

  Not MudBlazor's, by Avalonia's choice: the year view is the CalendarItem's decade, twelve years
  in a grid, where MudBlazor scrolls a list of years; and months sit four to a row, where
  `.mud-picker-month` is a third of the row. The text in the field can be typed, as MudPicker's
  Editable="true" allows.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <!--
    A day: `.mud-picker-calendar .mud-day`, a `mud-icon-button` 36px round with 2px either side,
    its number body2 (the <p class="mud-typography-body2"> inside, which sets size and weight over
    the button's .75rem/500) 2px down. MudDatePicker.GetDayClasses: the selected day is
    `mud-selected mud-theme-primary`, primary under its contrast text; today, unless selected, is
    `mud-current mud-button-outlined mud-button-outlined-primary mud-primary-text`, a 1px primary
    ring round primary text; a day of the next or previous month is `mud-hidden`, opacity 0 and no
    pointer; a disabled one text-disabled. Hover is action-default-hover, and a press ripples.
  -->
  <ControlTheme x:Key="FiliCalendarDayButton" TargetType="CalendarDayButton">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <theme:PartBorder x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="Transparent" />
            <theme:PartBorder x:Name="PART_Ripple"
                    theme:Ripple.IsLayer="True"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Margin="0,2,0,0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:today">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <!-- After :today, so a selected today is the filled circle, as GetDayClasses returns first. -->
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- On the part, not the day: the CalendarItem sets each day's own Opacity in code, which a
         style cannot beat. With the part hidden nothing in the day is hit-testable either. -->
    <Style Selector="^:inactive /template/ theme|PartBorder#PART_Root">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="^:blackout">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!--
    A month, or a year of the decade: `.mud-picker-month`, 60px high and centred, subtitle1, with
    action-default-hover under the pointer. The selected one is h5 in primary at 500
    (GetMonthTypo, GetMonthClasses, `.mud-picker-month-selected`); a year outside the decade
    is the CalendarItem's :inactive, in text-secondary.
  -->
  <ControlTheme x:Key="FiliCalendarButton" TargetType="CalendarButton">
    <Setter Property="Height" Value="60" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliSubtitle1FontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <theme:PartBorder x:Name="PART_StateLayer" Background="Transparent" />
          <theme:PartBorder x:Name="PART_Ripple" theme:Ripple.IsLayer="True" />
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:inactive">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextSecondaryBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FiliH5FontSize}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
  </ControlTheme>

  <!--
    The arrows: `.mud-picker-calendar-header-switch > .mud-icon-button`, a MudIconButton at
    `padding: 8px; margin: 6px` on the surface, so 40px round a 24px glyph, action-default, with
    action-default-hover under the pointer and a ripple. Its own theme rather than `icon`, whose
    12px a value in this template could not beat.
  -->
  <ControlTheme x:Key="FiliCalendarNavButton" TargetType="Button">
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FiliActionDefaultBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <theme:PartBorder x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="Transparent" />
            <theme:PartBorder x:Name="PART_Ripple"
                    theme:Ripple.IsLayer="True"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </Panel>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!--
    The month's name between the arrows: `.mud-picker-calendar-header-transition`, a plain button
    23px high across the row, its MudText body1 and centred, at 500 under the pointer.
  -->
  <ControlTheme x:Key="FiliCalendarHeaderButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="23" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          Content="{TemplateBinding Content}"
                          Foreground="{TemplateBinding Foreground}"
                          FontSize="{TemplateBinding FontSize}"
                          FontWeight="{TemplateBinding FontWeight}"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
  </ControlTheme>

  <!--
    The calendar: `.mud-picker-calendar-header-switch` (4px over, 8px under, the arrows and the
    month's name), `.mud-picker-calendar-header-day` (the day names, caption in text-secondary,
    36px wide with 2px either side, 16px high) and `.mud-picker-calendar-transition` (12px under
    them, six weeks of days). The arrows are MudIconButtons with `padding: 8px; margin: 6px`,
    PreviousIcon ChevronLeft and NextIcon ChevronRight.
  -->
  <ControlTheme x:Key="FiliCalendarItem" TargetType="CalendarItem">
    <Setter Property="Width" Value="310" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel Background="{TemplateBinding Background}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,8">
            <Button x:Name="PART_PreviousButton"
                    Theme="{StaticResource FiliCalendarNavButton}"
                    IsVisible="False">
              <Path Width="24" Height="24" Stretch="None"
                    Data="{DynamicResource FiliNavigateBeforeGeometry}"
                    Fill="{Binding $parent[Button].Foreground}" />
            </Button>
            <Button x:Name="PART_HeaderButton"
                    Grid.Column="1"
                    Theme="{StaticResource FiliCalendarHeaderButton}" />
            <Button x:Name="PART_NextButton"
                    Grid.Column="2"
                    Theme="{StaticResource FiliCalendarNavButton}"
                    IsVisible="False">
              <Path Width="24" Height="24" Stretch="None"
                    Data="{DynamicResource FiliChevronRightGeometry}"
                    Fill="{Binding $parent[Button].Foreground}" />
            </Button>
          </Grid>

          <Panel>
            <Grid x:Name="PART_MonthView"
                  HorizontalAlignment="Center"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  IsVisible="False" />
            <Grid x:Name="PART_YearView"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,*,*,*"
                  IsVisible="False" />
          </Panel>
        </DockPanel>
      </ControlTemplate>
    </Setter>
    <Setter Property="DayTitleTemplate">
      <Template x:DataType="x:String">
        <TextBlock Width="36"
                   Height="16"
                   Margin="2,0,2,12"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource FiliCaptionFontSize}"
                   LetterSpacing="{DynamicResource FiliCaptionLetterSpacing}"
                   Foreground="{DynamicResource FiliTextSecondaryBrush}"
                   Text="{Binding}" />
      </Template>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="FiliCalendar" TargetType="Calendar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
          <CalendarItem x:Name="PART_CalendarItem" Background="{TemplateBinding Background}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="FiliCalendarDatePicker" TargetType="CalendarDatePicker">
    <!-- Avalonia clips this control to its bounds, and the text field inside it reaches past
         them: the outlined label floats onto the stroke, 6px above the field, as a TextBox's does,
         and the icon button's 48px circle reaches 12px past the field's end, as MudBlazor's
         edge-end button does. Clipped, the label's top and the circle's end were cut off. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <!-- MudDatePicker always rings today (GetDayClasses' `mud-current`); Avalonia's picker
         defaults to not marking it. A setter, so an app's own False still wins. -->
    <Setter Property="IsTodayHighlighted" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- Where the picker's own focus lands, so the picker and its field are one Tab stop. -->
          <TextBox x:Name="PART_TextBox"
                   TemplatedControl.IsTemplateFocusTarget="True"
                   theme:FieldClasses.Mirrors="True"
                   DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                   AutomationProperties.HelpText="{TemplateBinding (AutomationProperties.HelpText)}"
                   PlaceholderText="{TemplateBinding PlaceholderText}">
            <TextBox.InnerRightContent>
              <!-- MudBlazor's edge-end icon button: 48px, pulled 12px into the field's end. Pulled
                   14px in at the top and bottom, so its 20px is inside the text line's 21px and the
                   field keeps a text field's height, as the button does in MudInput's 32px slot.
                   Raw to automation: the picker's own peer expands and collapses, and an icon
                   has no name to give a second control. -->
              <Button x:Name="PART_Button"
                      Classes="icon"
                      Margin="0,-14,-12,-14"
                      Focusable="False"
                      AutomationProperties.AccessibilityView="Raw">
                <PathIcon Data="{DynamicResource FiliEventGeometry}" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>

          <Popup x:Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 PlacementTarget="{TemplateBinding}"
                 Placement="BottomEdgeAlignedLeft"
                 IsLightDismissEnabled="True">
            <theme:PartBorder x:Name="PART_PopupBorder"
                    Background="{DynamicResource FiliSurfaceBrush}"
                    CornerRadius="{DynamicResource FiliCornerRadius}"
                    BoxShadow="{DynamicResource FiliElevation8}"
                    Margin="8">
              <!-- The calendar's 310px (`.mud-picker-calendar-container`), so a long date in the
                   toolbar shrinks to it rather than widening the popover. -->
              <StackPanel Width="310">
                <theme:PartBorder x:Name="PART_Toolbar"
                        Height="100"
                        Padding="24,0"
                        Background="{DynamicResource FiliPrimaryBrush}"
                        TextElement.Foreground="{DynamicResource FiliPrimaryContrastTextBrush}"
                        CornerRadius="{Binding CornerRadius, ElementName=PART_PopupBorder, Converter={x:Static theme:CalendarView.TopCorners}}">
                  <!-- The year and the date: text MudButtons in Color.Inherit, so in the toolbar's
                       contrast text; the date in the case written (`text-transform: none`), the
                       year being digits. -->
                  <StackPanel VerticalAlignment="Center">
                    <Button x:Name="PART_YearButton"
                            Classes="inherit"
                            FontWeight="Normal"
                            HorizontalAlignment="Left"
                            Focusable="False"
                            FontSize="{DynamicResource FiliBody1FontSize}"
                            LetterSpacing="0.15"
                            theme:CalendarView.Target="{Binding ElementName=PART_Calendar}"
                            theme:CalendarView.Shows="Decade"
                            Content="{Binding DisplayDate.Year, ElementName=PART_Calendar}" />
                    <!-- `.mud-button-date` is h4 on a 1.17 line, where a button's is 1.75: so the
                         size and the line are the text's, 34 x 1.17 = 39.8px, and the button is
                         51.8px, not the 71.5 a 34px button's own line would make it. The year's
                         `.mud-button-year` keeps the button's 1.75, 40px. -->
                    <Button x:Name="PART_DateButton"
                            Classes="inherit"
                            FontWeight="Normal"
                            HorizontalAlignment="Left"
                            Focusable="False"
                            LetterSpacing="0.25"
                            theme:CalendarView.Target="{Binding ElementName=PART_Calendar}"
                            theme:CalendarView.Shows="Month"
                            HorizontalContentAlignment="Left">
                      <Button.Resources>
                        <x:String x:Key="FiliButtonTextTransform">none</x:String>
                      </Button.Resources>
                      <!-- Shrunk to the toolbar's width where the culture's day name is long
                           ("domingo, 11 out"), so the date is never cut off; at h4 otherwise. -->
                      <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SelectedDate, ElementName=PART_Calendar, StringFormat='{}{0:ddd, dd MMM}'}"
                                   FontSize="{DynamicResource FiliH4FontSize}"
                                   LineHeight="39.78" />
                      </Viewbox>
                    </Button>
                  </StackPanel>
                </theme:PartBorder>
                <Calendar x:Name="PART_Calendar"
                          DisplayDate="{TemplateBinding DisplayDate}"
                          DisplayDateEnd="{TemplateBinding DisplayDateEnd}"
                          DisplayDateStart="{TemplateBinding DisplayDateStart}"
                          FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                          IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                          SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              </StackPanel>
            </theme:PartBorder>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CalendarDayButton}" TargetType="CalendarDayButton" BasedOn="{StaticResource FiliCalendarDayButton}" />
  <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton" BasedOn="{StaticResource FiliCalendarButton}" />
  <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem" BasedOn="{StaticResource FiliCalendarItem}" />
  <ControlTheme x:Key="{x:Type Calendar}" TargetType="Calendar" BasedOn="{StaticResource FiliCalendar}" />
  <ControlTheme x:Key="{x:Type CalendarDatePicker}" TargetType="CalendarDatePicker" BasedOn="{StaticResource FiliCalendarDatePicker}" />

</ResourceDictionary>
