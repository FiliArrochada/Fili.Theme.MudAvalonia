<!--
  Separator: MudDivider.

  The whole of _divider.scss, which is short enough to quote:

    .mud-divider          margin: 0; border-color: the palette divider token;
                          border-width: 1px; border-style: solid none none none
    .mud-divider-vertical border-style: none solid none none; height: 100%
    .mud-divider-inset    margin-left: 72px
    .mud-divider-middle   margin-left: 16px; margin-right: 16px
    .mud-divider-light    border-color: the palette divider-light token

  Note `margin: 0`. The forked Simple template ships `Margin="29,1,0,1"` - a menu-shaped indent
  baked into every divider - and FiliTheme.axaml previously recoloured it with a blanket Style
  while leaving that margin in place. Both are replaced here: a divider is a hairline at the edge
  of its container unless `inset` or `middle` says otherwise. Those two are classes rather than a
  Margin because they turn with `vertical`: 72px at the top of a vertical divider, not the left.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliSeparator" TargetType="Separator">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{DynamicResource FiliDividerBrush}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Height" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />

    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>

    <!-- MudDivider.Light: `.mud-divider-light`, the divider-light colour. -->
    <Style Selector="^.light">
      <Setter Property="Background" Value="{DynamicResource FiliDividerLightBrush}" />
    </Style>

    <!-- .mud-divider-vertical: the rule turns 90 degrees, so the fixed dimension swaps. -->
    <Style Selector="^.vertical">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Width" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="^.inset">
      <Setter Property="Margin" Value="72,0,0,0" />
    </Style>
    <Style Selector="^.middle">
      <Setter Property="Margin" Value="16,0" />
    </Style>
    <Style Selector="^.vertical.inset">
      <Setter Property="Margin" Value="0,72,0,0" />
    </Style>
    <Style Selector="^.vertical.middle">
      <Setter Property="Margin" Value="0,16" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator" BasedOn="{StaticResource FiliSeparator}" />

  <!--
    MudDivider with ChildContent (9.12): `divider` on a ContentControl, as a Separator holds
    nothing. _divider.scss:

      .mud-divider-with-content        a flex row, centred; `-vertical` a column, the
                                       parent's height
      .mud-divider-with-content-line   flex 1 1 16px, at least 16px; 8px tall in a column
      .mud-divider-with-content-text   padding 0 12px, centred; 4px 0 in a column, unwrapped

    The text takes the type and colour round it, as the span has no class of its own. The
    two lines are the divider's colour, `light` the divider-light one; `inset` and `middle`
    are the wrapper's margins, as on a Separator. Two star columns round an Auto one share
    the rest equally, as the two lines' flex-grow does, and a vertical divider moves the lines
    above and below in the same three-by-three grid; a text wider than the row is not wrapped,
    where the browser wraps it anywhere.
  -->
  <ControlTheme x:Key="FiliTextDivider" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{DynamicResource FiliDividerBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="PART_Root" ColumnDefinitions="*,Auto,*" RowDefinitions="*,Auto,*">
          <theme:PartBorder x:Name="PART_StartLine" Grid.Row="1" Grid.Column="0" Height="1" MinWidth="16"
                            VerticalAlignment="Center" Background="{TemplateBinding Background}" />
          <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <theme:PartBorder x:Name="PART_EndLine" Grid.Row="1" Grid.Column="2" Height="1" MinWidth="16"
                            VerticalAlignment="Center" Background="{TemplateBinding Background}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.light">
      <Setter Property="Background" Value="{DynamicResource FiliDividerLightBrush}" />
    </Style>

    <!-- `.mud-divider-with-content-vertical`: a column the parent's height, lines 1px wide and at
         least 8px tall, the text padded 4px above and below. -->
    <Style Selector="^.vertical">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0,4" />
    </Style>
    <Style Selector="^.vertical /template/ theme|PartBorder#PART_StartLine">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="^.vertical /template/ theme|PartBorder#PART_EndLine">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.Row" Value="2" />
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="^.inset">
      <Setter Property="Margin" Value="72,0,0,0" />
    </Style>
    <Style Selector="^.middle">
      <Setter Property="Margin" Value="16,0" />
    </Style>
    <Style Selector="^.vertical.inset">
      <Setter Property="Margin" Value="0,72,0,0" />
    </Style>
    <Style Selector="^.vertical.middle">
      <Setter Property="Margin" Value="0,16" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
