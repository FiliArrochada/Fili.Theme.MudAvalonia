<!--
  Separator: MudDivider.

  The whole of _divider.scss, which is short enough to quote:

    .mud-divider          margin: 0; border-color: the palette divider token;
                          border-width: 1px; border-style: solid none none none
    .mud-divider-vertical border-style: none solid none none; height: 100%
    .mud-divider-inset    margin-left: 72px
    .mud-divider-middle   margin-left: 16px; margin-right: 16px
    .mud-divider-light    border-color: the palette divider-light token

  Note `margin: 0`. The forked Simple template ships `Margin="29,1,0,1"` - a menu-shaped indent
  baked into every divider - and FiliTheme.axaml previously recoloured it with a blanket Style
  while leaving that margin in place. Both are replaced here: a divider is a hairline at the edge
  of its container unless `inset` or `middle` says otherwise. Those two are classes rather than a
  Margin because they turn with `vertical`: 72px at the top of a vertical divider, not the left.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia">

  <ControlTheme x:Key="FiliSeparator" TargetType="Separator">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{DynamicResource FiliDividerBrush}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Height" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />

    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>

    <!-- MudDivider.Light: `.mud-divider-light`, the divider-light colour. -->
    <Style Selector="^.light">
      <Setter Property="Background" Value="{DynamicResource FiliDividerLightBrush}" />
    </Style>

    <!-- .mud-divider-vertical: the rule turns 90 degrees, so the fixed dimension swaps. -->
    <Style Selector="^.vertical">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Width" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="^.inset">
      <Setter Property="Margin" Value="72,0,0,0" />
    </Style>
    <Style Selector="^.middle">
      <Setter Property="Margin" Value="16,0" />
    </Style>
    <Style Selector="^.vertical.inset">
      <Setter Property="Margin" Value="0,72,0,0" />
    </Style>
    <Style Selector="^.vertical.middle">
      <Setter Property="Margin" Value="0,16" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator" BasedOn="{StaticResource FiliSeparator}" />

</ResourceDictionary>
