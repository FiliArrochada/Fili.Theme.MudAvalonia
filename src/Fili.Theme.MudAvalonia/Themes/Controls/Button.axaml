<!--
  Button: MudButton. Transcribed from _button.scss and MudButton.razor.cs.

  Three kinds of class, combined the way MudButton's parameters are:

    Variant   text (the default - MudButton.Variant defaults to Variant.Text), outlined, filled
    Color     none (Color.Default), primary, secondary, tertiary, info, success, warning, error,
              dark, inherit
    Size      none (Size.Medium), small, large
    Shape     icon (MudIconButton), flat (DropShadow="false")

    <Button Content="Learn more" />                        text, default colour
    <Button Classes="primary" Content="Learn more" />      text, primary
    <Button Classes="outlined error" Content="Delete" />   outlined, error
    <Button Classes="filled primary" Content="Save" />     filled, primary
    <Button Classes="filled success small" Content="OK" /> filled, success, small
    <Button Classes="icon primary"><PathIcon /></Button>   a round primary icon button

  A colour class is ONLY a colour, as Color is in MudBlazor. `primary` on its own is a primary
  TEXT button; the fill comes from `filled`. Each variant follows one rule for every colour:

    text      colour as text; hover, focus and press tint with {color}-hover (the colour at 6%)
    outlined  the same, plus a 1px line in the colour (BorderOpacity is 1.0, so it IS the colour)
    filled    colour as fill, {color}-text on it; hover, focus and press switch the fill to
              {color}-darken, and elevation goes 2 -> 4 (hover, focus) -> 8 (press)

  With no colour, text and outlined use text-primary (and so does outlined's line), tinting with
  action-default-hover. A filled button with no colour is grey: action-default-hover as the
  fill, action-disabled-background on hover.

  :active and :focus-visible share the hover value in _button.scss, so press is not a stronger
  tint here either. MudBlazor's extra press feedback is the ripple, the part with no Avalonia
  primitive: an animated, clipped ellipse driven from pointer position.

  GENERATED by ThemeColourGenerator (tst/Fili.Theme.MudAvalonia.UnitTests/Generation) from one
  list of colours, so every colour follows exactly the same rules. Do not hand-edit one colour's
  block: change the generator, then rewrite this file with FILI_REGENERATE=1 (GeneratedThemeTests).

  Order inside each theme is load-bearing: defaults, then colours, then sizes, then disabled.
  Of two styles matching the same element, the later one wins - so a colour beats the default
  tint, and disabled beats everything.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.Theme.MudAvalonia"
                    xmlns:conv="using:Fili.Theme.MudAvalonia.Converters">

  <!-- Text: `.mud-button-text`. No fill, no elevation, ever. -->
  <ControlTheme x:Key="FiliTextButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacity}" />
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <!-- State layer. Sits under the content, over the fill: the colour's hover tint
                 (Accent.Hover), shown on hover, focus and press. -->
            <theme:PartBorder x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{TemplateBinding (theme:Accent.Hover)}"
                    Opacity="0" />
            <theme:PartBorder x:Name="PART_Ripple"
                    theme:Ripple.IsLayer="True"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <!-- The label's line box. `.mud-button` sets the button typography's line-height,
                 1.75 (Typography.cs), so the label is 1.75 of its font size tall whatever it
                 holds: 6 + 24.5 + 6 = 36.5px at 14px, 30.75 small, 42.25 large. The text alone
                 is 17px, and the button was 29. Nothing is drawn; it only holds the height. -->
            <Rectangle x:Name="PART_LineBox"
                       Margin="{TemplateBinding Padding}"
                       Height="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:FactorConverter.Instance}, ConverterParameter=1.75}"
                       IsHitTestVisible="False" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              theme:TextTransform.Case="{DynamicResource FiliButtonTextTransform}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter.Content>
                <MultiBinding Converter="{x:Static theme:TextTransform.Converter}">
                  <TemplateBinding Property="Content" />
                  <Binding Path="(theme:TextTransform.Case)" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </ContentPresenter.Content>
            </ContentPresenter>
          </Panel>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <!-- No colour: action-default-hover. Keyboard focus paints the same tint - that IS the
         affordance in MudBlazor, whose _reset.scss drops the browser focus ring. -->
    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:focus-visible /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pressed /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- MudIconButton, Variant.Text: round, 12px round a 24px icon, and action-default rather
         than text-primary - `.mud-icon-button` comes after `.mud-button` in MudBlazor's
         bundle, so its colour wins. Before the colours, so a colour class still beats it. -->
    <Style Selector="^.icon">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDefaultBrush}" />
    </Style>

    <!-- `.mud-icon-button` is its padding round the icon: no label, so no line box. -->
    <Style Selector="^.icon /template/ Rectangle#PART_LineBox">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^.primary">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>

    <!-- Color.Inherit: `color: inherit`. Bound to the parent's inherited text colour, because a
         ControlTheme setter cannot withdraw its own Foreground and fall back to inheriting. -->
    <Style Selector="^.inherit">
      <Setter Property="Foreground" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
    </Style>

    <!-- `.mud-button-text-size-*`: 4px 5px / 8px 11px at 0.8125rem / 0.9375rem. -->
    <Style Selector="^.small">
      <Setter Property="Padding" Value="5,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="^">
      <Setter Property="theme:IconSlot.StartSize" Value="20" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-4,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="20" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-4,0" />
      <Setter Property="theme:IconSlot.Brush" Value="{x:Null}" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="theme:IconSlot.StartSize" Value="18" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-2,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="18" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-2,0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="theme:IconSlot.StartSize" Value="22" />
      <Setter Property="theme:IconSlot.EndSize" Value="22" />
    </Style>

    <!-- `.mud-icon-button-size-small`: 3px; large keeps 12px and grows the icon instead. -->
    <Style Selector="^.icon.small">
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="^.icon.large">
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ theme|PartBorder#PART_StateLayer">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>

  <!--
    Outlined: `.mud-button-outlined`. The text button plus a 1px line, at 5px 15px so the line
    does not grow the button. The line is text-primary at BorderOpacity, which Palette.cs sets to
    1.0 - a hard line in the text colour, not the faint input outline.
  -->
  <ControlTheme x:Key="FiliOutlinedButton" TargetType="Button" BasedOn="{StaticResource FiliTextButton}">
    <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="15,5" />

    <Style Selector="^.primary">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>

    <!-- `.mud-button-outlined-inherit`: `border-color: currentColor`. -->
    <Style Selector="^.inherit">
      <Setter Property="BorderBrush" Value="{Binding $self.Foreground}" />
    </Style>

    <!-- `.mud-button-outlined-size-*`: 3px 9px / 7px 21px. -->
    <Style Selector="^.small">
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="21,7" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="^">
      <Setter Property="theme:IconSlot.StartSize" Value="20" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-4,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="20" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-4,0" />
      <Setter Property="theme:IconSlot.Brush" Value="{x:Null}" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="theme:IconSlot.StartSize" Value="18" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-2,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="18" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-2,0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="theme:IconSlot.StartSize" Value="22" />
      <Setter Property="theme:IconSlot.EndSize" Value="22" />
    </Style>

    <!-- `.mud-button-outlined.mud-icon-button`: the default radius again, 5px; 4px small or large. -->
    <Style Selector="^.icon">
      <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
      <Setter Property="Padding" Value="5" />
    </Style>
    <Style Selector="^.icon.small">
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="^.icon.large">
      <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
  </ControlTheme>

  <!--
    Filled: `.mud-button-filled`. The elevation change across rest -> hover -> press is the one
    thing a style on Button cannot do, because Button has no BoxShadow - only the Border inside
    its template does. The three shadows are the layers _button.scss spells out, which are
    FiliElevation2, 4 and 8 exactly.
  -->
  <ControlTheme x:Key="FiliFilledButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    <Setter Property="theme:Accent.Seam" Value="{DynamicResource FiliDividerBrush}" />
    <!-- Every TemplatedControl clips to its bounds in Avalonia 12, which would cut the shadow
         off at the edge it is drawn past. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- MudBlazor's ripple, drawn in PART_Ripple (Ripple.cs). -->
    <Setter Property="theme:Ripple.Opacity" Value="{DynamicResource FiliRippleOpacitySecondary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <theme:PartBorder x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource FiliElevation2}">
          <Panel>
            <!-- State layer. Sits under the content, over the fill: the colour's hover tint
                 (Accent.Hover), shown on hover, focus and press. -->
            <theme:PartBorder x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{TemplateBinding (theme:Accent.Hover)}"
                    Opacity="0" />
            <theme:PartBorder x:Name="PART_Ripple"
                    theme:Ripple.IsLayer="True"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <!-- The label's line box. `.mud-button` sets the button typography's line-height,
                 1.75 (Typography.cs), so the label is 1.75 of its font size tall whatever it
                 holds: 6 + 24.5 + 6 = 36.5px at 14px, 30.75 small, 42.25 large. The text alone
                 is 17px, and the button was 29. Nothing is drawn; it only holds the height. -->
            <Rectangle x:Name="PART_LineBox"
                       Margin="{TemplateBinding Padding}"
                       Height="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:FactorConverter.Instance}, ConverterParameter=1.75}"
                       IsHitTestVisible="False" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              theme:TextTransform.Case="{DynamicResource FiliButtonTextTransform}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter.Content>
                <MultiBinding Converter="{x:Static theme:TextTransform.Converter}">
                  <TemplateBinding Property="Content" />
                  <Binding Path="(theme:TextTransform.Case)" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </ContentPresenter.Content>
            </ContentPresenter>
          </Panel>
        </theme:PartBorder>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
    </Style>
    <Style Selector="^:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
    </Style>
    <Style Selector="^:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
    </Style>

    <!-- Hover, focus and press switch the fill to Accent.Hover: with no colour, grey going to
         action-disabled-background; with one, the colour's darken shade. -->
    <Style Selector="^:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{Binding (theme:Accent.Hover), RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="^:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{Binding (theme:Accent.Hover), RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="^:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="Background" Value="{Binding (theme:Accent.Hover), RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>

    <!-- `.mud-button-filled.mud-icon-button`: 5px inside a transparent 1px border. -->
    <Style Selector="^.icon">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDefaultBrush}" />
    </Style>

    <!-- `.mud-icon-button` is its padding round the icon: no label, so no line box. -->
    <Style Selector="^.icon /template/ Rectangle#PART_LineBox">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
      <Setter Property="theme:Accent.Seam" Value="{DynamicResource FiliPrimaryLightenBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
      <Setter Property="theme:Accent.Seam" Value="{DynamicResource FiliSecondaryLightenBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
      <Setter Property="theme:Accent.Seam" Value="{DynamicResource FiliTertiaryLightenBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliInfoDarkenBrush}" />
      <Setter Property="theme:Accent.Seam" Value="{DynamicResource FiliInfoLightenBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliSuccessDarkenBrush}" />
      <Setter Property="theme:Accent.Seam" Value="{DynamicResource FiliSuccessLightenBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliWarningDarkenBrush}" />
      <Setter Property="theme:Accent.Seam" Value="{DynamicResource FiliWarningLightenBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliErrorDarkenBrush}" />
      <Setter Property="theme:Accent.Seam" Value="{DynamicResource FiliErrorLightenBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
      <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliDarkDarkenBrush}" />
      <Setter Property="theme:Accent.Seam" Value="{DynamicResource FiliDarkLightenBrush}" />
    </Style>

    <!-- `.mud-button-color-inherit`: the text inherits and the grey fill stays, as in MudBlazor,
         which generates no filled-inherit class. -->
    <Style Selector="^.inherit">
      <Setter Property="Foreground" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
    </Style>

    <!-- `.mud-button-filled-size-*`: 4px 10px / 8px 22px. -->
    <Style Selector="^.small">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="22,8" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="^">
      <Setter Property="theme:IconSlot.StartSize" Value="20" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-4,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="20" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-4,0" />
      <Setter Property="theme:IconSlot.Brush" Value="{x:Null}" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="theme:IconSlot.StartSize" Value="18" />
      <Setter Property="theme:IconSlot.StartMargin" Value="-2,0,8,0" />
      <Setter Property="theme:IconSlot.EndSize" Value="18" />
      <Setter Property="theme:IconSlot.EndMargin" Value="8,0,-2,0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="theme:IconSlot.StartSize" Value="22" />
      <Setter Property="theme:IconSlot.EndSize" Value="22" />
    </Style>
    <Style Selector="^.icon.small">
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="^.icon.large">
      <Setter Property="Padding" Value="4" />
    </Style>

    <!-- `flat` is DropShadow="false": `.mud-button-disable-elevation` drops the shadow in every state. -->
    <Style Selector="^.flat /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.flat:pointerover /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.flat:focus-visible /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^.flat:pressed /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>

    <!-- Disabled drops to the ground: no shadow at all, not a dimmed one. -->
    <Style Selector="^:disabled /template/ theme|PartBorder#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!--
    MudButton defaults to Variant.Text and Color.Default, so an unclassed Button is the text one in
    text-primary. `outlined` and `filled` switch the theme (FiliTheme.axaml); colour and size
    classes work inside whichever theme is active.
  -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button" BasedOn="{StaticResource FiliTextButton}" />

</ResourceDictionary>
