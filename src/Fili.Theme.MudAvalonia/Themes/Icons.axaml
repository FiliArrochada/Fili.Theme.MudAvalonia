<!--
  The handful of icon glyphs the control themes cannot do without.

  This package deliberately ships no icon set - that is stated in the README and still true. What
  is here is the minimum needed for FIDELITY rather than for convenience: MudBlazor does not draw
  a checkbox or a radio, it renders a Material icon.

      MudCheckBox.razor   -> <MudIcon Icon="@GetIcon()" ... />
      CheckedIcon         = Icons.Material.Filled.CheckBox
      UncheckedIcon       = Icons.Material.Filled.CheckBoxOutlineBlank
      IndeterminateIcon   = Icons.Material.Filled.IndeterminateCheckBox
      MudRadio            = RadioButtonChecked / RadioButtonUnchecked

  So a hand-drawn 18px Border with a stroked tick is not a close approximation of MudBlazor, it is
  a different artefact - it cannot match the glyph's corner geometry or the indeterminate bar.

  Path data transcribed verbatim from MudBlazor's Icons/Material/Filled.cs, which is Google's
  Material Icons under Apache 2.0. The `M0 0h24v24H0z` viewbox spacer each glyph carries is
  dropped: it is a transparent bounding rect in SVG, but in a filled StreamGeometry it would
  paint the whole square. Bounds are preserved instead by drawing at Width/Height 24 with
  Stretch="None", since the data is already in 0-24 coordinate space.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Icons.Material.Filled.CheckBox -->
  <StreamGeometry x:Key="FiliCheckBoxCheckedGeometry">M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.11 0 2-.9 2-2V5c0-1.1-.89-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z</StreamGeometry>

  <!-- Icons.Material.Filled.CheckBoxOutlineBlank -->
  <StreamGeometry x:Key="FiliCheckBoxUncheckedGeometry">M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z</StreamGeometry>

  <!-- Icons.Material.Filled.IndeterminateCheckBox -->
  <StreamGeometry x:Key="FiliCheckBoxIndeterminateGeometry">M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M17,13H7v-2h10V13z</StreamGeometry>

  <!-- Icons.Material.Filled.RadioButtonChecked -->
  <StreamGeometry x:Key="FiliRadioCheckedGeometry">M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0-5C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z</StreamGeometry>

  <!-- Icons.Material.Filled.RadioButtonUnchecked -->
  <StreamGeometry x:Key="FiliRadioUncheckedGeometry">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z</StreamGeometry>

  <!--
    The two disclosure glyphs, and they are NOT interchangeable. MudSelect's adornment is
    ArrowDropDown, a solid triangle; MudExpansionPanel's is ExpandMore, a thin chevron. Drawing
    one stroked path and using it for both was the first attempt here and it made a select look
    like an expander.
  -->

  <!-- Icons.Material.Filled.ArrowDropDown -->
  <StreamGeometry x:Key="FiliArrowDropDownGeometry">M7 10l5 5 5-5z</StreamGeometry>

  <!-- Icons.Material.Filled.ArrowDropUp -->
  <StreamGeometry x:Key="FiliArrowDropUpGeometry">M7 14l5-5 5 5z</StreamGeometry>

  <!--
    MudInput's NumericUpIcon and NumericDownIcon, MudNumericField's spin buttons: chevrons, not
    the select's triangles, and keys of their own, so swapping one control's glyph leaves the
    other's.
  -->

  <!-- Icons.Material.Filled.KeyboardArrowUp -->
  <StreamGeometry x:Key="FiliKeyboardArrowUpGeometry">M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z</StreamGeometry>

  <!-- Icons.Material.Filled.KeyboardArrowDown -->
  <StreamGeometry x:Key="FiliKeyboardArrowDownGeometry">M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z</StreamGeometry>

  <!-- Icons.Material.Filled.ExpandMore -->
  <StreamGeometry x:Key="FiliExpandMoreGeometry">M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z</StreamGeometry>

  <!--
    Icons.Material.Filled.NavigateBefore. Its forward twin, NavigateNext, is byte-identical to
    ChevronRight below, so there is no separate entry for it - MudBlazor ships the same path under
    both names.
  -->
  <StreamGeometry x:Key="FiliNavigateBeforeGeometry">M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z</StreamGeometry>

  <!-- Icons.Material.Filled.ChevronRight, which doubles as NavigateNext. MudTreeView's ExpandButtonIcon: it points RIGHT at rest
       and rotates 90 degrees to open, where the expansion panel's chevron points down and rotates
       180. Using one for the other is a visible tell. -->
  <StreamGeometry x:Key="FiliChevronRightGeometry">M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z</StreamGeometry>

  <!-- MudSwitch's ThumbIcon, none by default: set this key in a switch's Resources to draw one. -->
  <StreamGeometry x:Key="FiliSwitchThumbIconGeometry" />

  <!-- Icons.Material.Filled.ArrowRight: MudMenuItem's submenu icon. -->
  <StreamGeometry x:Key="FiliArrowRightGeometry">M10 17l5-5-5-5v10z</StreamGeometry>
  <!--
    MudSnackbar's severity icons, CommonSnackbarOptions' defaults: NormalIcon, InfoIcon,
    SuccessIcon, WarningIcon and ErrorIcon. Note the mix of sets - three Outlined, one Filled and
    one of MudBlazor's own Custom glyphs - which is MudBlazor's choice, not a slip here.
  -->

  <!-- Icons.Material.Outlined.EventNote -->
  <StreamGeometry x:Key="FiliEventNoteGeometry">M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V9h14v10zM5 7V5h14v2H5zm2 4h10v2H7zm0 4h7v2H7z</StreamGeometry>

  <!-- Icons.Material.Outlined.Info -->
  <StreamGeometry x:Key="FiliInfoOutlinedGeometry">M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z</StreamGeometry>

  <!-- Icons.Custom.Uncategorized.AlertSuccess -->
  <StreamGeometry x:Key="FiliAlertSuccessGeometry">M20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4C12.76,4 13.5,4.11 14.2,4.31L15.77,2.74C14.61,2.26 13.34,2 12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12M7.91,10.08L6.5,11.5L11,16L21,6L19.59,4.58L11,13.17L7.91,10.08Z</StreamGeometry>

  <!-- Icons.Material.Outlined.ReportProblem -->
  <StreamGeometry x:Key="FiliReportProblemGeometry">M12 5.99L19.53 19H4.47L12 5.99M12 2L1 21h22L12 2zm1 14h-2v2h2v-2zm0-6h-2v4h2v-4z</StreamGeometry>

  <!-- Icons.Material.Filled.ErrorOutline -->
  <StreamGeometry x:Key="FiliErrorOutlineGeometry">M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z</StreamGeometry>

  <!-- Icons.Material.Filled.Close: MudSnackbar's CloseIcon. -->
  <StreamGeometry x:Key="FiliCloseGeometry">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>

</ResourceDictionary>
