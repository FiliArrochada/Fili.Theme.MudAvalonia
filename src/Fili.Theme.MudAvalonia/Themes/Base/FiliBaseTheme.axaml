<!--
  The base layer: templates for every Avalonia control, so this package needs no substrate.

  This replaces FluentTheme exactly where it used to sit:

      <Application.Styles>
        <StyleInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Base/FiliBaseTheme.axaml" />
        <StyleInclude Source="avares://Fili.Theme.MudAvalonia/FiliTheme.axaml" />
      </Application.Styles>

  Order is still load-bearing, for the same reason as before: base first, Fili second, because
  later styles win for overlapping setters. The seventeen hand-written control themes in
  FiliTheme override their forked counterparts precisely because they come after this.

  Kept as a separate entry point rather than folded into FiliTheme so that the precedence stays
  explicit and inspectable, instead of depending on how resource lookup orders a parent Styles
  against a child StyleInclude.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Tokens first: Accents.axaml binds Simple's key surface to them. -->
        <MergeResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Palette.axaml" />
        <MergeResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Typography.axaml" />
        <MergeResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Geometry.axaml" />
        <MergeResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Base/Accents.axaml" />
        <MergeResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Base/InvariantResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <StyleInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Base/Controls/SimpleControls.axaml" />

  <!--
    Every brush again, outside the variant dictionaries, for a lookup that names no variant
    (FindResource(key) in an app's code), which never searches a variant dictionary. Here and not
    in the dictionary above: a dictionary finds a plain entry in any of its merged dictionaries
    before a variant dictionary's, so these would shadow every per-variant brush. A Styles
    searches its own resources before its children's, so a lookup reaches these only when the
    dictionary above had nothing for it (FallbackBrushes.axaml, VariantScopeTests).
  -->
  <Styles>
    <Styles.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <MergeResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/FallbackBrushes.axaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Styles.Resources>
  </Styles>

</Styles>
