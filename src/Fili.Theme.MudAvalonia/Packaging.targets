<!--
  The pack's own steps, imported by the theme's csproj. Each changes what goes into the package
  while it is built, so they run inside every `dotnet pack` rather than as a tool beside it.
-->
<Project>

  <!--
    The README is also the package's page on nuget.org, which cannot follow a relative link. The
    repository keeps relative links, which work on GitHub in any branch or fork; the packed copy
    has each one rewritten to the commit the package was built from, so a version's page links to
    that version's docs. An image is rewritten to the file's raw URL instead, as nuget.org shows an
    image only from a host it trusts and a blob URL is a page, not the image. A link to a file that
    does not exist fails the pack.
  -->
  <Target Name="PackReadmeWithAbsoluteLinks"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_ReadmeRevision>$(SourceRevisionId)</_ReadmeRevision>
      <_ReadmeRevision Condition="'$(_ReadmeRevision)' == ''">v$(Version)</_ReadmeRevision>
      <_PackedReadme>$(IntermediateOutputPath)package\README.md</_PackedReadme>
    </PropertyGroup>
    <AbsoluteReadmeLinks Source="$(MSBuildThisFileDirectory)..\..\README.md"
                         Destination="$(_PackedReadme)"
                         BaseUrl="$(PackageProjectUrl)/blob/$(_ReadmeRevision)/"
                         ImageBaseUrl="$(PackageProjectUrl.Replace('https://github.com/', 'https://raw.githubusercontent.com/'))/$(_ReadmeRevision)/" />
    <ItemGroup>
      <None Include="$(_PackedReadme)" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
  </Target>

  <!--
    nuget.org's "Release notes" tab: the version's page in docs/versions/ - its summary, then a link
    to the whole page at the commit the package was built from. A build between releases has no
    page of its own yet, so it says so and links unreleased.md instead of claiming a version.
  -->
  <Target Name="PackReleaseNotesFromVersionPage"
          BeforeTargets="GenerateNuspec"
          DependsOnTargets="PackReadmeWithAbsoluteLinks">
    <ReleaseNotesFromVersionPage Versions="$(MSBuildThisFileDirectory)..\..\docs\versions"
                                 Version="$(Version)"
                                 PageBaseUrl="$(PackageProjectUrl)/blob/$(_ReadmeRevision)/docs/versions/">
      <Output TaskParameter="Notes" PropertyName="PackageReleaseNotes" />
    </ReleaseNotesFromVersionPage>
  </Target>

  <UsingTask TaskName="ReleaseNotesFromVersionPage"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Versions ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
      <PageBaseUrl ParameterType="System.String" Required="true" />
      <Notes ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
            var page = Path.Combine(Versions, Version + ".md");
            if (!File.Exists(page))
            {
                Notes = "A build between releases: what has landed since the last one is in "
                    + PageBaseUrl + "unreleased.md";
                return true;
            }

            // The summary: the paragraphs between the "All versions" link and the first section.
            var summary = string.Join(" ", File.ReadAllLines(page)
                .Skip(1)
                .TakeWhile(line => !line.StartsWith("## "))
                .Where(line => line.Trim().Length > 0 && !line.StartsWith("[All versions]"))
                .Select(line => line.Trim()));

            // Links read as their text: nuget.org shows the notes as plain text.
            summary = Regex.Replace(summary, @"\s*\(\[([^\]]*)\]\([^)]*\)\)", "");
            summary = Regex.Replace(summary, @"\[([^\]]*)\]\([^)]*\)", "$1");
            Notes = summary + "\n\nWhat changed, and how to upgrade: " + PageBaseUrl + Version + ".md";
            return true;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Source Link for the XAML. On a runner, ContinuousIntegrationBuild maps the C# paths in the PDB
    to /_/, and Source Link maps /_/ to the commit on GitHub. Avalonia's XAML compiler writes its
    sequence points after the C# compiler, with the real path and no path map (its
    CompileAvaloniaXamlTask takes none), so a debugger stepping into a theme's XAML found no
    mapping and no file. This adds the unmapped repository root to the same Source Link map,
    before the compiler embeds it: the XAML still carries the runner's path, but it now resolves
    to the file at the commit.
  -->
  <Target Name="MapXamlSourcesInSourceLink"
          AfterTargets="GenerateSourceLinkFile"
          Condition="'$(DeterministicSourcePaths)' == 'true' And '$(SourceLink)' != '' And Exists('$(SourceLink)')">
    <ItemGroup>
      <_XamlSourceRoot Include="@(SourceRoot)"
                       Condition="'%(SourceRoot.SourceLinkUrl)' != '' And '%(SourceRoot.MappedPath)' != '' And '%(SourceRoot.MappedPath)' != '%(SourceRoot.Identity)'" />
    </ItemGroup>
    <AddUnmappedSourceLinkRoots SourceLinkFile="$(SourceLink)" Roots="@(_XamlSourceRoot)" />
  </Target>

  <UsingTask TaskName="AddUnmappedSourceLinkRoots"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceLinkFile ParameterType="System.String" Required="true" />
      <Roots ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
            var json = File.ReadAllText(SourceLinkFile);
            var added = new StringBuilder();
            foreach (var root in Roots)
            {
                var path = root.ItemSpec.Replace("\\", "\\\\").Replace("\"", "\\\"");
                var url = root.GetMetadata("SourceLinkUrl").Replace("\\", "\\\\").Replace("\"", "\\\"");
                added.Append("\"").Append(path).Append("*\":\"").Append(url).Append("\",");
            }

            const string Documents = "{\"documents\":{";
            if (added.Length > 0 && json.StartsWith(Documents))
            {
                File.WriteAllText(SourceLinkFile, Documents + added + json.Substring(Documents.Length));
            }

            return true;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="AbsoluteReadmeLinks"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <BaseUrl ParameterType="System.String" Required="true" />
      <ImageBaseUrl ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
            var root = Path.GetDirectoryName(Path.GetFullPath(Source));
            var text = Regex.Replace(
                File.ReadAllText(Source),
                @"(!\[[^\]]*)?\]\((?!https?:|#|mailto:)([^)\s]+)\)",
                match =>
                {
                    var image = match.Groups[1].Success;
                    var target = match.Groups[2].Value;
                    var path = Path.Combine(root, target.Split('#')[0]);
                    if (!File.Exists(path) && !Directory.Exists(path))
                    {
                        Log.LogError("README.md links to " + target + ", which does not exist.");
                    }

                    return match.Groups[1].Value + "](" + (image ? ImageBaseUrl : BaseUrl) + target + ")";
                });
            Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(Destination)));
            File.WriteAllText(Destination, text);
            return !Log.HasLoggedErrors;
        }
      ]]></Code>
    </Task>
  </UsingTask>

</Project>
