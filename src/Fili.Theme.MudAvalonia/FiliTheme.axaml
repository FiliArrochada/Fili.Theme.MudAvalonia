  <!-- END GENERATED -->
  <!-- After the colours, which it ignores: `mud-avatar-text-{color}` has no rule. -->
  <Style Selector="Border.avatar.text">
    <Setter Property="Background" Value="{DynamicResource FiliGrayLightBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliAvatarBareTextBrush}" />
