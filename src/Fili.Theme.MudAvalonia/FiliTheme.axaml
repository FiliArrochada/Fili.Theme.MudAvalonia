  <!--
    SelectionMode.MultiSelection on MudList and MudTreeView: `multi-selection` puts a checkbox on
    each row, checked while the row is selected; the app sets SelectionMode="Multiple, Toggle",
    the behaviour. The class cannot: a SelectingItemsControl declared in XAML creates its selection
    model at EndInit, before any style applies, and that writes SelectionMode as a LOCAL value,
    which no style setter outranks. The row itself is no longer marked (`mud-selected-item` is only added for single selection), so it keeps
    the text colour and takes the hover and focus tints like any other. The checkbox is
    CheckBoxColor: action-default with no colour class, or the colour class on the list - which
    names the selection's Color otherwise, unused while selecting many. A tree's branch does not
    work out its children's state: its box is checked or not, never indeterminate.
  -->
  <Style Selector="ListBox.multi-selection ListBoxItem /template/ Panel#PART_CheckBox, TreeView.multi-selection TreeViewItem /template/ Panel#PART_CheckBox">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBox.multi-selection ListBoxItem:selected /template/ Path#PART_CheckUnchecked, TreeView.multi-selection TreeViewItem:selected /template/ Path#PART_CheckUnchecked">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.multi-selection ListBoxItem:selected /template/ Path#PART_CheckChecked, TreeView.multi-selection TreeViewItem:selected /template/ Path#PART_CheckChecked">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBox.multi-selection ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.multi-selection ListBoxItem:selected /template/ theme|PartBorder#PART_StateLayer">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.multi-selection ListBoxItem:selected:pointerover /template/ theme|PartBorder#PART_StateLayer, ListBox.multi-selection ListBoxItem:selected:focus-visible /template/ theme|PartBorder#PART_StateLayer">
    <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
  </Style>
  <Style Selector="TreeView.multi-selection TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
  </Style>
  <Style Selector="TreeView.multi-selection TreeViewItem:selected /template/ theme|PartBorder#SelectionBorder">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TreeView.multi-selection.hover TreeViewItem:selected /template/ theme|PartBorder#SelectionBorder:pointerover, TreeView.multi-selection TreeViewItem:selected:focus-visible /template/ theme|PartBorder#SelectionBorder">
    <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
  </Style>
  <!-- `.mud-treeview-dense .mud-icon-button`: no padding, so the checkbox is the bare 24px glyph. -->
  <Style Selector="TreeView.dense TreeViewItem /template/ Panel#PART_CheckBox">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <!-- GENERATED by ThemeColourGenerator: multi-selection checkbox colours. -->
  <Style Selector="ListBox.multi-selection, TreeView.multi-selection">
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliActionDefaultBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
  </Style>
  <Style Selector="ListBox.multi-selection.primary, TreeView.multi-selection.primary">
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliPrimaryHoverBrush}" />
  </Style>
  <Style Selector="ListBox.multi-selection.secondary, TreeView.multi-selection.secondary">
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliSecondaryBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliSecondaryHoverBrush}" />
  </Style>
  <Style Selector="ListBox.multi-selection.tertiary, TreeView.multi-selection.tertiary">
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliTertiaryBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliTertiaryHoverBrush}" />
  </Style>
  <Style Selector="ListBox.multi-selection.info, TreeView.multi-selection.info">
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliInfoBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliInfoHoverBrush}" />
  </Style>
  <Style Selector="ListBox.multi-selection.success, TreeView.multi-selection.success">
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliSuccessBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliSuccessHoverBrush}" />
  </Style>
  <Style Selector="ListBox.multi-selection.warning, TreeView.multi-selection.warning">
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliWarningBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliWarningHoverBrush}" />
  </Style>
  <Style Selector="ListBox.multi-selection.error, TreeView.multi-selection.error">
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliErrorBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliErrorHoverBrush}" />
  </Style>
  <Style Selector="ListBox.multi-selection.dark, TreeView.multi-selection.dark">
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliDarkBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliDarkHoverBrush}" />
  </Style>
  <Style Selector="ListBox.multi-selection ListBoxItem /template/ Panel#PART_CheckBox > Path">
    <Setter Property="Fill" Value="{Binding $parent[ListBox].(theme:Accent.Colour)}" />
  </Style>
  <Style Selector="ListBox.multi-selection ListBoxItem /template/ Panel#PART_CheckBox:pointerover > Ellipse#PART_CheckHalo">
    <Setter Property="Fill" Value="{Binding $parent[ListBox].(theme:Accent.Hover)}" />
  </Style>
  <Style Selector="TreeView.multi-selection TreeViewItem /template/ Panel#PART_CheckBox > Path">
    <Setter Property="Fill" Value="{Binding $parent[TreeView].(theme:Accent.Colour)}" />
  </Style>
  <Style Selector="TreeView.multi-selection TreeViewItem /template/ Panel#PART_CheckBox:pointerover > Ellipse#PART_CheckHalo">
    <Setter Property="Fill" Value="{Binding $parent[TreeView].(theme:Accent.Hover)}" />
  </Style>
  <!-- END GENERATED -->
  <Style Selector="ListBox.multi-selection ListBoxItem:disabled /template/ Panel#PART_CheckBox > Path, TreeView.multi-selection TreeViewItem:disabled /template/ Panel#PART_CheckBox > Path">
    <Setter Property="Fill" Value="{DynamicResource FiliTextDisabledBrush}" />
  </Style>

  <!--
    MudMenu.Dense: rows of 2px 12px in body2. On the ContextMenu, the MenuFlyout's presenter
    (FlyoutPresenterClasses) or the item whose submenu it is, so it reaches every row under it.
  -->
  <Style Selector="ContextMenu.dense MenuItem, MenuFlyoutPresenter.dense MenuItem, MenuItem.dense MenuItem">
    <Setter Property="Padding" Value="12,2" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
  </Style>

  <!--
    MudIcon on a PathIcon: `small`, `medium` and `large` are its Size (20, 24 and 36px), and a
    colour class its Color. Last of the icon rules, so an icon's own class beats one that sizes
    or colours it by where it sits - an icon button's, an alert's. Color.Default, text-secondary,
    has no class; with none the icon inherits, as Color.Inherit, MudIcon's default, does.
  -->
  <!-- GENERATED by ThemeColourGenerator: icon sizes and colours. -->
  <Style Selector="PathIcon.small">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="PathIcon.medium">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="PathIcon.large">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
  </Style>
  <Style Selector="PathIcon.primary">
    <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="PathIcon.secondary">
    <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
  </Style>
  <Style Selector="PathIcon.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
  </Style>
  <Style Selector="PathIcon.info">
    <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
  </Style>
  <Style Selector="PathIcon.success">
    <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
  </Style>
  <Style Selector="PathIcon.warning">
    <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
  </Style>
  <Style Selector="PathIcon.error">
    <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="PathIcon.dark">
    <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!--
    MudTable's row states on a TableView, from _table.scss: here because a row's theme cannot see
    its table's classes. A stripe on odd rows, then `hover` over it as `.mud-table-hover` is, then
    the selection that Themes/Controls/TableView.axaml puts on the row itself; `dense` is
    6px 24px 6px 16px a cell and the header, 16px on the right of the last. `bordered` is
    `.mud-table-bordered`: 1px of table-lines on the right of every body cell but the last, and
    none in the header, which MudTable rules only for a `table-head-bordered` HeaderClass.
  -->
  <Style Selector="TableView.striped TableViewRow:nth-child(odd)">
    <Setter Property="Background" Value="{DynamicResource FiliTableStripedBrush}" />
  </Style>
  <Style Selector="TableView.hover TableViewRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource FiliTableHoverBrush}" />
  </Style>
  <Style Selector="TableView TableViewRow:selected">
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
  </Style>
  <Style Selector="TableView.dense TableViewCell, TableView.dense TableViewColumnHeader">
    <Setter Property="Padding" Value="16,6,24,6" />
  </Style>
  <Style Selector="TableView.dense TableViewCell:nth-last-child(1), TableView.dense TableViewColumnHeader:nth-last-child(1)">
    <Setter Property="Padding" Value="16,6,16,6" />
  </Style>
  <Style Selector="TableView.bordered TableViewCell">
    <Setter Property="BorderBrush" Value="{DynamicResource FiliTableLinesBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="TableView.bordered TableViewCell:nth-last-child(1)">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    The spinner DatePicker, which still wears the forked Simple template. Type and radius are all
    a blanket style can safely give a control it does not template.

    Every other input used to be in this selector and has been taken out as it was templated,
    because A STYLE ALWAYS OUTRANKS A CONTROLTHEME SETTER. Left in, the CornerRadius below would
    have quietly overridden the standard field's 0 and the filled field's top-only 4,4,0,0 - the
    same trap as the TextBlock Foreground one above, in a different costume. The rule to carry
    forward: when a control gets a ControlTheme, delete it from here.
  -->
  <Style Selector="DatePicker">
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
  </Style>

</Styles>
