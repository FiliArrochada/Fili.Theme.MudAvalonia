  <Style Selector="TabControl[(theme|Accent.Bar)=True] /template/ Button#PART_ScrollNext:not(:disabled)">
    <Setter Property="Foreground" Value="{Binding (theme:Accent.Colour), RelativeSource={RelativeSource TemplatedParent}}" />
