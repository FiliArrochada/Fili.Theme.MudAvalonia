  <!--
    MudMenu.Dense: rows of 2px 12px in body2. On the ContextMenu, the MenuFlyout's presenter
    (FlyoutPresenterClasses) or the item whose submenu it is, so it reaches every row under it.
  -->
  <Style Selector="ContextMenu.dense MenuItem, MenuFlyoutPresenter.dense MenuItem, MenuItem.dense MenuItem">
    <Setter Property="Padding" Value="12,2" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
  </Style>

  <!--
    MudIcon on a PathIcon: `small`, `medium` and `large` are its Size (20, 24 and 36px), and a
    colour class its Color. Last of the icon rules, so an icon's own class beats one that sizes
    or colours it by where it sits - an icon button's, an alert's. Color.Default, text-secondary,
    has no class; with none the icon inherits, as Color.Inherit, MudIcon's default, does.
  -->
  <!-- GENERATED by ThemeColourGenerator: icon sizes and colours. -->
  <Style Selector="PathIcon.small">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="PathIcon.medium">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="PathIcon.large">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
  </Style>
  <Style Selector="PathIcon.primary">
    <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="PathIcon.secondary">
    <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
  </Style>
  <Style Selector="PathIcon.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
  </Style>
  <Style Selector="PathIcon.info">
    <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
  </Style>
  <Style Selector="PathIcon.success">
    <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
  </Style>
  <Style Selector="PathIcon.warning">
    <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
  </Style>
  <Style Selector="PathIcon.error">
    <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="PathIcon.dark">
    <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!--
    The pickers, which are still wearing forked Simple templates. Type and radius are all a
    blanket style can safely give a control it does not template.

    Every other input used to be in this selector and has been taken out as it was templated,
    because A STYLE ALWAYS OUTRANKS A CONTROLTHEME SETTER. Left in, the CornerRadius below would
    have quietly overridden the standard field's 0 and the filled field's top-only 4,4,0,0 - the
    same trap as the TextBlock Foreground one above, in a different costume. The rule to carry
    forward: when a control gets a ControlTheme, delete it from here.
  -->
  <Style Selector="DatePicker, TimePicker, CalendarDatePicker">
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
  </Style>

</Styles>
