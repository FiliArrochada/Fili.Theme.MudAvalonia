    <Setter Property="theme:Accent.Ground" Value="{DynamicResource FiliWarningBrush}" />
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliWarningContrastTextBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliWarningLightenBrush}" />
  </Style>
  <Style Selector="TabStrip.warning">
