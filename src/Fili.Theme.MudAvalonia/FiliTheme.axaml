  <!-- END GENERATED -->

  <!-- MudPaper.Square on a card: `.mud-paper-square`, no radius, and none on its media either.
       A paper's is `CornerRadius="0"`: one property, so no class. -->
  <Style Selector="Border.card.square">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <!-- An outlined paper or card has no elevation at all: MudPaper adds `mud-elevation-{n}` only
       when it is not outlined, so this beats an elevation class too. -->
  <Style Selector="Border.paper.outlined, Border.card.outlined">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
  </Style>

  <!--
    MudCard's parts, from _card.scss, as classes on whatever lays the card out - usually a
    StackPanel inside the `card` Border:

      card-header           MudCardHeader: 16px round; a DockPanel, so its content fills
        card-header-avatar    CardHeaderAvatar: docked at the start, 16px from the content
        card-header-actions   CardHeaderActions: docked at the end, pulled 8px up and out
        card-header-content   CardHeaderContent: the rest, and last, so the DockPanel fills with it
      card-media            MudCardMedia: a Border 300px high; an Image in it covers it, and the
                            top corners follow the card's when it comes first
      card-content          MudCardContent: 16px round
      card-actions          MudCardActions: a row, 8px round, its items centred

    The paddings are margins here, since a Panel has none; nothing paints behind them, so they
    look the same. ContentPadding="false" is Margin="0" on the part.

    A part is a StackPanel, DockPanel, Grid, WrapPanel, Border, TextBlock, Button or Image, named in
    each selector: on `:is(Control)` each part's style was an instance on every control in the
    window. A card-actions row is a panel; ChildAlignment centres its items.
  -->
  <Style Selector="StackPanel.card-header, DockPanel.card-header, Grid.card-header, WrapPanel.card-header, Border.card-header, TextBlock.card-header, Button.card-header, Image.card-header">
    <Setter Property="Margin" Value="16" />
  </Style>
