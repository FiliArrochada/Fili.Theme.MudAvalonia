  </Style>
  <Style Selector="Border.avatar.outlined.primary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="Border.avatar.outlined.secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
