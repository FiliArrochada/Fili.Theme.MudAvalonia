  <!--
    A mini drawer's nav: a compact SplitView (CompactInline or CompactOverlay) with its pane closed
    is a closed `.mud-drawer-mini`. The text beside a link's icon goes (sr-only there,
    so a TextBlock in the header's panel here), leaving the icon in the 56px rail, and every row
    is 8px 16px whatever its depth.

    A DrawerPage's drawer is the same mini drawer, matched on the DrawerPage itself: its SplitView
    is inside its template, and the menu's logical parent is the DrawerPage, so a SplitView
    selector never reaches it. Its rail is DrawerMiniWidthLeft's 56px too, unless the app sets
    CompactDrawerLength.
  -->
  <Style Selector="SplitView:closed:compactinline TreeView.nav TreeViewItem > StackPanel > TextBlock,
                   SplitView:closed:compactoverlay TreeView.nav TreeViewItem > StackPanel > TextBlock,
                   DrawerPage[IsOpen=False][DisplayMode=CompactInline] TreeView.nav TreeViewItem > StackPanel > TextBlock,
                   DrawerPage[IsOpen=False][DisplayMode=CompactOverlay] TreeView.nav TreeViewItem > StackPanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="SplitView:closed:compactinline TreeView.nav TreeViewItem /template/ Border#PART_Indent,
                   SplitView:closed:compactoverlay TreeView.nav TreeViewItem /template/ Border#PART_Indent,
                   DrawerPage[IsOpen=False][DisplayMode=CompactInline] TreeView.nav TreeViewItem /template/ Border#PART_Indent,
                   DrawerPage[IsOpen=False][DisplayMode=CompactOverlay] TreeView.nav TreeViewItem /template/ Border#PART_Indent">
    <Setter Property="Width" Value="0" />
  </Style>
  <!-- The 12px between icon and text is `.mud-nav-link-text`'s, so it goes with the text: an icon
       keeping it would make each row 68px in a 56px rail, and the menu would scroll sideways. -->
  <Style Selector="SplitView:closed:compactinline TreeView.nav TreeViewItem :is(Control).start-icon,
                   SplitView:closed:compactoverlay TreeView.nav TreeViewItem :is(Control).start-icon,
                   DrawerPage[IsOpen=False][DisplayMode=CompactInline] TreeView.nav TreeViewItem :is(Control).start-icon,
                   DrawerPage[IsOpen=False][DisplayMode=CompactOverlay] TreeView.nav TreeViewItem :is(Control).start-icon">
    <Setter Property="Margin" Value="-12,0,0,0" />
  </Style>
  <!-- A group's row still carries its ExpandMore at the end, which MudBlazor's closed mini drawer
       does not hide either: its rows are the rail's width and the arrow runs past the edge. So the
       menu lays out at the rail's width rather than scrolling sideways to reach the arrow. -->
  <Style Selector="SplitView:closed:compactinline TreeView.nav,
                   SplitView:closed:compactoverlay TreeView.nav,
                   DrawerPage[IsOpen=False][DisplayMode=CompactInline] TreeView.nav,
                   DrawerPage[IsOpen=False][DisplayMode=CompactOverlay] TreeView.nav">
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="DrawerPage">
    <Setter Property="CompactDrawerLength" Value="{DynamicResource FiliDrawerMiniWidth}" />
  </Style>

