  <!--
    A mini drawer's nav: a compact SplitView (CompactInline or CompactOverlay) with its pane closed
    is a closed `.mud-drawer-mini`. The text beside a link's icon goes (sr-only there,
    so a TextBlock in the header's panel here), leaving the icon in the 56px rail, and every row
    is 8px 16px whatever its depth.

    A DrawerPage's drawer is the same mini drawer, matched on the DrawerPage itself: its SplitView
    is inside its template, and the menu's logical parent is the DrawerPage, so a SplitView
    selector never reaches it. Its rail is DrawerMiniWidthLeft's 56px too, unless the app sets
    CompactDrawerLength.
  -->
  <Style Selector="SplitView:closed:compactinline TreeView.nav TreeViewItem > StackPanel > TextBlock,
                   SplitView:closed:compactoverlay TreeView.nav TreeViewItem > StackPanel > TextBlock,
                   DrawerPage[IsOpen=False][DisplayMode=CompactInline] TreeView.nav TreeViewItem > StackPanel > TextBlock,
                   DrawerPage[IsOpen=False][DisplayMode=CompactOverlay] TreeView.nav TreeViewItem > StackPanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="SplitView:closed:compactinline TreeView.nav TreeViewItem /template/ theme|PartBorder#PART_Indent,
                   SplitView:closed:compactoverlay TreeView.nav TreeViewItem /template/ theme|PartBorder#PART_Indent,
                   DrawerPage[IsOpen=False][DisplayMode=CompactInline] TreeView.nav TreeViewItem /template/ theme|PartBorder#PART_Indent,
                   DrawerPage[IsOpen=False][DisplayMode=CompactOverlay] TreeView.nav TreeViewItem /template/ theme|PartBorder#PART_Indent">
    <Setter Property="Width" Value="0" />
  </Style>
  <!-- The 12px between icon and text is `.mud-nav-link-text`'s, so it goes with the text: an icon
       keeping it would make each row 68px in a 56px rail, and the menu would scroll sideways. -->
  <Style Selector="SplitView:closed:compactinline TreeView.nav TreeViewItem,
                   SplitView:closed:compactoverlay TreeView.nav TreeViewItem,
                   DrawerPage[IsOpen=False][DisplayMode=CompactInline] TreeView.nav TreeViewItem,
                   DrawerPage[IsOpen=False][DisplayMode=CompactOverlay] TreeView.nav TreeViewItem">
    <Setter Property="theme:IconSlot.StartMargin" Value="-12,0,0,0" />
  </Style>
