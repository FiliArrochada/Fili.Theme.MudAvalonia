  <!-- The content, centred; an icon is MudIcon's Size.Medium, 24px, at every avatar size. -->
  <Style Selector="Border.avatar > :is(Control)">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
