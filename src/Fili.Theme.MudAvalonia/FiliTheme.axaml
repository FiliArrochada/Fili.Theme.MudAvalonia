    <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
  </Style>
  <Style Selector="TabStrip.dark > TabStripItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
  </Style>
  <Style Selector="TabStrip.dark > TabStripItem:selected /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliDarkContrastTextBrush}" />
  </Style>
  <Style Selector="TabStrip.dark > TabStripItem:selected:pointerover /template/ Border#PART_StateLayer">
    <Setter Property="Background" Value="{DynamicResource FiliDarkLightenBrush}" />
  </Style>
  <Style Selector="TabStrip.dark > TabStripItem:selected:focus-visible /template/ Border#PART_StateLayer">
    <Setter Property="Background" Value="{DynamicResource FiliDarkLightenBrush}" />
  </Style>
  <Style Selector="TabControl.slider-primary > TabItem /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="TabStrip.slider-primary > TabStripItem:selected /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="TabControl.slider-secondary > TabItem /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
  </Style>
  <Style Selector="TabStrip.slider-secondary > TabStripItem:selected /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
  </Style>
  <Style Selector="TabControl.slider-tertiary > TabItem /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
  </Style>
  <Style Selector="TabStrip.slider-tertiary > TabStripItem:selected /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
  </Style>
  <Style Selector="TabControl.slider-info > TabItem /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
  </Style>
  <Style Selector="TabStrip.slider-info > TabStripItem:selected /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
  </Style>
  <Style Selector="TabControl.slider-success > TabItem /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
  </Style>
  <Style Selector="TabStrip.slider-success > TabStripItem:selected /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
  </Style>
  <Style Selector="TabControl.slider-warning > TabItem /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
  </Style>
  <Style Selector="TabStrip.slider-warning > TabStripItem:selected /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
  </Style>
  <Style Selector="TabControl.slider-error > TabItem /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="TabStrip.slider-error > TabStripItem:selected /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="TabControl.slider-dark > TabItem /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <Style Selector="TabStrip.slider-dark > TabStripItem:selected /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!-- ============================== Controls ==============================
       VARIANTS ONLY. The templates live in Themes/Controls/, keyed by type.
  -->

  <!--
    Packages this theme builds against but does not depend on, each loaded only when the app has
    it. Here, among the control styles, because their row and state rules are Styles and the later
    style wins. MinimumVersion is the version Directory.Packages.props builds against.
  -->
  <theme:OptionalStyleInclude Requires="Avalonia.Controls.DataGrid"
                              MinimumVersion="12.1.0"
                              Source="avares://Fili.Theme.MudAvalonia/Themes/Optional/DataGrid/DataGridStyles.axaml" />

  <!--
    MudButton.Variant defaults to Variant.Text, so an unclassed Button is already the text one.
    Only the VARIANT switches theme here; colour and size are classes the active theme reads
    itself (Themes/Controls/Button.axaml), so `filled primary small` composes.
  -->
  <Style Selector="Button.text">
    <Setter Property="Theme" Value="{StaticResource FiliTextButton}" />
  </Style>

  <Style Selector="Button.outlined">
    <Setter Property="Theme" Value="{StaticResource FiliOutlinedButton}" />
  </Style>

  <Style Selector="Button.filled">
    <Setter Property="Theme" Value="{StaticResource FiliFilledButton}" />
  </Style>

  <!--
    MudChip is a theme a Button or ToggleButton takes, not a variant of the button, so `chip` wins
    over `outlined` / `filled` here by coming after them; the chip theme reads those classes itself
    as ITS variants. Themes/Controls/Chip.axaml.
  -->
  <Style Selector="Button.chip">
    <Setter Property="Theme" Value="{StaticResource FiliChip}" />
  </Style>

  <!--
    MudToggleIconButton is `icon` on a ToggleButton: the icon button's look and variants
    (Themes/Controls/ToggleButton.axaml). A colour class is ToggledColor, shown while checked, and
    `unchecked-{color}` is Color, shown while not; with neither it is action-default, as both
    default to Color.Default. ToggledIcon is a second PathIcon: put both in a Panel, Icon first,
    and the second shows only while checked. Before the chip's, so `chip` wins over `icon`.
  -->
  <Style Selector="ToggleButton.icon">
    <Setter Property="Theme" Value="{StaticResource FiliToggleIconButton}" />
  </Style>
  <Style Selector="ToggleButton.icon.outlined">
    <Setter Property="Theme" Value="{StaticResource FiliOutlinedToggleIconButton}" />
  </Style>
  <Style Selector="ToggleButton.icon.filled">
    <Setter Property="Theme" Value="{StaticResource FiliFilledToggleIconButton}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked :is(Panel) > PathIcon:nth-child(1):nth-last-child(2)">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleButton.icon:unchecked :is(Panel) > PathIcon:nth-child(2):nth-last-child(1)">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="Theme" Value="{StaticResource FiliChip}" />
  </Style>

  <!--
    DrawerPage's pane toggles are MudLayout's drawer button, a MudIconButton: an action-default
    icon in a round hover tint, the same open or closed. As plain ToggleButtons they would be
    MudToggleItem, filled once checked, and the template's own Background="Transparent" beats that
    fill and leaves the contrast-coloured icon on nothing. The forked template stays as it is, so
    the toggles take the icon toggle's theme here, with the four values its `icon` class would
    add: a style cannot add a class. No colour class, so checked looks as unchecked does.
  -->
  <Style Selector="DrawerPage /template/ ToggleButton#PART_PaneButton, DrawerPage /template/ ToggleButton#PART_BottomPaneButton, DrawerPage /template/ ToggleButton#PART_CompactPaneToggle">
    <Setter Property="Theme" Value="{StaticResource FiliToggleIconButton}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FiliActionDefaultBrush}" />
  </Style>

  <!-- MudFab is a theme a Button takes, like a chip, and reads `outlined` and `text` itself as ITS
       variants - filled being its default. Themes/Controls/Fab.axaml. -->
  <Style Selector="Button.fab">
    <Setter Property="Theme" Value="{StaticResource FiliFab}" />
  </Style>

  <!-- MudBadge is a theme a HeaderedContentControl takes: Content is what it decorates, Header the
       badge. Themes/Controls/Badge.axaml. -->
  <Style Selector="HeaderedContentControl.badge">
    <Setter Property="Theme" Value="{StaticResource FiliBadge}" />
  </Style>

  <!-- MudProgressCircular is a theme a ProgressBar takes, as a chip is one a Button takes; it reads
       the size, colour and `rounded` classes itself. Themes/Controls/ProgressCircular.axaml. -->
  <Style Selector="ProgressBar.circular">
    <Setter Property="Theme" Value="{StaticResource FiliProgressCircular}" />
  </Style>

  <!--
    The icon of an icon button. MudBlazor sizes it with font-size on the MudIcon; Avalonia's PathIcon
    is sized by Width/Height, so these set it: 24px (`.mud-icon-button` 1.5rem), 18px small
    (1.125rem), 36px large for a text icon button (`.mud-icon-size-large` 2.25rem) and 32px large
    for an outlined or filled one (2rem). A local Width/Height on the icon still wins.
  -->
  <Style Selector="Button.icon PathIcon, ToggleButton.icon PathIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Button.icon.small PathIcon, ToggleButton.icon.small PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.icon.large PathIcon, ToggleButton.icon.large PathIcon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
  </Style>
  <Style Selector="Button.icon.large.outlined PathIcon, Button.icon.large.filled PathIcon, ToggleButton.icon.large.outlined PathIcon, ToggleButton.icon.large.filled PathIcon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
  </Style>

  <!--
    MudButton's StartIcon and EndIcon, and MudChip's Icon, as classes on whatever icon a button's
    content carries: `<PathIcon Classes="start-icon" />` before the label, `end-icon` after it.
    From _button.scss: 20px (18 small, 22 large), the start icon pulled 4px out and spaced 8px
    from the label (2px out when small), the end icon the mirror. A chip's icon is
    `.mud-chip-icon` at MudIcon Size.Small: 20px (18 on a small chip, 24 on a large one), 4px out
    and 4px in (6px on a large chip); its end icon takes the close button's place, 18px, 6px from
    the label and 4px out.
  -->
  <Style Selector="Button :is(Control).start-icon, ToggleButton :is(Control).start-icon, SplitButton :is(Control).start-icon, DropDownButton :is(Control).start-icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="-4,0,8,0" />
  </Style>
  <Style Selector="Button :is(Control).end-icon, ToggleButton :is(Control).end-icon, SplitButton :is(Control).end-icon, DropDownButton :is(Control).end-icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="8,0,-4,0" />
  </Style>
  <Style Selector="Button.small :is(Control).start-icon, ToggleButton.small :is(Control).start-icon, SplitButton.small :is(Control).start-icon, DropDownButton.small :is(Control).start-icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="-2,0,8,0" />
  </Style>
  <Style Selector="Button.small :is(Control).end-icon, ToggleButton.small :is(Control).end-icon, SplitButton.small :is(Control).end-icon, DropDownButton.small :is(Control).end-icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="8,0,-2,0" />
  </Style>
  <Style Selector="Button.large :is(Control).start-icon, ToggleButton.large :is(Control).start-icon, SplitButton.large :is(Control).start-icon, DropDownButton.large :is(Control).start-icon, Button.large :is(Control).end-icon, ToggleButton.large :is(Control).end-icon, SplitButton.large :is(Control).end-icon, DropDownButton.large :is(Control).end-icon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>

  <Style Selector="Button.chip :is(Control).start-icon, ToggleButton.chip :is(Control).start-icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="-4,0,4,0" />
  </Style>
  <Style Selector="Button.chip.small :is(Control).start-icon, ToggleButton.chip.small :is(Control).start-icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.chip.large :is(Control).start-icon, ToggleButton.chip.large :is(Control).start-icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="-6,0,6,0" />
  </Style>
  <Style Selector="Button.chip :is(Control).end-icon, ToggleButton.chip :is(Control).end-icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="6,0,-4,0" />
  </Style>

  <!-- A FAB's icons are MudIcon at its IconSize, Size.Medium: 24px whatever the FAB's size. In an
       `extended` FAB the label's gap sits between icon and text, 8px (4px when small). -->
  <Style Selector="Button.fab PathIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Button.fab :is(Control).start-icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="Button.fab :is(Control).end-icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style Selector="Button.fab.small :is(Control).start-icon">
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="Button.fab.small :is(Control).end-icon">
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>

  <Style Selector="TextBox.filled">
    <Setter Property="Theme" Value="{StaticResource FiliFilledTextBox}" />
  </Style>

  <Style Selector="TextBox.outlined">
    <Setter Property="Theme" Value="{StaticResource FiliOutlinedTextBox}" />
  </Style>

  <Style Selector="ComboBox.filled">
    <Setter Property="Theme" Value="{StaticResource FiliFilledComboBox}" />
  </Style>

  <Style Selector="ComboBox.outlined">
    <Setter Property="Theme" Value="{StaticResource FiliOutlinedComboBox}" />
  </Style>

  <!--
    ============================== Drawer ==============================

    SplitView is MudDrawer, and it is the one control here treated with STYLES rather than with a
    ControlTheme. That is deliberate, and the reasoning is the same one that deleted the
    ScrollViewer and Window themes.

    Everything MudDrawer contributes is a VALUE, not a shape. layout/_drawer.scss gives it
    the drawer-background and drawer-text palette tokens;
    LayoutProperties.cs gives `DrawerWidthLeft = "240px"` and `DrawerMiniWidthLeft = "56px"`,
    which are already FiliDrawerWidth and FiliDrawerMiniWidth; MudDrawer.Elevation defaults to 1.
    None of that needs a template.

    What the template DOES carry is the pane sliding, the display modes and the light-dismiss
    layer - structure, where a wrong part name produces a drawer that lays out perfectly and
    never opens. So the fork keeps it, and these styles change what it paints from.

    Note the mechanism: a Style outranks a ControlTheme setter, which is normally the trap this
    file warns about and is exactly what makes this work. The forked theme's own
    OpenPaneLength/CompactPaneLength/PaneBackground setters lose to these.

    Not carried over: the pane's elevation-1 shadow, because the pane root is a Panel and only a
    Border can carry a BoxShadow. Adding one means owning the template.
  -->
  <Style Selector="SplitView">
    <Setter Property="OpenPaneLength" Value="{DynamicResource FiliDrawerWidth}" />
    <Setter Property="CompactPaneLength" Value="{DynamicResource FiliDrawerMiniWidth}" />
    <Setter Property="PaneBackground" Value="{DynamicResource FiliDrawerBackgroundBrush}" />
  </Style>

  <!--
    The pane's edge. Avalonia's Simple SplitView already carries a 1px Rectangle for it, named
    HCPaneBorder and left Transparent, so no fork edit and no ControlTheme are needed - only a
    Fill. It stays invisible in light and dark, where the drawer is separated by its own
    background, and appears in High Contrast, where both grounds are black and the rail would
    otherwise dissolve into the page.

    THE FOUR SELECTORS ARE NOT PADDING, and this is the sharpest priority rule in Avalonia:

      Animation < LocalValue < StyleTrigger < Template < Style

    Lower binds harder. A value written INSIDE a ControlTemplate - like this rectangle's
    Fill="Transparent" - binds at Template, which OUTRANKS an ordinary Style. So the obvious
    `SplitView /template/ Rectangle#HCPaneBorder` setter does nothing at all, silently, and looks
    for all the world like a selector that failed to match. Add an activator - any pseudo-class -
    and the same setter binds at StyleTrigger instead, which does win. That is also why the
    floating-label transforms elsewhere in this package work: every one of them is on a `:focus`.

    Those are the four values DisplayMode can take, so between them they are always true. Naming
    them is the honest way to buy the activator; a `:not(.some-class-nobody-applies)` would buy
    the same thing while pretending to mean something.
  -->
  <Style Selector="SplitView:inline /template/ Rectangle#HCPaneBorder,
                   SplitView:compactinline /template/ Rectangle#HCPaneBorder,
                   SplitView:overlay /template/ Rectangle#HCPaneBorder,
                   SplitView:compactoverlay /template/ Rectangle#HCPaneBorder">
    <Setter Property="Fill" Value="{DynamicResource FiliDrawerBorderBrush}" />
  </Style>

  <!-- drawer-text, on the pane only: the content beside it keeps the page's own foreground. -->
  <Style Selector="SplitView /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDrawerTextBrush}" />
  </Style>

  <!-- The scrim behind a temporary drawer. MudOverlay's dark variant is #212121 at 50%. -->
  <Style Selector="SplitView /template/ Rectangle#LightDismissLayer">
    <Setter Property="Fill" Value="{DynamicResource FiliOverlayDarkBrush}" />
  </Style>

  <!-- MudDrawer's Color is .mud-theme-{color}: the pane in the colour, its content in the
       contrast text. -->
  <!--
    MudTooltip's Arrow, on a ToolTip with `arrow`. The ToolTip's logical parent is its Popup, so the
    placement picks the side: Top puts the arrow under the chip pointing down, Bottom over it
    pointing up, Left at its right pointing right, Right at its left pointing left - the four
    `.mud-tooltip-{placement}.mud-tooltip-arrow::after` rules. Pointer, MudBlazor's lack, draws none.
  -->
  <Style Selector="Popup[Placement=Top] > ToolTip.arrow /template/ Path#PART_Arrow">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Popup[Placement=Bottom] > ToolTip.arrow /template/ Path#PART_Arrow">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="DockPanel.Dock" Value="Top" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Data" Value="M0,6 L12,6 L6,0 Z" />
  </Style>
  <Style Selector="Popup[Placement=Left] > ToolTip.arrow /template/ Path#PART_Arrow">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Data" Value="M0,0 L6,6 L0,12 Z" />
  </Style>
  <Style Selector="Popup[Placement=Right] > ToolTip.arrow /template/ Path#PART_Arrow">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="DockPanel.Dock" Value="Left" />
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Data" Value="M6,0 L0,6 L6,12 Z" />
  </Style>

  <!-- GENERATED by ThemeColourGenerator: drawer colours. -->
  <Style Selector="SplitView.primary">
    <Setter Property="PaneBackground" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="SplitView.primary /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
  </Style>
  <Style Selector="SplitView.secondary">
    <Setter Property="PaneBackground" Value="{DynamicResource FiliSecondaryBrush}" />
  </Style>
  <Style Selector="SplitView.secondary /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
  </Style>
  <Style Selector="SplitView.tertiary">
    <Setter Property="PaneBackground" Value="{DynamicResource FiliTertiaryBrush}" />
  </Style>
  <Style Selector="SplitView.tertiary /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
  </Style>
  <Style Selector="SplitView.info">
    <Setter Property="PaneBackground" Value="{DynamicResource FiliInfoBrush}" />
  </Style>
  <Style Selector="SplitView.info /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
  </Style>
  <Style Selector="SplitView.success">
    <Setter Property="PaneBackground" Value="{DynamicResource FiliSuccessBrush}" />
  </Style>
  <Style Selector="SplitView.success /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
  </Style>
  <Style Selector="SplitView.warning">
    <Setter Property="PaneBackground" Value="{DynamicResource FiliWarningBrush}" />
  </Style>
  <Style Selector="SplitView.warning /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
  </Style>
  <Style Selector="SplitView.error">
    <Setter Property="PaneBackground" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="SplitView.error /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
  </Style>
  <Style Selector="SplitView.dark">
    <Setter Property="PaneBackground" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <Style Selector="SplitView.dark /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!--
    MudTreeView.Hover, false by default: only a `hover` tree tints the row under the pointer, in
    action-default-hover. A Style rather than part of Themes/Controls/TreeView.axaml, because it
    reaches from the tree to its items and a ControlTheme may not hold a descendant selector.
    The ROW, not the item: an item is :pointerover while the pointer is anywhere over its
    children too, which would light a branch's row along with the child's. A selected row keeps
    its own tint, as `.mud-treeview-item-selected` outranks the hover rule in _treeview.scss.
  -->
  <Style Selector="TreeView.hover TreeViewItem:not(:selected) /template/ Border#SelectionBorder:pointerover">
    <Setter Property="Background" Value="{DynamicResource FiliOverlayHoverBrush}" />
  </Style>

  <!--
    MudTreeView.Dense: `.mud-treeview-dense` drops the 32px minimum from the row and the arrow and
    pads the row 1px 4px.
  -->
  <Style Selector="TreeView.dense TreeViewItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,1" />
  </Style>
  <Style Selector="TreeView.dense TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <!-- MudNavMenu.Dense: `.mud-navmenu-dense .mud-nav-link`, 4px 16px. -->
  <Style Selector="TreeView.nav.dense TreeViewItem">
    <Setter Property="Padding" Value="16,4" />
  </Style>

  <!--
    MudNavMenu: `nav` on a TreeView swaps every row to the nav link (FiliNavItem, in
    Themes/Controls/TreeView.axaml). Its options reach from the tree to the rows, so they are
    here: `dense` (4px 16px), `rounded` (the default radius), `bordered` (a 2px line at the end
    of the active link, in its colour), the link icon in drawer-icon with 12px before the text,
    and the colours, which share the tree's selection colours below and add their own.
  -->
  <Style Selector="TreeView.nav">
    <Setter Property="Theme" Value="{StaticResource FiliNavMenu}" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem">
    <Setter Property="Theme" Value="{StaticResource FiliNavItem}" />
  </Style>
  <Style Selector="TreeView.nav.rounded TreeViewItem">
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
  </Style>
  <Style Selector="TreeView.nav.bordered TreeViewItem:selected /template/ Border#SelectionBorder">
    <Setter Property="BorderThickness" Value="0,0,2,0" />
  </Style>
  <!-- The text keeps its 12px from where the padding ends; an icon pulls itself back into it. -->
  <Style Selector="TreeView.nav TreeViewItem :is(Control).start-icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="-12,0,12,0" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDrawerIconBrush}" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem:disabled :is(Control).start-icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
