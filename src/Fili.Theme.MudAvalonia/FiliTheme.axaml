  <Style Selector="TabStrip.error">
    <Setter Property="theme:Accent.Bar" Value="True" />
    <Setter Property="theme:Accent.Ground" Value="{DynamicResource FiliErrorBrush}" />
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliErrorContrastTextBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliErrorLightenBrush}" />
