<!--
  Fili.Theme.MudAvalonia entry point.

  Two includes, in this order, and nothing else:

      <Application.Styles>
        <StyleInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Base/FiliBaseTheme.axaml" />
        <StyleInclude Source="avares://Fili.Theme.MudAvalonia/FiliTheme.axaml" />
      </Application.Styles>

  No FluentTheme, and no Avalonia.Themes.* package reference anywhere in the library. The base
  include carries 79 templates forked from Avalonia Simple, repaletted onto this theme's tokens;
  this file carries the tokens, the type ramp, the surface classes and the hand-written control
  themes. ORDER IS LOAD-BEARING: later styles win, which is the only reason a hand-written
  ControlTheme beats its forked counterpart.

  What lives here versus in a ControlTheme:

    here            tokens, the TextBlock type ramp, Border.surface / .elevation* / .appbar,
                    and the handful of classes that name a MudBlazor VARIANT
    ControlTheme    everything about a control's template, keyed to its type

  A class is only ever a variant now - Button.primary, TextBox.filled. It is NOT how a control
  opts in to being themed; every themed control is keyed to {x:Type} and applies on its own. The
  older `.fili` marker classes are gone, because a class that means "please theme me" was only
  ever a workaround for layering over Fluent.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:Fili.Theme.MudAvalonia">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Palette.axaml" />
        <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Elevation.axaml" />
        <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Typography.axaml" />
        <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Geometry.axaml" />
        <!-- Last: the control themes reference tokens from all four above. -->
        <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ============================== Type ramp ==============================
       Usage: <TextBlock Classes="h6" Text="Section" />
  -->

  <!--
    The INHERITABLE defaults go on the container, not on TextBlock.

    This matters more than it looks. FontFamily, FontSize and Foreground all inherit down the
    tree, so setting them here reaches every TextBlock without a style rule. Setting them on
    "TextBlock" instead would also hit the TextBlock a ContentPresenter generates for a
    button's string content - and a style setter beats an inherited value, so white-on-primary
    button text silently rendered in the body-text grey. Ask how that bug is found: only by
    looking, which is what the gallery is for.
  -->
  <Style Selector="Window, UserControl">
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
  </Style>

  <!--
    A popup's host is the root of its own tree, so it inherits nothing from the window. The base
    gives it ContentControlThemeFontFamily, an alias Accents.axaml resolves once inside this theme,
    so it is Roboto whatever the app's FiliFontFamily says. Only the font: the base's size and
    foreground for these hosts are already the Fili ones.
  -->
  <Style Selector="PopupRoot, OverlayPopupHost, EmbeddableControlRoot">
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
  </Style>

  <!--
    No focus rectangle. MudBlazor's _reset.scss removes the browser's outline, and every control
    here marks keyboard focus with its state layer instead (docs/controls.md, Keyboard focus). The
    forked AdornerLayer still drew Simple's dashed box round every focused control, on top of the
    tint. A control's own FocusAdorner, set by an app, still draws.
  -->
  <Style Selector="AdornerLayer">
    <Setter Property="DefaultFocusAdorner" Value="{x:Null}" />
  </Style>

  <!--
    Access keys: "_Save" is Save, Alt+S, on every control the base recognises them on - the base's
    own templates set RecognizesAccessKey on these presenters, and the hand-written ones had not,
    so the underscore showed. MudBlazor has none; Avalonia apps write them anyway. One rule here
    rather than one per theme: Button.axaml is generated, and an Expander's header is a toggle's.
    A menu row's header is an AccessText in its template (Menu.axaml), as the base's is.
  -->
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter, CheckBox /template/ ContentPresenter#PART_ContentPresenter, RadioButton /template/ ContentPresenter#PART_ContentPresenter, ToggleSwitch /template/ ContentPresenter#PART_ContentPresenter, SplitButton /template/ ContentPresenter#PART_ContentPresenter, DropDownButton /template/ ContentPresenter#PART_ContentPresenter, HyperlinkButton /template/ ContentPresenter#PART_ContentPresenter, TabItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="RecognizesAccessKey" Value="True" />
  </Style>

  <!--
    LineHeight and LetterSpacing do NOT go on a blanket TextBlock selector, and this is the
    third costume of the same trap.

    They were there once, set to body2's metrics on every TextBlock in the app. That silently
    CLIPS any text bigger than 20px: a 28px heading gets a 20px line box and loses its
    descenders. It cost one adopting app every page title - each rendered with its tails cut
    off - and it was invisible in this package's own gallery, because the
    gallery labels everything with a ramp class that sets its own LineHeight.

    That is the giveaway: a blanket style is only safe when every control it reaches also gets
    the matching value. An adopter's own type scale never will, because it does not know this
    rule exists. So the metrics live on the ramp classes below, and unclassed text keeps the
    font's natural line height, which cannot clip.
  -->

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{DynamicResource FiliH1FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH1LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH1LetterSpacing}" />
    <Setter Property="FontWeight" Value="Light" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource FiliH2FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH2LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH2LetterSpacing}" />
    <Setter Property="FontWeight" Value="Light" />
  </Style>

  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="{DynamicResource FiliH3FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH3LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH3LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.h4">
    <Setter Property="FontSize" Value="{DynamicResource FiliH4FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH4LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH4LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.h5">
    <Setter Property="FontSize" Value="{DynamicResource FiliH5FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH5LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH5LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.h6">
    <Setter Property="FontSize" Value="{DynamicResource FiliH6FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH6LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH6LetterSpacing}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="TextBlock.subtitle1">
    <Setter Property="FontSize" Value="{DynamicResource FiliSubtitle1FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliSubtitle1LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliSubtitle1LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.subtitle2">
    <Setter Property="FontSize" Value="{DynamicResource FiliSubtitle2FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliSubtitle2LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliSubtitle2LetterSpacing}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="TextBlock.body1">
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliBody1LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliBody1LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.body2">
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliBody2LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliBody2LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- Typo.button: .875rem, 500, 1.75, .02857em - and uppercase, which Avalonia cannot do. For
       text that should read as a button's label without being one. -->
  <Style Selector="TextBlock.button">
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliButtonLineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FiliCaptionFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliCaptionLineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliCaptionLetterSpacing}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="{DynamicResource FiliOverlineFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliOverlineLineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliOverlineLetterSpacing}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextSecondaryBrush}" />
  </Style>

  <!--
    MudText's Color: `<TextBlock Classes="body2 error" />` is `<MudText Typo="Typo.body2"
    Color="Color.Error">`. A colour class is the palette colour, as everywhere else in this theme -
    `secondary` is the secondary colour, not grey. Grey supporting text is text-secondary, which
    MudBlazor reaches with its `mud-text-secondary` utility class rather than a Color; here it is
    Foreground="{DynamicResource FiliTextSecondaryBrush}". After the type ramp on purpose, so a
    colour beats a style's own default colour (overline is text-secondary until told otherwise).
  -->
  <!-- GENERATED by ThemeColourGenerator: TextBlock colours. -->
  <Style Selector="TextBlock.primary">
    <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.info">
    <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.dark">
    <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!-- ============================== Surfaces ==============================
       Usage: <Border Classes="surface elevation4"> ... </Border>
  -->

  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
  </Style>

  <!-- MudCard: MudPaper at its default Elevation 1, in text-primary. Its parts are below. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation1}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
  </Style>

  <!--
    MudAppBar's Elevation defaults to 4. Declared here, ahead of the elevation classes, so that
    `appbar elevation0` and the rest win over it, as they do over the card's 1; the rest of the
    app bar is under "App bar" below.
  -->
  <Style Selector="Border.appbar">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
  </Style>

  <Style Selector="Border.outlined">
    <Setter Property="BorderBrush" Value="{DynamicResource FiliLinesDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FiliBorderThickness}" />
  </Style>

  <!-- GENERATED by ThemeColourGenerator: paper elevation. -->
  <Style Selector="Border.elevation0">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
  </Style>
  <Style Selector="Border.elevation1">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation1}" />
  </Style>
  <Style Selector="Border.elevation2">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation2}" />
  </Style>
  <Style Selector="Border.elevation3">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation3}" />
  </Style>
  <Style Selector="Border.elevation4">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
  </Style>
  <Style Selector="Border.elevation5">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation5}" />
  </Style>
  <Style Selector="Border.elevation6">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation6}" />
  </Style>
  <Style Selector="Border.elevation7">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation7}" />
  </Style>
  <Style Selector="Border.elevation8">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
  </Style>
  <Style Selector="Border.elevation9">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation9}" />
  </Style>
  <Style Selector="Border.elevation10">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation10}" />
  </Style>
  <Style Selector="Border.elevation11">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation11}" />
  </Style>
  <Style Selector="Border.elevation12">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation12}" />
  </Style>
  <Style Selector="Border.elevation13">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation13}" />
  </Style>
  <Style Selector="Border.elevation14">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation14}" />
  </Style>
  <Style Selector="Border.elevation15">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation15}" />
  </Style>
  <Style Selector="Border.elevation16">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation16}" />
  </Style>
  <Style Selector="Border.elevation17">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation17}" />
  </Style>
  <Style Selector="Border.elevation18">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation18}" />
  </Style>
  <Style Selector="Border.elevation19">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation19}" />
  </Style>
  <Style Selector="Border.elevation20">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation20}" />
  </Style>
  <Style Selector="Border.elevation21">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation21}" />
  </Style>
  <Style Selector="Border.elevation22">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation22}" />
  </Style>
  <Style Selector="Border.elevation23">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation23}" />
  </Style>
  <Style Selector="Border.elevation24">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation24}" />
  </Style>
  <Style Selector="Border.elevation25">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation25}" />
  </Style>
  <!-- END GENERATED -->

  <!--
    material-elevation-overlay, on a window or any container: Material's dark-theme answer to
    shadows that barely show on a dark ground, which MudBlazor does not offer. In Dark, each raised
    surface inside is lightened by white at its level's opacity - 5% at 1, 9% at 4, 12% at 8, 16%
    at 24 - so height reads as lightness. Light and high contrast are unchanged. The overlay is an
    inset shadow drawn over the surface's own background and under its content, so it follows a
    custom surface colour and the corner radius; FiliElevationOverlay{n} in Elevation.axaml holds
    each level. Only surfaces in the surface colour take it, as Material says: a paper or card, an
    expansion panel, a data grid and the menus, selects and flyouts. Coloured app bars, buttons and
    badges keep their colour, and a tab bar's shadow sits outside the bar it would have to lighten.
  -->
  <!-- GENERATED by ThemeColourGenerator: material elevation overlay. -->
  <Style Selector=".material-elevation-overlay Border.card">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay1}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation0, .material-elevation-overlay Border.card.elevation0">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay0}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation1, .material-elevation-overlay Border.card.elevation1">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay1}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation2, .material-elevation-overlay Border.card.elevation2">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay2}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation3, .material-elevation-overlay Border.card.elevation3">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay3}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation4, .material-elevation-overlay Border.card.elevation4">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay4}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation5, .material-elevation-overlay Border.card.elevation5">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay5}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation6, .material-elevation-overlay Border.card.elevation6">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay6}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation7, .material-elevation-overlay Border.card.elevation7">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay7}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation8, .material-elevation-overlay Border.card.elevation8">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay8}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation9, .material-elevation-overlay Border.card.elevation9">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay9}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation10, .material-elevation-overlay Border.card.elevation10">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay10}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation11, .material-elevation-overlay Border.card.elevation11">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay11}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation12, .material-elevation-overlay Border.card.elevation12">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay12}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation13, .material-elevation-overlay Border.card.elevation13">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay13}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation14, .material-elevation-overlay Border.card.elevation14">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay14}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation15, .material-elevation-overlay Border.card.elevation15">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay15}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation16, .material-elevation-overlay Border.card.elevation16">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay16}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation17, .material-elevation-overlay Border.card.elevation17">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay17}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation18, .material-elevation-overlay Border.card.elevation18">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay18}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation19, .material-elevation-overlay Border.card.elevation19">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay19}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation20, .material-elevation-overlay Border.card.elevation20">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay20}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation21, .material-elevation-overlay Border.card.elevation21">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay21}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation22, .material-elevation-overlay Border.card.elevation22">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay22}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation23, .material-elevation-overlay Border.card.elevation23">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay23}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation24, .material-elevation-overlay Border.card.elevation24">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay24}" />
  </Style>
  <Style Selector=".material-elevation-overlay Border.surface.elevation25, .material-elevation-overlay Border.card.elevation25">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay25}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay1}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation0 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay0}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation1 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay1}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation2 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay2}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation3 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay3}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation4 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay4}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation5 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay5}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation6 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay6}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation7 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay7}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation8 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay8}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation9 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay9}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation10 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay10}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation11 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay11}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation12 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay12}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation13 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay13}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation14 /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevationOverlay14}" />
  </Style>
  <Style Selector=".material-elevation-overlay Expander.elevation15 /template/ Border#PART_Root">
