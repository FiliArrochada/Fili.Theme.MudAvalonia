  </Style>

  <!--
    MudSkeleton: `<Border Classes="skeleton" Width="..." />`, from _skeleton.scss. SkeletonType.Text
    is the default - a 4px-rounded bar drawn at 60% of its height from 60% down, so a 20px line
    (body2's line height) shows a 12px bar. `circle` and `rectangle` are the other two types, at
    `.mud-skeleton`'s 1.2em unless sized. Animation.Pulse is the default: opacity 1 -> 0.4 -> 1
    over 1.5s, ease-in-out, after a 0.5s delay, for ever. `wave` is Animation.Wave, below.
  -->
  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource FiliSkeletonBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="Height" Value="20" />
    <Setter Property="RenderTransformOrigin" Value="0%,60%" />
    <Setter Property="RenderTransform" Value="scaleY(0.6)" />
  </Style>
  <!-- Animation.Pulse, the default; `no-animation` is Animation.False. -->
  <Style Selector="Border.skeleton[(theme|Motion.Reduced)=False]:not(.no-animation):not(.wave)">
    <Style.Animations>
      <Animation Duration="0:0:1.5" Delay="0:0:0.5" IterationCount="Infinite" Easing="0.42,0,0.58,1">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.4" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!--
    Animation.Wave. MudBlazor slides an ::after layer across the skeleton - as wide as it, a
    gradient of transparent -> rgba(0,0,0,0.04) -> transparent, translateX -100% -> 100% over the
    first 60% of 1.6s, linear, after a 0.5s delay - and clips it to the skeleton's shape.

    A Border has no second layer, so the band is drawn INTO the background instead: a gradient of
    the skeleton colour -> FiliSkeletonWaveColor -> the skeleton colour, one skeleton wide, whose
    start and end points slide from -100% to +100%. Source-over compositing is associative, so 4%
    black over the skeleton colour is a single colour per variant, and the result is the same
    pixels. Outside the band the gradient pads with the skeleton colour, which is the resting
    look, so the delay and the last 40% of each cycle show the plain skeleton, as on the web.

    The RESTING background is the start gradient too, not the plain skeleton brush. Avalonia picks
    a gradient animator from the key frames and casts the property's own value to a gradient
    when the animation starts, so a solid resting brush throws InvalidCastException - in an app,
    a crash on the first frame. The start gradient has its band wholly off the left edge, so it
    draws exactly the plain skeleton.
  -->
  <Style Selector="Border.skeleton.wave:not(.no-animation)">
    <Setter Property="Background" Value="{DynamicResource FiliSkeletonWaveStartBrush}" />
  </Style>
  <Style Selector="Border.skeleton.wave[(theme|Motion.Reduced)=False]:not(.no-animation)">
    <Style.Animations>
      <Animation Duration="0:0:1.6" Delay="0:0:0.5" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Background" Value="{DynamicResource FiliSkeletonWaveStartBrush}" />
        </KeyFrame>
        <KeyFrame Cue="60%">
          <Setter Property="Background" Value="{DynamicResource FiliSkeletonWaveEndBrush}" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Background" Value="{DynamicResource FiliSkeletonWaveEndBrush}" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.skeleton.circle">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Height" Value="16.8" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Border.skeleton.rectangle">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Height" Value="16.8" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- App bar -->
  <!--
    The text colour is INHERITED from the bar, not set on every TextBlock inside it. The blanket
    `Border.appbar TextBlock` it replaces matched through the LOGICAL tree, which includes a
    dropdown's items - they render in a popup on a white surface but are logical children of the
    control on the bar - so an app-bar ComboBox opened onto white text on white. Inherited, the
    colour reaches plain text and loses to every control that sets its own, which is also
    MudBlazor's behaviour: .mud-input paints text-primary wherever it sits. A control that should
    read in the bar's colour says so itself. Pinned by AppBarTests.
  -->
  <Style Selector="Border.appbar">
    <Setter Property="Background" Value="{DynamicResource FiliAppbarBackgroundBrush}" />
    <Setter Property="Height" Value="{DynamicResource FiliAppbarHeight}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliAppbarTextBrush}" />
    <!-- MudAppBar.Gutters defaults to true: _toolbar.scss's .mud-toolbar-gutters, 24px a side
         from the sm breakpoint up. An app that wants none sets Padding="0". -->
    <Setter Property="Padding" Value="24,0" />
  </Style>
  <!-- Dense: .mud-appbar-dense, the bar height less a quarter, 64 -> 48. -->
  <Style Selector="Border.appbar.dense">
    <Setter Property="Height" Value="48" />
  </Style>
  <!-- A CommandBar on an app bar: its commands and its overflow button in the bar's text colour,
       as MudBlazor's app bar examples give their icon buttons Color.Inherit. Not a command moved
       into the overflow menu, which sits on the surface in text-primary. A checked toggle takes
       it too, as ToggledColor.Inherit does: primary would vanish on a primary bar. -->
  <Style Selector="Border.appbar CommandBarButton[IsInOverflow=False], Border.appbar CommandBarToggleButton[IsInOverflow=False]">
    <Setter Property="Foreground" Value="{Binding $parent[CommandBar].Foreground}" />
  </Style>
  <!-- And on a NavigationPage's bar, whose own template gives the commands the bar's colour but
       cannot reach into the CommandBar's template for its overflow button. `.icon` is named so the
       selector has an activator: one without loses to the icon button's own `.icon` rule. -->
  <Style Selector="Border.appbar CommandBar /template/ Button#PART_OverflowButton">
    <Setter Property="Foreground" Value="{Binding $parent[CommandBar].Foreground}" />
  </Style>
  <Style Selector="NavigationPage CommandBar /template/ Button#PART_OverflowButton.icon">
    <Setter Property="Foreground" Value="{Binding $parent[CommandBar].Foreground}" />
  </Style>

  <!--
    MudToolBar: `<Border Classes="toolbar">`, from _toolbar.scss. A flex row, centred, 64px high
    with 24px gutters from the sm breakpoint up (the desktop case); `dense` is 48px and
    Gutters="false" is Padding="0", on an app bar too. The row is the app's own
    panel inside; its children are centred, as `align-items: center` centres them.
  -->
  <Style Selector="Border.toolbar">
    <Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="24,0" />
  </Style>
  <Style Selector="Border.toolbar.dense">
    <Setter Property="Height" Value="48" />
  </Style>
  <!-- Gutters="false" on a toolbar or an app bar is `Padding="0"`: one property, so no class. -->
  <!-- The row and its items centred (ChildAlignment). -->
  <Style Selector="Border.toolbar">
    <Setter Property="theme:ChildAlignment.Child" Value="Vertical" />
    <Setter Property="theme:ChildAlignment.Items" Value="True" />
  </Style>

  <!-- MudAppBar's Color is .mud-theme-{color}: the colour as the ground, its contrast text
       inherited by the content. -->
  <!-- GENERATED by ThemeColourGenerator: app bar colours. -->
  <Style Selector="Border.appbar.primary">
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.secondary">
    <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.tertiary">
    <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.info">
    <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.success">
    <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.warning">
    <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.error">
    <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.dark">
    <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!--
    MudExpansionPanels: `expansion-panels` on the StackPanel that holds the Expanders, or on an
    ItemsControl that generates them. What the group does between its panels, from
    _expansionpanel.scss, with Outlined on as it is by default:

      Outlined (true)                `no-outline` on the group for false: no rule under any panel

      .mud-expand-panel-border       a 1px lines-default rule under each panel
      :first-child / :last-child     the group's radius on the top / bottom corners only; the
                                     last loses its rule
      .mud-panel-expanded            margin 16px 0 (none above the first, none below the last),
                                     every corner rounded, no rule; margin over .3s
                                     cubic-bezier(.25,.8,.5,1), after 100ms when it closes
      .mud-panel-next-expanded       the panel before an expanded one: no rule, bottom corners
      expanded + panel               the panel after one: top corners
      .mud-expansion-panels-square   `square` on the group: no radius anywhere
      MultiExpansion (false)         opening a panel closes the others; `multi-expansion` on the
                                     group lets them open independently

    The two selectors below are the only ones that name the group: one for a panel written in
    place, one for a panel an ItemsControl generated into a presenter. Everything after them
    reads ExpansionPanels.cs's pseudo-classes - :joined, :first-panel, :last-panel and the two
    neighbours - which see through those presenters where :nth-child cannot. The radius is written
    as 4 where only two corners take it, as SplitButton.axaml writes its halves: this theme has ONE
    radius. Elevation, Dense and Gutters stay on each Expander, as classes.
    Order is load-bearing: of these, the later style wins, and `square` and `no-outline` come
    last.
  -->
  <Style Selector=".expansion-panels > Expander, .expansion-panels > ContentPresenter > Expander">
    <Setter Property="theme:ExpansionPanels.Joins" Value="True" />
  </Style>
  <Style Selector=".expansion-panels.multi-expansion > Expander, .expansion-panels.multi-expansion > ContentPresenter > Expander">
    <Setter Property="theme:ExpansionPanels.MultiExpansion" Value="True" />
  </Style>
  <Style Selector="Expander:joined">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliLinesDefaultBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <ThicknessTransition Property="Margin" Duration="0:0:0.3" Delay="0:0:0.1" Easing="0.25,0.8,0.5,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Expander:joined:first-panel, Expander:joined:previous-expanded">
    <Setter Property="CornerRadius" Value="4,4,0,0" />
  </Style>
  <Style Selector="Expander:joined:last-panel, Expander:joined:next-expanded">
    <Setter Property="CornerRadius" Value="0,0,4,4" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Expander:joined:first-panel:last-panel, Expander:joined:first-panel:next-expanded, Expander:joined:previous-expanded:last-panel, Expander:joined:previous-expanded:next-expanded">
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
  </Style>
  <Style Selector="Expander:joined:expanded">
    <Setter Property="Transitions">
      <Transitions>
        <ThicknessTransition Property="Margin" Duration="0:0:0.3" Easing="0.25,0.8,0.5,1" />
      </Transitions>
    </Setter>
    <Setter Property="Margin" Value="0,16" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Expander:joined:expanded:first-panel">
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <Style Selector="Expander:joined:expanded:last-panel">
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>
  <Style Selector="Expander:joined:expanded:first-panel:last-panel">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector=".expansion-panels.square > Expander, .expansion-panels.square > ContentPresenter > Expander">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector=".expansion-panels.no-outline > Expander, .expansion-panels.no-outline > ContentPresenter > Expander">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    MudTabs' Color, on a TabControl or TabStrip: the bar in the colour, the tabs and indicator in
    its contrast text. The rest of MudTabs lives in Controls/TabControl.axaml and TabStrip.axaml.
  -->
  <!-- SliderAnimation="false": `no-animation`, as on a skeleton. The new tab's indicator appears
       under it at once instead of sliding over from the old one. -->
  <Style Selector="TabControl.no-animation, TabStrip.no-animation">
    <Setter Property="theme:SlidingIndicator.Slides" Value="False" />
  </Style>
  <!-- HideSlider: `hide-indicator`, the indicator gone from the bar's own tabs. -->
  <Style Selector="TabControl.hide-indicator > TabItem /template/ theme|PartBorder#PART_Indicator">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TabStrip.hide-indicator > TabStripItem /template/ theme|PartBorder#PART_Indicator">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- `material-fixed-tabs`: no 160px minimum, so the bar's equal shares can be narrower than MinimumTabWidth. -->
  <Style Selector="TabControl.material-fixed-tabs > TabItem, TabStrip.material-fixed-tabs > TabStripItem">
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <!-- GENERATED by ThemeColourGenerator: tab bar colours. -->
  <Style Selector="TabControl.primary">
    <Setter Property="theme:Accent.Bar" Value="True" />
    <Setter Property="theme:Accent.Ground" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliPrimaryLightenBrush}" />
  </Style>
  <Style Selector="TabStrip.primary">
    <Setter Property="theme:Accent.Bar" Value="True" />
    <Setter Property="theme:Accent.Ground" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliPrimaryLightenBrush}" />
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="TabControl.secondary">
    <Setter Property="theme:Accent.Bar" Value="True" />
    <Setter Property="theme:Accent.Ground" Value="{DynamicResource FiliSecondaryBrush}" />
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliSecondaryLightenBrush}" />
  </Style>
  <Style Selector="TabStrip.secondary">
    <Setter Property="theme:Accent.Bar" Value="True" />
    <Setter Property="theme:Accent.Ground" Value="{DynamicResource FiliSecondaryBrush}" />
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliSecondaryLightenBrush}" />
    <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
  </Style>
  <Style Selector="TabControl.tertiary">
    <Setter Property="theme:Accent.Bar" Value="True" />
    <Setter Property="theme:Accent.Ground" Value="{DynamicResource FiliTertiaryBrush}" />
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliTertiaryLightenBrush}" />
  </Style>
  <Style Selector="TabStrip.tertiary">
    <Setter Property="theme:Accent.Bar" Value="True" />
    <Setter Property="theme:Accent.Ground" Value="{DynamicResource FiliTertiaryBrush}" />
    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliTertiaryLightenBrush}" />
    <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
  </Style>
  <Style Selector="TabControl.info">
    <Setter Property="theme:Accent.Bar" Value="True" />
