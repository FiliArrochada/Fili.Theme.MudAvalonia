    <Setter Property="theme:Accent.Colour" Value="{DynamicResource FiliInfoContrastTextBrush}" />
    <Setter Property="theme:Accent.Hover" Value="{DynamicResource FiliInfoLightenBrush}" />
  </Style>
  <Style Selector="TabStrip.info">
