  <!-- The content, centred (ChildAlignment); an icon is MudIcon's Size.Medium, 24px, at every
       avatar size. -->
  <Style Selector="Border.avatar">
    <Setter Property="theme:ChildAlignment.Child" Value="Both" />
  </Style>
  <Style Selector="Border.avatar > PathIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>

  <!-- `.mud-avatar > .mud-image`: the whole avatar, object-fit: cover, clipped to the shape -
       inside the line when outlined, at the line's inner radius. -->
  <Style Selector="Border.avatar > Image">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Stretch" Value="UniformToFill" />
    <Setter Property="Clip">
