  <!--
    MudAvatar: `<Border Classes="avatar">`, from _avatar.scss and MudAvatar.razor.cs. Put initials,
    a PathIcon or an Image inside; it is centred, as `.mud-avatar` is inline-flex and centred.

    Variant.Filled is the default: text-primary on lines-inputs with no colour (black in High
    Contrast, where lines-inputs is near-white), the colour with its contrast text otherwise. `outlined` is the colour (text-primary with none) as text and as a 1px
    line on no ground. `text` is the bare `.mud-avatar`: white on gray-light, whatever the colour,
    since 9.11's _avatar.scss has no text-variant rule. A later one adds `.mud-avatar-text`,
    text-primary or the colour on no ground, to follow when the theme moves past 9.11. Size.Medium is the default, 40px with 20px text;
    `small` is 24px with 12px and `large` 56px with 24px. `rounded` is the default 4px radius and
    `square` none. Elevation is the elevation classes, which this Border already takes.

    A photo is an Image child or an ImageBrush as the Background. The Image is scaled to cover and
    clipped to the shape here, because clipping the Border itself would clip its own elevation
    shadow too: Avalonia pushes a visual's clip before it draws itself. An ImageBrush needs neither,
    being painted inside the Border's own rounded outline. A size of your own needs a CornerRadius
    of half of it, and an Image in it a Clip of your own.
  -->
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{DynamicResource FiliLinesInputsBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- text-primary; its own token only so High Contrast can make it black. -->
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliAvatarTextBrush}" />
    <Setter Property="TextElement.FontSize" Value="20" />
  </Style>
  <Style Selector="Border.avatar.small">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="TextElement.FontSize" Value="12" />
  </Style>
  <Style Selector="Border.avatar.large">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="TextElement.FontSize" Value="24" />
  </Style>
  <Style Selector="Border.avatar.rounded">
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
  </Style>
  <Style Selector="Border.avatar.square">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.avatar.outlined">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- GENERATED by ThemeColourGenerator: avatar colours. -->
  <Style Selector="Border.avatar.primary">
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.avatar.secondary">
    <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.avatar.tertiary">
    <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
