    <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
  </Style>
  <Style Selector="TabControl.indicator-error > TabItem /template/ theme|PartBorder#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="TabStrip.indicator-error > TabStripItem:selected /template/ theme|PartBorder#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="TabControl.indicator-dark > TabItem /template/ theme|PartBorder#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <Style Selector="TabStrip.indicator-dark > TabStripItem:selected /template/ theme|PartBorder#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!-- ============================== Controls ==============================
       VARIANTS ONLY. The templates live in Themes/Controls/, keyed by type.
  -->

  <!--
    Packages this theme builds against but does not depend on, each loaded only when the app has
    it. Here, among the control styles, because their row and state rules are Styles and the later
    style wins. MinimumVersion is the version Directory.Packages.props builds against.
  -->
  <theme:OptionalStyleInclude Requires="Avalonia.Controls.DataGrid"
                              MinimumVersion="12.1.0"
                              Source="avares://Fili.Theme.MudAvalonia/Themes/Optional/DataGrid/DataGridStyles.axaml" />

  <!--
    MudButton.Variant defaults to Variant.Text, so an unclassed Button is already the text one.
    Only the VARIANT switches theme here; colour and size are classes the active theme reads
    itself (Themes/Controls/Button.axaml), so `filled primary small` composes.
  -->
  <Style Selector="Button.text">
    <Setter Property="Theme" Value="{DynamicResource FiliTextButton}" />
  </Style>

  <Style Selector="Button.outlined">
    <Setter Property="Theme" Value="{DynamicResource FiliOutlinedButton}" />
  </Style>

  <Style Selector="Button.filled">
    <Setter Property="Theme" Value="{DynamicResource FiliFilledButton}" />
  </Style>

  <!--
    MudChip is a theme a Button or ToggleButton takes, not a variant of the button, so `chip` wins
    over `outlined` / `filled` here by coming after them; the chip theme reads those classes itself
    as ITS variants. Themes/Controls/Chip.axaml.
  -->
  <Style Selector="Button.chip">
    <Setter Property="Theme" Value="{DynamicResource FiliChip}" />
  </Style>
  <!-- A chip with nothing to do: MudChip with neither OnClick nor Href. A type selector matches
       its type exactly, so this never reaches a Button, a ContentControl itself. -->
  <Style Selector="ContentControl.chip">
    <Setter Property="Theme" Value="{DynamicResource FiliStaticChip}" />
  </Style>
  <!-- MudListItem with OnClick or Href: a row that acts, outside a selecting list.
       Themes/Controls/ListBox.axaml. After the variants and the chip, so `list-item` wins. -->
  <Style Selector="Button.list-item">
    <Setter Property="Theme" Value="{DynamicResource FiliListItemButton}" />
  </Style>

  <!--
    MudToggleIconButton is `icon` on a ToggleButton: the icon button's look and variants
    (Themes/Controls/ToggleButton.axaml). A colour class is ToggledColor, shown while checked, and
    `unchecked-{color}` is Color, shown while not; with neither it is action-default, as both
    default to Color.Default. ToggledIcon is a second PathIcon: put both in a Panel, Icon first,
    and the second shows only while checked. Before the chip's, so `chip` wins over `icon`.
  -->
  <Style Selector="ToggleButton.icon">
    <Setter Property="Theme" Value="{DynamicResource FiliToggleIconButton}" />
  </Style>
  <Style Selector="ToggleButton.icon.outlined">
    <Setter Property="Theme" Value="{DynamicResource FiliOutlinedToggleIconButton}" />
  </Style>
  <Style Selector="ToggleButton.icon.filled">
    <Setter Property="Theme" Value="{DynamicResource FiliFilledToggleIconButton}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked :is(Panel) > PathIcon:nth-child(1):nth-last-child(2)">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleButton.icon:unchecked :is(Panel) > PathIcon:nth-child(2):nth-last-child(1)">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="Theme" Value="{DynamicResource FiliChip}" />
  </Style>

  <!--
    DrawerPage's pane toggles are MudLayout's drawer button, a MudIconButton: an action-default
    icon in a round hover tint, the same open or closed. As plain ToggleButtons they would be
    MudToggleItem, filled once checked, and the template's own Background="Transparent" beats that
    fill and leaves the contrast-coloured icon on nothing. The forked template stays as it is, so
    the toggles take the icon toggle's theme here, with the four values its `icon` class would
    add: a style cannot add a class. No colour class, so checked looks as unchecked does.
  -->
  <Style Selector="DrawerPage /template/ ToggleButton#PART_PaneButton, DrawerPage /template/ ToggleButton#PART_BottomPaneButton, DrawerPage /template/ ToggleButton#PART_CompactPaneToggle">
    <Setter Property="Theme" Value="{DynamicResource FiliToggleIconButton}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FiliActionDefaultBrush}" />
  </Style>
  <!-- The bars the toggles sit in are the fork's 48px with 5px round, which squeezed the 48px
       toggle to 38 and its round tint to a pill. MudBlazor's dense app bar holds its 48px icon
       button full height: the bars keep their 5px at the ends and drop it above and below. The
       fork writes the padding in its template, which only a style with an activator outranks:
       IsOpen's two values, so it always applies (see HCPaneBorder below). -->
  <Style Selector="DrawerPage[IsOpen=True] /template/ Border#PART_TopBar, DrawerPage[IsOpen=False] /template/ Border#PART_TopBar,
                   DrawerPage[IsOpen=True] /template/ Border#PART_BottomBar, DrawerPage[IsOpen=False] /template/ Border#PART_BottomBar">
    <Setter Property="Padding" Value="5,0" />
  </Style>
  <!-- The spinner date picker's highlight is the fork's ThemeAccentColor, a fixed colour per
       variant that an app's FiliPrimaryColor never reaches. ThemeAccentBrush2 is the same 0.6 of
       the primary, following it. IsEnabled's two values buy the activator the template's own
       Fill needs to be outranked. -->
  <Style Selector="DatePickerPresenter[IsEnabled=True] /template/ Rectangle#HighlightRect, DatePickerPresenter[IsEnabled=False] /template/ Rectangle#HighlightRect">
    <Setter Property="Fill" Value="{DynamicResource ThemeAccentBrush2}" />
  </Style>

  <!-- MudFab is a theme a Button takes, like a chip, and reads `outlined` and `text` itself as ITS
       variants - filled being its default. Themes/Controls/Fab.axaml. -->
  <Style Selector="Button.fab">
    <Setter Property="Theme" Value="{DynamicResource FiliFab}" />
  </Style>

  <!-- MudBadge is a theme a HeaderedContentControl takes: Content is what it decorates, Header the
       badge. Themes/Controls/Badge.axaml. -->
  <Style Selector="HeaderedContentControl.badge">
    <Setter Property="Theme" Value="{DynamicResource FiliBadge}" />
  </Style>

  <!-- MudProgressCircular is a theme a ProgressBar takes, as a chip is one a Button takes; it reads
       the size, colour and `rounded` classes itself. Themes/Controls/ProgressCircular.axaml. -->
  <Style Selector="ProgressBar.circular">
    <Setter Property="Theme" Value="{DynamicResource FiliProgressCircular}" />
  </Style>

  <!--
    The icon of an icon button. MudBlazor sizes it with font-size on the MudIcon; Avalonia's PathIcon
    is sized by Width/Height, so these set it: 24px (`.mud-icon-size-medium` 1.5rem), 20px small
    (`.mud-icon-size-small` 1.25rem), 36px large for a text icon button (`.mud-icon-size-large`
    2.25rem) and 32px large for an outlined or filled one (2rem). Each is the MudIcon's own size
    class, which MudIconButton.razor passes its Size to and which sits on the svg itself, so it
    wins over the button's inherited `.mud-icon-button-size-small` 1.125rem (_icons.scss,
    _iconbutton.scss): a small icon button is 3 + 20 + 3 = 26px. A local Width/Height on the icon
    still wins.
  -->
  <Style Selector="Button.icon PathIcon, ToggleButton.icon PathIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Button.icon.small PathIcon, ToggleButton.icon.small PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="Button.icon.large PathIcon, ToggleButton.icon.large PathIcon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
  </Style>
  <Style Selector="Button.icon.large.outlined PathIcon, Button.icon.large.filled PathIcon, ToggleButton.icon.large.outlined PathIcon, ToggleButton.icon.large.filled PathIcon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
  </Style>

  <!--
    MudButton's StartIcon and EndIcon, and MudChip's Icon, as classes on whatever icon a button's
    content carries: `<PathIcon Classes="start-icon" />` before the label, `end-icon` after it.
    From _button.scss: 20px (18 small, 22 large), the start icon pulled 4px out and spaced 8px
    from the label (2px out when small), the end icon the mirror. A chip's icon is
    `.mud-chip-icon` at MudIcon Size.Small: 20px (18 on a small chip, 24 on a large one), 4px out
    and 4px in (6px on a large chip); its end icon takes the close button's place, 18px, 6px from
    the label and 4px out.
  -->
  <!--
    MudButton's StartIcon and EndIcon, and MudChip's Icon: `start-icon` before the label, `end-icon`
    after it, on whatever icon a button's content carries. Each host's theme says what its icons
    take - 20px on a button, 18 small, 22 large; a chip's, a FAB's, a nav link's - and IconSlot.cs
    sets it on the icon. No style here reaches the icon: one ending in :is(Control) is matched
    against every control in the window.
  -->

  <!-- A FAB's icons are MudIcon at its IconSize, Size.Medium: 24px whatever the FAB's size. In an
       `extended` FAB the label's gap sits between icon and text, 8px (4px when small). -->
  <Style Selector="Button.fab PathIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>

  <!--
    MudButtonGroup, _buttongroup.scss: `button-group` on a StackPanel of buttons joins them into
    one shape. The radius stays on the outer corners only; each button after the first overlaps
    the one before by 1px, so two outlined buttons share a line; a text button after the first
    draws a 1px line in its own colour before it (`rgba(color, border-opacity)`, and
    BorderOpacity is 1), a filled one `{color}-lighten`, or divider with no colour; and a filled
    button in a group rests flat and lifts to elevation 4. The buttons keep their own classes:
    nothing cascades, so OverrideStyles is the app's to repeat on each. ButtonGroup.cs marks
    where each button sits; these styles ask only for those pseudo-classes, so no selector here
    reaches from the panel to its children.

    The same on a StackPanel of ToggleButtons is MudToggleGroup, _togglegroup.scss: one shape
    with the radius on its outer corners (`.mud-toggle-group > .mud-toggle-item { border-radius:
    0 }` inside a rounded, clipped group), and outlined items 1px over each other, so the group's
    line and the delimiters between items are one line each. Only the shape: a toggle group draws
    no line between text or filled items, so the separator styles below stay on Button.
  -->
  <Style Selector="StackPanel.button-group">
    <Setter Property="theme:ButtonGroup.IsOn" Value="True" />
  </Style>
  <Style Selector="Button:joined-next, ToggleButton:joined-next">
    <Setter Property="CornerRadius" Value="4,0,0,4" />
  </Style>
  <Style Selector="Button:joined-previous, ToggleButton:joined-previous">
    <Setter Property="CornerRadius" Value="0,4,4,0" />
    <Setter Property="Margin" Value="-1,0,0,0" />
  </Style>
  <Style Selector="Button:joined-vertical:joined-next, ToggleButton:joined-vertical:joined-next">
    <Setter Property="CornerRadius" Value="4,4,0,0" />
  </Style>
  <Style Selector="Button:joined-vertical:joined-previous, ToggleButton:joined-vertical:joined-previous">
    <Setter Property="CornerRadius" Value="0,0,4,4" />
    <Setter Property="Margin" Value="0,-1,0,0" />
  </Style>
  <Style Selector="Button:joined-previous:joined-next, ToggleButton:joined-previous:joined-next">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button:joined-previous:not(.outlined):not(.filled)">
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="BorderBrush" Value="{Binding $self.Foreground}" />
  </Style>
  <!-- The divider, or a colour's lighten shade: the filled theme's colour class sets Accent.Seam. -->
  <Style Selector="Button.filled:joined-previous">
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="BorderBrush" Value="{Binding $self.(theme:Accent.Seam)}" />
  </Style>
  <Style Selector="Button:joined-vertical:joined-previous:not(.outlined)">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <!-- `.mud-button-root:disabled { border-color: action-disabled-background !important }`. -->
  <Style Selector="Button:joined-previous:disabled:not(.outlined)">
    <Setter Property="BorderBrush" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
  </Style>
  <Style Selector="Button.filled:joined /template/ theme|PartBorder#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
  </Style>
  <Style Selector="Button.filled:joined:pointerover /template/ theme|PartBorder#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
  </Style>
  <Style Selector="Button.filled:joined:focus-visible /template/ theme|PartBorder#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
  </Style>
  <Style Selector="Button.filled:joined:pressed /template/ theme|PartBorder#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
  </Style>
  <Style Selector="Button.filled.flat:joined /template/ theme|PartBorder#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
  </Style>
  <Style Selector="Button.filled:joined:disabled /template/ theme|PartBorder#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
  </Style>

  <Style Selector="TextBox.filled">
    <Setter Property="Theme" Value="{DynamicResource FiliFilledTextBox}" />
  </Style>

  <Style Selector="TextBox.outlined">
    <Setter Property="Theme" Value="{DynamicResource FiliOutlinedTextBox}" />
  </Style>

  <Style Selector="ComboBox.filled">
    <Setter Property="Theme" Value="{DynamicResource FiliFilledComboBox}" />
  </Style>

  <Style Selector="ComboBox.outlined">
    <Setter Property="Theme" Value="{DynamicResource FiliOutlinedComboBox}" />
  </Style>

  <!--
    ============================== Drawer ==============================

    SplitView is MudDrawer, and almost all of it is these STYLES rather than its ControlTheme.
    That is deliberate, and the reasoning is the same one that deleted the ScrollViewer and Window
    themes.

    Nearly everything MudDrawer contributes is a VALUE, not a shape. layout/_drawer.scss gives it
    the drawer-background and drawer-text palette tokens;
    LayoutProperties.cs gives `DrawerWidthLeft = "240px"` and `DrawerMiniWidthLeft = "56px"`,
    which are already FiliDrawerWidth and FiliDrawerMiniWidth. None of that needs a template.

    What the template DOES carry is the pane sliding, the display modes and the light-dismiss
    layer - structure, where a wrong part name produces a drawer that lays out perfectly and
    never opens. So the fork keeps it, and these styles change what it paints from.

    Note the mechanism: a Style outranks a ControlTheme setter, which is normally the trap this
    file warns about and is exactly what makes this work. The forked theme's own
    OpenPaneLength/CompactPaneLength/PaneBackground setters lose to these.

    The exception is MudDrawer.Elevation, 1 by default, which is a part: a Border for the shadow,
    where the fork's pane root is a Panel that cannot carry one and clips. So Controls/SplitView.axaml
    owns the template - the fork's, with PART_PaneShadow added - and draws elevation 1 itself. The
    elevation classes, below, change it.
  -->
  <Style Selector="SplitView">
    <Setter Property="OpenPaneLength" Value="{DynamicResource FiliDrawerWidth}" />
    <Setter Property="CompactPaneLength" Value="{DynamicResource FiliDrawerMiniWidth}" />
    <Setter Property="PaneBackground" Value="{DynamicResource FiliDrawerBackgroundBrush}" />
  </Style>

  <!-- MudDrawer.Elevation: `mud-elevation-{n}` on the drawer, on the part Controls/SplitView.axaml
       draws it with. -->
  <!-- GENERATED by ThemeColourGenerator: drawer elevation. -->
  <Style Selector="SplitView.elevation0 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
  </Style>
  <Style Selector="SplitView.elevation1 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation1}" />
  </Style>
  <Style Selector="SplitView.elevation2 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation2}" />
  </Style>
  <Style Selector="SplitView.elevation3 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation3}" />
  </Style>
  <Style Selector="SplitView.elevation4 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
  </Style>
  <Style Selector="SplitView.elevation5 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation5}" />
  </Style>
  <Style Selector="SplitView.elevation6 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation6}" />
  </Style>
  <Style Selector="SplitView.elevation7 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation7}" />
  </Style>
  <Style Selector="SplitView.elevation8 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
  </Style>
  <Style Selector="SplitView.elevation9 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation9}" />
  </Style>
  <Style Selector="SplitView.elevation10 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation10}" />
  </Style>
  <Style Selector="SplitView.elevation11 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation11}" />
  </Style>
  <Style Selector="SplitView.elevation12 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation12}" />
  </Style>
  <Style Selector="SplitView.elevation13 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation13}" />
  </Style>
  <Style Selector="SplitView.elevation14 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation14}" />
  </Style>
  <Style Selector="SplitView.elevation15 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation15}" />
  </Style>
  <Style Selector="SplitView.elevation16 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation16}" />
  </Style>
  <Style Selector="SplitView.elevation17 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation17}" />
  </Style>
  <Style Selector="SplitView.elevation18 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation18}" />
  </Style>
  <Style Selector="SplitView.elevation19 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation19}" />
  </Style>
  <Style Selector="SplitView.elevation20 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation20}" />
  </Style>
  <Style Selector="SplitView.elevation21 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation21}" />
  </Style>
  <Style Selector="SplitView.elevation22 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation22}" />
  </Style>
  <Style Selector="SplitView.elevation23 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation23}" />
  </Style>
  <Style Selector="SplitView.elevation24 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation24}" />
  </Style>
  <Style Selector="SplitView.elevation25 /template/ theme|PartBorder#PART_PaneShadow">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation25}" />
  </Style>
  <!-- END GENERATED -->

  <!--
    The pane's edge. Avalonia's Simple SplitView already carries a 1px Rectangle for it, named
    HCPaneBorder and left Transparent, so no fork edit and no ControlTheme are needed - only a
    Fill. It stays invisible in light and dark, where the drawer is separated by its own
    background, and appears in High Contrast, where both grounds are black and the rail would
    otherwise dissolve into the page.

    THE FOUR SELECTORS ARE NOT PADDING, and this is the sharpest priority rule in Avalonia:

      Animation < LocalValue < StyleTrigger < Template < Style

    Lower binds harder. A value written INSIDE a ControlTemplate - like this rectangle's
    Fill="Transparent" - binds at Template, which OUTRANKS an ordinary Style. So the obvious
    `SplitView /template/ Rectangle#HCPaneBorder` setter does nothing at all, silently, and looks
    for all the world like a selector that failed to match. Add an activator - any pseudo-class -
    and the same setter binds at StyleTrigger instead, which does win. That is also why the
    floating-label transforms elsewhere in this package work: every one of them is on a `:focus`.

    Those are the four values DisplayMode can take, so between them they are always true. Naming
    them is the honest way to buy the activator; a `:not(.some-class-nobody-applies)` would buy
    the same thing while pretending to mean something.
  -->
  <Style Selector="SplitView:inline /template/ Rectangle#HCPaneBorder,
                   SplitView:compactinline /template/ Rectangle#HCPaneBorder,
                   SplitView:overlay /template/ Rectangle#HCPaneBorder,
                   SplitView:compactoverlay /template/ Rectangle#HCPaneBorder">
    <Setter Property="Fill" Value="{DynamicResource FiliDrawerBorderBrush}" />
  </Style>

  <!-- drawer-text, on the pane only: the content beside it keeps the page's own foreground. -->
  <Style Selector="SplitView /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDrawerTextBrush}" />
  </Style>

  <!--
    MudDrawerHeader: `drawer-header` on a Border at the top of the pane. layout/_drawer.scss:

      .mud-drawer-header         min-height: the app bar's height; padding: 12px 24px
      .mud-drawer-header-dense   min-height: three quarters of it, 48px; padding: 8px 24px

    The height is a floor, as min-height is: a taller header grows. Its text is the drawer's, as
    everything in the pane is.
  -->
  <Style Selector="Border.drawer-header">
    <Setter Property="MinHeight" Value="{DynamicResource FiliAppbarHeight}" />
    <Setter Property="Padding" Value="24,12" />
  </Style>
  <Style Selector="Border.drawer-header.dense">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="24,8" />
  </Style>

  <!-- The scrim behind a temporary drawer. MudOverlay's dark variant is #212121 at 50%. -->
  <Style Selector="SplitView /template/ Rectangle#LightDismissLayer">
    <Setter Property="Fill" Value="{DynamicResource FiliOverlayDarkBrush}" />
  </Style>

  <!-- MudDrawer's Color is .mud-theme-{color}: the pane in the colour, its content in the
       contrast text. -->
  <!--
    MudTooltip's placements and Arrow. The ToolTip's logical parent is its Popup, so the placement
    picks the side: Top puts the arrow under the chip pointing down, Bottom over it pointing up,
    Left at its right pointing right, Right at its left pointing left - the four
    `.mud-tooltip-{placement}.mud-tooltip-arrow::after` rules. The arrow and the 4px beyond it are
    the 10px gap `.mud-tooltip-{placement}` translates the chip by, so every tooltip on a side has
    it, drawn only with `arrow` (Overlays.axaml). Pointer, MudBlazor's lack, has neither.
  -->
  <Style Selector="Popup[Placement=Top] > ToolTip /template/ Path#PART_Arrow">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Popup[Placement=Bottom] > ToolTip /template/ Path#PART_Arrow">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="DockPanel.Dock" Value="Top" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Data" Value="M0,6 L12,6 L6,0 Z" />
  </Style>
  <Style Selector="Popup[Placement=Left] > ToolTip /template/ Path#PART_Arrow">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Data" Value="M0,0 L6,6 L0,12 Z" />
  </Style>
  <Style Selector="Popup[Placement=Right] > ToolTip /template/ Path#PART_Arrow">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="DockPanel.Dock" Value="Left" />
