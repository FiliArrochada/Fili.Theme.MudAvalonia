       does not hide either: its rows are the rail's width and the arrow runs past the edge. The
       menu never scrolls sideways to reach it (FiliNavMenu, in Themes/Controls/TreeView.axaml). -->
  <Style Selector="DrawerPage">
    <Setter Property="CompactDrawerLength" Value="{DynamicResource FiliDrawerMiniWidth}" />
