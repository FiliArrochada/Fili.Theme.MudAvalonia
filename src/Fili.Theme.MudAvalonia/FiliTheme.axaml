  <!-- `.mud-avatar > .mud-image`: the whole avatar, object-fit: cover, clipped to the shape -
       inside the line when outlined, at the line's inner radius. -->
  <Style Selector="Border.avatar > Image">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Stretch" Value="UniformToFill" />
    <Setter Property="Clip">
