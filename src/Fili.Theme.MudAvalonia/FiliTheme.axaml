  </Style>
  <Style Selector="Border.avatar.outlined.large > Image">
    <Setter Property="Clip">
      <RectangleGeometry Rect="0,0,54,54" RadiusX="27" RadiusY="27" />
    </Setter>
  </Style>
  <Style Selector="Border.avatar.outlined.rounded > Image">
    <Setter Property="Clip">
      <RectangleGeometry Rect="0,0,38,38" RadiusX="3" RadiusY="3" />
    </Setter>
  </Style>
  <Style Selector="Border.avatar.outlined.rounded.small > Image">
