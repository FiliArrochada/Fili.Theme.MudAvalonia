  <!-- MudPaper.Square, on a paper or a card: `.mud-paper-square`, no radius. -->
  <Style Selector="Border.surface.square, Border.card.square">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <!-- An outlined card has no elevation at all: MudPaper adds `mud-elevation-{n}` only when it is
       not outlined, so this beats an elevation class too. -->
  <Style Selector="Border.card.outlined">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
  </Style>

  <!--
    MudCard's parts, from _card.scss, as classes on whatever lays the card out - usually a
    StackPanel inside the `card` Border:

      card-header           MudCardHeader: 16px round; a DockPanel, so its content fills
        card-header-avatar    CardHeaderAvatar: docked at the start, 16px from the content
        card-header-actions   CardHeaderActions: docked at the end, pulled 8px up and out
        card-header-content   CardHeaderContent: the rest, and last, so the DockPanel fills with it
      card-media            MudCardMedia: a Border 300px high; an Image in it covers it, and the
                            top corners follow the card's when it comes first
      card-content          MudCardContent: 16px round
      card-actions          MudCardActions: a row, 8px round, its items centred

    The paddings are margins here, since a Panel has none; nothing paints behind them, so they
    look the same. ContentPadding="false" is Margin="0" on the part.
  -->
  <Style Selector=":is(Control).card-header">
    <Setter Property="Margin" Value="16" />
  </Style>
  <Style Selector=":is(Control).card-header-avatar">
    <Setter Property="DockPanel.Dock" Value="Left" />
    <Setter Property="Margin" Value="0,0,16,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Control).card-header-actions">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Margin" Value="0,-8,-8,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector=":is(Control).card-header-content">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.card-media">
    <Setter Property="Height" Value="300" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.card-media > Image">
    <Setter Property="Stretch" Value="UniformToFill" />
  </Style>
  <!-- `border-top-*-radius: inherit`, dropped to 0 after a header. FiliCornerRadius on the top. -->
  <Style Selector="Border.card-media:nth-child(1)">
    <Setter Property="CornerRadius" Value="4,4,0,0" />
  </Style>
  <Style Selector="Border.card.square Border.card-media">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector=":is(Control).card-content">
    <Setter Property="Margin" Value="16" />
  </Style>
  <Style Selector=":is(Control).card-actions">
    <Setter Property="Margin" Value="8" />
  </Style>
  <Style Selector="StackPanel.card-actions">
    <Setter Property="Orientation" Value="Horizontal" />
  </Style>
  <Style Selector=":is(Panel).card-actions > :is(Control)">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

