  </Style>
  <Style Selector="TabControl[(theme|Accent.Bar)=True] /template/ theme|PartBorder#PART_TabBar">
    <Setter Property="Background" Value="{Binding (theme:Accent.Ground), RelativeSource={RelativeSource TemplatedParent}}" />
  </Style>
  <Style Selector="TabControl[(theme|Accent.Bar)=True] > TabItem">
