    <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!--
    MudTabs' Color, on a TabControl or TabStrip: the bar in the colour, the tabs and indicator in
    its contrast text. The rest of MudTabs lives in Controls/TabControl.axaml and TabStrip.axaml.
  -->
