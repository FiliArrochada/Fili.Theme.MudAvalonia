<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Fili.Theme.MudAvalonia</RootNamespace>
    <AssemblyName>Fili.Theme.MudAvalonia</AssemblyName>
    <PackageId>Fili.MudAvalonia.Theme</PackageId>
    <Description>MudBlazor's look for Avalonia 12: MudBlazor's palette, elevation, typography and component styles as classes on Avalonia's own controls, in light, dark and high contrast. Not affiliated with MudBlazor.</Description>
    <PackageTags>avalonia;avaloniaui;theme;mudblazor;material;material-design;design-tokens;dark-mode</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>PackageIcon.png</PackageIcon>
    <!-- A .snupkg beside the .nupkg; `dotnet nuget push` uploads both. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- FiliThemeVariants' documentation, its one public type's, shows in an app's editor: where
         to set the variant and how to name it in XAML. Packed beside the assembly. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- MudDataGrid's look is a theme for this package's DataGrid. Built against, never passed on:
         an app that adds the package gets the look with nothing to opt into, and one that does not
         never downloads it. OptionalDataGridStyles loads the DataGrid XAML only when it is there. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Roboto, embedded. Three static instances rather than the variable Roboto[wdth,wght].ttf,
      because Avalonia resolves a weight by picking a matching face, not by setting a variable
      axis - a variable file would render Light and Medium as Regular.
      Light 300 / Regular 400 / Medium 500 are the three weights this theme actually uses.
    -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\OFL.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\PackageIcon.png" Pack="true" PackagePath="\" />
    <!-- The forked templates, the glyphs and the transcribed values keep their own licences, which
         require their notices to travel with the package (PackageContentTests). -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The README's links, the release notes and the XAML's Source Link, written at pack. -->
  <Import Project="Packaging.targets" />

</Project>
