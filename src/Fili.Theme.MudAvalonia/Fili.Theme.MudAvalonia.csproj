<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Fili.Theme.MudAvalonia</RootNamespace>
    <AssemblyName>Fili.Theme.MudAvalonia</AssemblyName>
    <PackageId>Fili.MudAvalonia.Theme</PackageId>
    <Description>MudBlazor's look for Avalonia 12: MudBlazor 9.11's palette, elevation, typography and component styles as classes on Avalonia's own controls, in light, dark and high contrast. Not affiliated with MudBlazor.</Description>
    <PackageTags>avalonia;avaloniaui;theme;mudblazor;material;material-design;design-tokens;dark-mode</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>PackageIcon.png</PackageIcon>
    <!-- A .snupkg beside the .nupkg; `dotnet nuget push` uploads both. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- MudDataGrid's look is a theme for this package's DataGrid. Built against, never passed on:
         an app that adds the package gets the look with nothing to opt into, and one that does not
         never downloads it. OptionalDataGridStyles loads the DataGrid XAML only when it is there. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Roboto, embedded. Three static instances rather than the variable Roboto[wdth,wght].ttf,
      because Avalonia resolves a weight by picking a matching face, not by setting a variable
      axis - a variable file would render Light and Medium as Regular.
      Light 300 / Regular 400 / Medium 500 are the three weights this theme actually uses.
    -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\OFL.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\PackageIcon.png" Pack="true" PackagePath="\" />
    <!-- The forked templates, the glyphs and the transcribed values keep their own licences, which
         require their notices to travel with the package (PackageContentTests). -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    The README is also the package's page on nuget.org, which cannot follow a relative link. The
    repository keeps relative links, which work on GitHub in any branch or fork; the packed copy
    has each one rewritten to the commit the package was built from, so a version's page links to
    that version's docs. An image is rewritten to the file's raw URL instead, as nuget.org shows an
    image only from a host it trusts and a blob URL is a page, not the image. A link to a file that
    does not exist fails the pack.
  -->
  <Target Name="PackReadmeWithAbsoluteLinks"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_ReadmeRevision>$(SourceRevisionId)</_ReadmeRevision>
      <_ReadmeRevision Condition="'$(_ReadmeRevision)' == ''">v$(Version)</_ReadmeRevision>
      <_PackedReadme>$(IntermediateOutputPath)package\README.md</_PackedReadme>
    </PropertyGroup>
    <AbsoluteReadmeLinks Source="$(MSBuildThisFileDirectory)..\..\README.md"
                         Destination="$(_PackedReadme)"
                         BaseUrl="$(PackageProjectUrl)/blob/$(_ReadmeRevision)/"
                         ImageBaseUrl="$(PackageProjectUrl.Replace('https://github.com/', 'https://raw.githubusercontent.com/'))/$(_ReadmeRevision)/" />
    <ItemGroup>
      <None Include="$(_PackedReadme)" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="AbsoluteReadmeLinks"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <BaseUrl ParameterType="System.String" Required="true" />
      <ImageBaseUrl ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
            var root = Path.GetDirectoryName(Path.GetFullPath(Source));
            var text = Regex.Replace(
                File.ReadAllText(Source),
                @"(!\[[^\]]*)?\]\((?!https?:|#|mailto:)([^)\s]+)\)",
                match =>
                {
                    var image = match.Groups[1].Success;
                    var target = match.Groups[2].Value;
                    var path = Path.Combine(root, target.Split('#')[0]);
                    if (!File.Exists(path) && !Directory.Exists(path))
                    {
                        Log.LogError("README.md links to " + target + ", which does not exist.");
                    }

                    return match.Groups[1].Value + "](" + (image ? ImageBaseUrl : BaseUrl) + target + ")";
                });
            Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(Destination)));
            File.WriteAllText(Destination, text);
            return !Log.HasLoggedErrors;
        }
      ]]></Code>
    </Task>
  </UsingTask>

</Project>
