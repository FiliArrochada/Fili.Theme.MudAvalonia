<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fili.Theme.MudAvalonia.Gallery"
        x:Class="Fili.Theme.MudAvalonia.Gallery.MainWindow"
        Title="Fili.Theme.MudAvalonia - Gallery"
        Width="1280" Height="820"
        Background="{DynamicResource FiliBackgroundGrayBrush}">

  <!-- 100px wider than the 1180px screenshot frames, which have no tab margin or scroll bar: the
       control states page then lays its samples out beside its index exactly as the frames do. -->

  <local:MainView />

</Window>
