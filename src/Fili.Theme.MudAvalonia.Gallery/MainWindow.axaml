<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fili.Theme.MudAvalonia.Gallery"
        x:Class="Fili.Theme.MudAvalonia.Gallery.MainWindow"
        Title="Fili.Theme.MudAvalonia - Gallery"
        Width="1440" Height="900"
        Background="{DynamicResource FiliBackgroundGrayBrush}">

  <!-- The docs drawer's 260px wider than the 1180px screenshot frames: a page then lays its
       samples out exactly as the frames do. -->

  <local:MainView />

</Window>
