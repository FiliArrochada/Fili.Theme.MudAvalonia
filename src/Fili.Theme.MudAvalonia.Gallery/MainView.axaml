<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fili.Theme.MudAvalonia.Gallery.MainView"
             Background="{DynamicResource FiliBackgroundBrush}">

  <!--
    The docs site, laid out as mudblazor.com is: an app bar, a drawer of pages with a search, and
    the page. Hosted by MainWindow on desktop and directly by the page in the browser, which has no
    windows. Built with the theme it documents, as mudblazor.com is built with MudBlazor.
  -->
  <DockPanel>

    <Border Classes="appbar" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="8,0,16,0">
        <Button x:Name="MenuButton"
                Grid.Column="0"
                Classes="icon inherit"
                ToolTip.Tip="Menu"
                VerticalAlignment="Center"
                Click="OnMenu">
          <PathIcon Data="{DynamicResource GalleryMenuIcon}" />
        </Button>
        <TextBlock Grid.Column="1"
                   Classes="h6"
                   Margin="12,0,16,0"
                   VerticalAlignment="Center"
                   Text="Fili MudAvalonia" />
        <!-- The theme's own version, read from its assembly in code-behind: what the site
             actually renders, not a number typed here that could drift from it. -->
        <Border x:Name="ThemeVersionChip"
                Grid.Column="2"
                Padding="8,2"
                CornerRadius="10"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource FiliAppbarTextBrush}"
                BorderThickness="1">
          <TextBlock x:Name="ThemeVersion"
                     Classes="caption"
                     VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- Three variants rather than a light/dark switch: high contrast is the one worth
               reaching in one click, the only variant whose tokens are derived. The select's
               text and arrow take the bar's colour; its list keeps its own. -->
          <ComboBox x:Name="VariantSelector"
                    Classes="placeholder adornment-inherit"
                    Width="150"
                    Foreground="{DynamicResource FiliAppbarTextBrush}"
                    SelectedIndex="0"
                    VerticalAlignment="Center"
                    SelectionChanged="OnVariantChanged">
            <ComboBoxItem>Light</ComboBoxItem>
            <ComboBoxItem>Dark</ComboBoxItem>
            <ComboBoxItem>High contrast</ComboBoxItem>
          </ComboBox>
          <ToggleButton x:Name="RightToLeft"
                        Classes="icon inherit"
                        ToolTip.Tip="Right to left"
                        VerticalAlignment="Center"
                        IsCheckedChanged="OnRightToLeft">
            <PathIcon Data="{DynamicResource DocsRightToLeftIcon}" />
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <SplitView x:Name="Drawer"
               DisplayMode="Inline"
               IsPaneOpen="True"
               OpenPaneLength="260">
      <SplitView.Pane>
        <DockPanel>
          <TextBox x:Name="Filter"
                   DockPanel.Dock="Top"
                   Classes="outlined dense placeholder"
                   PlaceholderText="Search pages"
                   Margin="16,16,16,8"
                   TextChanged="OnFilter">
            <TextBox.InnerLeftContent>
              <PathIcon Classes="start-icon" Data="{DynamicResource DocsSearchIcon}" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <TreeView x:Name="Nav" Classes="nav" SelectionChanged="OnNav" />
        </DockPanel>
      </SplitView.Pane>

      <ContentControl x:Name="PageHost"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
    </SplitView>

  </DockPanel>

</UserControl>
