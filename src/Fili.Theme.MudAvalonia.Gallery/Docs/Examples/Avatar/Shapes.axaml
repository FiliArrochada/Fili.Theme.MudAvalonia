<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Round by default; rounded is the 4px radius and square none. -->
  <Grid ColumnDefinitions="120,120,120" RowDefinitions="64,Auto">
    <Border Grid.Column="0" Classes="avatar secondary large" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="C" /></Border>
    <Border Grid.Column="1" Classes="avatar secondary large rounded" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="R" /></Border>
    <Border Grid.Column="2" Classes="avatar secondary large square" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="S" /></Border>
    <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="no class (circle)" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="rounded" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="square" HorizontalAlignment="Center" Margin="0,8,0,0" />
  </Grid>
</UserControl>
