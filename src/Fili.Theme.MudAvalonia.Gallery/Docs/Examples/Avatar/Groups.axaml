<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MudAvatarGroup: a StackPanel with a negative Spacing; the 2px ring of Outlined is a
       BorderThickness and BorderBrush on each avatar. -->
  <StackPanel Spacing="16">
    <StackPanel Orientation="Horizontal" Spacing="-8">
      <Border Classes="avatar primary" BorderThickness="2" BorderBrush="{DynamicResource FiliSurfaceBrush}"><TextBlock Text="A" /></Border>
      <Border Classes="avatar secondary" BorderThickness="2" BorderBrush="{DynamicResource FiliSurfaceBrush}"><TextBlock Text="B" /></Border>
      <Border Classes="avatar tertiary" BorderThickness="2" BorderBrush="{DynamicResource FiliSurfaceBrush}"><TextBlock Text="C" /></Border>
      <Border Classes="avatar info" BorderThickness="2" BorderBrush="{DynamicResource FiliSurfaceBrush}"><TextBlock Text="D" /></Border>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="-12">
      <Border Classes="avatar large success" BorderThickness="2" BorderBrush="{DynamicResource FiliErrorBrush}"><TextBlock Text="E" /></Border>
      <Border Classes="avatar large warning" BorderThickness="2" BorderBrush="{DynamicResource FiliErrorBrush}"><TextBlock Text="F" /></Border>
      <Border Classes="avatar large dark" BorderThickness="2" BorderBrush="{DynamicResource FiliErrorBrush}"><TextBlock Text="G" /></Border>
    </StackPanel>
  </StackPanel>
</UserControl>
