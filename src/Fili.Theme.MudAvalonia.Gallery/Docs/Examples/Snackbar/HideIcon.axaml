<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- hide-icon is HideIcon; hide-close is ShowCloseIcon="false". -->
  <WrapPanel Orientation="Horizontal" ItemSpacing="16">
    <NotificationCard NotificationType="Information" Classes="hide-icon">
      <TextBlock Text="hide-icon: no severity icon" Margin="0,8" TextWrapping="Wrap" LineHeight="20" />
    </NotificationCard>
    <NotificationCard NotificationType="Information" Classes="hide-close">
      <TextBlock Text="hide-close: no close button" Margin="0,8" TextWrapping="Wrap" LineHeight="20" />
    </NotificationCard>
    <NotificationCard NotificationType="Information" Classes="hide-icon hide-close">
      <TextBlock Text="Both" Margin="0,8" TextWrapping="Wrap" LineHeight="20" />
    </NotificationCard>
  </WrapPanel>
</UserControl>
