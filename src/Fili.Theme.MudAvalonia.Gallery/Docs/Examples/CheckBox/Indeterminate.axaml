<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <!-- A click cycles unchecked, checked and indeterminate. -->
    <CheckBox Classes="primary" Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" Margin="0,0,16,0" />
    <CheckBox Classes="secondary" Content="Checked" IsThreeState="True" IsChecked="True" Margin="0,0,16,0" />
    <CheckBox Classes="success" Content="Unchecked" IsThreeState="True" IsChecked="False" Margin="0,0,16,0" />
  </WrapPanel>
</UserControl>
