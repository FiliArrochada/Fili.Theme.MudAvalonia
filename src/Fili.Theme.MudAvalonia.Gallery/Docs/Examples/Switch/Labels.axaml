<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Orientation="Horizontal" Spacing="24">
    <ToggleSwitch Classes="primary" Content="End" IsChecked="True" />
    <ToggleSwitch Classes="primary label-start" Content="Start" IsChecked="True" />
    <ToggleSwitch Classes="primary label-top" Content="Top" IsChecked="True" />
    <ToggleSwitch Classes="primary label-bottom" Content="Bottom" IsChecked="True" />
  </StackPanel>
</UserControl>
