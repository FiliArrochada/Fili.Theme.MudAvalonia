<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <ToggleSwitch Classes="primary small" Content="Small" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center" />
    <ToggleSwitch Classes="primary" Content="Medium" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center" />
    <ToggleSwitch Classes="primary large" Content="Large" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center" />
  </WrapPanel>
</UserControl>
