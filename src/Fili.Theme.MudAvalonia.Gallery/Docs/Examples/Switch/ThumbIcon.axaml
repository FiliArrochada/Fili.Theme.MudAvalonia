<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <ToggleSwitch Classes="thumb-primary" Content="Wi-Fi" IsChecked="True" Margin="0,0,24,0">
      <ToggleSwitch.Resources>
        <StreamGeometry x:Key="FiliSwitchThumbIconGeometry">M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z</StreamGeometry>
      </ToggleSwitch.Resources>
    </ToggleSwitch>
    <ToggleSwitch Classes="thumb-success" Content="Bluetooth" IsChecked="True" Margin="0,0,24,0">
      <ToggleSwitch.Resources>
        <StreamGeometry x:Key="FiliSwitchThumbIconGeometry">M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z</StreamGeometry>
      </ToggleSwitch.Resources>
    </ToggleSwitch>
    <ToggleSwitch Classes="thumb-error" Content="Off" Margin="0,0,24,0">
      <ToggleSwitch.Resources>
        <StreamGeometry x:Key="FiliSwitchThumbIconGeometry">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
      </ToggleSwitch.Resources>
    </ToggleSwitch>
  </WrapPanel>
</UserControl>
