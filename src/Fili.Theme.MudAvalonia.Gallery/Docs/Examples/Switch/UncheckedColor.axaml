<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <ToggleSwitch Classes="success unchecked-error" Content="Off: error" Margin="0,0,24,0" />
    <ToggleSwitch Classes="success unchecked-error" Content="On: success" IsChecked="True" Margin="0,0,24,0" />
  </WrapPanel>
</UserControl>
