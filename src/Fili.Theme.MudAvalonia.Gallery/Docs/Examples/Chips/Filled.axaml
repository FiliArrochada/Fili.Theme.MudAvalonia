<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <Button Classes="chip" Content="Default" Margin="0,0,8,8" />
    <Button Classes="chip primary" Content="Primary" Margin="0,0,8,8" />
    <Button Classes="chip secondary" Content="Secondary" Margin="0,0,8,8" />
    <Button Classes="chip tertiary" Content="Tertiary" Margin="0,0,8,8" />
    <Button Classes="chip info" Content="Info" Margin="0,0,8,8" />
    <Button Classes="chip success" Content="Success" Margin="0,0,8,8" />
    <Button Classes="chip warning" Content="Warning" Margin="0,0,8,8" />
    <Button Classes="chip error" Content="Error" Margin="0,0,8,8" />
    <Button Classes="chip dark" Content="Dark" Margin="0,0,8,8" />
  </WrapPanel>
</UserControl>
