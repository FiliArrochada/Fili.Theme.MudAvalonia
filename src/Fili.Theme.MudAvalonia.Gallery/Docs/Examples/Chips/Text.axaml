<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <Button Classes="chip text" Content="Default" Margin="0,0,8,8" />
    <Button Classes="chip text primary" Content="Primary" Margin="0,0,8,8" />
    <Button Classes="chip text secondary" Content="Secondary" Margin="0,0,8,8" />
    <Button Classes="chip text tertiary" Content="Tertiary" Margin="0,0,8,8" />
    <Button Classes="chip text info" Content="Info" Margin="0,0,8,8" />
    <Button Classes="chip text success" Content="Success" Margin="0,0,8,8" />
    <Button Classes="chip text warning" Content="Warning" Margin="0,0,8,8" />
    <Button Classes="chip text error" Content="Error" Margin="0,0,8,8" />
  </WrapPanel>
</UserControl>
