<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <Button Classes="chip outlined" Content="Default" Margin="0,0,8,8" />
    <Button Classes="chip outlined primary" Content="Primary" Margin="0,0,8,8" />
    <Button Classes="chip outlined secondary" Content="Secondary" Margin="0,0,8,8" />
    <Button Classes="chip outlined tertiary" Content="Tertiary" Margin="0,0,8,8" />
    <Button Classes="chip outlined info" Content="Info" Margin="0,0,8,8" />
    <Button Classes="chip outlined success" Content="Success" Margin="0,0,8,8" />
    <Button Classes="chip outlined warning" Content="Warning" Margin="0,0,8,8" />
    <Button Classes="chip outlined error" Content="Error" Margin="0,0,8,8" />
  </WrapPanel>
</UserControl>
