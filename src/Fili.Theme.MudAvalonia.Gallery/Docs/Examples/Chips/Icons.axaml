<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <Button Classes="chip" Margin="0,0,8,8">
      <StackPanel Orientation="Horizontal">
        <PathIcon Classes="start-icon" Data="{DynamicResource GalleryFavoriteIcon}" />
        <TextBlock Text="Favourite" />
      </StackPanel>
    </Button>
    <Button Classes="chip primary" Margin="0,0,8,8">
      <StackPanel Orientation="Horizontal">
        <PathIcon Classes="start-icon" Data="{DynamicResource GalleryMailIcon}" />
        <TextBlock Text="Mail" />
      </StackPanel>
    </Button>
    <Button Classes="chip outlined secondary" Margin="0,0,8,8">
      <StackPanel Orientation="Horizontal">
        <PathIcon Classes="start-icon" Data="{DynamicResource GalleryNotificationsIcon}" />
        <TextBlock Text="Alerts" />
      </StackPanel>
    </Button>
    <Button Classes="chip text success" Margin="0,0,8,8">
      <StackPanel Orientation="Horizontal">
        <PathIcon Classes="start-icon" Data="{DynamicResource GalleryDoneIcon}" />
        <TextBlock Text="Done" />
      </StackPanel>
    </Button>
  </WrapPanel>
</UserControl>
