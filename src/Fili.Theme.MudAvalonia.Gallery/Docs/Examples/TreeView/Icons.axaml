<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MudTreeViewItem's Icon is content in the Header: the app lays out the icon and the text. -->
  <TreeView Classes="paper" Width="360" HorizontalAlignment="Left">
    <TreeViewItem IsExpanded="True">
      <TreeViewItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{DynamicResource GalleryFolderIcon}" />
          <TextBlock Text="Pictures" />
        </StackPanel>
      </TreeViewItem.Header>
      <TreeViewItem IsSelected="True">
        <TreeViewItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{DynamicResource GalleryImageIcon}" />
            <TextBlock Text="beach.jpg" />
          </StackPanel>
        </TreeViewItem.Header>
      </TreeViewItem>
      <TreeViewItem>
        <TreeViewItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{DynamicResource GalleryImageIcon}" />
            <TextBlock Text="forest.jpg" />
          </StackPanel>
        </TreeViewItem.Header>
      </TreeViewItem>
    </TreeViewItem>
    <TreeViewItem>
      <TreeViewItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{DynamicResource GalleryFolderIcon}" />
          <TextBlock Text="Documents" />
        </StackPanel>
      </TreeViewItem.Header>
      <TreeViewItem>
        <TreeViewItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{DynamicResource GalleryInsertDriveFileIcon}" />
            <TextBlock Text="notes.txt" />
          </StackPanel>
        </TreeViewItem.Header>
      </TreeViewItem>
    </TreeViewItem>
  </TreeView>
</UserControl>
