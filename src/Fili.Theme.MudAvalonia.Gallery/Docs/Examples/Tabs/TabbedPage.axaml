<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A TabbedPage is MudTabs: each page's Header is one of the theme's tabs.
       A fixed box keeps the page in it. -->
  <Border BorderBrush="{DynamicResource FiliLinesDefaultBrush}" BorderThickness="1" Height="200">
    <TabbedPage>
      <ContentPage Header="Inbox">
        <TextBlock Classes="body2" Margin="24" Text="The Inbox page." />
      </ContentPage>
      <ContentPage Header="Sent">
        <TextBlock Classes="body2" Margin="24" Text="The Sent page." />
      </ContentPage>
      <ContentPage Header="Drafts">
        <TextBlock Classes="body2" Margin="24" Text="The Drafts page." />
      </ContentPage>
    </TabbedPage>
  </Border>
</UserControl>
