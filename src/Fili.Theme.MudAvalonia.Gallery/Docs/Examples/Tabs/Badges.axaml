<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A badge as the header: the label is its Content and the count its Header.
       ToolTip.Tip on an item is MudTabPanel's ToolTip. -->
  <TabControl>
    <TabItem ToolTip.Tip="Unread mail">
      <TabItem.Header>
        <HeaderedContentControl Classes="badge error" Header="3" Content="Inbox" />
      </TabItem.Header>
    </TabItem>
    <TabItem>
      <TabItem.Header>
        <HeaderedContentControl Classes="badge primary dot" Header="" Content="Updates" />
      </TabItem.Header>
    </TabItem>
    <TabItem Header="Archive" />
  </TabControl>
</UserControl>
