<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- dense is MudAppBar's Dense: 48px instead of 64. -->
  <Border Classes="appbar dense">
    <DockPanel>
      <Button DockPanel.Dock="Left" Classes="icon inherit" Margin="-12,0,8,0" VerticalAlignment="Center">
        <PathIcon Data="{DynamicResource GalleryMenuIcon}" />
      </Button>
      <TextBlock Classes="h6" Text="Dense" VerticalAlignment="Center" />
    </DockPanel>
  </Border>
</UserControl>
