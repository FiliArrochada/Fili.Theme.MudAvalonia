<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A colour class is the colour as the ground; its contrast text is inherited by the content. -->
  <StackPanel Spacing="16">
    <Border Classes="appbar primary">
      <DockPanel>
        <Button DockPanel.Dock="Left" Classes="icon inherit" Margin="-12,0,8,0" VerticalAlignment="Center">
          <PathIcon Data="{DynamicResource GalleryMenuIcon}" />
        </Button>
        <TextBlock Classes="h6" Text="primary" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Border Classes="appbar secondary">
      <DockPanel>
        <Button DockPanel.Dock="Left" Classes="icon inherit" Margin="-12,0,8,0" VerticalAlignment="Center">
          <PathIcon Data="{DynamicResource GalleryMenuIcon}" />
        </Button>
        <TextBlock Classes="h6" Text="secondary" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Border Classes="appbar dark">
      <DockPanel>
        <Button DockPanel.Dock="Left" Classes="icon inherit" Margin="-12,0,8,0" VerticalAlignment="Center">
          <PathIcon Data="{DynamicResource GalleryMenuIcon}" />
        </Button>
        <TextBlock Classes="h6" Text="dark" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
