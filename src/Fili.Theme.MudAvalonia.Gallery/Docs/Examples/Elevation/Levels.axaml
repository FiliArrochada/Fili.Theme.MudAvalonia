      </Border>
      <Border Classes="paper elevation21" Width="96" Height="72" Margin="0,0,24,24">
        <TextBlock Classes="caption" Text="elevation21" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <Border Classes="paper elevation22" Width="96" Height="72" Margin="0,0,24,24">
        <TextBlock Classes="caption" Text="elevation22" HorizontalAlignment="Center" VerticalAlignment="Center" />
