<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- multi-expansion is MultiExpansion="true": the panels open independently. -->
  <StackPanel Classes="expansion-panels multi-expansion">
    <Expander Header="Panel One" IsExpanded="True">
      <TextBlock Text="Panel One Content" />
    </Expander>
    <Expander Header="Panel Two" IsExpanded="True">
      <TextBlock Text="Panel Two Content" />
    </Expander>
    <Expander Header="Panel Three">
      <TextBlock Text="Panel Three Content" />
    </Expander>
    <Expander Header="Panel Four">
      <TextBlock Text="Panel Four Content" />
    </Expander>
  </StackPanel>
</UserControl>
