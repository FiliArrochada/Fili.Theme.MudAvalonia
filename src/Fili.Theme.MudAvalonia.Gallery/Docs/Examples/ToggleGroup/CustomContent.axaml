<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16">
    <!-- Icons alone. -->
    <StackPanel Orientation="Horizontal" Classes="button-group">
      <ToggleButton Classes="outlined" IsChecked="True">
        <PathIcon Data="{DynamicResource GalleryFormatAlignLeftIcon}" />
      </ToggleButton>
      <ToggleButton Classes="outlined">
        <PathIcon Data="{DynamicResource GalleryFormatAlignCenterIcon}" />
      </ToggleButton>
      <ToggleButton Classes="outlined">
        <PathIcon Data="{DynamicResource GalleryFormatAlignRightIcon}" />
      </ToggleButton>
      <ToggleButton Classes="outlined">
        <PathIcon Data="{DynamicResource GalleryFormatAlignJustifyIcon}" />
      </ToggleButton>
    </StackPanel>
    <!-- CheckMark is check-mark: the check shows before the content while IsChecked. -->
    <StackPanel Orientation="Horizontal" Classes="button-group">
      <ToggleButton Classes="outlined secondary check-mark" Content="Bold" IsChecked="True" />
      <ToggleButton Classes="outlined secondary check-mark" Content="Italic" />
      <ToggleButton Classes="outlined secondary check-mark" Content="Underline" />
    </StackPanel>
  </StackPanel>
</UserControl>
