<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <!-- No ground and no shadow: the colour is the icon and label. -->
    <Button Classes="fab text" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Classes="fab text primary" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></Button>
    <Button Classes="fab text error" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryDeleteIcon}" /></Button>
    <Button Classes="fab extended text secondary" Margin="0,0,16,16" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
        <PathIcon Classes="start-icon" Data="{DynamicResource GalleryShareIcon}" />
        <TextBlock Text="Share" />
      </StackPanel>
    </Button>
  </WrapPanel>
</UserControl>
