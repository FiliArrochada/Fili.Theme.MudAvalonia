<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="8">
    <WrapPanel Orientation="Horizontal">
      <!-- Large is the default: 56, 48 and 40px. -->
      <Button Classes="fab primary" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
      <Button Classes="fab primary medium" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
      <Button Classes="fab primary small" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    </WrapPanel>
    <WrapPanel Orientation="Horizontal">
      <Button Classes="fab extended secondary" Margin="0,0,16,16" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <PathIcon Classes="start-icon" Data="{DynamicResource GalleryEditIcon}" />
          <TextBlock Text="Large" />
        </StackPanel>
      </Button>
      <Button Classes="fab extended secondary medium" Margin="0,0,16,16" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <PathIcon Classes="start-icon" Data="{DynamicResource GalleryEditIcon}" />
          <TextBlock Text="Medium" />
        </StackPanel>
      </Button>
      <Button Classes="fab extended secondary small" Margin="0,0,16,16" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <PathIcon Classes="start-icon" Data="{DynamicResource GalleryEditIcon}" />
          <TextBlock Text="Small" />
        </StackPanel>
      </Button>
    </WrapPanel>
  </StackPanel>
</UserControl>
