<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <Button Classes="fab primary" Margin="0,0,16,16" VerticalAlignment="Center" IsEnabled="False"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Classes="fab outlined primary" Margin="0,0,16,16" VerticalAlignment="Center" IsEnabled="False"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Classes="fab text primary" Margin="0,0,16,16" VerticalAlignment="Center" IsEnabled="False"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
  </WrapPanel>
</UserControl>
