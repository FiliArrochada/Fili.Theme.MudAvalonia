<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <!-- MudFab defaults: filled, Color.Default, Size.Large. -->
    <Button Classes="fab" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Classes="fab extended" Margin="0,0,16,16" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
        <PathIcon Classes="start-icon" Data="{DynamicResource GalleryAddIcon}" />
        <TextBlock Text="Add" />
      </StackPanel>
    </Button>
  </WrapPanel>
</UserControl>
