<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <!-- A 1px line in the colour, no ground and no shadow. -->
    <Button Classes="fab outlined" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Classes="fab outlined primary" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></Button>
    <Button Classes="fab outlined success" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryDoneIcon}" /></Button>
    <Button Classes="fab extended outlined secondary" Margin="0,0,16,16" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
        <PathIcon Classes="start-icon" Data="{DynamicResource GalleryShareIcon}" />
        <TextBlock Text="Share" />
      </StackPanel>
    </Button>
  </WrapPanel>
</UserControl>
