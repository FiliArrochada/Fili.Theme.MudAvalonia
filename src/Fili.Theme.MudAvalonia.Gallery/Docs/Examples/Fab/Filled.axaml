<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="8">
    <WrapPanel Orientation="Horizontal">
    <Button Classes="fab primary" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Classes="fab secondary" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></Button>
    <Button Classes="fab tertiary" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryFavoriteIcon}" /></Button>
    <Button Classes="fab info" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryShareIcon}" /></Button>
    <Button Classes="fab success" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryDoneIcon}" /></Button>
    <Button Classes="fab warning" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryNotificationsIcon}" /></Button>
    <Button Classes="fab error" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryDeleteIcon}" /></Button>
    <Button Classes="fab dark" Margin="0,0,16,16" VerticalAlignment="Center"><PathIcon Data="{DynamicResource GalleryMenuIcon}" /></Button>
    </WrapPanel>
    <WrapPanel Orientation="Horizontal">
    <Button Classes="fab extended primary" Margin="0,0,16,16" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
        <PathIcon Classes="start-icon" Data="{DynamicResource GalleryEditIcon}" />
        <TextBlock Text="Edit" />
      </StackPanel>
    </Button>
    <Button Classes="fab extended secondary" Margin="0,0,16,16" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
        <PathIcon Classes="start-icon" Data="{DynamicResource GalleryShareIcon}" />
        <TextBlock Text="Share" />
      </StackPanel>
    </Button>
    </WrapPanel>
  </StackPanel>
</UserControl>
