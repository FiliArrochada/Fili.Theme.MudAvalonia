<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The ring starts at 12 o'clock and fills clockwise; a new Value eases in over 300ms. -->
  <Grid ColumnDefinitions="88,88,88,88" RowDefinitions="Auto,Auto">
    <ProgressBar Grid.Column="0" Classes="circular primary" Value="25" HorizontalAlignment="Center" />
    <ProgressBar Grid.Column="1" Classes="circular primary" Value="50" HorizontalAlignment="Center" />
    <ProgressBar Grid.Column="2" Classes="circular primary" Value="75" HorizontalAlignment="Center" />
    <ProgressBar Grid.Column="3" Classes="circular primary" Value="100" HorizontalAlignment="Center" />
    <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="Value 25" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="Value 50" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="Value 75" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="3" Classes="caption" Text="Value 100" HorizontalAlignment="Center" Margin="0,8,0,0" />
  </Grid>
</UserControl>
