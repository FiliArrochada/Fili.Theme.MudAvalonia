<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ShowProgressText centres the formatted value over the bar, whole however thin it is. -->
  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
    <TextBlock Grid.Row="0" Classes="caption" Text="primary" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ProgressBar Grid.Row="0" Grid.Column="1" Classes="primary" Value="35" ShowProgressText="True" VerticalAlignment="Center" Margin="0,12" />
    <TextBlock Grid.Row="1" Classes="caption" Text="primary large" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ProgressBar Grid.Row="1" Grid.Column="1" Classes="primary large" Value="35" ShowProgressText="True" VerticalAlignment="Center" Margin="0,12" />
    <TextBlock Grid.Row="2" Classes="caption" Text="ProgressTextFormat" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ProgressBar Grid.Row="2" Grid.Column="1" Classes="success large" Value="7" Maximum="10" ShowProgressText="True" ProgressTextFormat="{}{0} of {3} steps" VerticalAlignment="Center" Margin="0,12" />
  </Grid>
</UserControl>
