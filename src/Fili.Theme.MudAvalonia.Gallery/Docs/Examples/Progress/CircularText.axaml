<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ShowProgressText puts the formatted value in the middle, in the ring's colour. -->
  <StackPanel Orientation="Horizontal" Spacing="32">
    <ProgressBar Classes="circular primary large" Value="60" ShowProgressText="True" />
    <ProgressBar Classes="circular success large" Value="85" ShowProgressText="True" />
    <ProgressBar Classes="circular large" Value="3" Maximum="8"
                 ShowProgressText="True" ProgressTextFormat="{}{0}/{3}" />
  </StackPanel>
</UserControl>
