<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MudProgressLinear.Size defaults to Small: a bare bar is a 4px hairline. -->
  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
    <TextBlock Grid.Row="0" Classes="caption" Text="primary (4px)" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ProgressBar Grid.Row="0" Grid.Column="1" Classes="primary" Value="40" VerticalAlignment="Center" Margin="0,12" />
    <TextBlock Grid.Row="1" Classes="caption" Text="primary medium (8px)" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ProgressBar Grid.Row="1" Grid.Column="1" Classes="primary medium" Value="40" VerticalAlignment="Center" Margin="0,12" />
    <TextBlock Grid.Row="2" Classes="caption" Text="primary large (12px)" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ProgressBar Grid.Row="2" Grid.Column="1" Classes="primary large" Value="40" VerticalAlignment="Center" Margin="0,12" />
  </Grid>
</UserControl>
