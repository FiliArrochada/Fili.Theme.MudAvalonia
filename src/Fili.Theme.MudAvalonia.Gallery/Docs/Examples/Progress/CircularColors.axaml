<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- No class is text-secondary; a colour class is the palette colour. There is no track. -->
  <Grid ColumnDefinitions="80,80,80,80,80,80,80,80" RowDefinitions="Auto,Auto">
    <ProgressBar Grid.Column="0" Classes="circular" Value="70" HorizontalAlignment="Center" />
    <ProgressBar Grid.Column="1" Classes="circular primary" Value="70" HorizontalAlignment="Center" />
    <ProgressBar Grid.Column="2" Classes="circular secondary" Value="70" HorizontalAlignment="Center" />
    <ProgressBar Grid.Column="3" Classes="circular tertiary" Value="70" HorizontalAlignment="Center" />
    <ProgressBar Grid.Column="4" Classes="circular info" Value="70" HorizontalAlignment="Center" />
    <ProgressBar Grid.Column="5" Classes="circular success" Value="70" HorizontalAlignment="Center" />
    <ProgressBar Grid.Column="6" Classes="circular warning" Value="70" HorizontalAlignment="Center" />
    <ProgressBar Grid.Column="7" Classes="circular error" Value="70" HorizontalAlignment="Center" />
    <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="no class" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="primary" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="secondary" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="3" Classes="caption" Text="tertiary" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="4" Classes="caption" Text="info" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="5" Classes="caption" Text="success" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="6" Classes="caption" Text="warning" HorizontalAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Grid.Row="1" Grid.Column="7" Classes="caption" Text="error" HorizontalAlignment="Center" Margin="0,8,0,0" />
  </Grid>
</UserControl>
