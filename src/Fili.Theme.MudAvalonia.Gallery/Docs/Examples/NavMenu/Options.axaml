<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MudNavMenu's Bordered, Rounded and Dense, one menu each, all with the same links. -->
  <Grid ColumnDefinitions="220,16,220,16,220" RowDefinitions="Auto,Auto">
    <TextBlock Grid.Column="0" Classes="caption" Text="bordered" HorizontalAlignment="Center" Margin="0,0,0,8" />
    <TextBlock Grid.Column="2" Classes="caption" Text="rounded" HorizontalAlignment="Center" Margin="0,0,0,8" />
    <TextBlock Grid.Column="4" Classes="caption" Text="dense" HorizontalAlignment="Center" Margin="0,0,0,8" />
    <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource FiliLinesDefaultBrush}" BorderThickness="1" Padding="0,8" VerticalAlignment="Top">
      <TreeView Classes="nav bordered">
        <TreeViewItem Header="Dashboard" IsSelected="True" />
        <TreeViewItem Header="Servers" />
        <TreeViewItem Header="Billing" />
      </TreeView>
    </Border>
    <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource FiliLinesDefaultBrush}" BorderThickness="1" Padding="8" VerticalAlignment="Top">
      <TreeView Classes="nav rounded">
        <TreeViewItem Header="Dashboard" IsSelected="True" />
        <TreeViewItem Header="Servers" />
        <TreeViewItem Header="Billing" />
      </TreeView>
    </Border>
    <Border Grid.Row="1" Grid.Column="4" BorderBrush="{DynamicResource FiliLinesDefaultBrush}" BorderThickness="1" Padding="0,8" VerticalAlignment="Top">
      <TreeView Classes="nav dense">
        <TreeViewItem Header="Dashboard" IsSelected="True" />
        <TreeViewItem Header="Servers" />
        <TreeViewItem Header="Billing" />
      </TreeView>
    </Border>
  </Grid>
</UserControl>
