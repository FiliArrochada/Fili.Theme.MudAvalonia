<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MenuItem.Icon is MudMenuItem's Icon. The row without one keeps the icon gutter,
       so every label lines up. -->
  <DropDownButton Classes="outlined" Content="Item icons" HorizontalAlignment="Left">
    <DropDownButton.Flyout>
      <MenuFlyout>
        <MenuItem Header="Edit">
          <MenuItem.Icon><PathIcon Data="{DynamicResource GalleryEditIcon}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Share">
          <MenuItem.Icon><PathIcon Data="{DynamicResource GalleryShareIcon}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="No icon, same gutter" />
        <MenuItem Header="Delete">
          <MenuItem.Icon><PathIcon Foreground="{DynamicResource FiliErrorBrush}" Data="{DynamicResource GalleryDeleteIcon}" /></MenuItem.Icon>
        </MenuItem>
      </MenuFlyout>
    </DropDownButton.Flyout>
  </DropDownButton>
</UserControl>
