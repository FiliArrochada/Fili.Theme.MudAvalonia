<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <SplitButton Classes="filled primary" Content="Elevated" Margin="0,0,16,16">
      <SplitButton.Flyout>
        <MenuFlyout>
          <MenuItem Header="Option" />
        </MenuFlyout>
      </SplitButton.Flyout>
    </SplitButton>
    <!-- flat is DropShadow="false": elevation 0 in every state. -->
    <SplitButton Classes="filled primary flat" Content="Flat" Margin="0,0,16,16">
      <SplitButton.Flyout>
        <MenuFlyout>
          <MenuItem Header="Option" />
        </MenuFlyout>
      </SplitButton.Flyout>
    </SplitButton>
  </WrapPanel>
</UserControl>
