<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MudListItem's AvatarContent and SecondaryText are content the app lays out: a Border.avatar,
       then the text with a body2 line under it in text-secondary. -->
  <ListBox Classes="paper" Width="360" HorizontalAlignment="Left" SelectedIndex="0">
    <ListBoxItem>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Border Classes="avatar primary"><TextBlock Text="AL" /></Border>
        <StackPanel>
          <TextBlock Text="Ada Lovelace" />
          <TextBlock Classes="body2" Text="Analytical engine" Foreground="{DynamicResource FiliTextSecondaryBrush}" />
        </StackPanel>
      </StackPanel>
    </ListBoxItem>
    <ListBoxItem>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Border Classes="avatar secondary"><PathIcon Data="{DynamicResource GalleryPersonIcon}" /></Border>
        <StackPanel>
          <TextBlock Text="Grace Hopper" />
          <TextBlock Classes="body2" Text="Compilers" Foreground="{DynamicResource FiliTextSecondaryBrush}" />
        </StackPanel>
      </StackPanel>
    </ListBoxItem>
    <ListBoxItem>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Border Classes="avatar"><TextBlock Text="AT" /></Border>
        <StackPanel>
          <TextBlock Text="Alan Turing" />
          <TextBlock Classes="body2" Text="Computability" Foreground="{DynamicResource FiliTextSecondaryBrush}" />
        </StackPanel>
      </StackPanel>
    </ListBoxItem>
  </ListBox>
</UserControl>
