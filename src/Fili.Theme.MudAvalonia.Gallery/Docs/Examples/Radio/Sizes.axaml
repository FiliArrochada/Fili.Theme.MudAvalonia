<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <RadioButton Classes="primary small" GroupName="docs-radio-small" Content="Small" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" />
    <RadioButton Classes="primary" GroupName="docs-radio-medium" Content="Medium" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" />
    <RadioButton Classes="primary large" GroupName="docs-radio-large" Content="Large" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" />
  </WrapPanel>
</UserControl>
