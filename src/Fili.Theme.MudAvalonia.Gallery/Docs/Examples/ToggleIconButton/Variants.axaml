<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- One row per variant and state, one column per size. flat is DropShadow="false": a filled
       toggle that stays at elevation 0. -->
  <Grid ColumnDefinitions="Auto,72,72,72" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
    <TextBlock Grid.Column="1" Classes="caption" Text="small" HorizontalAlignment="Center" />
    <TextBlock Grid.Column="2" Classes="caption" Text="medium" HorizontalAlignment="Center" />
    <TextBlock Grid.Column="3" Classes="caption" Text="large" HorizontalAlignment="Center" />

    <TextBlock Grid.Row="1" Classes="caption" Text="outlined, off" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ToggleButton Grid.Row="1" Grid.Column="1" Classes="icon outlined primary small" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
    <ToggleButton Grid.Row="1" Grid.Column="2" Classes="icon outlined primary" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
    <ToggleButton Grid.Row="1" Grid.Column="3" Classes="icon outlined primary large" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>

    <TextBlock Grid.Row="2" Classes="caption" Text="outlined, on" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ToggleButton Grid.Row="2" Grid.Column="1" Classes="icon outlined primary small" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
    <ToggleButton Grid.Row="2" Grid.Column="2" Classes="icon outlined primary" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
    <ToggleButton Grid.Row="2" Grid.Column="3" Classes="icon outlined primary large" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>

    <TextBlock Grid.Row="3" Classes="caption" Text="filled, off" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ToggleButton Grid.Row="3" Grid.Column="1" Classes="icon filled success small" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
    <ToggleButton Grid.Row="3" Grid.Column="2" Classes="icon filled success" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
    <ToggleButton Grid.Row="3" Grid.Column="3" Classes="icon filled success large" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>

    <TextBlock Grid.Row="4" Classes="caption" Text="filled, on" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ToggleButton Grid.Row="4" Grid.Column="1" Classes="icon filled success small" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
    <ToggleButton Grid.Row="4" Grid.Column="2" Classes="icon filled success" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
    <ToggleButton Grid.Row="4" Grid.Column="3" Classes="icon filled success large" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>

    <TextBlock Grid.Row="5" Classes="caption" Text="filled flat, on" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ToggleButton Grid.Row="5" Grid.Column="1" Classes="icon filled success flat small" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
    <ToggleButton Grid.Row="5" Grid.Column="2" Classes="icon filled success flat" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
    <ToggleButton Grid.Row="5" Grid.Column="3" Classes="icon filled success flat large" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></ToggleButton>
  </Grid>
</UserControl>
