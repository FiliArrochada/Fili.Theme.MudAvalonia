<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <Button Content="Text" IsEnabled="False" Margin="0,0,8,8" />
    <Button Classes="outlined primary" Content="Outlined" IsEnabled="False" Margin="0,0,8,8" />
    <Button Classes="filled primary" Content="Filled" IsEnabled="False" Margin="0,0,8,8" />
    <SplitButton Classes="outlined primary" Content="Split" IsEnabled="False" Margin="0,0,8,8" />
    <DropDownButton Classes="filled primary" Content="Drop-down" IsEnabled="False" Margin="0,0,8,8" />
  </WrapPanel>
</UserControl>
