<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <Button Classes="filled primary" IsEnabled="False" Margin="0,0,8,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressBar Classes="circular small" IsIndeterminate="True" Margin="-4,0,0,0" />
        <TextBlock Text="Processing" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
    <Button Classes="outlined primary" IsEnabled="False" Margin="0,0,8,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressBar Classes="circular small" IsIndeterminate="True" Margin="-4,0,0,0" />
        <TextBlock Text="Saving" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </WrapPanel>
</UserControl>
