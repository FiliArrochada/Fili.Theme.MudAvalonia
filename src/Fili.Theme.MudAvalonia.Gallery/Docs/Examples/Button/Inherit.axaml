<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Color.Inherit: the text, and the outlined line, are the colour of the text around the
       button - the app bar's here, so the same markup reads on every bar colour. -->
  <StackPanel Spacing="16">
    <Border Classes="appbar" Padding="8,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="inherit" Content="Inherit" VerticalAlignment="Center" />
        <Button Classes="outlined inherit" Content="Inherit" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <Border Classes="appbar secondary" Padding="8,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="inherit" Content="Inherit" VerticalAlignment="Center" />
        <Button Classes="outlined inherit" Content="Inherit" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
