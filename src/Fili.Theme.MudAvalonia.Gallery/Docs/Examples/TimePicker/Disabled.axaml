<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel ItemSpacing="16" LineSpacing="16">
    <TimePicker Width="220" VerticalAlignment="Top" AutomationProperties.Name="Disabled" IsEnabled="False" SelectedTime="14:30" />
    <TimePicker Classes="filled" Width="220" VerticalAlignment="Top" AutomationProperties.Name="Disabled" IsEnabled="False" />
    <TimePicker Classes="outlined" Width="220" VerticalAlignment="Top" AutomationProperties.Name="Disabled" IsEnabled="False" SelectedTime="14:30" />
  </WrapPanel>
</UserControl>
