<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16">
    <WrapPanel ItemSpacing="16" LineSpacing="16">
      <CalendarDatePicker Width="220" VerticalAlignment="Top" PlaceholderText="Standard" />
      <CalendarDatePicker Classes="filled" Width="220" VerticalAlignment="Top" PlaceholderText="Filled" />
      <CalendarDatePicker Classes="outlined" Width="220" VerticalAlignment="Top" PlaceholderText="Outlined" />
    </WrapPanel>
    <WrapPanel ItemSpacing="16" LineSpacing="16">
      <CalendarDatePicker Width="220" VerticalAlignment="Top" PlaceholderText="Standard" SelectedDate="2026-10-11" />
      <CalendarDatePicker Classes="filled" Width="220" VerticalAlignment="Top" PlaceholderText="Filled" SelectedDate="2026-10-11" />
      <CalendarDatePicker Classes="outlined" Width="220" VerticalAlignment="Top" PlaceholderText="Outlined" SelectedDate="2026-10-11" />
    </WrapPanel>
  </StackPanel>
</UserControl>
