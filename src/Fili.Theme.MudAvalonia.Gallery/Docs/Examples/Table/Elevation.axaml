<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Fili.Theme.MudAvalonia.Gallery.Views">
  <!-- elevation0 to elevation25 replace the default Elevation 1. outlined is a 1px lines-default
       border and no elevation, whatever the elevation class says. CornerRadius="0" is Square. -->
  <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24">
    <TextBlock Classes="caption" Text="elevation4 dense" Margin="0,0,0,8" />
    <TextBlock Grid.Column="1" Classes="caption" Text="outlined dense" Margin="0,0,0,8" />
    <TextBlock Grid.Column="2" Classes="caption" Text="outlined dense, CornerRadius 0" Margin="0,0,0,8" />
    <TableView Grid.Row="1" Classes="elevation4 dense" ItemsSource="{x:Static v:GalleryElement.FirstSix}">
      <TableView.Columns>
        <TableViewColumn Header="Name" Width="*">
          <TableViewColumn.CellTemplate>
            <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </TableViewColumn.CellTemplate>
        </TableViewColumn>
        <TableViewColumn Header="Sign" Width="80">
          <TableViewColumn.CellTemplate>
            <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Sign}" /></DataTemplate>
          </TableViewColumn.CellTemplate>
        </TableViewColumn>
      </TableView.Columns>
    </TableView>
    <TableView Grid.Row="1" Grid.Column="1" Classes="outlined dense" ItemsSource="{x:Static v:GalleryElement.FirstSix}">
      <TableView.Columns>
        <TableViewColumn Header="Name" Width="*">
          <TableViewColumn.CellTemplate>
            <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </TableViewColumn.CellTemplate>
        </TableViewColumn>
        <TableViewColumn Header="Sign" Width="80">
          <TableViewColumn.CellTemplate>
            <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Sign}" /></DataTemplate>
          </TableViewColumn.CellTemplate>
        </TableViewColumn>
      </TableView.Columns>
    </TableView>
    <TableView Grid.Row="1" Grid.Column="2" Classes="outlined dense" ItemsSource="{x:Static v:GalleryElement.FirstSix}" CornerRadius="0">
      <TableView.Columns>
        <TableViewColumn Header="Name" Width="*">
          <TableViewColumn.CellTemplate>
            <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </TableViewColumn.CellTemplate>
        </TableViewColumn>
        <TableViewColumn Header="Sign" Width="80">
          <TableViewColumn.CellTemplate>
            <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Sign}" /></DataTemplate>
          </TableViewColumn.CellTemplate>
        </TableViewColumn>
      </TableView.Columns>
    </TableView>
  </Grid>
</UserControl>
