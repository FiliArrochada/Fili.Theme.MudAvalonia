<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Fili.Theme.MudAvalonia.Gallery.Views">
  <!-- bordered is MudTable's Bordered: 1px of table-lines between a row's cells. The header is
       not ruled, as MudTable rules it only for a table-head-bordered HeaderClass. -->
  <TableView Classes="bordered" ItemsSource="{x:Static v:GalleryElement.FirstSix}">
    <TableView.Columns>
      <TableViewColumn Header="Nr" Width="64">
        <TableViewColumn.CellTemplate>
          <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Number}" /></DataTemplate>
        </TableViewColumn.CellTemplate>
      </TableViewColumn>
      <TableViewColumn Header="Sign" Width="80">
        <TableViewColumn.CellTemplate>
          <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Sign}" /></DataTemplate>
        </TableViewColumn.CellTemplate>
      </TableViewColumn>
      <TableViewColumn Header="Name" Width="*">
        <TableViewColumn.CellTemplate>
          <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Name}" /></DataTemplate>
        </TableViewColumn.CellTemplate>
      </TableViewColumn>
      <TableViewColumn Header="Group" Width="*">
        <TableViewColumn.CellTemplate>
          <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Group}" /></DataTemplate>
        </TableViewColumn.CellTemplate>
      </TableViewColumn>
    </TableView.Columns>
  </TableView>
</UserControl>
