<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Fili.Theme.MudAvalonia.Gallery.Views">
  <!-- A selected row is primary-hover, the primary at 6%: MudTable draws no selection of its own,
       so the theme borrows a selected list row's tint, as it does on the data grid. -->
  <TableView Classes="hover" ItemsSource="{x:Static v:GalleryElement.FirstSix}" SelectedIndex="1">
    <TableView.Columns>
      <TableViewColumn Header="Name" Width="*">
        <TableViewColumn.CellTemplate>
          <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Name}" /></DataTemplate>
        </TableViewColumn.CellTemplate>
      </TableViewColumn>
      <TableViewColumn Header="Sign" Width="96">
        <TableViewColumn.CellTemplate>
          <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Sign}" /></DataTemplate>
        </TableViewColumn.CellTemplate>
      </TableViewColumn>
      <TableViewColumn Header="Group" Width="200">
        <TableViewColumn.CellTemplate>
          <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Group}" /></DataTemplate>
        </TableViewColumn.CellTemplate>
      </TableViewColumn>
    </TableView.Columns>
  </TableView>
</UserControl>
