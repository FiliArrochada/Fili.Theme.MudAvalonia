<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Fili.Theme.MudAvalonia.Gallery.Views">
  <!-- striped is Striped: table-striped on the 1st, 3rd, 5th... row. hover is Hover: table-hover
       under the pointer, over the stripe. Both are off by default, as in MudBlazor. -->
  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24">
    <TextBlock Classes="caption" Text="striped" Margin="0,0,0,8" />
    <TextBlock Grid.Column="1" Classes="caption" Text="hover (point at a row)" Margin="0,0,0,8" />
    <TableView Grid.Row="1" Classes="striped" ItemsSource="{x:Static v:GalleryElement.FirstSix}">
      <TableView.Columns>
        <TableViewColumn Header="Name" Width="*">
          <TableViewColumn.CellTemplate>
            <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </TableViewColumn.CellTemplate>
        </TableViewColumn>
        <TableViewColumn Header="Sign" Width="80">
          <TableViewColumn.CellTemplate>
            <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Sign}" /></DataTemplate>
          </TableViewColumn.CellTemplate>
        </TableViewColumn>
      </TableView.Columns>
    </TableView>
    <TableView Grid.Row="1" Grid.Column="1" Classes="hover" ItemsSource="{x:Static v:GalleryElement.FirstSix}">
      <TableView.Columns>
        <TableViewColumn Header="Name" Width="*">
          <TableViewColumn.CellTemplate>
            <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </TableViewColumn.CellTemplate>
        </TableViewColumn>
        <TableViewColumn Header="Sign" Width="80">
          <TableViewColumn.CellTemplate>
            <DataTemplate x:DataType="v:GalleryElement"><TextBlock Text="{Binding Sign}" /></DataTemplate>
          </TableViewColumn.CellTemplate>
        </TableViewColumn>
      </TableView.Columns>
    </TableView>
  </Grid>
</UserControl>
