<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16">
    <Slider Classes="filled" Value="40" />
    <Slider Classes="filled medium" Value="50" />
    <Slider Classes="filled large" Value="60" />
  </StackPanel>
</UserControl>
