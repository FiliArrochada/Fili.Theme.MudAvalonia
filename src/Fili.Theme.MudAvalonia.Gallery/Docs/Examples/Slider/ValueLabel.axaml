<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16">
    <!-- The label shows while the thumb is held. -->
    <Slider Classes="value-label" Value="75" />
    <Slider Classes="value-label filled tertiary" Value="25" />
  </StackPanel>
</UserControl>
