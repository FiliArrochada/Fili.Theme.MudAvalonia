<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="8">
    <Slider Classes="filled" Value="20" />
    <Slider Classes="filled secondary" Value="30" />
    <Slider Classes="filled tertiary" Value="40" />
    <Slider Classes="filled info" Value="50" />
    <Slider Classes="filled success" Value="60" />
    <Slider Classes="filled warning" Value="70" />
    <Slider Classes="filled error" Value="80" />
    <Slider Classes="filled dark" Value="90" />
  </StackPanel>
</UserControl>
