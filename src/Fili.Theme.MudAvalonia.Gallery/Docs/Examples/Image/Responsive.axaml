<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Fluid: Stretch="Uniform", the default, fills the width it is given and keeps the ratio;
       MaxWidth caps it. -->
  <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" HorizontalAlignment="Left">
    <Grid.Resources>
      <!-- A 300 x 200 DrawingImage stands in for a photo. -->
      <DrawingImage x:Key="Landscape">
        <DrawingGroup>
          <GeometryDrawing Brush="#FF90CAF9" Geometry="M0,0 H300 V200 H0 Z" />
          <GeometryDrawing Brush="#FFFFCA28" Geometry="M232,60 A22,22 0 1 1 188,60 A22,22 0 1 1 232,60 Z" />
          <GeometryDrawing Brush="#FF5C6BC0" Geometry="M0,200 L0,130 L80,60 L170,150 L170,200 Z" />
          <GeometryDrawing Brush="#FF3949AB" Geometry="M90,200 L190,90 L300,170 L300,200 Z" />
          <GeometryDrawing Brush="#FF66BB6A" Geometry="M0,200 L0,170 Q150,140 300,175 L300,200 Z" />
        </DrawingGroup>
      </DrawingImage>
    </Grid.Resources>
    <Border Grid.Column="0" Width="160" VerticalAlignment="Bottom" Margin="0,0,24,0">
      <Image Source="{DynamicResource Landscape}" />
    </Border>
    <Border Grid.Column="1" Width="320" VerticalAlignment="Bottom" Margin="0,0,24,0">
      <Image Source="{DynamicResource Landscape}" />
    </Border>
    <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="in 160px" Margin="0,8,24,0" />
    <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="in 320px" Margin="0,8,24,0" />
  </Grid>
</UserControl>
