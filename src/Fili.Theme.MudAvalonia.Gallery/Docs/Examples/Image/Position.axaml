<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ObjectPosition is the Image's alignment in its frame. Each frame is 220 x 80. -->
  <WrapPanel Orientation="Horizontal">
    <WrapPanel.Resources>
      <!-- A 300 x 200 DrawingImage stands in for a photo. -->
      <DrawingImage x:Key="Landscape">
        <DrawingGroup>
          <GeometryDrawing Brush="#FF90CAF9" Geometry="M0,0 H300 V200 H0 Z" />
          <GeometryDrawing Brush="#FFFFCA28" Geometry="M232,60 A22,22 0 1 1 188,60 A22,22 0 1 1 232,60 Z" />
          <GeometryDrawing Brush="#FF5C6BC0" Geometry="M0,200 L0,130 L80,60 L170,150 L170,200 Z" />
          <GeometryDrawing Brush="#FF3949AB" Geometry="M90,200 L190,90 L300,170 L300,200 Z" />
          <GeometryDrawing Brush="#FF66BB6A" Geometry="M0,200 L0,170 Q150,140 300,175 L300,200 Z" />
        </DrawingGroup>
      </DrawingImage>
    </WrapPanel.Resources>
    <StackPanel Spacing="8" Margin="0,0,24,16">
      <Border Width="220" Height="80" BorderThickness="1" BorderBrush="{DynamicResource FiliLinesDefaultBrush}">
        <Image Source="{DynamicResource Landscape}" HorizontalAlignment="Left" />
      </Border>
      <TextBlock Classes="caption" Text="HorizontalAlignment=Left (left)" />
    </StackPanel>
    <StackPanel Spacing="8" Margin="0,0,24,16">
      <Border Width="220" Height="80" BorderThickness="1" BorderBrush="{DynamicResource FiliLinesDefaultBrush}">
        <Image Source="{DynamicResource Landscape}" HorizontalAlignment="Center" />
      </Border>
      <TextBlock Classes="caption" Text="HorizontalAlignment=Center (center)" />
    </StackPanel>
    <StackPanel Spacing="8" Margin="0,0,24,16">
      <Border Width="220" Height="80" BorderThickness="1" BorderBrush="{DynamicResource FiliLinesDefaultBrush}">
        <Image Source="{DynamicResource Landscape}" HorizontalAlignment="Right" />
      </Border>
      <TextBlock Classes="caption" Text="HorizontalAlignment=Right (right)" />
    </StackPanel>
  </WrapPanel>
</UserControl>
