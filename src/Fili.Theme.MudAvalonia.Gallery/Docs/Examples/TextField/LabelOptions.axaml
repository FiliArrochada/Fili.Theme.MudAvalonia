<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel ItemSpacing="16" LineSpacing="16">
    <TextBox Classes="required" Width="220" VerticalAlignment="Top" PlaceholderText="Required" />
    <TextBox Classes="filled shrink-label" Width="220" VerticalAlignment="Top" PlaceholderText="Shrink label" />
    <TextBox Classes="filled no-underline" Width="220" VerticalAlignment="Top" PlaceholderText="No underline" Text="Filled" />
  </WrapPanel>
</UserControl>
