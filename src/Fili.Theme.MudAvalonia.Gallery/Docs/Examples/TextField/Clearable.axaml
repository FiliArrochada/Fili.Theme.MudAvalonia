<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel ItemSpacing="16" LineSpacing="16">
    <TextBox Classes="clearable" Width="220" VerticalAlignment="Top" PlaceholderText="Search" Text="Avalonia" />
    <TextBox Classes="filled clearable" Width="220" VerticalAlignment="Top" PlaceholderText="City" Text="Lisbon" />
    <TextBox Classes="outlined clearable" Width="220" VerticalAlignment="Top" PlaceholderText="Weight" Text="72"
             InnerRightContent="kg" />
  </WrapPanel>
</UserControl>
