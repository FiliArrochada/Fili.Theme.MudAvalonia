<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel ItemSpacing="16" LineSpacing="16">
    <TextBox Width="220" VerticalAlignment="Top" PlaceholderText="Email"
             AutomationProperties.HelpText="We never share it" />
    <TextBox Classes="filled" Width="220" VerticalAlignment="Top" PlaceholderText="Email"
             AutomationProperties.HelpText="We never share it" />
    <TextBox Classes="outlined helper-on-focus" Width="220" VerticalAlignment="Top" PlaceholderText="Notes"
             AutomationProperties.HelpText="Shown while focused" />
  </WrapPanel>
</UserControl>
