<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:generic="using:System.Collections.Generic">
  <WrapPanel ItemSpacing="16" LineSpacing="16">
    <AutoCompleteBox Width="220" VerticalAlignment="Top" PlaceholderText="US state">
      <AutoCompleteBox.ItemsSource>
        <generic:List x:TypeArguments="x:String">
          <x:String>Alabama</x:String>
          <x:String>Alaska</x:String>
          <x:String>Arizona</x:String>
          <x:String>Arkansas</x:String>
          <x:String>California</x:String>
        </generic:List>
      </AutoCompleteBox.ItemsSource>
    </AutoCompleteBox>
    <AutoCompleteBox Classes="filled" Width="220" VerticalAlignment="Top" PlaceholderText="US state">
      <AutoCompleteBox.ItemsSource>
        <generic:List x:TypeArguments="x:String">
          <x:String>Alabama</x:String>
          <x:String>Alaska</x:String>
          <x:String>Arizona</x:String>
          <x:String>Arkansas</x:String>
          <x:String>California</x:String>
        </generic:List>
      </AutoCompleteBox.ItemsSource>
    </AutoCompleteBox>
    <AutoCompleteBox Classes="outlined" Width="220" VerticalAlignment="Top" PlaceholderText="US state" Text="Ala">
      <AutoCompleteBox.ItemsSource>
        <generic:List x:TypeArguments="x:String">
          <x:String>Alabama</x:String>
          <x:String>Alaska</x:String>
          <x:String>Arizona</x:String>
          <x:String>Arkansas</x:String>
          <x:String>California</x:String>
        </generic:List>
      </AutoCompleteBox.ItemsSource>
    </AutoCompleteBox>
  </WrapPanel>
</UserControl>
