<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The order number reads left to right inside right-to-left content because the app says so. -->
  <StackPanel FlowDirection="RightToLeft" Width="352" HorizontalAlignment="Left" Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Classes="body1" Text="رقم الطلب" />
      <TextBlock Classes="body1" FlowDirection="LeftToRight" Text="INV-2026/0042" />
    </StackPanel>
    <TextBox Classes="outlined" Width="240" HorizontalAlignment="Left" PlaceholderText="الرمز"
             FlowDirection="LeftToRight" HorizontalContentAlignment="Left" Text="git status" />
  </StackPanel>
</UserControl>
