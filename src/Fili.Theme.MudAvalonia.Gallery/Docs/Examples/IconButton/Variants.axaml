<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- One row per variant, one column per size. flat is DropShadow="false": a filled icon
       button that stays at elevation 0. -->
  <Grid ColumnDefinitions="Auto,72,72,72" RowDefinitions="Auto,Auto,Auto,Auto">
    <TextBlock Grid.Column="1" Classes="caption" Text="small" HorizontalAlignment="Center" />
    <TextBlock Grid.Column="2" Classes="caption" Text="medium" HorizontalAlignment="Center" />
    <TextBlock Grid.Column="3" Classes="caption" Text="large" HorizontalAlignment="Center" />

    <TextBlock Grid.Row="1" Classes="caption" Text="outlined" VerticalAlignment="Center" Margin="0,0,16,0" />
    <Button Grid.Row="1" Grid.Column="1" Classes="icon outlined primary small" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Grid.Row="1" Grid.Column="2" Classes="icon outlined primary" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Grid.Row="1" Grid.Column="3" Classes="icon outlined primary large" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>

    <TextBlock Grid.Row="2" Classes="caption" Text="filled" VerticalAlignment="Center" Margin="0,0,16,0" />
    <Button Grid.Row="2" Grid.Column="1" Classes="icon filled primary small" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Grid.Row="2" Grid.Column="2" Classes="icon filled primary" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Grid.Row="2" Grid.Column="3" Classes="icon filled primary large" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>

    <TextBlock Grid.Row="3" Classes="caption" Text="filled flat" VerticalAlignment="Center" Margin="0,0,16,0" />
    <Button Grid.Row="3" Grid.Column="1" Classes="icon filled primary flat small" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Grid.Row="3" Grid.Column="2" Classes="icon filled primary flat" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
    <Button Grid.Row="3" Grid.Column="3" Classes="icon filled primary flat large" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"><PathIcon Data="{DynamicResource GalleryAddIcon}" /></Button>
  </Grid>
</UserControl>
