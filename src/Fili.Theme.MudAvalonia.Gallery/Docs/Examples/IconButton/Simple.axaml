<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <WrapPanel Orientation="Horizontal">
    <!-- No colour class is Color.Default: action-default grey. -->
    <Button Classes="icon" Margin="0,0,8,8"><PathIcon Data="{DynamicResource GalleryDeleteIcon}" /></Button>
    <Button Classes="icon primary" Margin="0,0,8,8"><PathIcon Data="{DynamicResource GalleryFavoriteIcon}" /></Button>
    <Button Classes="icon secondary" Margin="0,0,8,8"><PathIcon Data="{DynamicResource GalleryShareIcon}" /></Button>
    <Button Classes="icon success" Margin="0,0,8,8"><PathIcon Data="{DynamicResource GalleryDoneIcon}" /></Button>
    <Button Classes="icon error" Margin="0,0,8,8"><PathIcon Data="{DynamicResource GalleryDeleteIcon}" /></Button>
    <Button Classes="icon dark" Margin="0,0,8,8"><PathIcon Data="{DynamicResource GalleryMenuIcon}" /></Button>
    <Button Classes="icon" IsEnabled="False" Margin="0,0,8,8"><PathIcon Data="{DynamicResource GalleryEditIcon}" /></Button>
  </WrapPanel>
</UserControl>
