<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ToolTip.Tip is MudTooltip's Text; ToolTip.Placement its Placement. Hover a button. -->
  <WrapPanel Orientation="Horizontal">
    <Button Classes="icon" Margin="0,0,8,8" ToolTip.Tip="Top" ToolTip.Placement="Top">
      <PathIcon Data="{DynamicResource GalleryDeleteIcon}" />
    </Button>
    <Button Classes="icon" Margin="0,0,8,8" ToolTip.Tip="Bottom" ToolTip.Placement="Bottom">
      <PathIcon Data="{DynamicResource GalleryEditIcon}" />
    </Button>
    <Button Classes="icon" Margin="0,0,8,8" ToolTip.Tip="Left" ToolTip.Placement="Left">
      <PathIcon Data="{DynamicResource GalleryShareIcon}" />
    </Button>
    <Button Classes="icon" Margin="0,0,8,8" ToolTip.Tip="Right" ToolTip.Placement="Right">
      <PathIcon Data="{DynamicResource GalleryFavoriteIcon}" />
    </Button>
  </WrapPanel>
</UserControl>
