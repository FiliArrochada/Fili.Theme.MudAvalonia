<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.NumericFieldPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Numeric field"
                    Summary="A numeric field takes a number, with spin buttons to step it: Avalonia's NumericUpDown, drawn as MudNumericField. Its field is a text field with a 24px spin column inside the box."
                    MudBlazor="NumericField"
                    MudBlazorPath="components/numericfield"
                    AvaloniaControls="NumericUpDown" />

    <TextBlock Classes="h5 section" Text="Basic usage" />
    <docs:ExampleCard Title="Standard, filled and outlined"
                      Description="The spin column sits inside the input box, top to bottom: the underline, the filled ground and the outline run on under it to the field's edge, and the text keeps 24px clear."
                      Source="NumericField/Variants" />
    <TextBlock Classes="body1 p">
      <Run Text="The 24px is not a guess: MudBlazor's input styles reserve exactly that for the spinners. The text field's classes go on the " /><Run Classes="code" Text="NumericUpDown" /><Run Text=" itself and reach the TextBox inside, as does its helper text." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="text-field" Content="Text field" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="Common properties" />
    <docs:ExampleCard Title="Helper text, dense, required, shrink label, error and no underline"
                      Description="AutomationProperties.HelpText, dense, required, shrink-label, error and no-underline are the text field's. The helper line below runs the field's full width."
                      Source="NumericField/CommonProperties" />
    <TextBlock Classes="body1 p">
      <Run Text="A failing binding on " /><Run Classes="code" Text="Value" /><Run Text=" shows its message in the field's helper line, with the red rule, as MudInputControl does." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Spin buttons" />
    <docs:ExampleCard Title="Spin buttons"
                      Description="The column is on the right by default, and on the left with ButtonSpinnerLocation=&quot;Left&quot;. HideSpinButtons is ShowButtonSpinner=&quot;False&quot;."
                      Source="NumericField/SpinButtons" />

    <TextBlock Classes="h5 section" Text="Range and formatting" />
    <docs:ExampleCard Title="Minimum, maximum, step and format"
                      Description="Min, Max, Step and Format are Avalonia's own Minimum, Maximum, Increment and FormatString."
                      Source="NumericField/Range" />

    <TextBlock Classes="h5 section" Text="Adornments" />
    <docs:ExampleCard Title="Text and icon adornments"
                      Description="InnerLeftContent and InnerRightContent are the field's adornments, 8px from the text; beside the spin column an adornment keeps the column's 24px too."
                      Source="NumericField/Adornments" />

    <TextBlock Classes="h5 section" Text="Disabled and read-only" />
    <docs:ExampleCard Title="Disabled and read-only"
                      Description="IsEnabled=&quot;False&quot; is a disabled text field; IsReadOnly looks the same as an editable one."
                      Source="NumericField/Disabled" />

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudNumericField parameter and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="MudNumericField" Here="NumericUpDown" Status="Same" Note="A 24px spin column inside the input box, top to bottom; the underline, filled ground and outline run on under it, and the text keeps 24px clear." />
      <docs:ParityRow MudBlazor="Variant, Margin.Dense, Error, Counter, HelperText, HelperTextOnFocus" Here="the text field's classes and AutomationProperties.HelpText, on the outer control" Status="Same" Note="Passed to the TextBox inside; a validation error shows in its helper line." />
      <docs:ParityRow MudBlazor="Underline, Required, ShrinkLabel" Here="no-underline, required, shrink-label" Status="Same" Note="As on a text field." />
      <docs:ParityRow MudBlazor="HideSpinButtons" Here="ShowButtonSpinner=&quot;False&quot;" Status="Close" />
      <docs:ParityRow MudBlazor="NumericUpIcon, NumericDownIcon" Here="FiliKeyboardArrowUpGeometry, FiliKeyboardArrowDownGeometry in the field's Resources" Status="Same" Note="Drawn at their own size in the 24px box." />
      <docs:ParityRow MudBlazor="Clearable" Here="a button in InnerRightContent" Status="Close" Note="The app clears the value." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
