<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.ToggleGroupPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Toggle group"
                    Summary="A row of options that stay pressed: Avalonia's ToggleButton, drawn as MudToggleItem. A group is a panel of them, with the group's options as classes on each."
                    MudBlazor="ToggleGroup"
                    MudBlazorPath="components/togglegroup"
                    AvaloniaControls="ToggleButton" />

    <TextBlock Classes="h5 section" Text="Usage" />
    <docs:ExampleCard Title="A toggle group"
                      Description="A MudToggleItem is a MudButton with no border, shadow or minimum width, 36.5px high: the colour as text while off, under its hover tint on pointer-over; filled once checked, its darken shade under the pointer. Unlike most components the default is primary."
                      Source="ToggleGroup/Usage" />
    <TextBlock Classes="body1 p">
      <Run Text="An Avalonia toggle is one item, not a group. Put the colour, size and " /><Run Classes="code" Text="outlined" /><Run Text=" on each toggle, or in one " /><Run Classes="code" Text="Style" /><Run Text=" over the panel. MudToggleGroup's selection modes are the app's, through " /><Run Classes="code" Text="IsChecked" /><Run Text=" bindings." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Outlined" />
    <docs:ExampleCard Title="Outlined"
                      Description="MudToggleGroup is outlined by default; here outlined is opt-in on each item: a 1px line in the colour, absorbed into the padding. button-group on the panel joins the items into one shape, as MudToggleGroup is: the radius on its outer corners and one line between items."
                      Source="ToggleGroup/Outlined" />

    <TextBlock Classes="h5 section" Text="Colours" />
    <docs:ExampleCard Title="Every palette colour"
                      Description="A colour class is the group's Color, on each item. A toggle with no class is primary, the group's default; default is Color.Default, MudButton's grey: text-primary, and filled with action-default-hover once selected."
                      Source="ToggleGroup/Colors" />

    <TextBlock Classes="h5 section" Text="Sizes" />
    <docs:ExampleCard Title="Small, medium and large"
                      Description="small and large are 4 and 8px of padding at 13 and 15px text; 3 and 7px when outlined."
                      Source="ToggleGroup/Sizes" />

    <TextBlock Classes="h5 section" Text="Custom content" />
    <docs:ExampleCard Title="Icons and check marks"
                      Description="An item's content is anything: an icon alone, or an icon marked start-icon beside a label. check-mark is MudToggleGroup's CheckMark: a check before the content while IsChecked."
                      Source="ToggleGroup/CustomContent" />

    <TextBlock Classes="h5 section" Text="Vertical" />
    <docs:ExampleCard Title="Vertical"
                      Description="Vertical is a vertical StackPanel of toggles."
                      Source="ToggleGroup/Vertical" />

    <TextBlock Classes="h5 section" Text="Disabled" />
    <docs:ExampleCard Title="Disabled"
                      Description="IsEnabled=&quot;False&quot;: action-disabled text, and the line or ground in action-disabled-background."
                      Source="ToggleGroup/Disabled" />
    <TextBlock Classes="body1 p" Text="MudBlazor's selection modes are behaviour, not a look. ToggleButtons check on their own, which is MultiSelection; for SingleSelection, the default, or ToggleSelection, the app unchecks the other items when one is checked." />

    <TextBlock Classes="h5 section" Text="Without a group" />
    <docs:ExampleCard Title="Toggles side by side"
                      Description="ToggleButtons in a plain StackPanel: each keeps its own corners and, outlined, its own line, so neighbours meet in a 2px one. button-group on the panel, or Spacing=&quot;-1&quot;, gives them one line between them."
                      Source="ToggleGroup/Ungrouped" />

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudToggleGroup parameter and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way; " /><Run Classes="code" Text="Missing" /><Run Text=" is not here." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="button-group" Content="Button group" />
      <docs:DocLink Slug="toggle-icon-button" Content="Toggle icon button" />
    </StackPanel>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="MudToggleGroup item" Here="ToggleButton" Status="Same" Note="A MudButton with no border, shadow or minimum width, on its 1.75 line, 36.5px: the colour as text, its hover tint under the pointer; filled once checked, its darken shade under the pointer." />
      <docs:ParityRow MudBlazor="Color (default Primary)" Here="no class, or primary … dark" Status="Same" Note="On each item." />
      <docs:ParityRow MudBlazor="Outlined (default true)" Here="outlined" Status="Close" Note="Opt-in: the group's 1px line in the colour is a class on each item." />
      <docs:ParityRow MudBlazor="Size.Small / Large" Here="small / large" Status="Same" Note="4px / 8px at 13 / 15px; 3px / 7px when outlined." />
      <docs:ParityRow MudBlazor="Color.Default" Here="default" Status="Same" Note="The one control with a default class, since no class is primary." />
      <docs:ParityRow MudBlazor="Vertical" Here="a vertical StackPanel of toggles" Status="Close" />
      <docs:ParityRow MudBlazor="Delimiters (default true), the group's shape" Here="button-group on the StackPanel" Status="Same" Note="Outlined items share one line between them, and the radius sits on the group's outer corners only." />
      <docs:ParityRow MudBlazor="Delimiters, outside a button-group" Here="outlined items in a plain StackPanel" Status="Close" Note="Each outlined item draws its own line, so two side by side meet in a 2px one; button-group, or Spacing=&quot;-1&quot;, shares it." />
      <docs:ParityRow MudBlazor="CheckMark" Here="check-mark on each item" Status="Same" Note="The check shows before the content while IsChecked, in the item's text colour: 20px with 6px each side, 18px and 4px small, 22px and 8px large." />
      <docs:ParityRow MudBlazor="SelectedIcon" Here="FiliCheckGeometry in the item's Resources" Status="Same" />
      <docs:ParityRow MudBlazor="UnselectedIcon, FixedContent" Here="an icon in Content" Status="Close" Note="Shown by the app while not IsChecked; a transparent one keeps the content where it is." />
      <docs:ParityRow MudBlazor="CheckMarkClass" Here="a /template/ Viewbox#PART_CheckMark style" Status="Close" />
      <docs:ParityRow MudBlazor="SelectedClass" Here="a :checked style" Status="Close" />
      <docs:ParityRow MudBlazor="Disabled" Here="IsEnabled=&quot;False&quot;" Status="Same" Note="Action-disabled text, and the line or ground in action-disabled-background." />
      <docs:ParityRow MudBlazor="MudToggleItem.Text" Here="Content" Status="Same" />
      <docs:ParityRow MudBlazor="Value, Values, MudToggleItem.Value" Here="IsChecked on each item" Status="Close" Note="Which items are checked is the app's to bind." />
      <docs:ParityRow MudBlazor="SelectionMode.MultiSelection" Here="the same" Status="Same" Note="Each ToggleButton checks and unchecks on its own." />
      <docs:ParityRow MudBlazor="SelectionMode.SingleSelection (default), ToggleSelection" Here="—" Status="Missing" Note="Behaviour: ToggleButtons do not group, so the app unchecks the others when one is checked, and for SingleSelection keeps one checked." />
      <docs:ParityRow MudBlazor="Ripple (default true)" Here="on" Status="Same" />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
