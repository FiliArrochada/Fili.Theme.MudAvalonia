<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.ScrollBarPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Scroll bar"
                    Summary="The rail a ScrollViewer shows when its content does not fit: the scroll bar MudThemeProvider injects into every MudBlazor page, an 8px rail with a grey thumb and no line buttons, with nothing to opt into."
                    AvaloniaControls="ScrollBar, ScrollViewer" />

    <TextBlock Classes="h5 section" Text="Basic usage" />
    <docs:ExampleCard Title="A ScrollViewer"
                      Description="An 8px rail on a transparent track, with no line buttons, and a thumb that fills it, rounded 1px: #c4c4c4 at rest, #a6a6a6 under the pointer and while it is dragged. Scroll the panel, then hover and drag the thumb."
                      Source="ScrollBar/Vertical" />
    <TextBlock Classes="body1 p">
      <Run Text="Material has no scroll bar of its own, but MudBlazor does: unless MudThemeProvider's DefaultScrollbar is set, which it is not by default, it injects one into the page, and this is a transcription of it. Its two greys are literals rather than palette colours, the same in light and dark; high contrast gives them its own. There is no pressed colour, as a dragged thumb is under the pointer and keeps its hover grey. The rail takes its 8px beside the content, so content that becomes scrollable gives up that width." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Both ways" />
    <docs:ExampleCard Title="HorizontalScrollBarVisibility"
                      Description="A ScrollViewer scrolls only vertically by default. HorizontalScrollBarVisibility=&quot;Auto&quot; adds a horizontal rail when the content is wider than the viewer, and the corner where the two rails meet is a background-gray square."
                      Source="ScrollBar/BothWays" />

    <TextBlock Classes="h5 section" Text="The scroll viewer" />
    <TextBlock Classes="body1 p">
      <Run Text="Only the " /><Run Classes="code" Text="ScrollBar" /><Run Text=" is this theme's own. " /><Run Classes="code" Text="ScrollViewer" /><Run Text=" keeps Avalonia's template on purpose: it is structure rather than look, and the control where a mistake costs most, as a viewer with a misnamed part lays out perfectly and does not scroll. The wheel, a drag, the keyboard and touch are the ScrollViewer's, so they work as they always do; the bar has no line buttons to click." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="list" Content="List" />
      <docs:DocLink Slug="tabs" Content="Tabs" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="MudBlazor has no scroll bar component, but MudThemeProvider styles the page's scroll bars, which the bar here is " /><Run Classes="code" Text="Same" /><Run Text=" as. The scroll viewer is " /><Run Classes="code" Text="Extra" /><Run Text=": a MudBlazor page scrolls with overflow: auto." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="MudThemeProvider's scroll bar (DefaultScrollbar false, the default)" Here="ScrollBar, themed by type" Status="Same" Note="8px, a transparent track and no line buttons; the thumb fills it, rounded 1px, FiliScrollbarThumbColor (#c4c4c4) at rest and FiliScrollbarThumbHoverColor (#a6a6a6) under the pointer and while dragged. DefaultScrollbar=&quot;true&quot;, the browser's own bar, has no counterpart." />
      <docs:ParityRow MudBlazor="(none: overflow: auto)" Here="ScrollViewer" Status="Extra" Note="Avalonia's own template, parts and all: the wheel, a drag, the keyboard and touch scroll it, the rail sits beside the content, and the corner where two rails meet is background-gray." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
