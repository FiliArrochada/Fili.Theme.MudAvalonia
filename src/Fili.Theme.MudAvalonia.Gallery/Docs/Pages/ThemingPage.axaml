<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.ThemingPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Theming"
                    Summary="Your colours instead of MudBlazor's, in each variant, and one control's look without touching its template."
                    MudBlazor="MudThemeProvider"
                    MudBlazorPath="customization/overview" />

    <TextBlock Classes="h5 section" Text="Your colours" />
    <TextBlock Classes="body1 p">
      <Run Text="Every colour is a " /><Run Classes="code" Text="Fili{Name}Color" /><Run Text=" and its " /><Run Classes="code" Text="Fili{Name}Brush" /><Run Text=", declared for light, dark and high contrast. Light and dark are MudBlazor's Palette.cs and PaletteDark.cs; high contrast is derived from them. Override the colours in your application's resources, per variant, as MudTheme's PaletteLight and PaletteDark do, and declare high contrast too: it falls back to your dark colours otherwise." />
    </TextBlock>
    <docs:CodeBlock Code="&lt;!-- xmlns:theme=&quot;using:Fili.Theme.MudAvalonia&quot; on the Application --&gt;&#10;&lt;Application.Resources&gt;&#10;  &lt;ResourceDictionary&gt;&#10;    &lt;ResourceDictionary.ThemeDictionaries&gt;&#10;      &lt;ResourceDictionary x:Key=&quot;Light&quot;&gt;&#10;        &lt;Color x:Key=&quot;FiliPrimaryColor&quot;&gt;#C79A3B&lt;/Color&gt;&#10;        &lt;Color x:Key=&quot;FiliPrimaryHoverColor&quot;&gt;#0FC79A3B&lt;/Color&gt;&#10;        &lt;Color x:Key=&quot;FiliPrimaryDarkenColor&quot;&gt;#AB8431&lt;/Color&gt;&#10;        &lt;Color x:Key=&quot;FiliPrimaryLightenColor&quot;&gt;#D0A959&lt;/Color&gt;&#10;        &lt;Color x:Key=&quot;FiliPrimaryContrastTextColor&quot;&gt;#000000&lt;/Color&gt;&#10;        &lt;!-- the colour as text: 4.5:1 on the page, a surface and its tints --&gt;&#10;        &lt;Color x:Key=&quot;FiliPrimaryTextColor&quot;&gt;#896A27&lt;/Color&gt;&#10;        &lt;!-- the colour as a line or glyph: 3:1 on the page and a filled field --&gt;&#10;        &lt;Color x:Key=&quot;FiliPrimaryNonTextColor&quot;&gt;#A47E2F&lt;/Color&gt;&#10;      &lt;/ResourceDictionary&gt;&#10;      &lt;ResourceDictionary x:Key=&quot;Dark&quot;&gt;&#10;        &lt;!-- the same seven keys, in dark's colours --&gt;&#10;      &lt;/ResourceDictionary&gt;&#10;      &lt;ResourceDictionary x:Key=&quot;{x:Static theme:FiliThemeVariants.HighContrast}&quot;&gt;&#10;        &lt;!-- and again in high contrast's --&gt;&#10;      &lt;/ResourceDictionary&gt;&#10;    &lt;/ResourceDictionary.ThemeDictionaries&gt;&#10;  &lt;/ResourceDictionary&gt;&#10;&lt;/Application.Resources&gt;"
                    Margin="0,0,0,16" />
    <TextBlock Classes="body1 p">
      <Run Text="The palette button in this site's app bar does just that: a swatch sets the seven keys, with darken and lighten by MudBlazor's rule, the text darkened or lightened until it reads at 4.5:1 and the line until it shows at 3:1, in light and dark, and declares high contrast with the colours it ships, so high contrast is unchanged." />
    </TextBlock>
    <TextBlock Classes="body1 p">
      <Run Text="A colour is seven tokens, not one. Hover, focus and press paint the " /><Run Classes="code" Text="Hover" /><Run Text=" shade (the colour at 6%) on text and outlined controls and the " /><Run Classes="code" Text="Darken" /><Run Text=" shade on filled ones; " /><Run Classes="code" Text="ContrastText" /><Run Text=" is the text on a fill, at 4.5:1 or more on the colour and its darken shade; " /><Run Classes="code" Text="Text" /><Run Text=" the colour as text on the page: a link, a text button, a focused label, an error message, at 4.5:1 or more on the page and a surface; and " /><Run Classes="code" Text="NonText" /><Run Text=" the colour as a line or glyph, a checked box, a switch, a slider, a focused underline, a tab's indicator, at 3:1 or more on them. Leave one out and that state keeps MudBlazor's colour: a gold button that turns purple under the pointer. MudBlazor derives darken and lighten from the colour, its lightness 0.075 down and up." />
    </TextBlock>
    <TextBlock Classes="body1 p">
      <Run Text="The same goes for a button with no colour class: overriding " /><Run Classes="code" Text="FiliActionDefaultColor" /><Run Text=" means " /><Run Classes="code" Text="FiliActionDefaultHoverColor" /><Run Text=" too, the colour at 6%, which its hover, focus and press paint. A near-black colour darkens to black, as it does in MudBlazor, so a filled button in it barely changes under the pointer on a near-black page." />
    </TextBlock>
    <TextBlock Classes="body1 p">
      <Run Text="An app that swaps whole palette dictionaries at run time, rather than setting " /><Run Classes="code" Text="RequestedThemeVariant" /><Run Text=", needs nothing new: each of its palettes carries the same " /><Run Classes="code" Text="Fili*" /><Run Text=" overrides." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Font, corners and density" />
    <TextBlock Classes="body1 p">
      <Run FontWeight="Bold" Text="The font" /><Run Text=" is " /><Run Classes="code" Text="FiliFontFamily" /><Run Text=", embedded Roboto. Set it in the application's resources to your own face, and ship that face in the three weights the type ramp uses: Light (300) for h1 and h2, Regular (400) for body text and Medium (500) for buttons, tabs, h6 and subtitle2. A family without one of them is drawn in the nearest face it has, so headings or labels lose their weight." />
    </TextBlock>
    <docs:CodeBlock Code="&lt;Application.Resources&gt;&#10;  &lt;!-- Inter-Light.ttf, Inter-Regular.ttf and Inter-Medium.ttf as AvaloniaResource --&gt;&#10;  &lt;FontFamily x:Key=&quot;FiliFontFamily&quot;&gt;avares://MyApp/Assets/Fonts#Inter&lt;/FontFamily&gt;&#10;&lt;/Application.Resources&gt;"
                    Margin="0,0,0,16" />
    <TextBlock Classes="body1 p">
      <Run FontWeight="Bold" Text="The corners" /><Run Text=" are " /><Run Classes="code" Text="FiliCornerRadius" /><Run Text=", MudBlazor's DefaultBorderRadius of 4px: buttons, fields, papers, cards, menus, alerts and the rest read it. Shapes MudBlazor fixes keep their own, a chip's pill, a FAB's circle, a checkbox's box. In the application's resources it changes every control; in a control's, that control and what is inside it." />
    </TextBlock>
    <docs:CodeBlock Code="&lt;Application.Resources&gt;&#10;  &lt;CornerRadius x:Key=&quot;FiliCornerRadius&quot;&gt;8&lt;/CornerRadius&gt;&#10;&lt;/Application.Resources&gt;&#10;&#10;&lt;!-- one square card --&gt;&#10;&lt;Border Classes=&quot;card&quot;&gt;&#10;  &lt;Border.Resources&gt;&#10;    &lt;CornerRadius x:Key=&quot;FiliCornerRadius&quot;&gt;0&lt;/CornerRadius&gt;&#10;  &lt;/Border.Resources&gt;&#10;&lt;/Border&gt;"
                    Margin="0,0,0,16" />
    <TextBlock Classes="body1 p">
      <Run FontWeight="Bold" Text="Density" /><Run Text=" is MudBlazor's Dense parameter: the " /><Run Classes="code" Text="dense" /><Run Text=" class on each control that has one, a text field, select, number field, check box, radio, list, menu, tree view, table, data grid, expansion panel, tool bar or alert. There is no app-wide density switch, as MudBlazor has none: a class is set per control, so a dense screen sets it on each." />
    </TextBlock>
    <TextBlock Classes="body1 p" Text="Every key an app may set, with its type and what it changes, is in Published resource keys:" />
    <HyperlinkButton Content="docs/published-keys.md on GitHub"
                     NavigateUri="https://github.com/FiliArrochada/Fili.Theme.MudAvalonia/blob/master/docs/published-keys.md"
                     Margin="0,0,0,16" />
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="typography" Content="Typography" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="One control's look" />
    <TextBlock Classes="body1 p">
      <Run Text="A template's parts are not published, and a style that reaches into one can break on any release. Every part paints a token, and a resource lookup starts at the control, so a key in a control's own " /><Run Classes="code" Text="Resources" /><Run Text=" changes that control alone." />
    </TextBlock>
    <docs:ExampleCard Title="A button with no hover tint or ripple"
                      Description="The state layer reads FiliActionDefaultHoverBrush, and the ripple FiliRippleOpacity and, on a filled button, a filled chip or a coloured FAB, FiliRippleOpacitySecondary: set both to 0 to turn it off. In the button's Resources they reach this button and its content only."
                      Source="Theming/QuietButton" />
    <TextBlock Classes="body1 p" Text="The keys reach the control's content too, so a default button inside it loses its hover as well. And hover is also MudBlazor's focus cue: a control that drops it needs a focus cue of its own for the keyboard." />
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="keyboard-focus" Content="Keyboard focus" />
      <docs:DocLink Slug="reduced-motion" Content="Reduced motion" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="Variants" />
    <TextBlock Classes="body1 p">
      <Run Text="Light and Dark are Avalonia's own variants. High contrast is " /><Run Classes="code" Text="FiliThemeVariants.HighContrast" /><Run Text=", the package's one public type, and inherits from Dark: declare its colours too if you override Dark's. Set the variant on the Application for every window, or on a window or a ThemeVariantScope for what is inside it. The switch in this site's app bar changes all three." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="high-contrast" Content="High contrast" />
      <docs:DocLink Slug="palette" Content="Palette" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="Where it differs" />
    <TextBlock Classes="body1 p">
      <Run Text="The " /><Run Classes="code" Text="dark" /><Run Text=" colour barely shows as a line in dark mode: #27272F on a #32333D page, as in MudBlazor's dark theme. A filled dark button stays visible, and since 1.1.0 the colour as text, a dark text button or link, is FiliDarkTextColor, lightened to 4.5:1." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Right to left" />
    <TextBlock Classes="body1 p">
      <Run Text="Set " /><Run Classes="code" Text="FlowDirection=&quot;RightToLeft&quot;" /><Run Text=" on a window or any container, as MudRTLProvider does: every template mirrors, and the one deliberate exception is a glyph that must not." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="right-to-left" Content="Right to left" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="MudTheme's palette, shadows, layout and variants, and what each is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way. The type ramp is on the Typography page." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="Palette Primary … Dark" Here="FiliPrimaryColor … FiliDarkColor" Status="Close" Note="Every one MudBlazor's but dark's primary, #6F62E6 rather than #776BE7 since 1.2.0, a shade darker so its white text reaches 4.5:1." />
      <docs:ParityRow MudBlazor="PrimaryContrastText … DarkContrastText" Here="Fili…ContrastTextColor" Status="Close" Note="White in light and dark where it reaches 4.5:1 on the fill and its darken shade, primary and dark; since 1.2.0 black at 87% on the others, where MudBlazor's white fell as low as 1.93:1. Black on high contrast's pastels." />
      <docs:ParityRow MudBlazor="PrimaryDarken … DarkDarken" Here="Fili…DarkenColor" Status="Same" Note="MudBlazor's own algorithm, checked on every build." />
      <docs:ParityRow MudBlazor="PrimaryLighten … DarkLighten" Here="Fili…LightenColor" Status="Same" Note="The same algorithm; the 14 darken and lighten values of the default palette match mudblazor.com." />
      <docs:ParityRow MudBlazor="(none: an alert's text, the darken shade)" Here="FiliPrimaryAlertTextColor … FiliDarkAlertTextColor" Status="Extra" Note="A text or outlined alert's text: the darken shade, as _alert.scss paints it, where that reaches 4.5:1 on the alert; since 1.0.1 every other one keeps the hue and is darkened (light) or lightened (dark) to 4.5:1, a deliberate departure from MudBlazor. The lighten shade in high contrast." />
      <docs:ParityRow MudBlazor="(none: `mud-{color}-text`, the colour itself)" Here="FiliPrimaryTextColor … FiliDarkTextColor" Status="Extra" Note="The colour as text on the page or a surface: links, text and outlined buttons and chips, selected tabs, rows and nav links, focused labels, error messages. The colour where it reaches 4.5:1 on the page, a surface and the tints a control lays under it; since 1.1.0 every other one keeps the hue and is darkened (light) or lightened (dark) to 4.5:1, a deliberate departure from MudBlazor." />
      <docs:ParityRow MudBlazor="(none: `mud-{color}-text` on a glyph, the colour itself)" Here="FiliPrimaryNonTextColor … FiliDarkNonTextColor" Status="Extra" Note="The colour as a line or glyph: a checked checkbox or radio, an on switch, a slider, a progress bar, a focused or invalid field's underline, a tab's indicator, an active nav link's line and icon, an alert's icon, a coloured icon. The colour where it reaches WCAG 1.4.11's 3:1 on the page, a surface and a filled field; since 1.2.0 every other one keeps the hue and is darkened (light) or lightened (dark) to 3:1. The colour itself in high contrast." />
      <docs:ParityRow MudBlazor="(none: an avatar's ground, lines-inputs)" Here="FiliAvatarBackgroundColor" Status="Extra" Note="MudBlazor's lines-inputs value, kept for a default avatar when lines-inputs darkened for a field's edge in 1.1.0." />
      <docs:ParityRow MudBlazor="(none: a chip's hover, action-disabled)" Here="FiliChipHoverColor" Status="Extra" Note="A default chip's ground on hover, focus and press: action-disabled, as _chip.scss paints it, and an opaque grey in high contrast." />
      <docs:ParityRow MudBlazor="the theme provider's {color}-hover" Here="Fili…HoverColor" Status="Same" Note="The colour at HoverOpacity, 6%." />
      <docs:ParityRow MudBlazor="Black, White" Here="FiliBlackColor, FiliWhiteColor" Status="Same" />
      <docs:ParityRow MudBlazor="TextPrimary / TextSecondary / TextDisabled" Here="FiliText…Color" Status="Close" Note="Dark's TextSecondary is white at 53%, not 50%, since 1.1.0: 4.5:1 on the dark surface." />
      <docs:ParityRow MudBlazor="ActionDefault / ActionDisabled / ActionDisabledBackground" Here="FiliAction…Color" Status="Same" />
      <docs:ParityRow MudBlazor="the theme provider's action-default-hover" Here="FiliActionDefaultHoverColor" Status="Same" />
      <docs:ParityRow MudBlazor="Background / BackgroundGray / Surface" Here="FiliBackground…Color, FiliSurfaceColor" Status="Same" />
      <docs:ParityRow MudBlazor="DrawerBackground / DrawerText / DrawerIcon" Here="FiliDrawer…Color" Status="Same" />
      <docs:ParityRow MudBlazor="AppbarBackground / AppbarText" Here="FiliAppbar…Color" Status="Same" />
      <docs:ParityRow MudBlazor="LinesDefault / LinesInputs / Divider" Here="FiliLines…Color, FiliDividerColor" Status="Close" Note="LinesInputs is darker since 1.1.0, #848484 in light and white at 43% in dark, so a field's edge reaches 3:1 (WCAG 1.4.11)." />
      <docs:ParityRow MudBlazor="DividerLight" Here="FiliDividerLightColor" Status="Same" Note="High contrast keeps a visible line." />
      <docs:ParityRow MudBlazor="TableLines / TableStriped / TableHover" Here="FiliTable…Color" Status="Same" />
      <docs:ParityRow MudBlazor="Skeleton" Here="FiliSkeletonColor" Status="Same" />
      <docs:ParityRow MudBlazor="OverlayDark / OverlayLight" Here="FiliOverlayDarkColor / FiliOverlayLightColor" Status="Same" />
      <docs:ParityRow MudBlazor="MudThemeProvider's scroll bar thumb, #c4c4c4 and #a6a6a6 under the pointer" Here="FiliScrollbarThumbColor / FiliScrollbarThumbHoverColor" Status="Same" Note="Literals in MudThemeProvider, not palette properties: the same in light and dark; this variant's own greys in high contrast." />
      <docs:ParityRow MudBlazor="GrayDefault … GrayDarker" Here="FiliGrayDefaultColor … FiliGrayDarkerColor" Status="Same" Note="The same in light and dark, as PaletteDark.cs leaves them; a step lighter in high contrast." />
      <docs:ParityRow MudBlazor="HoverOpacity / BorderOpacity" Here="—" Status="Close" Note="Folded into the hover and line tokens rather than exposed." />
      <docs:ParityRow MudBlazor="RippleOpacity / RippleOpacitySecondary" Here="FiliRippleOpacity / FiliRippleOpacitySecondary" Status="Same" Note="0.1 and 0.2, a Double the same in every variant, as MudThemeProvider writes both from the light palette." />
      <docs:ParityRow MudBlazor="Shadow.cs" Here="FiliElevation0 … FiliElevation25" Status="Same" Note="Three layers each; a 1px ring in high contrast." />
      <docs:ParityRow MudBlazor="LayoutProperties DefaultBorderRadius" Here="FiliCornerRadius" Status="Same" Note="4px; set it in the application's resources for every control, or in a control's for that one." />
      <docs:ParityRow MudBlazor="AppbarHeight, DrawerWidthLeft, DrawerMiniWidthLeft" Here="FiliAppbarHeight, FiliDrawerWidth, FiliDrawerMiniWidth" Status="Same" />
      <docs:ParityRow MudBlazor="DrawerWidthRight, DrawerMiniWidthRight" Here="FiliDrawerWidth, FiliDrawerMiniWidth" Status="Close" Note="One key for either side, 240 and 56px as both of MudBlazor's are." />
      <docs:ParityRow MudBlazor="ZIndex (Drawer, Popover, AppBar, Dialog, Snackbar, Tooltip)" Here="—" Status="Missing" Note="Avalonia stacks by the tree and its own layers: popups, tooltips and notifications sit above the content, and ZIndex orders siblings." />
      <docs:ParityRow MudBlazor="PseudoCss.Scope (:root)" Here="the Resources the keys are set in" Status="Close" Note="Keys in the application's Resources reach everything; in a control's, only that control, and for a colour only its *Brush key: a *Color key works in the application's Resources alone." />
      <docs:ParityRow MudBlazor="the spacing scale (pa-4 and friends)" Here="Padding, Margin, Spacing; FiliSpacing0 … FiliSpacing20 and FiliSpacing0Thickness … FiliSpacing20Thickness" Status="Close" Note="Properties, not classes: MudBlazor's 0 to 20 steps of 4px, a number for a Spacing and a Thickness on every side for pa-N and ma-N; a one-sided step is written out." />
      <docs:ParityRow MudBlazor="IsDarkMode" Here="Application.RequestedThemeVariant = ThemeVariant.Dark" Status="Same" />
      <docs:ParityRow MudBlazor="(none: high contrast)" Here="FiliThemeVariants.HighContrast" Status="Extra" Note="This package's own third variant, inheriting from Dark." />
      <docs:ParityRow MudBlazor="MudRTLProvider" Here="FlowDirection" Status="Same" Note="Every template mirrors; a glyph that must not mirror opts out." />
      <docs:ParityRow MudBlazor="(none: a component's built-in aria-label text)" Here="FiliStringClear, FiliStringClose, FiliStringPrevious, FiliStringNext, FiliStringIncrease, FiliStringDecrease, FiliStringAccept, FiliStringDismiss" Status="Extra" Note="The names a screen reader hears for the templates' icon buttons, English by default; set one in the application's Resources to translate it." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
