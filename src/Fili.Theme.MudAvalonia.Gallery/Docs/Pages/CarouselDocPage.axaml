<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.CarouselDocPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Carousel"
                    Summary="Avalonia's Carousel, drawn as MudCarousel: arrows at the sides and bullets along the bottom, on by default. A CarouselPage is a carousel of pages, with the same arrows and bullets."
                    MudBlazor="Carousel"
                    MudBlazorPath="components/carousel"
                    AvaloniaControls="Carousel, PipsPager, CarouselPage" />

    <TextBlock Classes="h5 section" Text="Example" />
    <docs:ExampleCard Title="Arrows and bullets"
                      Description="NavigateBefore and NavigateNext icon buttons at the sides, centred, in the carousel's text colour at .75, and the bullets along the bottom at .75. SelectedIndex is the slide shown."
                      Source="Carousel/Basic" />
    <TextBlock Classes="body1 p">
      <Run Text="The bullets are a " /><Run Classes="code" Text="PipsPager" /><Run Text=", drawn with the radio button's two glyphs: the current slide's bullet is " /><Run Classes="code" Text="RadioButtonChecked" /><Run Text=", the others " /><Run Classes="code" Text="RadioButtonUnchecked" /><Run Text=". The arrows are for the pointer; the carousel itself is the Tab stop, and its keys turn it. Bind " /><Run Classes="code" Text="ItemsSource" /><Run Text=", " /><Run Classes="code" Text="ItemTemplate" /><Run Text=" and " /><Run Classes="code" Text="SelectedIndex" /><Run Text=" for MudCarousel's DataBinding section. Its Elements Templates section has no counterpart: the arrows and bullets are template parts, so another shape for them is a ControlTheme of the app's; their glyphs are keys, in the parity table below." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Arrows and bullets" />
    <docs:ExampleCard Title="no-arrows and no-bullets"
                      Description="no-arrows is ShowArrows=&quot;false&quot; and no-bullets is ShowBullets=&quot;false&quot;."
                      Source="Carousel/Options" />
    <docs:ExampleCard Title="Where the arrows and bullets sit"
                      Description="MudCarousel's ArrowsPosition is Center and BulletsPosition Bottom; arrows-top and arrows-bottom move the arrows, bullets-top and bullets-center the bullets."
                      Source="Carousel/Positions" />

    <TextBlock Classes="h5 section" Text="Transitions" />
    <docs:ExampleCard Title="PageSlide and CrossFade"
                      Description="How a slide moves is Avalonia's PageTransition, behaviour rather than a look: set any transition on the carousel."
                      Source="Carousel/Transitions" />

    <TextBlock Classes="h5 section" Text="Pips pager" />
    <docs:ExampleCard Title="A PipsPager on its own"
                      Description="A PipsPager outside a carousel wears the same look: the radio button's two glyphs in action-default at .75, the current page's filled, with NavigateBefore and NavigateNext buttons at the ends unless they are hidden."
                      Source="Carousel/PipsPager" />
    <TextBlock Classes="body1 p">
      <Run Text="It is MudCarousel's bullets, not MudPagination: Avalonia has no numbered pager, so a pager of page numbers is not here." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Carousel page" />
    <docs:ExampleCard Title="CarouselPage"
                      Description="A carousel of ContentPages, each on the app's background, with the same arrows and bullets."
                      Source="Carousel/CarouselPage" />

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudCarousel parameter that changes how it looks and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way; " /><Run Classes="code" Text="Missing" /><Run Text=" is not available." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="the arrows, NavigateBefore / NavigateNext" Here="at the sides, centred, .75" Status="Same" Note="Icon buttons in the carousel's text colour, for the pointer; the carousel itself is the Tab stop." />
      <docs:ParityRow MudBlazor="the bullets" Here="a PipsPager along the bottom" Status="Same" Note="RadioButtonChecked for the current slide, RadioButtonUnchecked for the rest, all in the carousel's text colour (Color.Inherit), in a 48px band, a MudIconButton's height, so they share the arrows' line." />
      <docs:ParityRow MudBlazor="the bullets on their own" Here="PipsPager" Status="Same" Note="The same glyphs in action-default at .75, with the arrows as its previous and next buttons; MudPagination has no counterpart, as Avalonia has no numbered pager." />
      <docs:ParityRow MudBlazor="ArrowsColor, BulletsColor" Here="Foreground on the carousel" Status="Close" Note="One colour for the arrows and the bullets together." />
      <docs:ParityRow MudBlazor="ShowArrows=&quot;false&quot;, ShowBullets=&quot;false&quot;" Here="no-arrows, no-bullets" Status="Same" Note="Each class hides its part." />
      <docs:ParityRow MudBlazor="ArrowsPosition (Center)" Here="arrows-top, arrows-bottom" Status="Same" Note="Top and Bottom, as align-self-start and align-self-end; Start and End are the same two." />
      <docs:ParityRow MudBlazor="BulletsPosition (Bottom)" Here="bullets-top, bullets-center" Status="Same" Note="Top and Center, as align-self-start and align-self-center." />
      <docs:ParityRow MudBlazor="AutoCycle, AutoCycleTime" Here="—" Status="Missing" Note="Cycling is behaviour, the app's." />
      <docs:ParityRow MudBlazor="PreviousIcon, NextIcon" Here="FiliNavigateBeforeGeometry, FiliChevronRightGeometry in the carousel's Resources" Status="Close" Note="Keys rather than parameters; NavigateNext is ChevronRight's path." />
      <docs:ParityRow MudBlazor="CheckedIcon, UncheckedIcon" Here="FiliRadioCheckedGeometry, FiliRadioUncheckedGeometry in the carousel's Resources" Status="Close" Note="The radio button's keys, so a radio on a slide changes with them." />
      <docs:ParityRow MudBlazor="PreviousButtonTemplate, NextButtonTemplate, BulletTemplate" Here="—" Status="Missing" Note="The arrows and bullets are template parts; another shape is a ControlTheme of the app's." />
      <docs:ParityRow MudBlazor="EnableSwipeGesture (default true)" Here="IsSwipeEnabled" Status="Close" Note="Off by default in Avalonia, and it takes the mouse as well as touch." />
      <docs:ParityRow MudBlazor="MudCarouselItem Color" Here="Foreground on the slide's content" Status="Close" Note="The bullets take the carousel's Foreground, not the current slide's." />
      <docs:ParityRow MudBlazor="MudCarouselItem Transition, CustomTransitionEnter, CustomTransitionExit" Here="PageTransition on the carousel" Status="Close" Note="One transition for every slide: Slide is PageSlide, Fade CrossFade, None null, Custom an IPageTransition of the app's." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
