<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.TooltipPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Tooltip"
                    Summary="A short label that appears when the pointer rests on a control: Avalonia's ToolTip, drawn as MudTooltip. Hover the controls in the examples to see them."
                    MudBlazor="Tooltip"
                    MudBlazorPath="components/tooltip" />

    <TextBlock Classes="h5 section" Text="Simple tooltips" />
    <docs:ExampleCard Title="ToolTip.Tip and ToolTip.Placement"
                      Description="ToolTip.Tip on any control is MudTooltip's Text, and ToolTip.Placement its Placement: hover each icon for Top, Bottom, Left and Right. Each sits centred on that side, 10px from the target, as MudBlazor's does. The tooltip is a solid gray-darker chip, 12px at weight 500, padded 4px 8px."
                      Source="Tooltip/Simple" />
    <TextBlock Classes="body1 p">
      <Run Text="The tooltip is deliberately not theme-varying: a Material tooltip is a dark chip in light and dark alike, and in high contrast, so it reads as an annotation above the UI rather than another surface of it. Its fill is " />
      <Run Classes="code" Text="_tooltip.scss" />
      <Run Text="'s gray-darker, #616161, solid. It has no width of its own, so a long tooltip wraps only at the edge of the screen, or of the page in a browser." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="How a tooltip looks" />
    <docs:ExampleCard Title="Open tooltips"
                      Description="ToolTip controls placed in the page, as they look once open: the default chip and each colour class. Out of a popup a tooltip has no placement, so these draw no arrow."
                      Source="Tooltip/Preview" />

    <TextBlock Classes="h5 section" Text="Arrow tooltips" />
    <docs:ExampleCard Title="arrow"
                      Description="A ToolTip used as the Tip keeps its classes: arrow is MudTooltip's Arrow, a 6px triangle in the chip's colour on the side facing the target, for Placement Top, Bottom, Left and Right."
                      Source="Tooltip/Arrow" />
    <TextBlock Classes="body1 p">
      <Run Text="The arrow and the 4px beyond it are the 10px gap every tooltip on a side keeps, arrow or not. Pointer, Avalonia's default placement and not one of MudBlazor's, draws no arrow and keeps Avalonia's " />
      <Run Classes="code" Text="ToolTip.VerticalOffset" />
      <Run Text=" of 20 under the pointer; on the four sides the theme sets it to 0, where a style would, so an offset the app sets moves the tooltip from MudBlazor's place." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Coloured tooltips" />
    <docs:ExampleCard Title="Colour classes"
                      Description="A colour class on that ToolTip is MudTooltip's Color: the colour and its contrast text, the arrow too."
                      Source="Tooltip/Colors" />

    <TextBlock Classes="h5 section" Text="Transitions" />
    <docs:ExampleCard Title="ToolTip.ShowDelay"
                      Description="MudTooltip's Delay is ToolTip.ShowDelay, in milliseconds. A tooltip fades in over MudTooltip's 251ms Duration, as every popup does."
                      Source="Tooltip/Delay" />
    <TextBlock Classes="body1 p">
      <Run Text="The fade is the one every popup here has; with FiliReducedMotion on, a tooltip appears at once." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="popover" Content="Popover" />
      <docs:DocLink Slug="reduced-motion" Content="Reduced motion" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudTooltip parameter and what it is here. " />
      <Run Classes="code" Text="Same" />
      <Run Text=" is transcribed from MudBlazor's source; " />
      <Run Classes="code" Text="Close" />
      <Run Text=" gets the same result another way." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="MudTooltip" Here="ToolTip.Tip" Status="Same" Note="A solid gray-darker chip in light, dark and high contrast, 12px at weight 500, 4px 8px; no width of its own, so it wraps only at the screen's edge, or the page's in a browser." />
      <docs:ParityRow MudBlazor="Placement Top, Bottom, Left, Right" Here="ToolTip.Placement" Status="Same" Note="Centred on that side, 10px from the target; Avalonia's 20px ToolTip.VerticalOffset is set to 0 for these four. Start and End are Left and Right." />
      <docs:ParityRow MudBlazor="Delay" Here="ToolTip.ShowDelay" Status="Same" Note="In milliseconds." />
      <docs:ParityRow MudBlazor="Duration (251ms)" Here="the same" Status="Same" Note="The tooltip fades in as every popup does." />
      <docs:ParityRow MudBlazor="Color (default Default)" Here="a ToolTip as the Tip, with primary … dark" Status="Same" Note="The colour and its contrast text; ToolTip.Tip uses a ToolTip as it is, so its classes survive." />
      <docs:ParityRow MudBlazor="Arrow" Here="arrow on that ToolTip" Status="Same" Note="A 6px triangle in the chip's colour facing the target, for Top, Bottom, Left and Right; none for Pointer, which MudBlazor lacks. Without arrow its place is still the gap." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
