<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.SliderPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Slider"
                    Summary="Sliders let people pick a value from a range: Avalonia's Slider, drawn as MudSlider. Unlike most components it is primary with no class."
                    MudBlazor="Slider"
                    MudBlazorPath="components/slider"
                    AvaloniaControls="Slider" />

    <TextBlock Classes="h5 section" Text="Basic sliders" />
    <docs:ExampleCard Title="Text, the default"
                      Description="MudSlider defaults to Size.Small, Color.Primary and Variant.Text: a 2px rail and a 12px thumb, the whole rail the colour at 30% with no solid part. Its ChildContent is a TextBlock above it."
                      Source="Slider/Basic" />

    <TextBlock Classes="h5 section" Text="Filled" />
    <docs:ExampleCard Title="Filled"
                      Description="filled is Variant.Filled: the colour, solid, from the start to the thumb."
                      Source="Slider/Filled" />

    <TextBlock Classes="h5 section" Text="Step and range" />
    <docs:ExampleCard Title="Steps, minimum and maximum"
                      Description="Avalonia names these itself: TickFrequency with IsSnapToTickEnabled is MudSlider's Step, Minimum and Maximum its Min and Max."
                      Source="Slider/Step" />

    <TextBlock Classes="h5 section" Text="Ticks" />
    <docs:ExampleCard Title="Tick marks"
                      Description="TickMarks is a TickPlacement other than None, at TickFrequency or at the values in Ticks, drawn as MudBlazor draws them: dots on the rail, its thickness and the colour."
                      Source="Slider/Ticks" />

    <TextBlock Classes="h5 section" Text="Value label" />
    <docs:ExampleCard Title="Value label"
                      Description="value-label is ValueLabel: the value in a 12px chip of the colour above the thumb while it is held, at most two decimals, in the app's number format. Press a thumb to see it."
                      Source="Slider/ValueLabel" />

    <TextBlock Classes="h5 section" Text="Colours" />
    <docs:ExampleCard Title="Every palette colour"
                      Description="A colour class repaints the thumb, the rail, the filled part, the ticks and the value label. With no class it is primary."
                      Source="Slider/Colors" />

    <TextBlock Classes="h5 section" Text="Sizes" />
    <docs:ExampleCard Title="Small, medium and large"
                      Description="Small is the default and needs no class; medium and large are a 4px rail with a 20px thumb and a 6px rail with a 24px thumb. The thumb does not grow on hover: a 1px ring of the colour at 24% shows instead, 2px on focus and press."
                      Source="Slider/Sizes" />

    <TextBlock Classes="h5 section" Text="Vertical" />
    <docs:ExampleCard Title="Vertical"
                      Description="Orientation=&quot;Vertical&quot;, with its own template: every variant, colour, size and tick mark works the same way up."
                      Source="Slider/Vertical" />

    <TextBlock Classes="h5 section" Text="Disabled" />
    <docs:ExampleCard Title="Disabled"
                      Description="IsEnabled=&quot;False&quot;: the rail and thumb at .38 in their colour, the thumb ringed 1px in white. The filled part and the ticks keep their strength."
                      Source="Slider/Disabled" />

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudSlider parameter and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way; " /><Run Classes="code" Text="Missing" /><Run Text=" is not here." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="Size.Small (default)" Here="no class" Status="Same" Note="A 2px rail and a 12px thumb." />
      <docs:ParityRow MudBlazor="Size.Medium / Large" Here="medium / large" Status="Same" Note="4px / 20px and 6px / 24px." />
      <docs:ParityRow MudBlazor="Variant.Text (default)" Here="no class" Status="Same" Note="The whole rail the colour at 30%, no solid part." />
      <docs:ParityRow MudBlazor="Variant.Filled" Here="filled" Status="Same" Note="The colour, solid, from the start to the thumb." />
      <docs:ParityRow MudBlazor="Color.Primary (default) … Color.Dark" Here="no class, or secondary … dark" Status="Same" Note="Thumb, rail, filled part, ticks and value label." />
      <docs:ParityRow MudBlazor="hover, focus and press" Here="the same" Status="Same" Note="A 1px / 2px ring of the colour at 24%; no growth." />
      <docs:ParityRow MudBlazor="Vertical" Here="Orientation=&quot;Vertical&quot;" Status="Same" />
      <docs:ParityRow MudBlazor="TickMarks" Here="TickPlacement other than None, at TickFrequency or Ticks" Status="Same" Note="Dots on the rail, its thickness and the colour." />
      <docs:ParityRow MudBlazor="TickMarkLabels" Here="—" Status="Missing" Note="An array of strings a Slider has no property for; passing it would take a public attached property, and this package's public API is one type. The tick dots are themed." />
      <docs:ParityRow MudBlazor="ValueLabel" Here="value-label" Status="Same" Note="A 12px chip of the colour above the thumb while it is held." />
      <docs:ParityRow MudBlazor="ValueLabelFormat, Culture" Here="—" Status="Close" Note="At most two decimals, in the app's culture rather than MudBlazor's invariant default." />
      <docs:ParityRow MudBlazor="ValueLabelContent" Here="—" Status="Missing" Note="The label shows the value." />
      <docs:ParityRow MudBlazor="Disabled" Here="IsEnabled=&quot;False&quot;" Status="Same" Note="The rail and thumb at .38 in their colour, the thumb ringed 1px in white; the filled part and ticks keep their strength, as elements outside the native input. MudBlazor's black, ×4 disabled thumb rule loses the cascade to its colour and size rules, so it never shows there either." />
      <docs:ParityRow MudBlazor="ChildContent" Here="a TextBlock above it" Status="Close" />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
