<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.TreeViewPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Tree view"
                    Summary="Avalonia's TreeView, drawn as MudTreeView: 32px rows indented 17px per level, with an arrow that turns as a branch opens. Hover, Dense, Color and multiselection are classes on the tree."
                    MudBlazor="TreeView"
                    MudBlazorPath="components/treeview" />

    <TextBlock Classes="h5 section" Text="Basic usage" />
    <docs:ExampleCard Title="Branches and leaves"
                      Description="A TreeViewItem with children is a branch: its ChevronRight turns 90 degrees as it opens. A leaf keeps the arrow's empty 40px slot, so its text lines up with a branch's. The selected row is primary text over its hover tint."
                      Source="TreeView/Basic" />
    <TextBlock Classes="body1 p">
      <Run Text="The indent is Avalonia's mechanism rather than MudBlazor's nested margins: a " />
      <Run Classes="code" Text="TreeViewItem" />
      <Run Text=" multiplies its own " />
      <Run Classes="code" Text="Level" />
      <Run Text=" by the 17px indent, declared once. A tree has no ground of its own; " />
      <Run Classes="code" Text="paper" />
      <Run Text=" gives it one, as on a list." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Usage" />
    <docs:ExampleCard Title="hover, dense and Disabled"
                      Description="hover is MudTreeView's Hover, off by default: only a hover tree tints the row under the pointer, and a selected row keeps its own tint. dense drops the 32px minimum and pads rows 1px 4px. IsEnabled=&quot;False&quot; is Disabled, in action-disabled."
                      Source="TreeView/Usage" />

    <TextBlock Classes="h5 section" Text="Icons" />
    <docs:ExampleCard Title="Icons in the header"
                      Description="MudTreeViewItem's Icon, EndIcon and EndText are content in the Header, laid out by the app."
                      Source="TreeView/Icons" />
    <docs:ExampleCard Title="Expand button icon"
                      Description="ExpandButtonIcon is the FiliChevronRightGeometry key: set in the tree's Resources, it swaps every arrow in that tree."
                      Source="TreeView/ExpandIcon" />

    <TextBlock Classes="h5 section" Text="Single selection" />
    <docs:ExampleCard Title="Selection colours"
                      Description="A colour class on the TreeView is MudTreeView's Color: the selected row's text in the colour over its hover tint. Primary with no class."
                      Source="TreeView/Colors" />

    <TextBlock Classes="h5 section" Text="Multi selection" />
    <docs:ExampleCard Title="multi-selection"
                      Description="A checkbox after the arrow on each row, 32px (24 dense), checked while the row is selected; no row is marked. Grey with no class, CheckBoxColor's default, or the tree's colour class."
                      Source="TreeView/MultiSelection" />
    <TextBlock Classes="body1 p">
      <Run Text="As on a list, the class is the look and " />
      <Run Classes="code" Text="SelectionMode=&quot;Multiple, Toggle&quot;" />
      <Run Text=" the behaviour, which the app sets. A branch's box is its own selection: it is never indeterminate from its children." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="list" Content="List" />
      <docs:DocLink Slug="nav-menu" Content="Nav menu" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudTreeView parameter that changes how it looks and what it is here. " />
      <Run Classes="code" Text="Same" />
      <Run Text=" is transcribed from MudBlazor's source; " />
      <Run Classes="code" Text="Close" />
      <Run Text=" gets the same result another way; " />
      <Run Classes="code" Text="Missing" />
      <Run Text=" is not available." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="MudTreeView" Here="TreeView" Status="Same" Note="32px rows, 17px per level; a leaf keeps the arrow's empty 40px slot, so its text lines up with a branch's." />
      <docs:ParityRow MudBlazor="Hover (default false)" Here="hover" Status="Same" Note="Action-default-hover on the row under the pointer, not on its branch; a selected row keeps its tint." />
      <docs:ParityRow MudBlazor="Disabled" Here="IsEnabled=&quot;False&quot;" Status="Same" Note="Action-disabled." />
      <docs:ParityRow MudBlazor="Color (the selection, default Primary)" Here="primary … dark on the TreeView" Status="Same" Note="The colour as the text over its hover tint." />
      <docs:ParityRow MudBlazor="Dense" Here="dense" Status="Same" Note="No 32px minimum, rows padded 1px 4px." />
      <docs:ParityRow MudBlazor="SelectionMode.MultiSelection" Here="multi-selection and SelectionMode=&quot;Multiple, Toggle&quot;" Status="Close" Note="A 32px checkbox after the arrow (24 dense), checked while the row is selected; a branch's box is its own selection, never indeterminate from its children." />
      <docs:ParityRow MudBlazor="CheckBoxColor (default Default)" Here="no class, or primary … dark on the tree while multi-selection is on" Status="Close" Note="As on a list: the tree's Color class doubles as it." />
      <docs:ParityRow MudBlazor="CheckedIcon, UncheckedIcon, IndeterminateIcon" Here="FiliCheckBoxCheckedGeometry, FiliCheckBoxUncheckedGeometry, FiliCheckBoxIndeterminateGeometry" Status="Same" Note="Resource keys set in the tree's Resources, as on a checkbox." />
      <docs:ParityRow MudBlazor="Icon, IconExpanded, EndIcon, EndText, TextTypo" Here="the Header's content" Status="Close" Note="The app lays out the header." />
      <docs:ParityRow MudBlazor="ExpandButtonIcon" Here="FiliChevronRightGeometry in the tree's Resources" Status="Same" Note="The key swaps every arrow in that tree." />
      <docs:ParityRow MudBlazor="ExpandButtonIconColor, LoadingIcon" Here="—" Status="Missing" Note="The arrow is action-default, and nothing loads lazily." />
      <docs:ParityRow MudBlazor="Width, Height, MaxHeight" Here="the same" Status="Close" Note="Ordinary Avalonia properties." />
      <docs:ParityRow MudBlazor="Ripple (default true)" Here="on" Status="Same" Note="On each row, and on its expand arrow." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
