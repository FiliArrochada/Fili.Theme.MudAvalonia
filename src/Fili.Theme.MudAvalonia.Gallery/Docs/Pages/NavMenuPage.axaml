<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.NavMenuPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Nav menu"
                    Summary="Links and groups for a drawer: nav on Avalonia's TreeView, drawn as MudNavMenu, MudNavLink and MudNavGroup. A row without children is a link, a row with children a group."
                    MudBlazor="NavMenu"
                    MudBlazorPath="components/navmenu" />

    <TextBlock Classes="h5 section" Text="Basic usage" />
    <docs:ExampleCard Title="Links, a group and the active link"
                      Description="Each link is 8px 16px, body1 on a 28px line in the drawer's text colour. The selected row is the active link: weight 500, primary over action-default-hover. A group opens on a click anywhere on its row, its ExpandMore arrow turning. IsEnabled=&quot;False&quot; is text-disabled."
                      Source="NavMenu/Basic" />
    <TextBlock Classes="body1 p">
      <Run Text="Which link is active is the app's to set through " /><Run Classes="code" Text="SelectedItem" /><Run Text=", where MudBlazor matches the URL with Href and Match. The menu scrolls up and down, never sideways: a label too long for the drawer wraps when its header gives the text a width, a string or a " /><Run Classes="code" Text="Grid" /><Run Text=" or " /><Run Classes="code" Text="DockPanel" /><Run Text="; in a horizontal " /><Run Classes="code" Text="StackPanel" /><Run Text=" it is cut off at the edge." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Sub groups" />
    <docs:ExampleCard Title="Nested groups"
                      Description="Rows step in to 36, 48, 60 and 72px by depth. A top-level group's title is 500, a nested one's 400 until it opens."
                      Source="NavMenu/SubGroups" />

    <TextBlock Classes="h5 section" Text="Icons" />
    <docs:ExampleCard Title="Link icons"
                      Description="A PathIcon with start-icon in the Header is MudNavLink's Icon: 24px in drawer-icon, 12px before the text, and in the menu's colour on the active link. Its Foreground is IconColor."
                      Source="NavMenu/Icons" />

    <TextBlock Classes="h5 section" Text="Bordered, rounded and dense" />
    <docs:ExampleCard Title="Menu options"
                      Description="bordered draws a 2px line at the active link's end in its colour; rounded gives every row the default radius; dense pads the rows 4px 16px."
                      Source="NavMenu/Options" />

    <TextBlock Classes="h5 section" Text="Colours" />
    <docs:ExampleCard Title="Colour classes"
                      Description="MudNavMenu's Color, primary through dark: the active link's text over the colour's hover tint, the colour at 12% under the pointer, and its icon, its line and an open group's arrow in the colour."
                      Source="NavMenu/Colors" />

    <TextBlock Classes="h5 section" Text="Hide the expand icon" />
    <docs:ExampleCard Title="hide-icon"
                      Description="hide-icon on a group's row is MudNavGroup's HideExpandIcon. ExpandIcon is FiliExpandMoreGeometry in the group's Resources."
                      Source="NavMenu/HideIcon" />

    <TextBlock Classes="h5 section" Text="Mini drawer" />
    <docs:ExampleCard Title="A rail of icons"
                      Description="In a closed CompactInline or CompactOverlay SplitView, or a closed compact DrawerPage, a link's text beside its icon is hidden and every row is 8px 16px whatever its depth, so the 56px rail shows the icons. A group's arrow runs off the edge, as in MudBlazor."
                      Source="NavMenu/Mini" />
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="drawer" Content="Drawer" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudNavMenu, MudNavLink and MudNavGroup parameter and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="MudNavLink" Here="a row without children" Status="Same" Note="8px 16px, body1 on a 28px line in the drawer's text colour, the text 12px in and wrapping; action-default-hover under the pointer and keyboard focus." />
      <docs:ParityRow MudBlazor="the active link (.active)" Here="the selected row" Status="Same" Note="Weight 500, primary over action-default-hover." />
      <docs:ParityRow MudBlazor="MudNavMenu.Color" Here="primary … dark" Status="Same" Note="The active link's text over the colour's hover tint, 12% under the pointer; its icon, line and an open group's arrow in the colour." />
      <docs:ParityRow MudBlazor="Bordered" Here="bordered" Status="Same" Note="A 2px line at the active link's end, in its colour." />
      <docs:ParityRow MudBlazor="Rounded" Here="rounded" Status="Same" Note="The default radius on every row." />
      <docs:ParityRow MudBlazor="Dense" Here="dense" Status="Same" Note="4px 16px." />
      <docs:ParityRow MudBlazor="Margin" Here="Margin on the rows, through a Style" Status="Close" />
      <docs:ParityRow MudBlazor="MudNavLink.Icon, IconColor" Here="a PathIcon with start-icon in the Header" Status="Same" Note="24px in drawer-icon, 12px before the text, the colour when active; IconColor is its Foreground." />
      <docs:ParityRow MudBlazor="MudNavLink.Disabled" Here="IsEnabled=&quot;False&quot;" Status="Same" Note="Text-disabled." />
      <docs:ParityRow MudBlazor="Href, Match, Target" Here="SelectedItem" Status="Close" Note="Which link is active is the app's to set." />
      <docs:ParityRow MudBlazor="MudNavGroup" Here="a row with children" Status="Same" Note="Opens on a click on its row; ExpandMore at its end turns 180 degrees and takes the colour once open; a top-level title at 500, a nested one at 400 until it opens." />
      <docs:ParityRow MudBlazor="nesting" Here="rows inside a group" Status="Same" Note="36px in, then 48, 60 and 72." />
      <docs:ParityRow MudBlazor="MudNavGroup.HideExpandIcon" Here="hide-icon on the group's row" Status="Same" />
      <docs:ParityRow MudBlazor="MudNavGroup.ExpandIcon" Here="FiliExpandMoreGeometry in the group's Resources" Status="Same" />
      <docs:ParityRow MudBlazor="MudNavGroup.MaxHeight" Here="none" Status="Missing" Note="A tree item's children have no scroller of their own, so a cap would clip them rather than scroll." />
      <docs:ParityRow MudBlazor="a mini drawer's nav" Here="a nav tree in a closed compact SplitView or DrawerPage" Status="Same" Note="The text beside each icon hidden on the 56px rail, every row 8px 16px whatever its depth; no sideways scrolling, a group's arrow running off the edge as in MudBlazor." />
      <docs:ParityRow MudBlazor="Ripple (default true) on MudNavLink and MudNavGroup" Here="on" Status="Same" Note="On a link's row and a group's header." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
