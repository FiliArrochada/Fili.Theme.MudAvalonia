<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.AppBarPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="App bar"
                    Summary="The bar across the top of an app: appbar on a Border, drawn as MudAppBar. 64px with 24px gutters at elevation 4; dense, a colour or an elevation class changes it."
                    MudBlazor="AppBar"
                    MudBlazorPath="components/appbar"
                    AvaloniaControls="Border, NavigationPage, ContentPage" />

    <TextBlock Classes="h5 section" Text="Basic app bar" />
    <docs:ExampleCard Title="Title and icon buttons"
                      Description="The appbar colours, 64px high, 24px a side. The text colour is inherited from the bar, so plain text takes it and a control that sets its own keeps it: icon buttons say inherit, as MudBlazor's examples give theirs Color.Inherit."
                      Source="AppBar/Simple" />
    <TextBlock Classes="body1 p">
      <Run Text="The row inside is the app's own panel: a " /><Run Classes="code" Text="DockPanel" /><Run Text=" stands in for MudSpacer. MudIconButton's " /><Run Classes="code" Text="Edge" /><Run Text=" is a negative " /><Run Classes="code" Text="Margin" /><Run Text=". Where the bar sits, top or bottom, fixed or not, is the app's layout." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Colours" />
    <docs:ExampleCard Title="Colour classes"
                      Description="MudAppBar's Color is .mud-theme-{color}: the colour as the ground and its contrast text inherited by the content, for primary through dark."
                      Source="AppBar/Colors" />

    <TextBlock Classes="h5 section" Text="Dense" />
    <docs:ExampleCard Title="Dense"
                      Description="dense is MudAppBar's Dense: 48px."
                      Source="AppBar/Dense" />

    <TextBlock Classes="h5 section" Text="Elevation and gutters" />
    <docs:ExampleCard Title="Elevation and gutters"
                      Description="Elevation 4 with no class; elevation0 through elevation25 replace it. Padding=&quot;0&quot; is Gutters=&quot;false&quot;."
                      Source="AppBar/Elevation" />

    <TextBlock Classes="h5 section" Text="App bar with menu" />
    <docs:ExampleCard Title="Commands and an overflow menu"
                      Description="A CommandBar on the bar: its commands are MudIconButtons in the bar's text colour, and MoreVert opens a MudMenu of the rest on the surface."
                      Source="AppBar/Menu" />
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="tool-bar" Content="Tool bar" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="Navigation page" />
    <docs:ExampleCard Title="NavigationPage's bar"
                      Description="Avalonia's NavigationPage draws its bar as MudAppBar: the appbar colours, 64px, 24px gutters and elevation 4. HasShadow, on by default here, is the elevation; HasShadow=&quot;False&quot; is 0."
                      Source="AppBar/NavigationPage" />
    <TextBlock Classes="body1 p">
      <Run Text="A " /><Run Classes="code" Text="ContentPage" /><Run Text=" is MudMainContent: text-primary on the app's background, and its top and bottom command bars are the CommandBar's MudToolBar. How pages slide, push and pop stays Avalonia's." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudAppBar parameter, and the page type that draws an app bar, and what each is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="background, text colour" Here="appbar" Status="Same" Note="The text colour is inherited, so a control's own colour wins." />
      <docs:ParityRow MudBlazor="height" Here="FiliAppbarHeight" Status="Same" Note="64px." />
      <docs:ParityRow MudBlazor="Elevation (default 4)" Here="no class, or the elevation classes" Status="Same" />
      <docs:ParityRow MudBlazor="Dense" Here="dense" Status="Same" Note="48px." />
      <docs:ParityRow MudBlazor="Color" Here="the colour classes" Status="Same" Note="The colour as ground, its contrast text inherited." />
      <docs:ParityRow MudBlazor="Gutters (default true)" Here="Padding=&quot;0&quot; for false" Status="Same" Note="24px a side, or none." />
      <docs:ParityRow MudBlazor="Bottom, Fixed" Here="the app's layout" Status="Close" Note="Placement is the app's layout." />
      <docs:ParityRow MudBlazor="WrapContent" Here="a WrapPanel inside" Status="Close" />
      <docs:ParityRow MudBlazor="Contextual" Here="none" Status="Missing" Note="Swapping the bar's content on selection is code." />
      <docs:ParityRow MudBlazor="MudMainContent" Here="ContentPage" Status="Same" Note="Text-primary on the background." />
      <docs:ParityRow MudBlazor="MudAppBar with a back MudIconButton and an h6 title" Here="NavigationPage" Status="Same" Note="HasShadow is Elevation 4 or 0." />
      <docs:ParityRow MudBlazor="Color.Inherit on an app bar's icon buttons" Here="a CommandBar inside an appbar" Status="Same" Note="Its commands and overflow button take the bar's text colour." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
