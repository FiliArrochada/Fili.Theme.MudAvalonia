<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.DataGridPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Data grid"
                    Summary="Avalonia's own DataGrid, drawn as MudDataGrid with nothing to opt into. The app references the Avalonia.Controls.DataGrid package; the theme does not pull it in, and themes the grid once it is there."
                    MudBlazor="DataGrid"
                    MudBlazorPath="components/datagrid"
                    AvaloniaControls="DataGrid" />

    <TextBlock Classes="h5 section" Text="Default data grid" />
    <docs:ExampleCard Title="A DataGrid with no class"
                      Description="Surface at elevation 1 and the default radius, subtitle2 headers in a 59px row with no rule between them, body2 cells 16px round, and a table-lines rule under every row but the last."
                      Source="DataGrid/Default" />
    <TextBlock Classes="body1 p">
      <Run Text="Reference " /><Run Classes="code" Text="Avalonia.Controls.DataGrid" /><Run Text=" 12.1.0 or later in the app and every " /><Run Classes="code" Text="DataGrid" /><Run Text=" is a MudDataGrid. An app without it never loads the grid's rules; on an older version the theme leaves the grid alone, rather than apply templates that name parts it lacks, and Avalonia's log says why. Avalonia has no default theme, so the grid then needs the package's own theme included to show at all." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Visual styling" />
    <docs:ExampleCard Title="dense, striped, hover and GridLinesVisibility"
                      Description="dense is Dense, 6px 24px 6px 16px with 16px on the right of the last visible column and a 39px header row. striped is Striped; hover is Hover and replaces the stripe under the pointer. GridLinesVisibility=&quot;All&quot; is Bordered."
                      Source="DataGrid/VisualStyling" />
    <TextBlock Classes="body1 p">
      <Run Text="Hover and the stripes are off by default, as " /><Run Classes="code" Text="MudDataGrid.Hover" /><Run Text=" and " /><Run Classes="code" Text="Striped" /><Run Text=" are. The last row has no rule under it: rows cannot tell they are last, so they reach 1px past the grid's clip instead." />
    </TextBlock>
    <docs:ExampleCard Title="outlined, elevation and CornerRadius 0"
                      Description="outlined is a 1px lines-default border and drops the elevation, as MudPaper does. elevation0 to elevation25 replace the default 1; CornerRadius=&quot;0&quot; is Square."
                      Source="DataGrid/Outlined" />

    <TextBlock Classes="h5 section" Text="Sorting" />
    <docs:ExampleCard Title="The sort arrow"
                      Description="MudDataGrid's ArrowUpward, 18px in a small icon button at the far end of the header, action-default, hidden until the column is sorted and turned for descending. Click a header to sort by it."
                      Source="DataGrid/Sorting" />
    <TextBlock Classes="body1 p">
      <Run Text="The arrow sits where " /><Run Classes="code" Text=".sortable-column-header" /><Run Text=" taking the width puts it, not next to the title, and shows at 0.8 while the header is hovered. A sort set in code is a " /><Run Classes="code" Text="DataGridCollectionView" /><Run Text=" with " /><Run Classes="code" Text="SortDescriptions" /><Run Text="; the example's comes from the gallery's sample data." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Row selection" />
    <docs:ExampleCard Title="A selected row"
                      Description="MudDataGrid draws no selected row: selection is a checkbox column's job. Here a selected row is primary-hover, what MudBlazor draws for a selected list row, so selection is visible. SelectionMode=&quot;Extended&quot; is MultiSelection."
                      Source="DataGrid/Selection" />
    <docs:ExampleCard Title="A checkbox column"
                      Description="A CheckBox in a cell is MudBlazor's table checkbox, the dense checkbox's circle pulled in 4px, so a row with one is 57px. A DataGridCheckBoxColumn's box is action-default in every row, as a read-only MudCheckBox is."
                      Source="DataGrid/CheckBoxColumn" />
    <TextBlock Classes="body1 p">
      <Run Text="The checkbox column disables every row but the current one; the theme keeps the boxes in action-default anyway, so the column does not read as disabled. A " /><Run Classes="code" Text="CheckBox" /><Run Text=" in a " /><Run Classes="code" Text="DataGridTemplateColumn" /><Run Text=" gets the same circle." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Editing" />
    <docs:ExampleCard Title="Edit mode"
                      Description="IsReadOnly=&quot;False&quot;, the default: double-click a cell or press F2. The field loses its resting line and keeps its focused one, as _datagrid.scss leaves it."
                      Source="DataGrid/Editing" />

    <TextBlock Classes="h5 section" Text="Grouping" />
    <docs:ExampleCard Title="Grouped by group, then by position"
                      Description="background-gray group rows, &quot;Title: Key&quot; in bold, ExpandMore or ChevronRight in a 48px icon button, and no count. A nested group's header steps in 48px per level; its data rows stay where they are."
                      Source="DataGrid/Grouping" />
    <TextBlock Classes="body1 p">
      <Run Text="Groupable is a " /><Run Classes="code" Text="DataGridCollectionView" /><Run Text=" with " /><Run Classes="code" Text="GroupDescriptions" /><Run Text=". The grid's own " /><Run Classes="code" Text="SublevelIndent" /><Run Text=" stays at 0, because it would move the rows as well; the headers step in up to a fifth level." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Loading" />
    <docs:ExampleCard Title="Loading"
                      Description="MudDataGrid's Loading is loading: an indeterminate 4px bar in its own row under the header. LoadingProgressColor is a colour class on the grid; with none the bar is info, MudBlazor's default."
                      Source="DataGrid/Loading" />

    <TextBlock Classes="h5 section" Text="Columns" />
    <TextBlock Classes="body1 p">
      <Run Text="Resizing, reordering and hiding are Avalonia's: " /><Run Classes="code" Text="CanUserResizeColumns" /><Run Text=", " /><Run Classes="code" Text="CanUserReorderColumns" /><Run Text=" and a column's " /><Run Classes="code" Text="IsVisible" /><Run Text=". Resizing works and shows its cursor, but MudBlazor's 2px primary line down the grid does not appear. The header never scrolls and the rows always virtualize. There is no column menu, filter row, pager or footer: each is a control of its own, not a look." />
    </TextBlock>
    <TextBlock Classes="body1 p">
      <Run Text="MudBlazor's other sections are Avalonia's own, so they have no example here. Column Types are " /><Run Classes="code" Text="DataGridTextColumn" /><Run Text=", " /><Run Classes="code" Text="DataGridCheckBoxColumn" /><Run Text=" and " /><Run Classes="code" Text="DataGridTemplateColumn" /><Run Text="; Column Sizing is a column's " /><Run Classes="code" Text="Width" /><Run Text=", star or pixels; Sticky Columns is " /><Run Classes="code" Text="FrozenColumnCount" /><Run Text="; Row Detail View is " /><Run Classes="code" Text="RowDetailsTemplate" /><Run Text=", with no expand button; a Context Menu is a " /><Run Classes="code" Text="ContextMenu" /><Run Text=" on the grid, or on its rows or cells by a style, drawn as a menu. Data Aggregation lives in a footer, which the DataGrid has none of." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="table" Content="Table" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudDataGrid parameter the theme touches, and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way; " /><Run Classes="code" Text="Missing" /><Run Text=" is not here." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="the component" Here="any DataGrid" Status="Same" Note="Surface, the default radius, text-primary." />
      <docs:ParityRow MudBlazor="Elevation (default 1)" Here="no class, or the elevation classes" Status="Same" />
      <docs:ParityRow MudBlazor="Outlined / Square" Here="outlined / CornerRadius=&quot;0&quot;" Status="Same" Note="outlined drops the elevation, as MudPaper does." />
      <docs:ParityRow MudBlazor="the header row" Here="the column headers" Status="Same" Note="Subtitle2, 16px round, 59px with the rule under it; no rule between headers." />
      <docs:ParityRow MudBlazor="a body row" Here="the rows" Status="Same" Note="Body2, 16px round, a table-lines rule under every row but the last." />
      <docs:ParityRow MudBlazor="Dense" Here="dense" Status="Same" Note="6px 24px 6px 16px, 16px on the right of the last visible column, a 39px header row." />
      <docs:ParityRow MudBlazor="Hover" Here="hover" Status="Same" Note="Table-hover, off by default." />
      <docs:ParityRow MudBlazor="Striped" Here="striped" Status="Same" Note="The 1st, 3rd, 5th row; hover replaces it." />
      <docs:ParityRow MudBlazor="Bordered" Here="GridLinesVisibility=&quot;All&quot;" Status="Same" Note="Table-lines between body cells, none after the last, none in the header." />
      <docs:ParityRow MudBlazor="SortIcon, sorting" Here="the column's sort" Status="Same" Note="ArrowUpward in a small icon button at the end of the header, action-default, hidden until sorted, 0.8 on hover, turned for descending." />
      <docs:ParityRow MudBlazor="a selected row" Here="SelectedItem" Status="Close" Note="MudDataGrid draws none; here a selected list row's primary-hover, so selection is visible." />
      <docs:ParityRow MudBlazor="Groupable, a group row" Here="a DataGridCollectionView with GroupDescriptions" Status="Same" Note="Background-gray, &quot;Title: Key&quot; in bold, ExpandMore / ChevronRight, a nested header 48px further in per level and its rows not at all." />
      <docs:ParityRow MudBlazor="edit mode" Here="IsReadOnly=&quot;False&quot;" Status="Same" Note="The field loses its resting line and keeps its focused one, as _datagrid.scss leaves it." />
      <docs:ParityRow MudBlazor="ShowColumnOptions, Filterable, MudDataGridPager" Here="—" Status="Missing" Note="No column menu, filter row or pager: each is a control with behaviour of its own, which belongs in a separate package rather than a theme." />
      <docs:ParityRow MudBlazor="ColumnResizeMode" Here="CanUserResizeColumns" Status="Close" Note="Resizing works and shows its cursor; MudBlazor's 2px primary line down the grid does not appear, because the DataGrid keeps its resize state internal and drawing it would mean re-implementing its pointer handling." />
      <docs:ParityRow MudBlazor="FixedHeader, Virtualize" Here="built in" Status="Close" Note="Avalonia's header never scrolls and its rows always virtualize." />
      <docs:ParityRow MudBlazor="Height, HorizontalScrollbar" Here="Height, HorizontalScrollBarVisibility" Status="Close" Note="Ordinary Avalonia properties." />
      <docs:ParityRow MudBlazor="DragDropColumnReordering, Hideable" Here="CanUserReorderColumns, a column's IsVisible" Status="Close" Note="Ordinary Avalonia properties." />
      <docs:ParityRow MudBlazor="MultiSelection" Here="SelectionMode=&quot;Extended&quot;" Status="Close" />
      <docs:ParityRow MudBlazor="SelectColumn" Here="a template column of CheckBoxes" Status="Close" Note="The boxes follow the grid's selection through a few lines of the app's, on the Custom components page; the header's is indeterminate for some." />
      <docs:ParityRow MudBlazor="a checkbox in a cell (SelectColumn, a template column's MudCheckBox)" Here="a CheckBox in a cell template or a header" Status="Same" Note="As .mud-table-cell .mud-checkbox, a header's too: the 32 / 28 / 44px circle of a dense checkbox, pulled in 4px, so a row with one is 57px rather than 81; a DataGridCheckBoxColumn's box in action-default in every row, as a read-only MudCheckBox is, though the column disables all but the current row's." />
      <docs:ParityRow MudBlazor="FixedFooter, footers" Here="—" Status="Missing" Note="Avalonia's DataGrid has no footer row." />
      <docs:ParityRow MudBlazor="Loading, LoadingProgressColor" Here="loading, a colour class" Status="Same" Note="Info with no colour class, as LoadingProgressColor defaults to Color.Info." />
      <docs:ParityRow MudBlazor="Breakpoint (the stacked mobile layout)" Here="—" Status="Missing" Note="Re-laying rows as cards is a layout the DataGrid does not have, not a look." />
      <docs:ParityRow MudBlazor="SortMode (default Multiple), AllowUnsorted" Here="CanUserSortColumns, and the header's own clicks" Status="Close" Note="SortMode.None is CanUserSortColumns=&quot;False&quot;. Single and AllowUnsorted have no switch: which clicks and keys sort is the grid's, and SortDescriptions in code sets any sort." />
      <docs:ParityRow MudBlazor="ReadOnly (default true), a column's Editable" Here="IsReadOnly, a column's IsReadOnly" Status="Close" Note="Avalonia's grid is editable by default, MudDataGrid read-only." />
      <docs:ParityRow MudBlazor="EditMode.Cell, EditTrigger" Here="editing in the cell, on a double-click or F2" Status="Close" Note="The grid's own gestures; EditTrigger's edit button is a template column's button of the app's." />
      <docs:ParityRow MudBlazor="EditMode.Form, EditMode.Inline" Here="—" Status="Missing" Note="No edit dialog and no whole-row editing: a cell is edited on its own." />
      <docs:ParityRow MudBlazor="SelectOnRowClick (default true)" Here="the default" Status="Close" Note="A click always selects its row; false has no switch." />
      <docs:ParityRow MudBlazor="RowClass, RowClassFunc, RowStyle, RowStyleFunc, CellClass, CellClassFunc, CellStyle, CellStyleFunc" Here="a style on DataGridRow or DataGridCell, or the LoadingRow event" Status="Close" Note="A look from the row's data is a style with a binding, or set as each row loads." />
      <docs:ParityRow MudBlazor="HierarchyColumn, ExpandSingleRow" Here="RowDetailsTemplate with RowDetailsVisibilityMode" Status="Close" Note="No expand button: VisibleWhenSelected shows the selected row's details only, as ExpandSingleRow does, and Visible every row's; ClosedIcon, OpenIcon, IconSize and InitiallyExpandedFunc have no counterpart." />
      <docs:ParityRow MudBlazor="a column's StickyLeft, StickyRight" Here="FrozenColumnCount" Status="Close" Note="Columns freeze from the start only; StickyRight has no counterpart." />
      <docs:ParityRow MudBlazor="ColumnsPanelReordering, DragIndicatorIcon" Here="—" Status="Missing" Note="No columns panel; CanUserReorderColumns drags the headers themselves." />
      <docs:ParityRow MudBlazor="QuickFilter" Here="a DataGridCollectionView's Filter" Status="Close" Note="No search field of its own; the app binds one to the filter." />
      <docs:ParityRow MudBlazor="a column's HideSmall" Here="—" Status="Missing" Note="No breakpoints; bind a column's IsVisible to the width instead." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
