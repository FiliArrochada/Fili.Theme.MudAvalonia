<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.SelectPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Select"
                    Summary="A select picks one value from a list: Avalonia's ComboBox, drawn as MudSelect. As in MudBlazor, a select is a text field with a drop-down arrow, and it takes the text field's classes."
                    MudBlazor="Select"
                    MudBlazorPath="components/select"
                    AvaloniaControls="ComboBox" />

    <TextBlock Classes="h5 section" Text="Variants" />
    <docs:ExampleCard Title="Standard, filled and outlined"
                      Description="A ComboBox with no class is the standard field: the same underline, accent rule and floating label as a TextBox. filled and outlined are the text field's own variants. The label floats once a value is selected."
                      Source="Select/Variants" />
    <TextBlock Classes="body1 p">
      <Run Text="The arrow is MudSelect's " /><Run Classes="code" Text="OpenIcon" /><Run Text=": ArrowDropDown, turned to ArrowDropUp while the list is open. The options are list rows: body1 on 48px, and a selected one is a primary tint, never a filled bar." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Label and placeholder" />
    <docs:ExampleCard Title="Label, placeholder, or neither"
                      Description="PlaceholderText is the floating label, as on a text field. placeholder makes it the hint in the empty select instead, and a select with no PlaceholderText has no label and no room for one."
                      Source="Select/Label" />

    <TextBlock Classes="h5 section" Text="Field options" />
    <docs:ExampleCard Title="Helper text, required, error and the label"
                      Description="AutomationProperties.HelpText, required, error, shrink-label and no-underline are the text field's, and a failing binding on a select shows its message in the helper line too."
                      Source="Select/FieldOptions" />

    <TextBlock Classes="h5 section" Text="Dense" />
    <docs:ExampleCard Title="A dense field and dense items"
                      Description="dense on the select is its field's Margin.Dense. MudSelect's Dense, which shortens the options, is dense-items: 4px top and bottom and body2, 36px rows. dense on one ComboBoxItem shortens that row alone."
                      Source="Select/Dense" />

    <TextBlock Classes="h5 section" Text="Arrow colour" />
    <docs:ExampleCard Title="AdornmentColor"
                      Description="The arrow is action-default. adornment-primary to adornment-dark is MudSelect's AdornmentColor, and adornment-inherit gives the arrow the colour round the select."
                      Source="Select/AdornmentColor" />
    <TextBlock Classes="body1 p">
      <Run Text="MudSelect's " /><Run Classes="code" Text="OpenIcon" /><Run Text=" and " /><Run Classes="code" Text="CloseIcon" /><Run Text=" set to other glyphs are " /><Run Classes="code" Text="FiliArrowDropDownGeometry" /><Run Text=" and " /><Run Classes="code" Text="FiliArrowDropUpGeometry" /><Run Text=" in the select's " /><Run Classes="code" Text="Resources" /><Run Text=":" />
    </TextBlock>
    <docs:CodeBlock Code="&lt;ComboBox PlaceholderText=&quot;Sort&quot;&gt;&#10;  &lt;ComboBox.Resources&gt;&#10;    &lt;StreamGeometry x:Key=&quot;FiliArrowDropDownGeometry&quot;&gt;…&lt;/StreamGeometry&gt;&#10;    &lt;StreamGeometry x:Key=&quot;FiliArrowDropUpGeometry&quot;&gt;…&lt;/StreamGeometry&gt;&#10;  &lt;/ComboBox.Resources&gt;&#10;&lt;/ComboBox&gt;"
                    Margin="0,0,0,16" />

    <TextBlock Classes="h5 section" Text="Disabled" />
    <docs:ExampleCard Title="Disabled"
                      Description="IsEnabled=&quot;False&quot;: a disabled text field, with the arrow in text-disabled whatever its class."
                      Source="Select/Disabled" />

    <TextBlock Classes="h5 section" Text="List height" />
    <docs:ExampleCard Title="MaxDropDownHeight"
                      Description="MudSelect's MaxHeight defaults to 300, and so does MaxDropDownHeight here, where Avalonia's default is 200. A longer list scrolls."
                      Source="Select/MaxHeight" />

    <TextBlock Classes="h5 section" Text="Templates and keys" />
    <TextBlock Classes="body1 p">
      <Run Text="MudBlazor's value presentation, custom converter and complex object examples have no look of their own: here " /><Run Classes="code" Text="ItemTemplate" /><Run Text=" or " /><Run Classes="code" Text="DisplayMemberBinding" /><Run Text=" draws each item and " /><Run Classes="code" Text="SelectionBoxItemTemplate" /><Run Text=" the chosen one, and the keyboard is ComboBox's own." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudSelect parameter and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way. The field it shares with a text field is described on that page." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="text-field" Content="Text field" />
    </StackPanel>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="MudSelect" Here="ComboBox" Status="Same" Note="A standard text field with a drop-down adornment, as _select.scss makes it." />
      <docs:ParityRow MudBlazor="Label" Here="PlaceholderText" Status="Close" Note="The floating label." />
      <docs:ParityRow MudBlazor="Error" Here="error" Status="Same" />
      <docs:ParityRow MudBlazor="Variant" Here="filled / outlined" Status="Same" Note="The text field's own variants." />
      <docs:ParityRow MudBlazor="HelperText, Margin.Dense" Here="AutomationProperties.HelpText, dense" Status="Same" Note="As on a text field; a failing binding shows its message too." />
      <docs:ParityRow MudBlazor="MaxHeight (default 300)" Here="MaxDropDownHeight" Status="Same" Note="300, where Avalonia's default is 200." />
      <docs:ParityRow MudBlazor="Disabled" Here="IsEnabled=&quot;False&quot;" Status="Close" Note="As a disabled text field, its arrow in text-disabled." />
      <docs:ParityRow MudBlazor="OpenIcon / CloseIcon (defaults)" Here="the same" Status="Same" Note="ArrowDropDown, turned to ArrowDropUp while the list is open." />
      <docs:ParityRow MudBlazor="AdornmentColor" Here="adornment-primary … adornment-dark, adornment-inherit" Status="Same" Note="The arrow in the colour, or the colour round the select; text-disabled when disabled." />
      <docs:ParityRow MudBlazor="OpenIcon / CloseIcon set to other glyphs" Here="FiliArrowDropDownGeometry / FiliArrowDropUpGeometry in the select's Resources" Status="Same" />
      <docs:ParityRow MudBlazor="Underline, Required, ShrinkLabel" Here="no-underline, required, shrink-label" Status="Same" Note="As on a text field." />
      <docs:ParityRow MudBlazor="Clearable, ClearIcon" Here="—" Status="Missing" Note="A ComboBox has no InnerRightContent to put a clear button in." />
      <docs:ParityRow MudBlazor="ReadOnly" Here="IsHitTestVisible=&quot;False&quot;" Status="Close" Note="A ComboBox has no IsReadOnly." />
      <docs:ParityRow MudBlazor="Open" Here="IsDropDownOpen" Status="Same" />
      <docs:ParityRow MudBlazor="MudSelectItem" Here="ComboBoxItem, or an item of ItemsSource" Status="Same" />
      <docs:ParityRow MudBlazor="MudSelectItem.Disabled" Here="IsEnabled=&quot;False&quot; on the ComboBoxItem" Status="Same" />
      <docs:ParityRow MudBlazor="ToStringFunc, a custom Converter" Here="DisplayMemberBinding or ItemTemplate, and SelectionBoxItemTemplate" Status="Close" Note="How an item reads is a binding or template, as with a complex object." />
      <docs:ParityRow MudBlazor="Strict" Here="the same" Status="Close" Note="A ComboBox only ever shows one of its items; a value outside them shows nothing." />
      <docs:ParityRow MudBlazor="RelativeWidth (default Relative), FitContent" Here="the list at least the field's width" Status="Close" Note="As DropdownWidth.Adaptive; the field's own width is Width or HorizontalAlignment." />
      <docs:ParityRow MudBlazor="AnchorOrigin, TransformOrigin" Here="—" Status="Missing" Note="The list opens below the field, or above where there is no room, as ComboBox places it." />
      <docs:ParityRow MudBlazor="SelectionOnEnter, QuickSearchInterval" Here="ComboBox's own keys; IsTextSearchEnabled" Status="Close" Note="Behaviour: arrow keys and type-to-search work as Avalonia's ComboBox does." />
      <docs:ParityRow MudBlazor="Modal, LockScroll, PopoverFixed" Here="—" Status="Missing" Note="Behaviour: the list is Avalonia's light-dismiss popup." />
      <docs:ParityRow MudBlazor="Dense on the items" Here="dense-items on the select, or dense on one ComboBoxItem" Status="Same" Note="4px top and bottom, body2: 36px rows; dense on the select is its field's Margin.Dense." />
      <docs:ParityRow MudBlazor="an option's height" Here="the same" Status="Same" Note="48px: MudListItem's 8px and the item text's 4px round a body1 line." />
      <docs:ParityRow MudBlazor="MultiSelection, SelectAll, SelectAllText, Delimiter, MultiSelectionTextFunc, and the CheckedIcon, UncheckedIcon and IndeterminateIcon they draw" Here="—" Status="Missing" Note="A ComboBox holds one value; a multi-selection ListBox in a Flyout is the nearest." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
