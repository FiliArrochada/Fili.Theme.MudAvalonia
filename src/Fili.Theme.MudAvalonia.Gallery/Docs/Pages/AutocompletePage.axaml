<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.AutocompletePage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Autocomplete"
                    Summary="An autocomplete suggests values as people type: Avalonia's AutoCompleteBox, drawn as MudAutocomplete. Its field is a text field, and its suggestions sit on a surface at elevation 8."
                    MudBlazor="Autocomplete"
                    MudBlazorPath="components/autocomplete"
                    AvaloniaControls="AutoCompleteBox" />

    <TextBlock Classes="h5 section" Text="Usage" />
    <docs:ExampleCard Title="Standard, filled and outlined"
                      Description="Type to see the suggestions. The field is the TextBox inside, and the suggestions are list rows in a popup on a surface, with the default 4px radius and elevation 8, as MudPopover draws them."
                      Source="Autocomplete/Usage" />
    <TextBlock Classes="body1 p">
      <Run Text="The text field's classes go on the " /><Run Classes="code" Text="AutoCompleteBox" /><Run Text=" itself: " /><Run Classes="code" Text="filled" /><Run Text=", " /><Run Classes="code" Text="outlined" /><Run Text=", " /><Run Classes="code" Text="dense" /><Run Text=", " /><Run Classes="code" Text="error" /><Run Text=", " /><Run Classes="code" Text="counter" /><Run Text=" and " /><Run Classes="code" Text="helper-on-focus" /><Run Text=" reach the TextBox inside, as does its helper text." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="text-field" Content="Text field" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="Presentation" />
    <docs:ExampleCard Title="Dense, required, helper text and counter"
                      Description="dense is Margin.Dense, required the label's asterisk, AutomationProperties.HelpText the helper text, and counter with helper-on-focus as on a text field."
                      Source="Autocomplete/Presentation" />

    <TextBlock Classes="h5 section" Text="Validation" />
    <docs:ExampleCard Title="Error"
                      Description="error is MudAutocomplete's Error: the field's rule and label in the error colour. A failing binding paints the same and shows its message in the helper line."
                      Source="Autocomplete/Validation" />

    <TextBlock Classes="h5 section" Text="Adornments" />
    <docs:ExampleCard Title="Drop-down arrow and icons"
                      Description="MudAutocomplete's Adornment.End: ArrowDropDown in an edge-end icon button, ArrowDropUp while open, out of the Tab order and right against the text; clicking it opens or closes the list, the whole list over an empty field. An app's own InnerRightContent replaces the button, and InnerRightContent=&quot;{x:Null}&quot; is Adornment.None. Start and end icons are a text field's adornments."
                      Source="Autocomplete/Adornments" />
    <TextBlock Classes="body1 p">
      <Run Text="MudAutocomplete's " /><Run Classes="code" Text="AdornmentIcon" /><Run Text=" with the toggle kept is the arrow's key in the field's " /><Run Classes="code" Text="Resources" /><Run Text=": " /><Run Classes="code" Text="FiliArrowDropDownGeometry" /><Run Text=", and " /><Run Classes="code" Text="FiliArrowDropUpGeometry" /><Run Text=" for while it is open. Content of the app's own replaces the button, click and all. The theme sets " /><Run Classes="code" Text="MinimumPrefixLength" /><Run Text=" to 0, MudAutocomplete's " /><Run Classes="code" Text="MinCharacters" /><Run Text=", so typing nothing lists everything; an app's own value wins, and at 1 the arrow does nothing over an empty field. MudAutocomplete's " /><Run Classes="code" Text="Clearable" /><Run Text=" is " /><Run Classes="code" Text="clearable" /><Run Text=", as on a text field, left of the arrow." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Progress" />
    <docs:ExampleCard Title="Progress indicator"
                      Description="ShowProgressIndicator is a small circular ProgressBar in InnerRightContent while the app searches, in place of the arrow, as MudAutocomplete hides its arrow while loading. Its colour class is ProgressIndicatorColor. Afterwards ClearValue(InnerRightContentProperty) brings the arrow back; setting null leaves none."
                      Source="Autocomplete/Progress" />

    <TextBlock Classes="h5 section" Text="Disabled" />
    <docs:ExampleCard Title="Disabled"
                      Description="IsEnabled=&quot;False&quot;: a disabled text field, its text, label and line in text-disabled."
                      Source="Autocomplete/Disabled" />

    <TextBlock Classes="h5 section" Text="List height" />
    <TextBlock Classes="body1 p">
      <Run Text="MudAutocomplete's " /><Run Classes="code" Text="MaxHeight" /><Run Text=" defaults to 300, and so does " /><Run Classes="code" Text="MaxDropDownHeight" /><Run Text=" here, where Avalonia's default is 200." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Behaviour" />
    <TextBlock Classes="body1 p">
      <Run Text="Search, keys and templates are AutoCompleteBox's own, so MudBlazor's Strict Mode, Keyboard Navigation, Cancellation Token and Presentation Extras sections have no example here. " /><Run Classes="code" Text="AsyncPopulator" /><Run Text=" is SearchFunc, given a CancellationToken as MudBlazor's is; " /><Run Classes="code" Text="ItemTemplate" /><Run Text=" draws every suggestion; Up and Down move through the list, Enter chooses and Escape closes it." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudAutocomplete parameter and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="MudAutocomplete" Here="AutoCompleteBox" Status="Same" Note="The popup on a surface at elevation 8." />
      <docs:ParityRow MudBlazor="Variant, Margin.Dense, Error, Counter, HelperText, HelperTextOnFocus" Here="the text field's classes and AutomationProperties.HelpText, on the outer control" Status="Same" Note="Passed to the TextBox inside." />
      <docs:ParityRow MudBlazor="Underline, Required, ShrinkLabel" Here="no-underline, required, shrink-label" Status="Same" Note="As on a text field." />
      <docs:ParityRow MudBlazor="MaxHeight (default 300)" Here="MaxDropDownHeight" Status="Same" Note="300, where Avalonia's default is 200." />
      <docs:ParityRow MudBlazor="Clearable" Here="clearable" Status="Same" Note="As on a text field: the class reaches the field inside." />
      <docs:ParityRow MudBlazor="Adornment.End, OpenIcon, CloseIcon, the adornment's click" Here="the default InnerRightContent" Status="Same" Note="ArrowDropDown, ArrowDropUp while open, in an action-default edge-end icon button that toggles the list and focuses the field; text-disabled on a disabled field, as the select's arrow." />
      <docs:ParityRow MudBlazor="MinCharacters (default 0)" Here="MinimumPrefixLength" Status="Same" Note="0, where Avalonia's default is 1." />
      <docs:ParityRow MudBlazor=".mud-select-input .mud-input-adornment-end" Here="the field inside" Status="Same" Note="No 8px between the text and the end adornment." />
      <docs:ParityRow MudBlazor="AdornmentIcon" Here="FiliArrowDropDownGeometry in the field's Resources, or InnerRightContent" Status="Close" Note="The key changes the glyph and keeps the toggle; content of the app's own replaces the button and its click." />
      <docs:ParityRow MudBlazor="Adornment.None, OnAdornmentClick" Here="InnerRightContent=&quot;{x:Null}&quot;, or a button of the app's own" Status="Close" Note="An own button is the click; the arrow's is not exposed." />
      <docs:ParityRow MudBlazor="ShowProgressIndicator, ProgressIndicatorColor" Here="a ProgressBar.circular.small in InnerRightContent" Status="Close" Note="In place of the arrow, as MudBlazor's hides it while loading; ClearValue, not null, brings the arrow back." />
      <docs:ParityRow MudBlazor="ClearIcon" Here="FiliCloseGeometry in the field's Resources" Status="Same" Note="As on a text field." />
      <docs:ParityRow MudBlazor="Dense" Here="—" Status="Missing" Note="The list's dense rows. dense on the AutoCompleteBox is Margin.Dense, and no class reaches the ListBox in its popup." />
      <docs:ParityRow MudBlazor="AnchorOrigin, TransformOrigin, RelativeWidth" Here="below the field, at least its width" Status="Close" Note="Fixed, as the popup is a template part; at least the field's width is DropdownWidth.Adaptive, not the default Relative." />
      <docs:ParityRow MudBlazor="SearchFunc" Here="AsyncPopulator, or ItemsSource with FilterMode" Status="Close" Note="AsyncPopulator is given a CancellationToken too." />
      <docs:ParityRow MudBlazor="DebounceInterval (default 100)" Here="MinimumPopulateDelay" Status="Close" Note="Avalonia's default is none; 0:0:0.1 is MudBlazor's." />
      <docs:ParityRow MudBlazor="MaxItems (default 10), MoreItemsTemplate" Here="—" Status="Missing" Note="Every match is listed; an AsyncPopulator can return fewer, but nothing says more exist." />
      <docs:ParityRow MudBlazor="NoItemsTemplate" Here="—" Status="Missing" Note="With no match the list closes; AutoCompleteBox has no slot for an empty one." />
      <docs:ParityRow MudBlazor="ItemTemplate" Here="ItemTemplate" Status="Close" Note="A DataTemplate for every suggestion." />
      <docs:ParityRow MudBlazor="ItemSelectedTemplate, ItemDisabledTemplate, ItemDisabledFunc, BeforeItemsTemplate, AfterItemsTemplate" Here="—" Status="Missing" Note="One template for every row and nothing above or below the list; a suggestion cannot be disabled." />
      <docs:ParityRow MudBlazor="ToStringFunc" Here="ValueMemberBinding, or the item's ToString" Status="Close" />
      <docs:ParityRow MudBlazor="Strict (default true)" Here="the default" Status="Close" Note="The arrow over a chosen value lists what its text matches, as Strict does; false, listing everything, has no counterpart." />
      <docs:ParityRow MudBlazor="CoerceText, CoerceValue, ResetValueOnEmptyText" Here="Text and SelectedItem, bound separately" Status="Close" Note="Choosing an item writes its text; SelectedItem is the exact match or null, so an empty field resets it, and CoerceValue is binding Text." />
      <docs:ParityRow MudBlazor="SelectOnActivation (default true)" Here="—" Status="Missing" Note="Focus does not select the text; an app does it on GotFocus." />
      <docs:ParityRow MudBlazor="SelectValueOnTab" Here="the default" Status="Close" Note="Arrowing through the list chooses each row as it goes, so Tab leaves the last one chosen." />
      <docs:ParityRow MudBlazor="OpenOnFocus (default true)" Here="—" Status="Missing" Note="The list opens on typing or the arrow, not on focus." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
