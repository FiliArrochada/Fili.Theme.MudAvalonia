<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.TypographyPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Typography"
                    Summary="MudText is a TextBlock with a type class: the thirteen styles of MudBlazor's Typography.cs, in embedded Roboto, and MudText's colours as colour classes."
                    MudBlazor="Typography"
                    MudBlazorPath="components/typography"
                    AvaloniaControls="TextBlock" />

    <TextBlock Classes="h5 section" Text="Type styles" />
    <docs:ExampleCard Title="Typo"
                      Description="Each Typo is a class of the same name on a TextBlock, labelled with its size and weight: the size, weight, line height and letter spacing of Typography.cs, the line height and tracking converted to pixels."
                      Source="Typography/Styles" />
    <TextBlock Classes="body1 p">
      <Run Text="Body2, 14px, is the default text of every window and popup, so a TextBlock with no class is body2 already. That smaller base, not 16px, is a large part of why the look reads dense and tidy, and the first thing to check if a ported screen feels wrong. Unclassed text keeps the font's own line height; the metrics are on the classes." />
    </TextBlock>
    <TextBlock Classes="body1 p">
      <Run Text="The baseline is MudBlazor's Typography.Default. " /><Run Classes="code" Text="FiliFontSize" /><Run Text=" is that default size: set in the application's resources, it scales every unclassed text, in windows and popups alike. The type classes and the controls keep their own styles' sizes. " /><Run Classes="code" Text="FiliLineHeight" /><Run Text=" and " /><Run Classes="code" Text="FiliLetterSpacing" /><Run Text=" are the baseline's line and tracking for an app's own styles to read; the theme puts neither on unclassed text, so an app's own large text is never clipped." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Colours" />
    <docs:ExampleCard Title="Color"
                      Description="A colour class is MudText's Color: the palette colour as text, moved to 4.5:1 where it falls short, on any type class. inherit is Color.Inherit, the colour round the text, over a colour class too. MudBlazor's grey supporting text is its mud-text-secondary utility class, not a Color; here it is a Foreground of FiliTextSecondaryBrush."
                      Source="Typography/Colors" />
    <TextBlock Classes="body1 p">
      <Run Text="No type class sets a colour of its own, as " /><Run Classes="code" Text=".mud-typography-*" /><Run Text=" sets none: a caption or an overline is the colour round it, as MudText's default Color.Inherit is." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Button text" />
    <docs:ExampleCard Title="button"
                      Description="Typo.button is text that reads as a button's label without being one: 14px, 500, a 24.5px line (1.75, as a button's label) and 0.4px tracking, in FiliButtonTextTransform's case. The key set to none, lowercase or capitalize in a region's resources changes it there, as CSS's text-transform would."
                      Source="Typography/ButtonText" />
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="button" Content="Button" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="Alignment and spacing" />
    <TextBlock Classes="body1 p">
      <Run Text="MudText's " /><Run Classes="code" Text="Align" /><Run Text=" is the TextBlock's " /><Run Classes="code" Text="TextAlignment" /><Run Text=", and " /><Run Classes="code" Text="GutterBottom" /><Run Text=" a bottom " /><Run Classes="code" Text="Margin" /><Run Text=". Inline text is a " /><Run Classes="code" Text="Run" /><Run Text=" inside one TextBlock, which can carry its own type and colour classes." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudText parameter and Typography.cs setting, and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="Typo.h1 … Typo.h6" Here="h1 … h6" Status="Same" Note="Size, weight, line height and letter spacing from Typography.cs." />
      <docs:ParityRow MudBlazor="Typo.subtitle1 / subtitle2" Here="subtitle1 / subtitle2" Status="Same" />
      <docs:ParityRow MudBlazor="Typo.body1 (default) / body2" Here="body1 / body2" Status="Same" Note="MudText with no Typo is body1, so put the class on; Body2, 14px, is the default text of every window and popup." />
      <docs:ParityRow MudBlazor="Typography.Default" Here="FiliFontSize, FiliLineHeight, FiliLetterSpacing" Status="Close" Note="FiliFontSize is every window's and popup's size; the line height and tracking are for an app's own styles, as unclassed text keeps the font's line." />
      <docs:ParityRow MudBlazor="Typo.inherit" Here="no class" Status="Same" Note="The font, size and spacing of the text round it." />
      <docs:ParityRow MudBlazor="Typo.caption / overline" Here="caption / overline" Status="Same" Note="No colour of their own, as .mud-typography-* sets none: the colour round them." />
      <docs:ParityRow MudBlazor="Typo.button" Here="button" Status="Same" Note="14px, 500, a 24.5px line (1.75 of 14, kept to the half pixel), 0.4px tracking, in FiliButtonTextTransform's case." />
      <docs:ParityRow MudBlazor="Color.Primary … Color.Dark" Here="primary … dark" Status="Close" Note="The palette colour as text, on any type class: Fili…TextColor, the colour where it reaches WCAG AA's 4.5:1 on the page and a surface and, since 1.1.0, that hue darkened (light) or lightened (dark) to 4.5:1 where it does not." />
      <docs:ParityRow MudBlazor="Color.Inherit (default), Color.Default, Color.Surface" Here="no class" Status="Same" Note="MudText adds no colour for these (mud-surface-text has no rule), so the text takes the colour round it." />
      <docs:ParityRow MudBlazor="Color.Inherit over a colour class" Here="inherit" Status="Same" Note="The surrounding text colour, over a colour class too." />
      <docs:ParityRow MudBlazor="mud-text-secondary (grey)" Here="Foreground set to FiliTextSecondaryBrush" Status="Close" Note="A utility class in MudBlazor, not a Color." />
      <docs:ParityRow MudBlazor="Truncate" Here="TextTrimming=&quot;CharacterEllipsis&quot;" Status="Close" Note="An Avalonia property: the text keeps to one line and ends in an ellipsis where it overflows, as mud-typography-nowrap does." />
      <docs:ParityRow MudBlazor="Align, GutterBottom, Inline, HtmlTag" Here="TextAlignment, Margin, a Run" Status="Close" Note="Ordinary Avalonia properties; HtmlTag has no counterpart outside HTML." />
      <docs:ParityRow MudBlazor="Typography.cs" Here="Fili{Style}FontSize, …LineHeight, …LetterSpacing per style" Status="Same" Note="Line height and letter spacing converted to absolute pixels." />
      <docs:ParityRow MudBlazor="Typography.Button.TextTransform (uppercase)" Here="FiliButtonTextTransform" Status="Same" Note="CSS's words: none, uppercase, lowercase, capitalize, on a button's string label and on the button class." />
      <docs:ParityRow MudBlazor="the font" Here="Roboto, embedded" Status="Same" Note="Light, Regular and Medium as static faces; FiliFontFamily is the key, and a replacement needs the same three weights (Theming)." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
