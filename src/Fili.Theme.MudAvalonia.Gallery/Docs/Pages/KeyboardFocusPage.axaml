<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.KeyboardFocusPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Keyboard focus"
                    Summary="Keyboard focus lights the control's state layer, as MudBlazor's does, and draws a focus ring round it, which MudBlazor does not; an app can turn the ring off. Each control is one Tab stop." />

    <TextBlock Classes="h5 section" Text="The state layer" />
    <TextBlock Classes="body1 p">
      <Run Text="Every interactive control lights its state layer on " /><Run Classes="code" Text=":focus-visible" /><Run Text=", the tint hovering gives it. That is MudBlazor's own affordance rather than a choice made here: its " /><Run Classes="code" Text="_reset.scss" /><Run Text=" removes the browser's focus outline, and each component maps " /><Run Classes="code" Text=":focus-visible" /><Run Text=" to its hover colour." />
    </TextBlock>
    <docs:CodeBlock Code="_button.scss          &amp;:focus-visible, &amp;:active { background-color: action-default-hover }&#10;_expansionpanel.scss  &amp;:focus-visible           { background-color: action-default-hover }&#10;_link.scss            &amp;:focus-visible, &amp;:active { text-decoration: underline }&#10;_list.scss            &amp;:focus:not(.mud-selected-item) { background-color: action-default-hover }"
                    Margin="0,0,0,16" />
    <docs:ExampleCard Title="Tab through"
                      Description="Click the field, then press Tab: each control takes focus in turn and shows its hover tint and the focus ring while it has it. The slider is one stop, not its two rail halves, and the numeric field's text box stands for its control."
                      Source="KeyboardFocus/TabThrough" />
    <TextBlock Classes="body1 p">
      <Run Text="It is " /><Run Classes="code" Text=":focus-visible" /><Run Text=", not " /><Run Classes="code" Text=":focus" /><Run Text=": clicking a button does not leave it tinted once the pointer has gone; only keyboard navigation marks it." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Lists and text fields" />
    <TextBlock Classes="body1 p">
      <Run Text="A selected list row gets no focus tint, as in " /><Run Classes="code" Text="_list.scss" /><Run Text=": it keeps its selection tint, the primary's hover shade under primary text, because the arrow keys move focus and selection together and tinting both would be the selection tint twice. In a " /><Run Classes="code" Text="multi-selection" /><Run Text=" list a selected row has no tint, its checkbox marks it, so there a focused row does take the hover tint. A text field keeps " /><Run Classes="code" Text=":focus" /><Run Text=", however it was focused: its accent rule says where typing goes, not where the keyboard is." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="The focus ring" />
    <TextBlock Classes="body1 p">
      <Run Text="The tint is MudBlazor's 6% action-default-hover. It is visible, but it falls far short of the 3:1 against its surroundings that WCAG 2.2's 1.4.11 asks of a focus indicator, so the tint alone does not meet WCAG AA, and a keyboard user loses their place. So the theme draws a focus ring too, in every variant: two adjacent 2px strokes round whichever control the keyboard focuses, white against the control and text-primary 2px out, where a single ring would be, in every window and popup, its corners following the control's: a pill round a pill, a square round a square. A switch's ring goes round the switch, not its label. At least one stroke keeps 3:1 against the page, a surface and the app bar in every variant: the text-primary one on a light page, the white one on a dark page or a coloured app bar. A click or a touch draws none, as it draws no tint: the ring is for the keyboard only." />
    </TextBlock>
    <TextBlock Classes="body1 p">
      <Run Text="MudBlazor has no ring; it removes the browser's. An app that wants MudBlazor's look, the tint alone, sets " /><Run Classes="code" Text="FiliFocusRing" /><Run Text=" to False in the application's resources, in every variant at once. Before 0.29.0 the ring was off in light and dark and on only in high contrast." />
    </TextBlock>
    <docs:CodeBlock Code="&lt;Application.Resources&gt;&#10;  &lt;x:Boolean x:Key=&quot;FiliFocusRing&quot;&gt;False&lt;/x:Boolean&gt;&#10;&lt;/Application.Resources&gt;"
                    Margin="0,0,0,16" />

    <TextBlock Classes="h5 section" Text="A ring of your own" />
    <TextBlock Classes="body1 p">
      <Run Text="Avalonia's dashed focus rectangle is off, but a ring an app sets through a control's " /><Run Classes="code" Text="FocusAdorner" /><Run Text=" still draws, in place of the theme's ring where that is on." />
    </TextBlock>
    <docs:ExampleCard Title="FocusAdorner"
                      Description="Tab to the second button: its FocusAdorner draws a 2px primary ring round the tint. An adorner is clipped to its control, so a ring drawn outside it sets AdornerLayer.IsClipEnabled to False. Set it in a style to give every button one."
                      Source="KeyboardFocus/FocusRing" />

    <TextBlock Classes="h5 section" Text="Access keys" />
    <docs:ExampleCard Title="_Save"
                      Description="An underscore before a letter makes it the access key, as in Avalonia's own themes: Alt underlines the letters and Alt with one presses the control. The label's case survives, so _Save reads SAVE with Alt+S. To show an underscore, double it. MudBlazor has none."
                      Source="KeyboardFocus/AccessKeys" />

    <TextBlock Classes="h5 section" Text="Screen readers" />
    <TextBlock Classes="body1 p">
      <Run Text="A field's label is its name to a screen reader, as a MudBlazor field's label element makes it: the theme sets " /><Run Classes="code" Text="AutomationProperties.Name" /><Run Text=" from " /><Run Classes="code" Text="PlaceholderText" /><Run Text=" on a text field, an autocomplete, a number field, a select and a date picker, and the text box inside that takes focus reads the same name. An app's own " /><Run Classes="code" Text="AutomationProperties.Name" /><Run Text=" wins, and so does a label it points the field at with " /><Run Classes="code" Text="AutomationProperties.LabeledBy" /><Run Text=". With the " /><Run Classes="code" Text="placeholder" /><Run Text=" class the text is a hint, not a label, and is still read as the name, as a browser reads an input's placeholder when nothing else names it: give such a field a name or a LabeledBy of its own. A time picker's label is its " /><Run Classes="code" Text="AutomationProperties.Name" /><Run Text=", and a field's helper text is its " /><Run Classes="code" Text="AutomationProperties.HelpText" /><Run Text=", which a screen reader announces too. The icon buttons inside the theme's templates are named from " /><Run Classes="code" Text="FiliString*" /><Run Text=" keys, which an app translates; its own icon-only buttons it names itself." />
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="text-field" Content="Text field" />
      <docs:DocLink Slug="time-picker" Content="Time picker" />
      <docs:DocLink Slug="high-contrast" Content="High contrast" />
      <docs:DocLink Slug="accessibility" Content="Accessibility" />
    </StackPanel>

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <docs:ParityTable>
      <docs:ParityRow MudBlazor=":focus-visible" Here=":focus-visible" Status="Same" Note="The control's hover tint; a click leaves none." />
      <docs:ParityRow MudBlazor="outline: none (_reset.scss)" Here="no focus rectangle" Status="Same" Note="The base's dashed rectangle is off; a FocusAdorner the app sets still draws." />
      <docs:ParityRow MudBlazor="(none: a focus ring)" Here="FiliFocusRing" Status="Extra" Note="Two 2px strokes, white against the control and text-primary outside it, on keyboard focus, its corners each the control's plus 4px: on in every variant; False in the application's resources keeps MudBlazor's tint alone." />
      <docs:ParityRow MudBlazor="a list row, :focus:not(.mud-selected-item)" Here="the same" Status="Same" Note="A selected row shows its selection tint only; in a multi-selection list, which tints no selected row, a focused one takes the hover tint." />
      <docs:ParityRow MudBlazor="a text field's :focus" Here="the same" Status="Same" Note="The accent rule and the label's colour, however the field was focused." />
      <docs:ParityRow MudBlazor="(none: access keys)" Here="_ before a letter in a label" Status="Extra" Note="Avalonia's own: Alt underlines and presses." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
