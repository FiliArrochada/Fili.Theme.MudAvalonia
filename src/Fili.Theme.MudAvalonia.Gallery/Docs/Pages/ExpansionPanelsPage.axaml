<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.ExpansionPanelsPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Expansion panels"
                    Summary="Expansion panels show and hide sections of content: Avalonia's Expander, drawn as MudExpansionPanel, and expansion-panels on the StackPanel that holds them, drawn as MudExpansionPanels."
                    MudBlazor="ExpansionPanels"
                    MudBlazorPath="components/expansionpanels"
                    AvaloniaControls="Expander" />

    <TextBlock Classes="h5 section" Text="Simple usage" />
    <docs:ExampleCard Title="A group of panels"
                      Description="The panels become one shape: the group's radius on the first panel's top corners and the last one's bottom, and a lines-default rule under each panel but the last. An open panel moves 16px from its neighbours with every corner rounded. Opening one closes the others."
                      Source="ExpansionPanels/Simple" />
    <TextBlock Classes="body1 p">
      <Run Text="Opening grows the content into view over .3s " /><Run Classes="code" Text="ease-in-out" /><Run Text=", as MudCollapse does, rather than fading it in; closing shrinks it away, from where it is if turned back half-way. A panel that starts open is open on its first frame. The header is 15px, MudBlazor's own size for it, neither body1 nor body2." />
    </TextBlock>
    <TextBlock Classes="body1 p">
      <Run Text="The group can also be an " /><Run Classes="code" Text="ItemsControl" /><Run Text=" whose items are Expanders or whose " /><Run Classes="code" Text="ItemTemplate" /><Run Text=" makes them, virtualising or not; bind " /><Run Classes="code" Text="IsExpanded" /><Run Text=" to the item there, as a virtualising panel rebuilds and reuses its Expanders. A generated panel's place is its item's index, so the panels on screen are rounded and ruled as their items stand, and a neighbour not yet realised is off screen and counts as closed. A " /><Run Classes="code" Text="ListBox" /><Run Text=" is not a group: its rows are list rows, with their own padding and selection." />
    </TextBlock>
    <TextBlock Classes="body1 p">
      <Run Text="Closing a panel when another opens is a current value, so a binding on " /><Run Classes="code" Text="IsExpanded" /><Run Text=" survives it and hears the change." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Multiple expanded panels" />
    <docs:ExampleCard Title="multi-expansion"
                      Description="MultiExpansion is off by default, so of panels written open only the first stays open. multi-expansion on the group lets them open independently."
                      Source="ExpansionPanels/Multi" />

    <TextBlock Classes="h5 section" Text="Disabled" />
    <docs:ExampleCard Title="Disabled"
                      Description="IsEnabled=&quot;False&quot;: a text-disabled header and an action-disabled chevron."
                      Source="ExpansionPanels/Disabled" />

    <TextBlock Classes="h5 section" Text="Padding" />
    <docs:ExampleCard Title="Gutters and dense"
                      Description="The header and content have 24px sides; no-gutters is Gutters=&quot;false&quot; and takes them off. dense takes the 16px off the top and bottom of the content. Both go on each panel."
                      Source="ExpansionPanels/Padding" />

    <TextBlock Classes="h5 section" Text="Borders" />
    <docs:ExampleCard Title="No outline, no elevation"
                      Description="no-outline on the group is Outlined=&quot;false&quot;: no rule between the panels. With elevation0 on each panel, for a flatter look, the panels keep their surface."
                      Source="ExpansionPanels/Borders" />

    <TextBlock Classes="h5 section" Text="Elevation and square" />
    <docs:ExampleCard Title="Elevation and square"
                      Description="Each panel carries its own elevation, 1 with no class, so an elevation class goes on every Expander. square on the group squares every panel."
                      Source="ExpansionPanels/ElevationSquare" />
    <TextBlock Classes="body1 p">
      <Run Text="Where two closed panels meet, the lower one's shadow falls faintly on the upper, in MudBlazor too. Use " /><Run Classes="code" Text="elevation0" /><Run Text=" when the panels already sit on a card. In high contrast that edge is the panel's ring." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="A panel on its own" />
    <docs:ExampleCard Title="One Expander"
                      Description="Without a group an Expander is one MudExpansionPanel: a surface at elevation 1 with the default radius. Square on one panel is CornerRadius=&quot;0&quot;."
                      Source="ExpansionPanels/Single" />

    <TextBlock Classes="h5 section" Text="Customizing the header and icon" />
    <docs:ExampleCard Title="Header content, hide-icon and a custom icon"
                      Description="The Header is any content, as TitleContent is. hide-icon is HideIcon: no chevron. The chevron is FiliExpandMoreGeometry, so the key in a panel's Resources swaps it."
                      Source="ExpansionPanels/Header" />

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudExpansionPanels and MudExpansionPanel parameter and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="MudExpansionPanels, the group" Here="expansion-panels on the StackPanel or ItemsControl that holds the Expanders" Status="Same" Note="One shape: the group's radius on the first panel's top and the last one's bottom, square between." />
      <docs:ParityRow MudBlazor="panel on a surface at elevation 1" Here="the same" Status="Same" Note="Each panel carries the surface and the shadow, as each MudExpansionPanel does." />
      <docs:ParityRow MudBlazor="15px header" Here="the same" Status="Same" Note="MudBlazor's .9375rem, sized on its own." />
      <docs:ParityRow MudBlazor="Elevation (default 1)" Here="no class, or elevation0 … elevation25" Status="Same" Note="On the panel; elevation0 keeps the surface." />
      <docs:ParityRow MudBlazor="Square" Here="CornerRadius=&quot;0&quot;" Status="Same" Note="No radius." />
      <docs:ParityRow MudBlazor="Dense" Here="dense" Status="Same" Note="The content loses its 16px top and bottom." />
      <docs:ParityRow MudBlazor="Gutters (default true)" Here="no-gutters for false" Status="Same" Note="The header and the content lose their 24px sides." />
      <docs:ParityRow MudBlazor="Dense, Gutters on MudExpansionPanels" Here="dense, no-gutters on each panel" Status="Close" Note="The group's values do not cascade: the classes go on every panel." />
      <docs:ParityRow MudBlazor="Outlined (default true)" Here="on in a group; no-outline on the group for false" Status="Same" Note="A 1px lines-default rule under each panel but the last, and under none that is open or comes before one." />
      <docs:ParityRow MudBlazor="an expanded panel" Here="in a group" Status="Same" Note="16px from its neighbours (none above the first or below the last) over .3s, every corner rounded; the panel before it takes the bottom corners and the one after it the top." />
      <docs:ParityRow MudBlazor="Square on the group" Here="square on the group" Status="Same" Note="No radius on any panel." />
      <docs:ParityRow MudBlazor="MultiExpansion (default false)" Here="no class, or multi-expansion for true" Status="Same" Note="Opening a panel closes the others, and of panels written open the first stays open; multi-expansion lets them open independently." />
      <docs:ParityRow MudBlazor="Disabled" Here="IsEnabled=&quot;False&quot;" Status="Same" Note="Text-disabled header, action-disabled chevron." />
      <docs:ParityRow MudBlazor="HideIcon" Here="hide-icon" Status="Same" Note="No chevron." />
      <docs:ParityRow MudBlazor="Icon" Here="FiliExpandMoreGeometry in the panel's Resources" Status="Same" Note="The key reaches every Expander under the one it is set on." />
      <docs:ParityRow MudBlazor="MaxHeight" Here="MaxHeight on the content" Status="Close" Note="An ordinary Avalonia property, on the content rather than the panel." />
      <docs:ParityRow MudBlazor="opening" Here="the same" Status="Same" Note="MudCollapse: the content grows into view over .3s ease-in-out and shrinks away closing, from where it is if turned back half-way." />
      <docs:ParityRow MudBlazor="MudCollapse" Here="an Expander's content, or IsVisible" Status="Close" Note="Avalonia has no headerless collapse." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
