<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.LinkPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Link"
                    Summary="Links navigate or act from inside text: Avalonia's HyperlinkButton, drawn as MudLink. Primary by default, underlined only under the pointer, and sized by the text around it."
                    MudBlazor="Link"
                    MudBlazorPath="components/link" />

    <TextBlock Classes="h5 section" Text="Simple links" />
    <docs:ExampleCard Title="Colours"
                      Description="MudLink is one of the few MudBlazor components whose Color defaults to Primary, so a bare HyperlinkButton is primary. A colour class is the text's colour, every palette colour."
                      Source="Link/Colors" />
    <docs:ExampleCard Title="inherit"
                      Description="inherit is Color.Inherit: the link takes the surrounding text colour, here text-secondary set on the panel round it."
                      Source="Link/Inherit" />
    <TextBlock Classes="body1 p">
      <Run Text="Size, weight and spacing are inherited from the surrounding text, so the theme sets no " /><Run Classes="code" Text="FontSize" /><Run Text=": a link inside body2 is body2, and a link inside a heading is the heading." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Underlines" />
    <docs:ExampleCard Title="Hover, always and none"
                      Description="MudLink.Underline defaults to Hover, so a link is not underlined at rest: it underlines under the pointer, on keyboard focus and while pressed. underline is Underline.Always and no-underline is Underline.None. Hover the first link to see it."
                      Source="Link/Underlines" />

    <TextBlock Classes="h5 section" Text="Typography" />
    <docs:ExampleCard Title="A type class inside"
                      Description="MudLink's Typo is a type class on a TextBlock inside the link."
                      Source="Link/Typography" />

    <TextBlock Classes="h5 section" Text="Icons" />
    <docs:ExampleCard Title="Start and end icons"
                      Description="StartIcon and EndIcon are a PathIcon in the content marked start-icon or end-icon: at the link's own font size and 4px from the text, as .mud-link-icon-start and -end are."
                      Source="Link/Icons" />

    <TextBlock Classes="h5 section" Text="Disabled" />
    <docs:ExampleCard Title="Disabled"
                      Description="IsEnabled=&quot;False&quot; is MudLink's Disabled: action-disabled, and no underline on hover unless underline is always on."
                      Source="Link/Disabled" />

    <TextBlock Classes="h5 section" Text="MudBlazor parity" />
    <TextBlock Classes="body1 p">
      <Run Text="Every MudLink parameter and what it is here. " /><Run Classes="code" Text="Same" /><Run Text=" is transcribed from MudBlazor's source; " /><Run Classes="code" Text="Close" /><Run Text=" gets the same result another way." />
    </TextBlock>
    <docs:ParityTable>
      <docs:ParityRow MudBlazor="Underline.Hover (default)" Here="no class" Status="Same" />
      <docs:ParityRow MudBlazor="Underline.Always / None" Here="underline / no-underline" Status="Same" />
      <docs:ParityRow MudBlazor="Color.Primary (default)" Here="no class" Status="Same" />
      <docs:ParityRow MudBlazor="Color.Secondary / Inherit" Here="secondary / inherit" Status="Same" Note="inherit is the surrounding text colour." />
      <docs:ParityRow MudBlazor="Color.Tertiary … Color.Dark" Here="tertiary … dark" Status="Same" Note="Every palette colour as the text." />
      <docs:ParityRow MudBlazor="Disabled" Here="IsEnabled=&quot;False&quot;" Status="Same" Note="Action-disabled." />
      <docs:ParityRow MudBlazor="Typo" Here="a type class on a TextBlock inside" Status="Close" />
      <docs:ParityRow MudBlazor="StartIcon, EndIcon" Here="an icon in the content marked start-icon / end-icon" Status="Same" Note="As .mud-link-icon-start and -end: the link's own font size and 4px from the text." />
    </docs:ParityTable>
  </StackPanel>
</UserControl>
