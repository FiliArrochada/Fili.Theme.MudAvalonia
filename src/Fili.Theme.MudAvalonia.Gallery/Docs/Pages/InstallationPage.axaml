<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Fili.Theme.MudAvalonia.Gallery.Docs"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.Pages.InstallationPage">
  <StackPanel Classes="doc">
    <docs:DocHeader Title="Installation"
                    Summary="One package, two includes, and no other theme." />

    <TextBlock Classes="h5 section" Text="Add the package" />
    <TextBlock Classes="body1 p">
      <Run Text="The package id is " /><Run Classes="code" Text="Fili.MudAvalonia.Theme" /><Run Text=" on nuget.org. It targets net10.0 and depends on Avalonia 12.1.3 or later and nothing else." />
    </TextBlock>
    <docs:CodeBlock Code="dotnet add package Fili.MudAvalonia.Theme" Margin="0,0,0,16" />
    <TextBlock Classes="body1 p">
      <Run Text="Under Central Package Management the version goes in " /><Run Classes="code" Text="Directory.Packages.props" /><Run Text=" and the reference stays version-less." />
    </TextBlock>

    <TextBlock Classes="h5 section" Text="Include the theme" />
    <TextBlock Classes="body1 p">
      <Run Text="Two includes in " /><Run Classes="code" Text="App.axaml" /><Run Text=", the base first: later styles win. No FluentTheme or SimpleTheme, and no other Avalonia.Themes package." />
    </TextBlock>
    <docs:CodeBlock Code="&lt;Application.Styles&gt;&#10;  &lt;StyleInclude Source=&quot;avares://Fili.Theme.MudAvalonia/Themes/Base/FiliBaseTheme.axaml&quot; /&gt;&#10;  &lt;StyleInclude Source=&quot;avares://Fili.Theme.MudAvalonia/FiliTheme.axaml&quot; /&gt;&#10;&lt;/Application.Styles&gt;"
                    Margin="0,0,0,16" />
    <TextBlock Classes="body1 p">
      <Run Text="Publish with ReadyToRun for a faster start. Loading the theme the first time is mostly the JIT compiling its XAML, about 300 ms on a desktop; precompiled, it is under 100." />
    </TextBlock>
    <docs:CodeBlock Code="&lt;PublishReadyToRun&gt;true&lt;/PublishReadyToRun&gt;"
                    Margin="0,0,0,16" />

    <TextBlock Classes="h5 section" Text="Use the tokens" />
    <TextBlock Classes="body1 p">
      <Run Text="Reach a colour or a shadow by its key, always as a " /><Run Classes="code" Text="DynamicResource" /><Run Text=": a StaticResource freezes the value of whichever variant was active when it loaded." />
    </TextBlock>
    <docs:CodeBlock Code="&lt;Border Classes=&quot;paper elevation4&quot; Padding=&quot;16&quot;&gt;&#10;  &lt;TextBlock Classes=&quot;h6&quot; Text=&quot;Section&quot; /&gt;&#10;&lt;/Border&gt;&#10;&#10;&lt;Border Background=&quot;{DynamicResource FiliPrimaryBrush}&quot; /&gt;"
                    Margin="0,0,0,16" />

    <TextBlock Classes="h5 section" Text="The DataGrid" />
    <TextBlock Classes="body1 p">
      <Run Text="The theme builds against " /><Run Classes="code" Text="Avalonia.Controls.DataGrid" /><Run Text=" without depending on it: reference the package in your app, 12.1.0 or later, and the data grid is MudDataGrid; leave it out and nothing breaks." />
    </TextBlock>
    <TextBlock Classes="body1 p" Text="On an older version the theme leaves the grid alone rather than apply templates that name parts it lacks, and Avalonia's log says why. Avalonia has no default theme, so the grid then needs the DataGrid package's own theme included to show at all." />
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="body1" Text="See also:" VerticalAlignment="Center" />
      <docs:DocLink Slug="data-grid" Content="Data grid" />
    </StackPanel>
  </StackPanel>
</UserControl>
