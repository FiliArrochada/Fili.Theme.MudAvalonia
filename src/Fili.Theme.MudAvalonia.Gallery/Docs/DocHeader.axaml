<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Docs.DocHeader">
  <!-- A page's heading, as mudblazor.com opens each page: its title, what it is, and for a
       component the MudBlazor page it mirrors and Avalonia's pages for the controls it is on. -->
  <StackPanel Spacing="8" Margin="0,0,0,32">
    <TextBlock x:Name="TitleText" Classes="h3" />
    <TextBlock x:Name="SummaryText" Classes="body1" TextWrapping="Wrap"
               Foreground="{DynamicResource FiliTextSecondaryBrush}" />
    <WrapPanel x:Name="MudBlazorLinks" Margin="0,8,0,0" IsVisible="False">
      <TextBlock Classes="body2" Text="MudBlazor docs:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <HyperlinkButton x:Name="MudBlazorLink">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock x:Name="MudBlazorText" Classes="body2" />
          <PathIcon Classes="small" Data="{DynamicResource DocsOpenInNewIcon}" />
        </StackPanel>
      </HyperlinkButton>
    </WrapPanel>
    <WrapPanel x:Name="AvaloniaLinks" IsVisible="False">
      <TextBlock Classes="body2" Text="Avalonia docs:" VerticalAlignment="Center" Margin="0,0,8,0" />
    </WrapPanel>
  </StackPanel>
</UserControl>
