<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Fili.Theme.MudAvalonia.Gallery</RootNamespace>
    <AssemblyName>Fili.Theme.MudAvalonia.Gallery</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- The theme only builds against the DataGrid; an app shows one by referencing it, as here. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Noto Sans Arabic, the fallback for the right-to-left section of Control states. Roboto and
      Inter have no Arabic glyphs. A browser has no system fonts to fall back on, so there the
      labels rendered as nothing; on desktop they fell back to whatever Arabic face the OS had,
      which made the pixel baselines depend on the machine's installed fonts. Every head
      registers it through GalleryFonts.
      Static Regular and Medium rather than the variable file, for the same reason the theme
      embeds static Roboto: Avalonia picks a face per weight instead of setting an axis.
      SIL Open Font License 1.1; the licence travels with the files in Assets/Fonts/OFL.txt.
      JetBrains Mono Regular is the docs' code font, for the same reason: a browser has no
      monospace face of its own to fall back on. Also OFL 1.1, in Assets/Fonts/OFL-JetBrainsMono.txt.
    -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The docs show each example's own XAML beside it: the file that renders the example is also
      embedded as text, so the code on the page cannot drift from what runs. ExampleCard finds it
      by its path under Docs/Examples. The C# an example built in the app uses, under Docs/Custom,
      is embedded the same way and shown under its XAML.
    -->
    <EmbeddedResource Include="Docs\Examples\**\*.axaml" LogicalName="Examples/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Docs\Custom\*.cs" LogicalName="Custom/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fili.Theme.MudAvalonia\Fili.Theme.MudAvalonia.csproj" />
  </ItemGroup>

</Project>
