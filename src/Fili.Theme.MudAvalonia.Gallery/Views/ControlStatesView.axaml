<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notifications="using:Avalonia.Controls.Notifications"
             xmlns:v="using:Fili.Theme.MudAvalonia.Gallery.Views"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Views.ControlStatesView">

  <!--
    The index on the left stays put while the samples scroll: one row per section heading (a
    TextBlock tagged "section"), built in code-behind, and the row of the section in view is the
    selected one.
  -->
  <Grid ColumnDefinitions="Auto,*">
  <DockPanel Grid.Column="0" Width="208" Margin="24,24,0,24" VerticalAlignment="Top">
    <TextBlock DockPanel.Dock="Top" Classes="overline" Text="On this page" Margin="16,0,0,8" />
    <ListBox x:Name="SectionIndex" Background="Transparent" />
  </DockPanel>

  <ScrollViewer x:Name="Page" Grid.Column="1">
    <StackPanel x:Name="PageContent" Margin="24" Spacing="24">

      <StackPanel Spacing="4">
        <TextBlock Classes="h6" Text="Control states" />
        <TextBlock Classes="body2" Foreground="{DynamicResource FiliTextSecondaryBrush}"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="States are where a theme breaks, and they are exactly what you never notice using the app normally. Hover and press each column, then flip the theme and do it again — a token wired with StaticResource will hold its light value here." />
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Spacing="8">
        <!-- A section heading: the index on the left is built from Tag="section". -->
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Buttons" Margin="0,8,0,4" />
        <TextBlock Classes="overline" Text="Button — variant × colour" />
        <TextBlock Classes="caption" Text="Text (the default variant)" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Default" Classes="text" />
          <Button Content="Primary" Classes="primary" />
          <Button Content="Secondary" Classes="secondary" />
          <Button Content="Tertiary" Classes="tertiary" />
          <Button Content="Info" Classes="info" />
          <Button Content="Success" Classes="success" />
          <Button Content="Warning" Classes="warning" />
          <Button Content="Error" Classes="error" />
          <Button Content="Dark" Classes="dark" />
        </StackPanel>
        <TextBlock Classes="caption" Text="Outlined" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Default" Classes="outlined" />
          <Button Content="Primary" Classes="outlined primary" />
          <Button Content="Secondary" Classes="outlined secondary" />
          <Button Content="Tertiary" Classes="outlined tertiary" />
          <Button Content="Info" Classes="outlined info" />
          <Button Content="Success" Classes="outlined success" />
          <Button Content="Warning" Classes="outlined warning" />
          <Button Content="Error" Classes="outlined error" />
          <Button Content="Dark" Classes="outlined dark" />
        </StackPanel>
        <TextBlock Classes="caption" Text="Filled" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Default" Classes="filled" />
          <Button Content="Primary" Classes="filled primary" />
          <Button Content="Secondary" Classes="filled secondary" />
          <Button Content="Tertiary" Classes="filled tertiary" />
          <Button Content="Info" Classes="filled info" />
          <Button Content="Success" Classes="filled success" />
          <Button Content="Warning" Classes="filled warning" />
          <Button Content="Error" Classes="filled error" />
          <Button Content="Dark" Classes="filled dark" />
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="MudButton's Variant × Color, one class each: Classes=&quot;outlined error&quot; is Variant.Outlined, Color.Error. A colour class is only a colour, so primary on its own is a primary TEXT button; the fill comes from filled. Hover each one: text and outlined tint with the colour at 6%, filled switches to the colour's darken shade and lifts from elevation 2 to 4 to 8, which no forked template can express because Button has no BoxShadow — only the Border inside a template has one. Default is Color.Default: text-primary, and a grey fill when filled. No ripple — the tint is the static half of it." />

        <TextBlock Classes="overline" Text="Button — size and inherit" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Small" Classes="filled primary small" VerticalAlignment="Center" />
          <Button Content="Medium" Classes="filled primary" VerticalAlignment="Center" />
          <Button Content="Large" Classes="filled primary large" VerticalAlignment="Center" />
          <Button Content="Small" Classes="outlined primary small" VerticalAlignment="Center" />
          <Button Content="Large" Classes="outlined primary large" VerticalAlignment="Center" />
          <Button Content="Small" Classes="primary small" VerticalAlignment="Center" />
          <Button Content="Large" Classes="primary large" VerticalAlignment="Center" />
          <Border Classes="appbar" Padding="8,0" CornerRadius="{DynamicResource FiliCornerRadius}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Content="Inherit" Classes="inherit" VerticalAlignment="Center" />
              <Button Content="Inherit" Classes="outlined inherit" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock Classes="overline" Text="Button — disabled" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Filled" Classes="filled primary" IsEnabled="False" />
          <Button Content="Outlined" Classes="outlined primary" IsEnabled="False" />
          <Button Content="Text" Classes="primary" IsEnabled="False" />
          <Button Content="Default" IsEnabled="False" />
        </StackPanel>

        <TextBlock Classes="overline" Text="Button — keyboard focus" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="FocusedSample" Content="Tabbed to" Classes="filled primary" />
          <Button Content="Not focused" Classes="filled primary" />
          <Button Content="Tabbed to" x:Name="FocusedText" />
          <Button Content="Not focused" />
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="The first and third carry keyboard focus, set from code-behind so it survives into a screenshot. MudBlazor has no focus ring to borrow — _reset.scss sets outline: none and _button.scss maps :focus-visible to the hover value — so the state is the whole affordance. It is :focus-visible rather than :focus on purpose: clicking a button should not leave it tinted after the pointer has gone." />

        <TextBlock Classes="overline" Text="Access keys" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="filled primary" Content="_Save" />
          <Button Classes="primary" Content="_Cancel" />
          <CheckBox Content="_Remember me" IsChecked="True" />
          <ToggleSwitch Content="_Notifications" IsChecked="True" />
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="&quot;_Save&quot; is Save with S as its access key, as in Avalonia's own themes: Alt underlines the letters and presses the control. MudBlazor has none; Avalonia apps write them anyway. To show an underscore, double it." />
      </StackPanel>

      <!-- Split and drop-down buttons -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Split and drop-down buttons" Margin="0,8,0,4" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <SplitButton Content="Save">
            <SplitButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="Save as…" />
                <MenuItem Header="Save a copy" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
          <SplitButton Classes="outlined primary" Content="Export">
            <SplitButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="Export as PDF" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
          <SplitButton Classes="filled primary" Content="Deploy">
            <SplitButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="Deploy to staging" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
          <SplitButton Content="Disabled" IsEnabled="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <DropDownButton Content="Sort by" />
          <DropDownButton Classes="outlined" Content="Filter" />
          <DropDownButton Classes="filled primary" Content="Create" />
          <DropDownButton Content="Disabled" IsEnabled="False" />
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="A split button is MudButtonGroup, with the same classes as Button: text by default, outlined, filled, any colour, small and large. The halves square off their inner corners and a 1px line sits between them — text-primary or the colour at FULL strength, because Palette.cs sets BorderOpacity to 1.0; divider when filled; the colour&apos;s lighten shade between filled coloured segments." />
      </StackPanel>

      <!-- Icon buttons, chips, alerts, skeletons -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Icon buttons, chips, alerts, skeletons" Margin="0,8,0,4" />
        <TextBlock Classes="overline" Text="Icon button" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="icon" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryMenuIcon}" /></Button>
          <Button Classes="icon primary" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryFavoriteIcon}" /></Button>
          <Button Classes="icon error" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryDeleteIcon}" /></Button>
          <Button Classes="icon primary small" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryFavoriteIcon}" /></Button>
          <Button Classes="icon primary large" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryFavoriteIcon}" /></Button>
          <Button Classes="icon outlined primary" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryAddIcon}" /></Button>
          <Button Classes="icon filled primary" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryAddIcon}" /></Button>
          <Button Classes="icon" IsEnabled="False" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryDeleteIcon}" /></Button>
          <Button Classes="filled primary flat" Content="Flat" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Classes="overline" Text="Start and end icons" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="filled primary" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><PathIcon Classes="start-icon" Data="{StaticResource GalleryAddIcon}" /><TextBlock Text="Add" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="outlined error small" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><PathIcon Classes="start-icon" Data="{StaticResource GalleryDeleteIcon}" /><TextBlock Text="Delete" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="secondary large" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Favourite" VerticalAlignment="Center" /><PathIcon Classes="end-icon" Data="{StaticResource GalleryFavoriteIcon}" /></StackPanel>
          </Button>
          <Button Classes="chip primary" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><PathIcon Classes="start-icon" Data="{StaticResource GalleryFavoriteIcon}" /><TextBlock Text="Chip icon" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="chip outlined" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Closable" VerticalAlignment="Center" /><PathIcon Classes="end-icon" Data="{StaticResource GalleryDeleteIcon}" /></StackPanel>
          </Button>
        </StackPanel>

        <TextBlock Classes="overline" Text="Chip" Margin="0,8,0,0" />
        <WrapPanel Orientation="Horizontal">
          <Button Classes="chip" Content="Default" />
          <Button Classes="chip primary" Content="Primary" />
          <Button Classes="chip outlined" Content="Outlined" />
          <Button Classes="chip outlined secondary" Content="Secondary" />
          <Button Classes="chip text" Content="Text" />
          <Button Classes="chip text success" Content="Success" />
          <ToggleButton Classes="chip primary" Content="Selected" IsChecked="True" />
          <ToggleButton Classes="chip outlined primary" Content="Selected" IsChecked="True" />
          <Button Classes="chip small primary" Content="Small" VerticalAlignment="Center" />
          <Button Classes="chip large primary" Content="Large" VerticalAlignment="Center" />
          <Button Classes="chip" Content="Disabled" IsEnabled="False" />
        </WrapPanel>

        <TextBlock Classes="overline" Text="Alert" Margin="0,8,0,0" />
        <StackPanel Spacing="8" Width="560" HorizontalAlignment="Left">
          <Border Classes="alert"><TextBlock Text="A normal alert, Variant.Text" /></Border>
          <Border Classes="alert info"><TextBlock Text="Library scan finished" /></Border>
          <Border Classes="alert outlined warning"><TextBlock Text="Two folders were skipped" /></Border>
          <Border Classes="alert filled error"><TextBlock Text="Could not reach the store" /></Border>
          <Border Classes="alert filled success dense"><TextBlock Text="Dense" /></Border>
        </StackPanel>

        <TextBlock Classes="overline" Text="Skeleton and light divider" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
          <StackPanel Width="220" Spacing="4">
            <Border Classes="skeleton" Width="200" HorizontalAlignment="Left" />
            <Border Classes="skeleton no-animation" Width="160" HorizontalAlignment="Left" />
            <Border Classes="skeleton wave" Width="180" HorizontalAlignment="Left" />
          </StackPanel>
          <Border Classes="skeleton circle" Width="40" Height="40" />
          <Border Classes="skeleton rectangle" Width="120" Height="60" />
          <StackPanel Width="200" Spacing="8">
            <TextBlock Classes="caption" Text="Divider" />
            <Separator />
            <TextBlock Classes="caption" Text="Divider, light" />
            <Separator Classes="light" />
          </StackPanel>
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="Each of these is a class on a control Avalonia already has. icon on a Button is MudIconButton: round, 12px round a 24px PathIcon, and action-default rather than text-primary; flat is DropShadow=&quot;false&quot;. chip on a Button or ToggleButton is MudChip, filled by default, and a selected filled chip draws as text. alert and skeleton on a Border are MudAlert, whose text is the colour&apos;s darken shade, and MudSkeleton, pulsing (the second line is no-animation, Animation.False, and the third wave, Animation.Wave). light on a Separator is MudDivider.Light." />
      </StackPanel>

      <!-- FABs, avatars, badges and cards -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="FABs, avatars, badges and cards" Margin="0,8,0,4" />

        <TextBlock Classes="overline" Text="FAB" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="16">
          <Button Classes="fab" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryAddIcon}" /></Button>
          <Button Classes="fab primary" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryAddIcon}" /></Button>
          <Button Classes="fab secondary medium" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryEditIcon}" /></Button>
          <Button Classes="fab tertiary small" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryFavoriteIcon}" /></Button>
          <Button Classes="fab outlined primary" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryShareIcon}" /></Button>
          <Button Classes="fab text error" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryDeleteIcon}" /></Button>
          <Button Classes="fab primary flat" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryAddIcon}" /></Button>
          <Button Classes="fab" IsEnabled="False" VerticalAlignment="Center"><PathIcon Data="{StaticResource GalleryAddIcon}" /></Button>
          <Button Classes="fab extended primary" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><PathIcon Classes="start-icon" Data="{StaticResource GalleryEditIcon}" /><TextBlock Text="Edit" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="fab extended secondary medium" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><PathIcon Classes="start-icon" Data="{StaticResource GalleryShareIcon}" /><TextBlock Text="Share" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="fab extended small" Content="Small" VerticalAlignment="Center" />
        </WrapPanel>

        <TextBlock Classes="overline" Text="Avatar" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Border Classes="avatar"><TextBlock Text="OP" /></Border>
          <Border Classes="avatar primary"><TextBlock Text="M" /></Border>
          <Border Classes="avatar secondary small"><TextBlock Text="S" /></Border>
          <Border Classes="avatar success large"><TextBlock Text="L" /></Border>
          <Border Classes="avatar outlined info"><PathIcon Data="{StaticResource GalleryPersonIcon}" /></Border>
          <Border Classes="avatar warning rounded"><PathIcon Data="{StaticResource GalleryMailIcon}" /></Border>
          <Border Classes="avatar error square"><TextBlock Text="SQ" /></Border>
          <Border Classes="avatar text"><TextBlock Text="T" /></Border>
          <Border Classes="avatar primary elevation4"><TextBlock Text="E" /></Border>
        </StackPanel>

        <TextBlock Classes="overline" Text="Badge" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="40" Margin="0,12">
          <HeaderedContentControl Classes="badge" Header="4"><PathIcon Data="{StaticResource GalleryMailIcon}" /></HeaderedContentControl>
          <HeaderedContentControl Classes="badge primary" Header="99"><PathIcon Data="{StaticResource GalleryMailIcon}" /></HeaderedContentControl>
          <HeaderedContentControl Classes="badge error"><HeaderedContentControl.Header><x:Int32>120</x:Int32></HeaderedContentControl.Header><PathIcon Data="{StaticResource GalleryNotificationsIcon}" /></HeaderedContentControl>
          <HeaderedContentControl Classes="badge secondary dot" Header=""><PathIcon Data="{StaticResource GalleryNotificationsIcon}" /></HeaderedContentControl>
          <HeaderedContentControl Classes="badge success bordered" Header="3"><Border Classes="avatar"><TextBlock Text="B" /></Border></HeaderedContentControl>
          <HeaderedContentControl Classes="badge info overlap" Header="7"><Border Classes="avatar"><TextBlock Text="O" /></Border></HeaderedContentControl>
          <HeaderedContentControl Classes="badge warning icon bottom-right overlap"><HeaderedContentControl.Header><PathIcon Data="{StaticResource GalleryEditIcon}" /></HeaderedContentControl.Header><Border Classes="avatar"><TextBlock Text="I" /></Border></HeaderedContentControl>
          <HeaderedContentControl Classes="badge primary top-left" Header="New"><Button Classes="outlined" Content="Origin" /></HeaderedContentControl>
        </StackPanel>

        <TextBlock Classes="overline" Text="Card" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="24">
          <Border Classes="card" Width="345" VerticalAlignment="Top">
            <StackPanel>
              <DockPanel Classes="card-header">
                <Border Classes="avatar secondary card-header-avatar"><TextBlock Text="I" /></Border>
                <Button Classes="icon card-header-actions"><PathIcon Data="{StaticResource GalleryMoreVertIcon}" /></Button>
                <StackPanel Classes="card-header-content">
                  <TextBlock Classes="body1" Text="Istra Croatia" />
                  <TextBlock Classes="body2" Text="Peninsula in Europe" Foreground="{DynamicResource FiliTextSecondaryBrush}" />
                </StackPanel>
              </DockPanel>
              <Border Classes="card-media" Height="140" Background="{DynamicResource FiliPrimaryLightenBrush}" />
              <TextBlock Classes="card-content body2" TextWrapping="Wrap"
                         Text="Istria is the largest peninsula within the Adriatic Sea. The peninsula is located at the head of the Adriatic between the Gulf of Trieste and the Kvarner Gulf." />
              <StackPanel Classes="card-actions">
                <Button Classes="icon"><PathIcon Data="{StaticResource GalleryFavoriteIcon}" /></Button>
                <Button Classes="icon"><PathIcon Data="{StaticResource GalleryShareIcon}" /></Button>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card outlined" Width="275" VerticalAlignment="Top">
            <StackPanel>
              <StackPanel Classes="card-content" Spacing="4">
                <TextBlock Classes="body2" Text="Outlined, so no elevation" />
                <TextBlock Classes="h5" Text="Word of the day" />
                <TextBlock Classes="body2" Text="adjective" Foreground="{DynamicResource FiliTextSecondaryBrush}" />
              </StackPanel>
              <StackPanel Classes="card-actions">
                <Button Classes="primary" Content="Learn more" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="These are classes too. fab on a Button is MudFab: filled, grey and 56px by default, at elevation 6, lifting to 8 on hover and 12 on press; medium and small are 48 and 40px and extended is the pill MudFab draws for a Label. avatar on a Border is MudAvatar, 40px and filled; text is its bare white-on-grey variant. badge on a HeaderedContentControl is MudBadge: Content is what it decorates and Header the badge, an int over 99 reads 99+, and a null Header hides it. card on a Border is MudCard, at elevation 1, and its parts are classes on what lays it out: card-header, card-media, card-content and card-actions." />
      </StackPanel>

      <!-- Data grid -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Data grid" Margin="0,8,0,4" />

        <TextBlock Classes="overline" Text="No class: MudDataGrid's defaults, sorted by name" />
        <DataGrid x:Name="PlainGrid" Width="760" HorizontalAlignment="Left" Margin="0,0,0,8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nr" Binding="{Binding Number}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Sign" Binding="{Binding Sign}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" x:DataType="v:GalleryElement" Width="*" />
              <DataGridTextColumn Header="Position" Binding="{Binding Position}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Molar mass" Binding="{Binding Molar}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" x:DataType="v:GalleryElement" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Classes="overline" Text="dense striped bordered hover, a row selected" />
        <DataGrid x:Name="OptionsGrid" Classes="dense striped bordered hover" Width="760" HorizontalAlignment="Left" Margin="0,0,0,8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nr" Binding="{Binding Number}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Sign" Binding="{Binding Sign}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" x:DataType="v:GalleryElement" Width="*" />
              <DataGridTextColumn Header="Position" Binding="{Binding Position}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Molar mass" Binding="{Binding Molar}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" x:DataType="v:GalleryElement" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Classes="overline" Text="outlined square dense, grouped by group and then position" />
        <DataGrid x:Name="GroupedGrid" Classes="outlined square dense" Width="760" HorizontalAlignment="Left">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nr" Binding="{Binding Number}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Sign" Binding="{Binding Sign}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" x:DataType="v:GalleryElement" Width="*" />
              <DataGridTextColumn Header="Position" Binding="{Binding Position}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Molar mass" Binding="{Binding Molar}" x:DataType="v:GalleryElement" />
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" x:DataType="v:GalleryElement" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="Avalonia's own DataGrid needs nothing to look like MudDataGrid: surface at elevation 1, subtitle2 headers in a 59px row, body2 cells 16px round with a table-lines rule under every row but the last, and MudIconButton's ArrowUpward at the end of a sorted header. dense, striped, bordered and hover are MudDataGrid's Dense, Striped, Bordered and Hover; outlined and square are the paper's. A nested group's header steps in 48px; its rows do not. MudDataGrid does not draw a selected row, so selection borrows a selected list row's primary-hover." />

        <TextBlock Classes="overline" Text="A selection column and long text" Margin="0,8,0,0" />
        <DataGrid x:Name="TaskGrid" Width="640" HorizontalAlignment="Left">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Done" Binding="{Binding Done}" x:DataType="v:GalleryTask" />
            <DataGridTextColumn Header="Task" Binding="{Binding Title}" x:DataType="v:GalleryTask" Width="*" />
            <DataGridTextColumn Header="Area" Binding="{Binding Owner}" x:DataType="v:GalleryTask" Width="120" />
            <DataGridTextColumn Header="Due" Binding="{Binding Due}" x:DataType="v:GalleryTask" Width="104" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="A checkbox in a cell is MudBlazor's table checkbox, a 32px circle pulled in 4px, so a selection column keeps the rows at 53px. Text longer than its column is cut off where the column ends, as Avalonia draws it; an app that wants an ellipsis sets TextTrimming on DataGridCell TextBlock." />
      </StackPanel>

      <!-- Selection -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Checkboxes, radios and switches" Margin="0,8,0,4" />
        <StackPanel Orientation="Horizontal" Spacing="24">
          <StackPanel Spacing="4">
            <CheckBox Content="Unchecked" />
            <CheckBox Content="Checked" IsChecked="True" />
            <CheckBox Content="Indeterminate" IsChecked="{x:Null}" IsThreeState="True" />
            <CheckBox Content="Disabled" IsEnabled="False" IsChecked="True" />
          </StackPanel>
          <StackPanel Spacing="4">
            <RadioButton Content="Option one" GroupName="themed" IsChecked="True" />
            <RadioButton Content="Option two" GroupName="themed" />
            <RadioButton Content="Disabled" GroupName="themed" IsEnabled="False" />
          </StackPanel>
          <StackPanel Spacing="4">
            <ToggleSwitch Content="On" IsChecked="True" />
            <ToggleSwitch Content="Off" />
            <ToggleSwitch Content="Disabled" IsEnabled="False" IsChecked="True" />
          </StackPanel>
        </StackPanel>

        <TextBlock Classes="caption" Text="Colours" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="24">
          <StackPanel Spacing="4">
            <CheckBox Classes="primary" Content="Primary" IsChecked="True" />
            <CheckBox Classes="secondary" Content="Secondary" IsChecked="True" />
            <CheckBox Classes="success" Content="Success" />
          </StackPanel>
          <StackPanel Spacing="4">
            <RadioButton Classes="primary" Content="Primary" GroupName="coloured" IsChecked="True" />
            <RadioButton Classes="error" Content="Error" GroupName="coloured-error" IsChecked="True" />
            <RadioButton Classes="info" Content="Info" GroupName="coloured-info" />
          </StackPanel>
          <StackPanel Spacing="4">
            <ToggleSwitch Classes="primary" Content="Primary" IsChecked="True" />
            <ToggleSwitch Classes="success" Content="Success" IsChecked="True" />
            <ToggleSwitch Classes="error" Content="Error, off" />
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Classes="primary unchecked-error" Content="Unchecked colour" />
            <CheckBox Classes="primary unchecked-error" Content="Checked: primary" IsChecked="True" />
            <RadioButton Classes="secondary unchecked-success" Content="Unchecked colour" GroupName="unchecked-colour" />
          </StackPanel>
        </StackPanel>

        <TextBlock Classes="caption" Text="Sizes" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <CheckBox Classes="primary small" Content="Small" IsChecked="True" VerticalAlignment="Center" />
          <CheckBox Classes="primary large" Content="Large" IsChecked="True" VerticalAlignment="Center" />
          <RadioButton Classes="primary small" Content="Small" GroupName="sized-small" IsChecked="True" VerticalAlignment="Center" />
          <RadioButton Classes="primary large" Content="Large" GroupName="sized-large" IsChecked="True" VerticalAlignment="Center" />
          <ToggleSwitch Classes="primary small" Content="Small" IsChecked="True" VerticalAlignment="Center" />
          <ToggleSwitch Classes="primary large" Content="Large" IsChecked="True" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Classes="caption" Text="Label placement, a thumb icon and custom glyphs" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="24">
          <CheckBox Classes="primary label-start" Content="Start" IsChecked="True" VerticalAlignment="Center" />
          <CheckBox Classes="primary label-top" Content="Top" IsChecked="True" />
          <RadioButton Classes="secondary label-bottom" Content="Bottom" GroupName="placed" IsChecked="True" />
          <ToggleSwitch Classes="thumb-success" Content="Thumb icon" IsChecked="True" VerticalAlignment="Center">
            <ToggleSwitch.Resources>
              <StaticResource x:Key="FiliSwitchThumbIconGeometry" ResourceKey="GalleryDoneIcon" />
            </ToggleSwitch.Resources>
          </ToggleSwitch>
          <CheckBox Classes="error" Content="Custom glyphs" IsChecked="True" VerticalAlignment="Center">
            <CheckBox.Resources>
              <StaticResource x:Key="FiliCheckBoxCheckedGeometry" ResourceKey="GalleryFavoriteIcon" />
              <StaticResource x:Key="FiliCheckBoxUncheckedGeometry" ResourceKey="GalleryFavoriteBorderIcon" />
            </CheckBox.Resources>
          </CheckBox>
          <CheckBox Classes="error" Content="Unchecked" VerticalAlignment="Center">
            <CheckBox.Resources>
              <StaticResource x:Key="FiliCheckBoxCheckedGeometry" ResourceKey="GalleryFavoriteIcon" />
              <StaticResource x:Key="FiliCheckBoxUncheckedGeometry" ResourceKey="GalleryFavoriteBorderIcon" />
            </CheckBox.Resources>
          </CheckBox>
        </StackPanel>

        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="The first row carries no class, which is MudBlazor's Color.Default: grey, checked or not, because the icon button the glyph sits in is action-default — and a switch keeps its #fafafa thumb on and off. A colour class is Color: on a checkbox or radio it paints the glyph in every state, on a switch the thumb and track only when on. small and large are MudIcon's 20 and 36px and the switch's own spans. MudBlazor renders Material icons here rather than drawing boxes, so these are the real CheckBox and RadioButtonChecked glyphs. The last row is LabelPlacement as label-start, label-top and label-bottom; MudSwitch's ThumbIcon, a glyph key in the switch's Resources, coloured by thumb-success; and CheckedIcon and UncheckedIcon, the checkbox's glyph keys set to Favorite and FavoriteBorder." />
      </StackPanel>

      <!-- Inputs -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Text fields and selects" Margin="0,8,0,4" />
        <TextBlock Classes="overline" Text="Text field — filled" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBox Classes="filled" Width="190" PlaceholderText="Label" />
          <TextBox Classes="filled" Width="190" PlaceholderText="Label" Text="With content" />
          <TextBox Classes="filled error" Width="190" PlaceholderText="Label" Text="Invalid" />
          <TextBox Classes="filled" Width="190" PlaceholderText="Label" IsEnabled="False" />
        </StackPanel>

        <TextBlock Classes="overline" Text="Text field — outlined" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBox Classes="outlined" Width="190" PlaceholderText="Label" />
          <TextBox Classes="outlined" Width="190" PlaceholderText="Label" Text="With content" />
          <TextBox Classes="outlined error" Width="190" PlaceholderText="Label" Text="Invalid" />
          <TextBox Classes="outlined" Width="190" PlaceholderText="Label" IsEnabled="False" />
        </StackPanel>

        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="Click into an empty one: the label shrinks and rises, and the accent rule scales out from the centre. Type, then click away — the label stays up, because the float condition is focused OR not empty. PlaceholderText is the label, so these variants have no separate placeholder." />

        <TextBlock Classes="overline" Text="Text field — standard (the default, no class)" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBox Width="190" PlaceholderText="Label" />
          <TextBox Width="190" PlaceholderText="Label" Text="With content" />
          <TextBox Classes="error" Width="190" PlaceholderText="Label" Text="Invalid" />
          <TextBox Width="190" PlaceholderText="Label" IsEnabled="False" />
        </StackPanel>
        <WrapPanel ItemSpacing="12" LineSpacing="12">
          <ComboBox Width="190" PlaceholderText="Select">
            <ComboBoxItem>Combo box</ComboBoxItem>
            <ComboBoxItem>Second item</ComboBoxItem>
            <ComboBoxItem>Third item</ComboBoxItem>
          </ComboBox>
          <ComboBox Width="190" PlaceholderText="Select" SelectedIndex="0">
            <ComboBoxItem>With a selection</ComboBoxItem>
            <ComboBoxItem>Second item</ComboBoxItem>
          </ComboBox>
          <ComboBox Width="190" PlaceholderText="Select" IsEnabled="False" SelectedIndex="0">
            <ComboBoxItem>Disabled</ComboBoxItem>
          </ComboBox>
          <NumericUpDown Width="190" Value="42" />
          <AutoCompleteBox Width="190" PlaceholderText="Autocomplete" />
        </WrapPanel>

        <TextBlock Classes="overline" Text="Field details — helper text, counter, dense, select variants" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
          <TextBox Classes="filled" Width="190" VerticalAlignment="Top" PlaceholderText="Email"
                   AutomationProperties.HelpText="We never share it" />
          <TextBox Classes="outlined counter" Width="190" VerticalAlignment="Top" PlaceholderText="Title"
                   MaxLength="40" Text="Fili Manga Reader"
                   AutomationProperties.HelpText="Shown on the card" />
          <TextBox Classes="counter helper-on-focus" Width="190" VerticalAlignment="Top" PlaceholderText="Notes" Text="No limit"
                   AutomationProperties.HelpText="Shown while focused" />
          <TextBox Classes="filled error counter" Width="190" VerticalAlignment="Top" PlaceholderText="Code"
                   MaxLength="6" Text="1234567"
                   AutomationProperties.HelpText="Hidden in error" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
          <TextBox Classes="dense" Width="190" VerticalAlignment="Top" PlaceholderText="Dense" Text="Standard" />
          <TextBox Classes="filled dense" Width="190" VerticalAlignment="Top" PlaceholderText="Dense" Text="Filled" />
          <TextBox Classes="outlined dense" Width="190" VerticalAlignment="Top" PlaceholderText="Dense" Text="Outlined" />
          <ComboBox Classes="outlined dense" Width="190" VerticalAlignment="Top" PlaceholderText="Dense" SelectedIndex="0">
            <ComboBoxItem>Outlined select</ComboBoxItem>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
          <TextBox Classes="required" Width="190" VerticalAlignment="Top" PlaceholderText="Required" />
          <TextBox Classes="filled shrink-label" Width="190" VerticalAlignment="Top" PlaceholderText="Shrink label" />
          <TextBox Classes="filled no-underline" Width="190" VerticalAlignment="Top" PlaceholderText="No underline" Text="Filled" />
          <ComboBox Classes="outlined required" Width="190" VerticalAlignment="Top" PlaceholderText="Required select" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
          <ComboBox Classes="filled" Width="190" VerticalAlignment="Top" PlaceholderText="Library"
                    AutomationProperties.HelpText="Where new files go">
            <ComboBoxItem>Manga</ComboBoxItem>
            <ComboBoxItem>Comics</ComboBoxItem>
          </ComboBox>
          <ComboBox Classes="filled" Width="190" VerticalAlignment="Top" PlaceholderText="Library" SelectedIndex="0">
            <ComboBoxItem>Filled select</ComboBoxItem>
          </ComboBox>
          <ComboBox Classes="outlined" Width="190" VerticalAlignment="Top" PlaceholderText="Library">
            <ComboBoxItem>Manga</ComboBoxItem>
          </ComboBox>
          <ComboBox Classes="outlined error" Width="190" VerticalAlignment="Top" PlaceholderText="Library" SelectedIndex="0">
            <ComboBoxItem>Outlined, error</ComboBoxItem>
          </ComboBox>
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="Helper text is AutomationProperties.HelpText, which a screen reader announces too; an error takes its place. counter is MudTextField's Counter over MaxLength, the length alone when there is none, and helper-on-focus is HelperTextOnFocus: the third field's help appears when it has focus. dense is Margin.Dense, and a select takes filled and outlined exactly as a text field does. required is Required, the label's asterisk; shrink-label is ShrinkLabel, the label up with nothing typed; no-underline is Underline=&quot;false&quot;. Open a select and its arrow turns up, as MudSelect's OpenIcon." />

        <TextBlock Classes="overline" Text="Adornments and several lines" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBox Width="220" PlaceholderText="Search games">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource GallerySearchIcon}" Width="20" Height="20" Margin="0,0,8,0" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <TextBox Classes="outlined" Width="220" PlaceholderText="Amount">
            <TextBox.InnerLeftContent>
              <TextBlock Text="€" Margin="0,0,6,0" VerticalAlignment="Center" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <TextBox Classes="filled" Width="220" PlaceholderText="Weight" Text="72">
            <TextBox.InnerRightContent>
              <TextBlock Text="kg" Margin="6,0,0,0" VerticalAlignment="Center" />
            </TextBox.InnerRightContent>
          </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBox Width="220" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Notes"
                   Text="Bring the receipts.&#10;Ask about the second invoice.&#10;File both by Friday." />
          <TextBox Classes="outlined" Width="220" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Description"
                   Text="Line one&#10;Line two&#10;Line three" />
          <TextBox Classes="filled" Width="220" Height="120" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Message"
                   Text="A short message in a tall field." />
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="A start adornment floats the label, as MudInput's Adornment.Start does, so the label never lies over the icon; an end adornment does not. With AcceptsReturn the text starts at the top and the label sits above it, as a textarea's do, in a field that grows with its lines or one given a height." />
      </StackPanel>

      <!-- Range and progress -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Sliders and progress" Margin="0,8,0,4" />
        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
          <Slider Width="190" Value="40" />
          <Slider Classes="secondary medium" Width="190" Value="55" />
          <Slider Classes="success large" Width="190" Value="70" />
          <Slider Width="190" Value="40" IsEnabled="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
          <Slider Classes="filled" Width="190" Value="40" />
          <Slider Classes="filled secondary medium" Width="190" Value="50" TickPlacement="BottomRight" TickFrequency="10" />
          <Slider Classes="tertiary large value-label" Width="190" Value="75" TickPlacement="BottomRight" TickFrequency="25" />
          <Slider Classes="filled value-label" Width="190" Value="30" />
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="MudSlider defaults to Size.Small, Color.Primary and Variant.Text: a 2px rail and a 12px thumb, the whole rail the colour at 30%. medium and large are 4px / 20px and 6px / 24px. filled is Variant.Filled, solid up to the thumb; TickPlacement and TickFrequency are TickMarks, dots on the rail; value-label shows the value above the thumb while it is held. Hover a thumb: it does not grow, it gains a 1px ring of the colour at 24%, and 2px while dragged or focused." />

        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="MudProgressLinear defaults to Size.Small and to square ends, so a bare ProgressBar is a 4px hairline. medium and large are 8px and 12px, rounded opts into the 4px radius, and the track is always the bar's own colour at 20%." />

        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
          <StackPanel Width="190" Spacing="12">
            <ProgressBar Value="65" />
            <ProgressBar Classes="medium" Value="65" />
            <ProgressBar Classes="large rounded" Value="65" />
          </StackPanel>
          <StackPanel Width="190" Spacing="12">
            <ProgressBar Classes="primary medium rounded" Value="65" />
            <ProgressBar Classes="success medium rounded" Value="40" />
            <ProgressBar Classes="error medium rounded" Value="20" />
          </StackPanel>
          <StackPanel Width="190" Spacing="12">
            <TextBlock Classes="caption" Text="Indeterminate" />
            <ProgressBar Classes="medium rounded" IsIndeterminate="True" />
            <ProgressBar Classes="primary medium rounded" IsIndeterminate="True" />
          </StackPanel>
          <StackPanel Width="190" Spacing="12">
            <TextBlock Classes="caption" Text="Striped" />
            <ProgressBar Classes="primary large rounded striped" Value="70" />
            <ProgressBar Classes="success large rounded striped" Value="45" />
          </StackPanel>
        </StackPanel>

        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="circular is MudProgressCircular: the same ProgressBar as a ring, 40px by default, text-secondary with no colour, small and large at 24px and 56px. It starts at twelve o'clock and fills clockwise; rounded rounds the ends, ShowProgressText puts the value in the middle, and IsIndeterminate spins it with MudBlazor's growing and shrinking dash." />

        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
          <ProgressBar Classes="circular small" Value="65" />
          <ProgressBar Classes="circular" Value="65" />
          <ProgressBar Classes="circular large" Value="65" />
          <ProgressBar Classes="circular primary rounded" Value="40" />
          <ProgressBar Classes="circular success large" Value="80" ShowProgressText="True" />
          <ProgressBar Classes="circular" IsIndeterminate="True" />
          <ProgressBar Classes="circular primary" IsIndeterminate="True" />
          <ProgressBar Classes="circular secondary large rounded" IsIndeterminate="True" />
        </StackPanel>

        <TextBlock Classes="overline" Text="A value over a thin bar" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="24">
          <ProgressBar Width="240" Value="40" ShowProgressText="True" VerticalAlignment="Center" />
          <ProgressBar Classes="primary large rounded" Width="240" Value="75" ShowProgressText="True" VerticalAlignment="Center" />
          <ProgressBar Classes="secondary" Orientation="Vertical" Height="72" Value="60" ShowProgressText="True" />
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="ShowProgressText draws the whole value over the bar, centred, however thin the bar is and either way up, as MudProgressLinear's content does." />
      </StackPanel>

      <!-- Dividers -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Dividers" Margin="0,8,0,4" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="MudDivider is a 1px rule in the divider colour with no margin of its own. inset indents it by 72px to clear an avatar column, middle by 16px on both sides, and vertical turns it into a hairline column." />
        <Border Classes="surface elevation1" Width="420" Padding="0,8" HorizontalAlignment="Left">
          <StackPanel>
            <TextBlock Classes="body2" Margin="16,8" Text="Plain divider below" />
            <Separator />
            <TextBlock Classes="body2" Margin="16,8" Text="Inset divider below" />
            <Separator Classes="inset" />
            <TextBlock Classes="body2" Margin="16,8" Text="Middle divider below" />
            <Separator Classes="middle" />
            <StackPanel Orientation="Horizontal" Margin="16,8" Height="20" Spacing="12">
              <TextBlock Classes="body2" Text="Vertical" VerticalAlignment="Center" />
              <Separator Classes="vertical" />
              <TextBlock Classes="body2" Text="divider" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Surfaces -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Surfaces" Margin="0,8,0,4" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Border Classes="surface elevation1" Width="200" Height="96" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="subtitle2" Text="Elevated surface" />
              <TextBlock Classes="caption" Text="elevation1" />
            </StackPanel>
          </Border>
          <Border Classes="surface elevation4" Width="200" Height="96" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="subtitle2" Text="Card" />
              <TextBlock Classes="caption" Text="elevation4" />
            </StackPanel>
          </Border>
          <Border Classes="surface outlined" Width="200" Height="96" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="subtitle2" Text="Outlined" />
              <TextBlock Classes="caption" Text="no shadow" />
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock Classes="overline" Text="MudBlazor" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Classes="surface elevation0" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="0" />
            </Border>
            <Border Classes="surface elevation1" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="1" />
            </Border>
            <Border Classes="surface elevation4" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="4" />
            </Border>
            <Border Classes="surface elevation8" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="8" />
            </Border>
            <Border Classes="surface elevation16" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="16" />
            </Border>
            <Border Classes="surface elevation24" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="24" />
            </Border>
        </StackPanel>
        <TextBlock Classes="overline" Text="material-elevation-overlay" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="16" Classes="material-elevation-overlay">
            <Border Classes="surface elevation0" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="0" />
            </Border>
            <Border Classes="surface elevation1" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="1" />
            </Border>
            <Border Classes="surface elevation4" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="4" />
            </Border>
            <Border Classes="surface elevation8" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="8" />
            </Border>
            <Border Classes="surface elevation16" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="16" />
            </Border>
            <Border Classes="surface elevation24" Width="88" Height="56" Padding="12,8">
              <TextBlock Classes="caption" Text="24" />
            </Border>
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="Elevation 0 to 24, as MudBlazor draws it and with material-elevation-overlay, Material's dark-theme overlay, which MudBlazor does not offer. In dark a black shadow barely shows, so the overlay lightens each raised surface by white at its level's opacity - 5% at 1, 9% at 4, 12% at 8, 16% at 24. Light and high contrast are unchanged. Set the class on a window or any container; papers, cards, panels, grids, menus and flyouts inside take it." />
      </StackPanel>

      <!-- Lists and tabs -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Lists, tabs and menus" Margin="0,8,0,4" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <ListBox Width="180" Height="140" SelectedIndex="1">
            <ListBoxItem>First item</ListBoxItem>
            <ListBoxItem>Selected item</ListBoxItem>
            <ListBoxItem>Third item</ListBoxItem>
            <ListBoxItem IsEnabled="False">Disabled item</ListBoxItem>
          </ListBox>
          <TabControl Width="480" Height="140">
            <TabItem Header="One">
              <TextBlock Classes="body2" Margin="12" Text="First tab content" />
            </TabItem>
            <TabItem Header="Two">
              <TextBlock Classes="body2" Margin="12" Text="Second tab content" />
            </TabItem>
            <TabItem Header="Disabled" IsEnabled="False" />
            <TabItem Header="Four">
              <TextBlock Classes="body2" Margin="12" Text="Four tabs do not fit 480px, so the bar scrolls" />
            </TabItem>
          </TabControl>
          <TreeView x:Name="SampleTree" Classes="surface" Width="180" Height="140">
            <TreeViewItem Header="Library" IsExpanded="True">
              <TreeViewItem x:Name="SelectedNode" Header="Installed" IsExpanded="True">
                <TreeViewItem Header="Recently played" />
              </TreeViewItem>
              <TreeViewItem Header="Collections" />
            </TreeViewItem>
          </TreeView>
        </StackPanel>

        <TextBlock Classes="overline" Text="Multi-selection" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <ListBox x:Name="MultiList" Classes="multi-selection primary" SelectionMode="Multiple, Toggle" Width="220" Height="160">
            <ListBoxItem>Inbox</ListBoxItem>
            <ListBoxItem>Starred</ListBoxItem>
            <ListBoxItem>Sent</ListBoxItem>
          </ListBox>
          <TreeView x:Name="MultiTree" Classes="multi-selection surface" SelectionMode="Multiple, Toggle" Width="220" Height="160">
            <TreeViewItem Header="Library" IsExpanded="True">
              <TreeViewItem Header="Installed" />
              <TreeViewItem Header="Collections" />
            </TreeViewItem>
          </TreeView>
          <TextBlock Classes="caption"
                     TextWrapping="Wrap"
                     Width="360"
                     VerticalAlignment="Top"
                     Text="multi-selection with SelectionMode Multiple, Toggle is SelectionMode.MultiSelection: rows toggle in and out of the selection, each with a checkbox in CheckBoxColor - grey with no class, the list's colour class otherwise - and no row is marked selected. Every list row is 48px, body1 with .mud-list-item-text's 4px above and below." />
        </StackPanel>

        <TextBlock Classes="overline" Text="Menu and scrolling" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Border Classes="surface elevation1" Width="380" Height="140">
            <StackPanel>
              <Menu>
                <MenuItem Header="Library">
                  <MenuItem Header="Scan for games" InputGesture="Ctrl+R" />
                  <MenuItem Header="Add folder" />
                  <Separator />
                  <MenuItem Header="Export" />
                </MenuItem>
                <MenuItem Header="View">
                  <MenuItem Header="Grid" />
                  <MenuItem Header="List" />
                </MenuItem>
                <MenuItem Header="Help" />
              </Menu>
              <TextBlock Classes="caption" Margin="12,12,12,0"
                         Text="Top-level strip; submenus open on a raised surface." />
            </StackPanel>
          </Border>

          <!-- ScrollViewer itself is NOT templated here - it keeps its forked Simple template,
               which is deliberate: it is structural, and a broken one stops scrolling entirely.
               What is themed is the ScrollBar inside it, keyed to its type. -->
          <ScrollViewer Width="330" Height="140"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12" Spacing="8">
              <TextBlock Classes="subtitle2" Text="Themed scrolling" />
              <TextBlock Classes="body2" TextWrapping="Wrap"
                         Text="A thin rail with a rounded thumb and no line buttons, overlaying the content rather than insetting it — so a list does not reflow by twelve pixels the moment it becomes scrollable." />
              <TextBlock Classes="body2" TextWrapping="Wrap"
                         Text="Scroll this panel to see the thumb. It darkens on hover and again on press." />
              <TextBlock Classes="body2" TextWrapping="Wrap"
                         Text="ScrollViewer keeps the forked template on purpose: it is structural rather than decorative, and without a ScrollContentPresenter nothing scrolls at all. Only the rail is ours." />
            </StackPanel>
          </ScrollViewer>
        </StackPanel>

        <TextBlock Classes="overline" Text="Menus opened from a button" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <StackPanel Spacing="8" VerticalAlignment="Top">
            <Button Classes="outlined" Content="_Menu">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="_Journey" />
                  <MenuItem Header="_Near me" />
                  <Separator />
                  <MenuItem Header="_Recent">
                    <MenuItem Header="Report.pdf" />
                    <MenuItem Header="Notes.txt" />
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="outlined" Content="_Dense menu">
              <Button.Flyout>
                <MenuFlyout FlyoutPresenterClasses="dense">
                  <MenuItem Header="Sort by name" />
                  <MenuItem Header="Sort by date" />
                  <MenuItem Header="Sort by size" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <!-- The surface a MenuFlyout opens, placed inline so it shows without a click. -->
          <MenuFlyoutPresenter VerticalAlignment="Top">
            <MenuItem Header="_Open" InputGesture="Ctrl+O" />
            <MenuItem Header="_Save" InputGesture="Ctrl+S" />
            <Separator />
            <MenuItem Header="E_xport">
              <MenuItem Header="PDF" />
            </MenuItem>
          </MenuFlyoutPresenter>
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="A MenuFlyout's rows, and the rows of a submenu inside it, are MudMenuItem's 48px rows, as a menu bar's are; FlyoutPresenterClasses=&quot;dense&quot; is MudMenu's Dense. The surface on the right is the one the buttons open, shown in place." />
      </StackPanel>

      <!-- Lists, toggles, links and panels -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Toggles, links and panels" Margin="0,8,0,4" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="A selected list row is primary text over primary at 6%, not a filled bar — MudList marks it with mud-primary-text plus mud-primary-hover, which keeps it as readable as the rows around it. A toggle is MudToggleItem, a button in the group's colour: the colour as text while off, filled once on; the second row adds outlined, the group's line. icon on a ToggleButton is MudToggleIconButton: a colour class is ToggledColor, unchecked-{colour} is Color, so the grey heart is the red one switched off; the bell becomes a letter, its second PathIcon being ToggledIcon." />
        <StackPanel Orientation="Horizontal" Spacing="24">
          <ListBox Classes="surface" Width="220" Height="176" SelectedIndex="1">
            <ListBoxItem>First item</ListBoxItem>
            <ListBoxItem>Selected item</ListBoxItem>
            <ListBoxItem>Third item</ListBoxItem>
            <ListBoxItem IsEnabled="False">Disabled item</ListBoxItem>
          </ListBox>

          <StackPanel Spacing="12" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ToggleButton Content="Bold" IsChecked="True" />
              <ToggleButton Content="Italic" />
              <ToggleButton Content="Underline" IsEnabled="False" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="0">
              <ToggleButton Classes="outlined" Content="Day" IsChecked="True" />
              <ToggleButton Classes="outlined" Content="Week" />
              <ToggleButton Classes="outlined" Content="Month" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ToggleButton Classes="icon error" IsChecked="True"><PathIcon Data="{StaticResource GalleryFavoriteIcon}" /></ToggleButton>
              <ToggleButton Classes="icon error"><PathIcon Data="{StaticResource GalleryFavoriteIcon}" /></ToggleButton>
              <ToggleButton Classes="icon primary unchecked-secondary">
                <Panel>
                  <PathIcon Data="{StaticResource GalleryNotificationsIcon}" />
                  <PathIcon Data="{StaticResource GalleryMailIcon}" />
                </Panel>
              </ToggleButton>
              <ToggleButton Classes="icon filled primary" IsChecked="True"><PathIcon Data="{StaticResource GalleryEditIcon}" /></ToggleButton>
              <ToggleButton Classes="icon outlined success" IsChecked="True"><PathIcon Data="{StaticResource GalleryAddIcon}" /></ToggleButton>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16">
              <HyperlinkButton Content="Hover to underline" />
              <HyperlinkButton Classes="underline" Content="Always underlined" />
              <HyperlinkButton Content="Disabled link" IsEnabled="False" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <TextBlock Classes="overline" Text="Expansion panel" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="24">
          <Expander Width="330" Header="Collapsed panel">
            <TextBlock Classes="body2" TextWrapping="Wrap"
                       Text="The header is 48px tall with 24px gutters, and the chevron turns -180 degrees over 0.3s." />
          </Expander>
          <Expander Width="330" Header="Expanded panel" IsExpanded="True">
            <TextBlock Classes="body2" TextWrapping="Wrap"
                       Text="The panel carries the surface and elevation 1 because MudExpansionPanels is a MudPaper. The elevation classes change the shadow; elevation0 drops it and keeps the surface." />
          </Expander>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="24">
          <Expander Width="330" Classes="dense square" Header="dense square" IsExpanded="True">
            <TextBlock Classes="body2" TextWrapping="Wrap"
                       Text="Dense drops the content's 16px top and bottom; square drops the radius." />
          </Expander>
          <Expander Width="330" Classes="no-gutters elevation4" Header="no-gutters elevation4" IsExpanded="True">
            <TextBlock Classes="body2" TextWrapping="Wrap"
                       Text="Gutters off: neither the header nor the content keeps its 24px sides." />
          </Expander>
        </StackPanel>

        <TextBlock Classes="overline" Text="Numeric field, autocomplete, validation" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Top">
          <NumericUpDown Width="190" Value="42" PlaceholderText="Quantity" />
          <AutoCompleteBox Width="190" PlaceholderText="Search" Text="Av" />
          <StackPanel Width="220">
            <TextBox x:Name="InvalidField" Width="220" PlaceholderText="Email" Text="not-an-email" />
          </StackPanel>
        </StackPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="The third field has a failing validation, not the error class: the rule turns red on its own and the message sits under the field at 12px, where MudBlazor puts it. The forked template's version was a red circle with a tooltip, off to the right." />
      </StackPanel>

      <!-- Drawer -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Drawer" Margin="0,8,0,4" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="SplitView is MudDrawer, and it is the one control here treated with styles rather than a ControlTheme: everything MudDrawer contributes is a value — 240px open, 56px mini, the drawer-background and drawer-text tokens — while the pane sliding and the display modes are structure the forked template already gets right. A Style outranks a ControlTheme setter, which is normally the trap this repo warns about and is exactly what makes it work. The pane holds a nav TreeView, MudNavMenu: the active link in primary at weight 500, and Downloads a group that opens on a click." />
        <StackPanel Orientation="Horizontal" Spacing="16">
        <Border Classes="surface elevation1" Width="520" Height="180" ClipToBounds="True">
          <SplitView IsPaneOpen="True" DisplayMode="Inline">
            <SplitView.Pane>
              <TreeView Classes="nav" Margin="0,8">
                <TreeViewItem Header="Library" IsSelected="True" />
                <TreeViewItem Header="Store" />
                <TreeViewItem Header="Downloads">
                  <TreeViewItem Header="Queue" />
                  <TreeViewItem Header="History" />
                </TreeViewItem>
              </TreeView>
            </SplitView.Pane>
            <SplitView.Content>
              <StackPanel Margin="16" Spacing="4">
                <TextBlock Classes="subtitle2" Text="Content beside the pane" />
                <TextBlock Classes="body2" TextWrapping="Wrap"
                           Text="The pane is 240px because LayoutProperties.cs says DrawerWidthLeft is 240px; the forked template's own default is 320." />
              </StackPanel>
            </SplitView.Content>
          </SplitView>
        </Border>
        <Border Classes="surface elevation1" Width="240" Height="180" ClipToBounds="True">
          <SplitView IsPaneOpen="False" DisplayMode="CompactInline">
            <SplitView.Pane>
              <TreeView Classes="nav" Margin="0,8">
                <TreeViewItem IsSelected="True">
                  <TreeViewItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <PathIcon Classes="start-icon" Data="{StaticResource GalleryInboxIcon}" />
                    <TextBlock Text="Inbox" />
                  </StackPanel>
                  </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem>
                  <TreeViewItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <PathIcon Classes="start-icon" Data="{StaticResource GallerySendIcon}" />
                    <TextBlock Text="Sent" />
                  </StackPanel>
                  </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem>
                  <TreeViewItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <PathIcon Classes="start-icon" Data="{StaticResource GalleryFavoriteIcon}" />
                    <TextBlock Text="Favourites" />
                  </StackPanel>
                  </TreeViewItem.Header>
                </TreeViewItem>
              </TreeView>
            </SplitView.Pane>
            <SplitView.Content>
              <TextBlock Classes="body2" Margin="16" TextWrapping="Wrap"
                         Text="A mini drawer, closed: CompactInline at 56px, only the links' icons." />
            </SplitView.Content>
          </SplitView>
        </Border>
        </StackPanel>
      </StackPanel>

      <!-- Snackbars -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Snackbars" Margin="0,8,0,4" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="MudSnackbar is a filled MudAlert on an elevation-6 surface: 6px/16px padding, 288px minimum, 500px maximum, Medium weight in the colour's contrast text. The shadow is not a guess — _snackbar.scss spells out the same three layers FiliElevation6 carries. Each card leads with MudSnackbar's severity icon and ends with its close button. The last row is Severity.Normal, then the outlined and text variants, classes WindowNotificationManager.Show passes to the card. Normally the notification manager builds these; here they are placed by hand so they hold still." />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <notifications:NotificationCard NotificationType="Information" Content="Library scan finished" />
          <notifications:NotificationCard NotificationType="Success" Content="12 games added" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <notifications:NotificationCard NotificationType="Warning" Content="Two folders were skipped" />
          <notifications:NotificationCard NotificationType="Error" Content="Could not reach the store" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <notifications:NotificationCard Classes="normal" Content="Settings saved" />
          <notifications:NotificationCard Classes="outlined" NotificationType="Success" Content="Outlined" />
          <notifications:NotificationCard Classes="text hide-close" NotificationType="Error" Content="Text, no close" />
        </StackPanel>

        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="MudTooltip's Color: a ToolTip the app builds as the Tip carries its classes. Placed by hand here, so without the popup that would place its arrow." />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ToolTip Content="Default" />
          <ToolTip Classes="primary" Content="Primary" />
          <ToolTip Classes="secondary" Content="Secondary" />
          <ToolTip Classes="error" Content="Error" />
          <ToolTip Classes="dark" Content="Dark" />
        </StackPanel>
      </StackPanel>

      <!-- Tab strip and pips -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Tab strips, pips and the app bar" Margin="0,8,0,4" />
        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
          <TabStrip Width="480" SelectedIndex="0">
            <TabStripItem>Library</TabStripItem>
            <TabStripItem>Store</TabStripItem>
            <TabStripItem IsEnabled="False">Disabled</TabStripItem>
          </TabStrip>
          <PipsPager NumberOfPages="5" SelectedPageIndex="2"
                     IsPreviousButtonVisible="True" IsNextButtonVisible="True"
                     VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="A TabStrip is a TabControl's header row without the content area — Avalonia splits them, MudBlazor does not, so both carry the same 48px/12px/6px metrics and the same 2px indicator. The pips are MudCarousel's bullets, and they are the RadioButtonChecked and RadioButtonUnchecked glyphs the radio button already uses rather than drawn dots: selecting one swaps the glyph, so a ring gains a disc. The 0.75 opacity on the whole row is transcribed from MudCarousel's own inline style." />

        <TextBlock Classes="overline" Text="Tab options and app bar" Margin="0,8,0,0" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="24" LineSpacing="16">
          <TabStrip Classes="primary" Width="480" SelectedIndex="0">
            <TabStripItem>Primary</TabStripItem>
            <TabStripItem>Store</TabStripItem>
            <TabStripItem IsEnabled="False">Disabled</TabStripItem>
          </TabStrip>
          <TabStrip Classes="dark rounded" Width="480" SelectedIndex="1">
            <TabStripItem>Dark</TabStripItem>
            <TabStripItem>Rounded</TabStripItem>
          </TabStrip>
          <TabStrip Classes="border centered" Width="480" SelectedIndex="0">
            <TabStripItem>Border</TabStripItem>
            <TabStripItem>Centered</TabStripItem>
          </TabStrip>
          <TabStrip Classes="outlined rounded hide-slider" Width="480" SelectedIndex="0">
            <TabStripItem>Outlined, no slider</TabStripItem>
            <TabStripItem>Rounded</TabStripItem>
          </TabStrip>
          <TabStrip Classes="elevation4 rounded slider-secondary" Width="480" SelectedIndex="0" Margin="0,0,0,8">
            <TabStripItem>Elevation 4</TabStripItem>
            <TabStripItem>Slider colour</TabStripItem>
          </TabStrip>
          <TabStrip Classes="primary slider-warning" Width="480" SelectedIndex="1">
            <TabStripItem>Primary bar</TabStripItem>
            <TabStripItem>Warning slider</TabStripItem>
          </TabStrip>
          <TabStrip Classes="material-fixed-tabs border" Width="480" SelectedIndex="0">
            <TabStripItem>Fixed</TabStripItem>
            <TabStripItem>Six</TabStripItem>
            <TabStripItem>Tabs</TabStripItem>
            <TabStripItem>In</TabStripItem>
            <TabStripItem>Equal</TabStripItem>
            <TabStripItem>Parts</TabStripItem>
          </TabStrip>
          <TabControl Classes="border" TabStripPlacement="Bottom" Width="480" Height="150">
            <TabItem Header="Bottom">
              <TextBlock Classes="body2" Margin="12" TextWrapping="Wrap" Text="TabStripPlacement Bottom: the bar under the content, its rule and indicator on top." />
            </TabItem>
            <TabItem Header="Second" />
          </TabControl>
          <TabControl Classes="border" TabStripPlacement="Left" Width="480" Height="150">
            <TabItem Header="Left">
              <TextBlock Classes="body2" Margin="12" TextWrapping="Wrap" Text="TabStripPlacement Left: the tabs stack, and the indicator is a column on the content side." />
            </TabItem>
            <TabItem Header="Second" />
          </TabControl>
          <Border Classes="appbar dense" Width="480">
            <TextBlock Classes="h6" Text="Dense app bar" VerticalAlignment="Center" />
          </Border>
          <Border Classes="appbar primary" Width="480">
            <TextBlock Classes="h6" Text="Primary app bar" VerticalAlignment="Center" />
          </Border>
          <Border Classes="toolbar surface" Width="480">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="icon"><PathIcon Data="{StaticResource GalleryMenuIcon}" /></Button>
              <TextBlock Classes="subtitle1" Text="Toolbar" />
              <PathIcon Classes="small primary" Data="{StaticResource GalleryFavoriteIcon}" />
            </StackPanel>
          </Border>
        </WrapPanel>
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="MudTabs' defaults: a surface bar with no rule under it, tabs in text-primary and at least 160px wide. A colour class is MudTabs' Color, the bar in the colour and the tabs in its contrast text; border, outlined, rounded, centered and hide-slider are its parameters of the same names, on a TabControl or a TabStrip; elevation4 and the like are Elevation, and slider-warning and the like are SliderColor. Position is TabStripPlacement on a TabControl. material-fixed-tabs is Material's fixed tabs, which MudTabs does not offer: the tabs share the bar in equal parts, under the 160px minimum, and never scroll. An app bar is 64px with 24px gutters, dense is 48px, and a colour class is MudAppBar's Color. toolbar on a Border is MudToolBar's box, the same 64px and 24px without the colour; the heart in it is a PathIcon with small and primary, MudIcon's Size and Color." />
      </StackPanel>

      <!-- Right to left -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Right to left" Margin="0,8,0,4" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   Text="The same controls under FlowDirection=RightToLeft. Avalonia mirrors the whole subtree with one transform at the point the direction changes, so grid columns, docks and Left/Right alignment all flip without the templates knowing — which is why MudBlazor's logical properties (margin-inline-end and friends) need no counterpart here. What does NOT take care of itself is a glyph that must not mirror." />
        <StackPanel FlowDirection="RightToLeft" Spacing="12" HorizontalAlignment="Left" Width="760">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox Content="مفعل" IsChecked="True" />
            <CheckBox Content="غير محدد" IsChecked="{x:Null}" IsThreeState="True" />
            <RadioButton Content="خيار" GroupName="rtl" IsChecked="True" />
            <ToggleSwitch Content="تشغيل" IsChecked="True" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBox Width="190" PlaceholderText="البريد" Text="محتوى" />
            <ComboBox Width="190" PlaceholderText="اختر" SelectedIndex="0">
              <ComboBoxItem>عنصر</ComboBoxItem>
            </ComboBox>
            <NumericUpDown Width="150" Value="42" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="filled primary" Content="حفظ" />
            <Separator Classes="vertical" />
            <TreeView Classes="surface" Width="200" Height="96">
              <TreeViewItem Header="المكتبة" IsExpanded="True">
                <TreeViewItem Header="مثبت" />
              </TreeViewItem>
            </TreeView>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- Semantic colours in use -->
      <StackPanel Spacing="8">
        <Separator Margin="0,8,0,0" />
        <TextBlock Classes="h5" Tag="section" Text="Semantic colours" Margin="0,8,0,4" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Classes="surface elevation1" Padding="12,8" Background="{DynamicResource FiliInfoBrush}">
            <TextBlock Classes="body2" Foreground="White" Text="Info" />
          </Border>
          <Border Classes="surface elevation1" Padding="12,8" Background="{DynamicResource FiliSuccessBrush}">
            <TextBlock Classes="body2" Foreground="White" Text="Success" />
          </Border>
          <Border Classes="surface elevation1" Padding="12,8" Background="{DynamicResource FiliWarningBrush}">
            <TextBlock Classes="body2" Foreground="White" Text="Warning" />
          </Border>
          <Border Classes="surface elevation1" Padding="12,8" Background="{DynamicResource FiliErrorBrush}">
            <TextBlock Classes="body2" Foreground="White" Text="Error" />
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- Shown while the sections above are still being added, one per dispatcher pass (see the
           code-behind), and removed with the last. Determinate on purpose: an indeterminate bar
           animates on the UI thread, so it would stall for as long as each section takes. -->
      <StackPanel x:Name="LoadingMore" Spacing="8" HorizontalAlignment="Left">
        <TextBlock Classes="caption" Foreground="{DynamicResource FiliTextSecondaryBrush}" Text="Loading the rest of the samples…" />
        <ProgressBar x:Name="LoadingBar" Classes="primary rounded" Width="240" Minimum="0" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
  </Grid>

</UserControl>
