<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Views.CustomStylesView">

  <!--
    Examples rather than parity, kept apart from the control states on purpose: an Avalonia control
    MudBlazor has no counterpart for, which the theme reaches into with a targeted style, and
    compositions an app builds out of the theme's pieces where MudBlazor has a pattern but no
    single component. Each is also a pixel frame, so the examples are verified like the rest.
  -->
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Classes="h6" Text="Custom styles" />
      <TextBlock Classes="body2"
                 Foreground="{DynamicResource FiliTextSecondaryBrush}"
                 TextWrapping="Wrap"
                 MaxWidth="760"
                 HorizontalAlignment="Left"
                 Text="Examples, not MudBlazor parity: Avalonia controls with no MudBlazor counterpart, where the theme styles only the part that would otherwise look wrong, and patterns built out of the theme's own pieces." />

      <TextBlock Classes="overline" Text="DrawerPage" Margin="0,8,0,0" />
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 MaxWidth="760"
                 HorizontalAlignment="Left"
                 Text="Avalonia's page with a drawer. Its pane toggles are MudLayout's drawer button, a MudIconButton: grey, round, the same open or closed. Closed and compact, it is a mini drawer as a compact SplitView is: a 56px rail showing only the links' icons. Everything else - the top bar and its title - is the fork's own." />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Border Classes="paper elevation1" Width="520" Height="200" ClipToBounds="True">
          <DrawerPage Header="Library" IsOpen="True" DrawerLayoutBehavior="Split" DrawerBreakpointLength="0" DrawerLength="200">
            <DrawerPage.Drawer>
              <TreeView Classes="nav" Margin="0,8">
                <TreeViewItem Header="Installed" IsSelected="True" />
                <TreeViewItem Header="Collections" />
              </TreeView>
            </DrawerPage.Drawer>
            <ContentPage>
              <TextBlock Classes="body2" Margin="16" TextWrapping="Wrap"
                         Text="Open, Split: the toggle is checked and still an icon button." />
            </ContentPage>
          </DrawerPage>
        </Border>
        <Border Classes="paper elevation1" Width="360" Height="200" ClipToBounds="True">
          <DrawerPage Header="Library" IsOpen="False" DrawerLayoutBehavior="CompactInline" DrawerBreakpointLength="0">
            <DrawerPage.Drawer>
              <TreeView Classes="nav" Margin="0,8">
                <TreeViewItem IsSelected="True">
                  <TreeViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <PathIcon Classes="start-icon" Data="{StaticResource GalleryInboxIcon}" />
                      <TextBlock Text="Inbox" />
                    </StackPanel>
                  </TreeViewItem.Header>
                </TreeViewItem>
                <TreeViewItem>
                  <TreeViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <PathIcon Classes="start-icon" Data="{StaticResource GallerySendIcon}" />
                      <TextBlock Text="Sent" />
                    </StackPanel>
                  </TreeViewItem.Header>
                </TreeViewItem>
              </TreeView>
            </DrawerPage.Drawer>
            <ContentPage>
              <TextBlock Classes="body2" Margin="16" TextWrapping="Wrap"
                         Text="Closed, CompactInline: a mini drawer, the links' icons in the rail under the compact toggle." />
            </ContentPage>
          </DrawerPage>
        </Border>
      </StackPanel>

      <TextBlock Classes="overline" Text="Page loader" Margin="0,8,0,0" />
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 MaxWidth="760"
                 HorizontalAlignment="Left"
                 Text="MudBlazor's loading pattern, MudOverlay with DarkBackground and Absolute over the content and an indeterminate MudProgressCircular on it. There is no overlay control here: a Panel over the content takes FiliOverlayDarkBrush, and the spinner is circular on a ProgressBar. Show the Panel while loading; nothing behind it can be clicked." />
      <Border Classes="paper elevation1" Width="520" Height="200" ClipToBounds="True" HorizontalAlignment="Left">
        <Panel>
          <StackPanel Margin="16" Spacing="8">
            <TextBlock Classes="h6" Text="Library" />
            <TextBlock Classes="body2" TextWrapping="Wrap" Text="The page behind the overlay, dimmed while it loads." />
            <Button Classes="filled primary" Content="Refresh" HorizontalAlignment="Left" />
          </StackPanel>
          <!-- <MudOverlay Visible="true" DarkBackground="true" Absolute="true">
                 <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
               </MudOverlay> -->
          <Panel Background="{DynamicResource FiliOverlayDarkBrush}">
            <ProgressBar Classes="circular primary"
                         IsIndeterminate="True"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
          </Panel>
        </Panel>
      </Border>
    </StackPanel>
  </ScrollViewer>

</UserControl>
