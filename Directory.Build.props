<Project>

  <!-- SHARED BLOCK - keep it exactly as it is, byte for byte. Put this repo's own settings below the separator, in this same file. -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Binding redirects for projects that carry an app.config or a web.config.
       GenerateBindingRedirectsOutputType extends the generation to library and test outputs, which are skipped otherwise. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/app.config') Or Exists('$(MSBuildProjectDirectory)/web.config')">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- ================================ end of shared block ================================ -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Globalization stays on. The gallery renders the type ramp with real text, and
      string.Normalize is a no-op in invariant globalization mode.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The build is warning-free, and stays so: a new warning fails it here, not in an app's
         build log months later. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Company>FiliArrochada</Company>
    <Authors>FiliArrochada</Authors>
    <Product>Fili.Theme.MudAvalonia</Product>
    <Copyright>Copyright (c) FiliArrochada</Copyright>
    <Version>0.30.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- MIT is this project's own; the rest is what the package bundles: Material Icons' glyphs,
         the forked templates' Ms-PL headers and Roboto. THIRD-PARTY-NOTICES.md carries each. -->
    <PackageLicenseExpression>MIT AND Apache-2.0 AND MS-PL AND OFL-1.1</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/FiliArrochada/Fili.Theme.MudAvalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FiliArrochada/Fili.Theme.MudAvalonia.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    On a CI runner only: normalises the source paths baked into PDBs and the package, so a
    published build does not carry the runner's directory layout and the same commit produces
    the same bytes. Local builds keep real paths, which the debugger needs.
  -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Each project's packages.lock.json records every package it restores, transitive ones included,
    with its content hash. A local restore updates them; CI restores in locked mode, so a package
    graph that moved without its lock file - a new transitive version, a re-published package -
    fails the restore instead of building something nobody reviewed. Projects only: the scripts in
    tools/ are run as files, restore nothing, and would write a lock file beside themselves.
  -->
  <PropertyGroup Condition="'$(FileBasedProgram)' != 'true'">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

</Project>
