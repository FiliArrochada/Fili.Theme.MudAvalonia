<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Avalonia">
    <!-- Keep every Avalonia package on the same version - a mismatched pair fails at runtime. -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.3" />
    <!-- Versioned apart from Avalonia since 12. Held at 12.1.0, the oldest 12.1 release and so the
         oldest the theme supports: the theme builds against it without passing it on, an app on
         any later version gets the same look, and the gallery and the tests run on it.
         docs/releasing.md has the versions measured. -->
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="3.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

</Project>
